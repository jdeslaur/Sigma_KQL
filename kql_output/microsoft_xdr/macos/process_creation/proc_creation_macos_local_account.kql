// Title: Local System Accounts Discovery - MacOs
// Rule ID: ddf36b67-e872-4507-ab2e-46bda21b842c
// Severity: low
// Tags: attack.discovery, attack.t1087.001
// Category: process_creation
// Product: macos
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_local_account.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "/dscl" and (ProcessCommandLine contains "list" and ProcessCommandLine contains "/users")) or (FolderPath endswith "/dscacheutil" and (ProcessCommandLine contains "-q" and ProcessCommandLine contains "user")) or ProcessCommandLine contains "'x:0:'" or (FolderPath endswith "/cat" and (ProcessCommandLine contains "/etc/passwd" or ProcessCommandLine contains "/etc/sudoers")) or FolderPath endswith "/id" or (FolderPath endswith "/lsof" and ProcessCommandLine contains "-u")