// Title: DLL Load via LSASS
// Rule ID: b3503044-60ce-4bf4-bbcb-e3db98788823
// Severity: high
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1547.008
// Category: registry_event
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_event/registry_event_susp_lsass_dll_load.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceRegistryEvents
| where (RegistryKey contains "\\CurrentControlSet\\Services\\NTDS\\DirectoryServiceExtPt" or RegistryKey contains "\\CurrentControlSet\\Services\\NTDS\\LsaDbExtPt") and (not((InitiatingProcessFolderPath =~ "C:\\Windows\\system32\\lsass.exe" and (RegistryValueData in~ ("%%systemroot%%\\system32\\ntdsa.dll", "%%systemroot%%\\system32\\lsadb.dll")))))