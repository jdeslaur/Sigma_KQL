// Title: ETW Logging Disabled In .NET Processes - Sysmon Registry
// Rule ID: bf4fc428-dcc3-4bbd-99fe-2422aeee2544
// Severity: high
// Tags: attack.persistence, attack.defense-evasion, attack.t1112, attack.t1562
// Category: registry_set
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_dot_net_etw_tamper.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceRegistryEvents
| where (RegistryKey endswith "SOFTWARE\\Microsoft\\.NETFramework\\ETWEnabled" and RegistryValueData =~ "DWORD (0x00000000)") or ((RegistryKey endswith "\\COMPlus_ETWEnabled" or RegistryKey endswith "\\COMPlus_ETWFlags") and (RegistryValueData in~ ("0", "DWORD (0x00000000)")))