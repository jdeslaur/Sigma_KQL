// Title: System Scripts Autorun Keys Modification
// Rule ID: e7a2fd40-3ae1-4a85-bf80-15cf624fb1b1
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Category: registry_set
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_asep_reg_keys_modification_system_scripts.yml
//
// Generated by sigma-to-kql converter
