// Title: Potential Persistence Via Excel Add-in - Registry
// Rule ID: 961e33d1-4f86-4fcf-80ab-930a708b2f82
// Severity: high
// Tags: attack.persistence, attack.t1137.006
// Category: registry_set
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_persistence_xll.yml
//
// Generated by sigma-to-kql converter
