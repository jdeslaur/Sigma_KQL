// Title: Periodic Backup For System Registry Hives Enabled
// Rule ID: 973ef012-8f1a-4c40-93b4-7e659a5cd17f
// Severity: medium
// Tags: attack.collection, attack.t1113
// Category: registry_set
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_enable_periodic_backup.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceRegistryEvents
| where RegistryKey endswith "\\Control\\Session Manager\\Configuration Manager\\EnablePeriodicBackup" and RegistryValueData =~ "DWORD (0x00000001)"