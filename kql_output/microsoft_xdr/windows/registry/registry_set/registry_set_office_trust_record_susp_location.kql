// Title: Macro Enabled In A Potentially Suspicious Document
// Rule ID: a166f74e-bf44-409d-b9ba-ea4b2dd8b3cd
// Severity: high
// Tags: attack.persistence, attack.defense-evasion, attack.t1112
// Category: registry_set
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_office_trust_record_susp_location.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceRegistryEvents
| where RegistryKey contains "\\Security\\Trusted Documents\\TrustRecords" and (RegistryKey contains "/AppData/Local/Microsoft/Windows/INetCache/" or RegistryKey contains "/AppData/Local/Temp/" or RegistryKey contains "/PerfLogs/" or RegistryKey contains "C:/Users/Public/" or RegistryKey contains "file:///D:/" or RegistryKey contains "file:///E:/")