// Title: Potential Persistence Via App Paths Default Property
// Rule ID: 707e097c-e20f-4f67-8807-1f72ff4500d6
// Severity: high
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.012
// Category: registry_set
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_persistence_app_paths.yml
