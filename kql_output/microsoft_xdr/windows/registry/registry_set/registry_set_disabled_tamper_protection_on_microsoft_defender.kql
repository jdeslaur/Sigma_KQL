// Title: Disable Tamper Protection on Windows Defender
// Rule ID: 93d298a1-d28f-47f1-a468-d971e7796679
// Severity: medium
// Tags: attack.defense-evasion, attack.t1562.001
// Category: registry_set
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_disabled_tamper_protection_on_microsoft_defender.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceRegistryEvents
| where (RegistryKey contains "\\Microsoft\\Windows Defender\\Features\\TamperProtection" and RegistryValueData =~ "DWORD (0x00000000)") and (not(((InitiatingProcessFolderPath startswith "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" and InitiatingProcessFolderPath endswith "\\MsMpEng.exe") or InitiatingProcessFolderPath =~ "C:\\Program Files\\Windows Defender\\MsMpEng.exe")))