// Title: Persistence Via New SIP Provider
// Rule ID: 5a2b21ee-6aaa-4234-ac9d-59a59edf90a1
// Severity: medium
// Tags: attack.persistence, attack.defense-evasion, attack.t1553.003
// Category: registry_set
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_sip_persistence.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceRegistryEvents
| where ((RegistryKey endswith "\\SOFTWARE\\Microsoft\\Cryptography\\Providers*" or RegistryKey contains "\\SOFTWARE\\Microsoft\\Cryptography\\OID\\EncodingType" or RegistryKey endswith "\\SOFTWARE\\WOW6432Node\\Microsoft\\Cryptography\\Providers*" or RegistryKey contains "\\SOFTWARE\\WOW6432Node\\Microsoft\\Cryptography\\OID\\EncodingType") and (RegistryKey contains "\\Dll" or RegistryKey contains "\\$DLL")) and (not(((RegistryValueData in~ ("WINTRUST.DLL", "mso.dll")) or (InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\poqexec.exe" and RegistryKey contains "\\CryptSIPDll" and RegistryValueData =~ "C:\\Windows\\System32\\PsfSip.dll"))))