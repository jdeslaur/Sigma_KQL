// Title: Microsoft Excel Add-In Loaded From Uncommon Location
// Rule ID: af4c4609-5755-42fe-8075-4effb49f5d44
// Severity: medium
// Tags: attack.execution, attack.t1204.002
// Category: image_load
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/image_load/image_load_office_excel_xll_susp_load.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceImageLoadEvents
| where InitiatingProcessFolderPath endswith "\\excel.exe" and (FolderPath contains "\\Desktop\\" or FolderPath contains "\\Downloads\\" or FolderPath contains "\\Perflogs\\" or FolderPath contains "\\Temp\\" or FolderPath contains "\\Users\\Public\\" or FolderPath contains "\\Windows\\Tasks\\") and FolderPath endswith ".xll"