// Title: Potential DLL Sideloading Of Libcurl.DLL Via GUP.EXE
// Rule ID: e49b5745-1064-4ac1-9a2e-f687bc2dd37e
// Severity: medium
// Tags: attack.defense-evasion, attack.persistence, attack.privilege-escalation, attack.t1574.001
// Category: image_load
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/image_load/image_load_side_load_gup_libcurl.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceImageLoadEvents
| where (InitiatingProcessFolderPath endswith "\\gup.exe" and FolderPath endswith "\\libcurl.dll") and (not(InitiatingProcessFolderPath endswith "\\Notepad++\\updater\\GUP.exe"))