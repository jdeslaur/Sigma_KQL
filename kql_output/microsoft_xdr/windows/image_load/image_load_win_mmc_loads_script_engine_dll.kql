DeviceImageLoadEvents
| where InitiatingProcessFolderPath endswith "\\mmc.exe" and (FolderPath endswith "\\vbscript.dll" or FolderPath endswith "\\jscript.dll" or FolderPath endswith "\\jscript9.dll")