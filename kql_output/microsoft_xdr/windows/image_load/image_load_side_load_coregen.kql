// Title: Potential DLL Sideloading Using Coregen.exe
// Rule ID: 0fa66f66-e3f6-4a9c-93f8-4f2610b00171
// Severity: medium
// Tags: attack.privilege-escalation, attack.defense-evasion, attack.t1218, attack.t1055
// Category: image_load
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/image_load/image_load_side_load_coregen.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceImageLoadEvents
| where InitiatingProcessFolderPath endswith "\\coregen.exe" and (not((FolderPath startswith "C:\\Program Files (x86)\\Microsoft Silverlight\\" or FolderPath startswith "C:\\Program Files\\Microsoft Silverlight\\" or FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\")))