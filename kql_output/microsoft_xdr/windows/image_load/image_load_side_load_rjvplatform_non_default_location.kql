// Title: Potential RjvPlatform.DLL Sideloading From Non-Default Location
// Rule ID: 0e0bc253-07ed-43f1-816d-e1b220fe8971
// Severity: high
// Tags: attack.persistence, attack.defense-evasion, attack.privilege-escalation, attack.t1574.001
// Category: image_load
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/image_load/image_load_side_load_rjvplatform_non_default_location.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceImageLoadEvents
| where (FolderPath endswith "\\RjvPlatform.dll" and InitiatingProcessFolderPath =~ "\\SystemResetPlatform.exe") and (not(InitiatingProcessFolderPath startswith "C:\\Windows\\System32\\SystemResetPlatform\\"))