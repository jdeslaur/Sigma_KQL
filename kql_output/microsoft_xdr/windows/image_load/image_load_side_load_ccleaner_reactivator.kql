// Title: Potential CCleanerReactivator.DLL Sideloading
// Rule ID: 3735d5ac-d770-4da0-99ff-156b180bc600
// Severity: medium
// Tags: attack.defense-evasion, attack.persistence, attack.privilege-escalation, attack.t1574.001
// Category: image_load
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/image_load/image_load_side_load_ccleaner_reactivator.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceImageLoadEvents
| where FolderPath endswith "\\CCleanerReactivator.dll" and (not(((InitiatingProcessFolderPath startswith "C:\\Program Files\\CCleaner\\" or InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\CCleaner\\") and InitiatingProcessFolderPath endswith "\\CCleanerReactivator.exe")))