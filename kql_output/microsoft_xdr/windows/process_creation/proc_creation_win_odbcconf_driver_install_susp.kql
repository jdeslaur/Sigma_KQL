// Title: Suspicious Driver/DLL Installation Via Odbcconf.EXE
// Rule ID: cb0fe7c5-f3a3-484d-aa25-d350a7912729
// Severity: high
// Tags: attack.defense-evasion, attack.t1218.008
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_odbcconf_driver_install_susp.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\odbcconf.exe" or ProcessVersionInfoOriginalFileName =~ "odbcconf.exe") and ProcessCommandLine contains "INSTALLDRIVER ") and (not(ProcessCommandLine contains ".dll"))