// Title: Suspicious Workstation Locking via Rundll32
// Rule ID: 3b5b0213-0460-4e3f-8937-3abf98ff7dcc
// Severity: medium
// Tags: attack.defense-evasion
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_rundll32_user32_dll.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE") and InitiatingProcessFolderPath endswith "\\cmd.exe" and ProcessCommandLine contains "user32.dll," and ProcessCommandLine contains "LockWorkStation"