DeviceProcessEvents
| where FolderPath endswith "\\amazon-ssm-agent.exe" and (ProcessCommandLine contains "-register " and ProcessCommandLine contains "-code " and ProcessCommandLine contains "-id " and ProcessCommandLine contains "-region ")