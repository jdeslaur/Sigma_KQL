// Title: Potential Persistence Via Microsoft Compatibility Appraiser
// Rule ID: f548a603-c9f2-4c89-b511-b089f7e94549
// Severity: medium
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_schtasks_persistence_windows_telemetry.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\schtasks.exe" or ProcessVersionInfoOriginalFileName =~ "schtasks.exe") and (ProcessCommandLine contains "run " and ProcessCommandLine contains "\\Application Experience\\Microsoft Compatibility Appraiser")