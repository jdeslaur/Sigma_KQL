// Title: PowerShell Web Access Feature Enabled Via DISM
// Rule ID: 7e8f2d3b-9c1a-4f67-b9e8-8d9006e0e51f
// Severity: high
// Tags: attack.privilege-escalation, attack.defense-evasion, attack.persistence, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_dism_enable_powershell_web_access_feature.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\dism.exe" or ProcessVersionInfoOriginalFileName =~ "DISM.EXE") and (ProcessCommandLine contains "WindowsPowerShellWebAccess" and ProcessCommandLine contains "/online" and ProcessCommandLine contains "/enable-feature")