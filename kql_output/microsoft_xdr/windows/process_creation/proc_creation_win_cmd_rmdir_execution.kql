// Title: Directory Removal Via Rmdir
// Rule ID: 41ca393d-538c-408a-ac27-cf1e038be80c
// Severity: low
// Tags: attack.defense-evasion, attack.t1070.004
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_cmd_rmdir_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\cmd.exe" or ProcessVersionInfoOriginalFileName =~ "Cmd.Exe") and ProcessCommandLine contains "rmdir" and (ProcessCommandLine contains "/s" or ProcessCommandLine contains "/q")