// Title: Mstsc.EXE Execution With Local RDP File
// Rule ID: 5fdce3ac-e7f9-4ecd-a3aa-a4d78ebbf0af
// Severity: low
// Tags: attack.command-and-control, attack.t1219.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_mstsc_run_local_rdp_file.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\mstsc.exe" or ProcessVersionInfoOriginalFileName =~ "mstsc.exe") and (ProcessCommandLine endswith ".rdp" or ProcessCommandLine endswith ".rdp\"")) and (not((InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\lxss\\wslhost.exe" and ProcessCommandLine contains "C:\\ProgramData\\Microsoft\\WSL\\wslg.rdp")))