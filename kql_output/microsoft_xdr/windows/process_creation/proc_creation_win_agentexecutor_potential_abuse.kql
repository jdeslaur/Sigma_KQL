// Title: AgentExecutor PowerShell Execution
// Rule ID: 7efd2c8d-8b18-45b7-947d-adfe9ed04f61
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_agentexecutor_potential_abuse.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath =~ "\\AgentExecutor.exe" or ProcessVersionInfoOriginalFileName =~ "AgentExecutor.exe") and (ProcessCommandLine contains " -powershell" or ProcessCommandLine contains " -remediationScript")) and (not(InitiatingProcessFolderPath endswith "\\Microsoft.Management.Services.IntuneWindowsAgent.exe"))