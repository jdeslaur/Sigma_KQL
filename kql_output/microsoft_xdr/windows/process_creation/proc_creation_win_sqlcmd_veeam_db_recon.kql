// Title: Veeam Backup Database Suspicious Query
// Rule ID: 696bfb54-227e-4602-ac5b-30d9d2053312
// Severity: medium
// Tags: attack.collection, attack.t1005
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_sqlcmd_veeam_db_recon.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\sqlcmd.exe" and (ProcessCommandLine contains "VeeamBackup" and ProcessCommandLine contains "From ")) and (ProcessCommandLine contains "BackupRepositories" or ProcessCommandLine contains "Backups" or ProcessCommandLine contains "Credentials" or ProcessCommandLine contains "HostCreds" or ProcessCommandLine contains "SmbFileShares" or ProcessCommandLine contains "Ssh_creds" or ProcessCommandLine contains "VSphereInfo")