DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\gup.exe" and FolderPath endswith "\\explorer.exe") and (not(((FolderPath endswith "\\explorer.exe" and ProcessCommandLine contains "\\Notepad++\\notepad++.exe") or InitiatingProcessFolderPath contains "\\Notepad++\\updater\\" or isnull(ProcessCommandLine))))