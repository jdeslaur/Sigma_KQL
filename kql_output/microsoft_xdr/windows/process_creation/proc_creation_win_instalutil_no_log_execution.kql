// Title: Suspicious Execution of InstallUtil Without Log
// Rule ID: d042284c-a296-4988-9be5-f424fadcc28c
// Severity: medium
// Tags: attack.defense-evasion
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_instalutil_no_log_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where FolderPath endswith "\\InstallUtil.exe" and FolderPath contains "Microsoft.NET\\Framework" and (ProcessCommandLine contains "/logfile= " and ProcessCommandLine contains "/LogToConsole=false")