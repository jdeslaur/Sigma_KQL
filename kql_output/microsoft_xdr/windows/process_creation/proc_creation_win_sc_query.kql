DeviceProcessEvents
| where ((FolderPath endswith "\\sc.exe" and ProcessVersionInfoOriginalFileName =~ "sc.exe") and ProcessCommandLine contains " query") and (not(ProcessCommandLine =~ "sc query dokan1"))