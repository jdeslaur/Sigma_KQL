// Title: Suspicious Csi.exe Usage
// Rule ID: 40b95d31-1afc-469e-8d34-9a3a667d058e
// Severity: medium
// Tags: attack.lateral-movement, attack.execution, attack.t1072, attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_csi_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\csi.exe" or FolderPath endswith "\\rcsi.exe") or (ProcessVersionInfoOriginalFileName in~ ("csi.exe", "rcsi.exe"))) and ProcessVersionInfoCompanyName =~ "Microsoft Corporation"