DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "pssuspend.exe" or (FolderPath endswith "\\pssuspend.exe" or FolderPath endswith "\\pssuspend64.exe")) and ProcessCommandLine contains "msmpeng.exe"