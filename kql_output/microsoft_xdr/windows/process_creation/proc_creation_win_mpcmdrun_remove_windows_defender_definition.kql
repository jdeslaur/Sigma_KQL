// Title: Windows Defender Definition Files Removed
// Rule ID: 9719a8aa-401c-41af-8108-ced7ec9cd75c
// Severity: high
// Tags: attack.defense-evasion, attack.t1562.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_mpcmdrun_remove_windows_defender_definition.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\MpCmdRun.exe" or ProcessVersionInfoOriginalFileName =~ "MpCmdRun.exe") and (ProcessCommandLine contains " -RemoveDefinitions" and ProcessCommandLine contains " -All")