// Title: Potential Arbitrary File Download Via Cmdl32.EXE
// Rule ID: f37aba28-a9e6-4045-882c-d5004043b337
// Severity: medium
// Tags: attack.execution, attack.defense-evasion, attack.t1218, attack.t1202
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_cmdl32_arbitrary_file_download.yml
