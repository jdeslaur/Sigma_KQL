// Title: Potential Arbitrary Command Execution Via FTP.EXE
// Rule ID: 06b401f4-107c-4ff9-947f-9ec1e7649f1e
// Severity: medium
// Tags: attack.execution, attack.t1059, attack.defense-evasion, attack.t1202
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_ftp_arbitrary_command_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\ftp.exe" or ((FolderPath endswith "\\ftp.exe" or ProcessVersionInfoOriginalFileName =~ "ftp.exe") and (ProcessCommandLine contains "-s:" or ProcessCommandLine contains "/s:" or ProcessCommandLine contains "–s:" or ProcessCommandLine contains "—s:" or ProcessCommandLine contains "―s:"))