// Title: Remote Access Tool - Action1 Arbitrary Code Execution and Remote Sessions
// Rule ID: aa3168fb-d594-4f93-a92d-7a9ba675b766
// Severity: medium
// Tags: attack.command-and-control, attack.t1219.002, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_remote_access_tools_action1_code_exec_and_remote_sessions.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\action1_agent.exe" and FolderPath contains "\\Windows\\Action1\\package_downloads\\") or ((InitiatingProcessFolderPath endswith "\\cmd.exe" or InitiatingProcessFolderPath endswith "\\powershell.exe") and (InitiatingProcessCommandLine contains "\\Action1\\scripts\\Run_Command_" or InitiatingProcessCommandLine contains "\\Action1\\scripts\\Run_PowerShell_")) or FolderPath endswith "\\agent1_remote.exe"