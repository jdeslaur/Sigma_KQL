// Title: Potential DLL Injection Or Execution Using Tracker.exe
// Rule ID: 148431ce-4b70-403d-8525-fcc2993f29ea
// Severity: medium
// Tags: attack.privilege-escalation, attack.defense-evasion, attack.t1055.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_lolbin_tracker.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\tracker.exe" or ProcessVersionInfoFileDescription =~ "Tracker") and (ProcessCommandLine contains " /d " or ProcessCommandLine contains " /c ")) and (not((ProcessCommandLine contains " /ERRORREPORT:PROMPT " or (InitiatingProcessFolderPath endswith "\\Msbuild\\Current\\Bin\\MSBuild.exe" or InitiatingProcessFolderPath endswith "\\Msbuild\\Current\\Bin\\amd64\\MSBuild.exe"))))