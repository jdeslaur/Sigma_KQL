DeviceProcessEvents
| where ((FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\wscript.exe") or (ProcessVersionInfoOriginalFileName in~ ("cscript.exe", "wscript.exe"))) and ProcessCommandLine contains "gatherNetworkInfo.vbs"