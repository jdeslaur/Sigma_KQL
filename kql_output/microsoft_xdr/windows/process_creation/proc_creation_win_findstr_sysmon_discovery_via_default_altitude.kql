// Title: Sysmon Discovery Via Default Driver Altitude Using Findstr.EXE
// Rule ID: 37db85d1-b089-490a-a59a-c7b6f984f480
// Severity: high
// Tags: attack.discovery, attack.t1518.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_findstr_sysmon_discovery_via_default_altitude.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\find.exe" or FolderPath endswith "\\findstr.exe") or (ProcessVersionInfoOriginalFileName in~ ("FIND.EXE", "FINDSTR.EXE"))) and ProcessCommandLine contains " 385201"