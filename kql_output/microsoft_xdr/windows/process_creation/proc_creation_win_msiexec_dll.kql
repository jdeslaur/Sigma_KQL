// Title: DllUnregisterServer Function Call Via Msiexec.EXE
// Rule ID: 84f52741-8834-4a8c-a413-2eb2269aa6c8
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218.007
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_msiexec_dll.yml
