// Title: Potential SPN Enumeration Via Setspn.EXE
// Rule ID: 1eeed653-dbc8-4187-ad0c-eeebb20e6599
// Severity: medium
// Tags: attack.credential-access, attack.t1558.003
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_setspn_spn_enumeration.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\setspn.exe" or ProcessVersionInfoOriginalFileName =~ "setspn.exe" or (ProcessVersionInfoFileDescription contains "Query or reset the computer" and ProcessVersionInfoFileDescription contains "SPN attribute")) and (ProcessCommandLine contains " -q " or ProcessCommandLine contains " /q ")