// Title: File Download Via Windows Defender MpCmpRun.EXE
// Rule ID: 46123129-1024-423e-9fae-43af4a0fa9a5
// Severity: high
// Tags: attack.defense-evasion, attack.t1218, attack.command-and-control, attack.t1105
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_mpcmdrun_download_arbitrary_file.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "MpCmdRun.exe" or FolderPath endswith "\\MpCmdRun.exe" or ProcessCommandLine contains "MpCmdRun.exe" or ProcessVersionInfoFileDescription =~ "Microsoft Malware Protection Command Line Utility") and (ProcessCommandLine contains "DownloadFile" and ProcessCommandLine contains "url")