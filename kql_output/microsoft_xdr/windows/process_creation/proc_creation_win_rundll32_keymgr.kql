// Title: Suspicious Key Manager Access
// Rule ID: a4694263-59a8-4608-a3a0-6f8d3a51664c
// Severity: high
// Tags: attack.credential-access, attack.t1555.004
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_rundll32_keymgr.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE") and (ProcessCommandLine contains "keymgr" and ProcessCommandLine contains "KRShowKeyMgr")