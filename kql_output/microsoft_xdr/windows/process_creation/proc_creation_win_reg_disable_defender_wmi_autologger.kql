// Title: Disabling Windows Defender WMI Autologger Session via Reg.exe
// Rule ID: a1b2c3d4-e5f6-a7b8-c9d0-e1f2a3b4c5d6
// Severity: high
// Tags: attack.defense-evasion, attack.t1562.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_reg_disable_defender_wmi_autologger.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\reg.exe" or ProcessVersionInfoOriginalFileName =~ "reg.exe") and (ProcessCommandLine contains "\\Control\\WMI\\Autologger\\DefenderApiLogger\\Start" or ProcessCommandLine contains "\\Control\\WMI\\Autologger\\DefenderAuditLogger\\Start") and (ProcessCommandLine contains "add" and ProcessCommandLine contains "0")) and (not(ProcessCommandLine contains "0x00000001"))