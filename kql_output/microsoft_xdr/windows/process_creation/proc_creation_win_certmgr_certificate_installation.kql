// Title: New Root Certificate Installed Via CertMgr.EXE
// Rule ID: ff992eac-6449-4c60-8c1d-91c9722a1d48
// Severity: medium
// Tags: attack.defense-evasion, attack.t1553.004
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_certmgr_certificate_installation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\CertMgr.exe" or ProcessVersionInfoOriginalFileName =~ "CERTMGT.EXE") and (ProcessCommandLine contains "/add" and ProcessCommandLine contains "root")