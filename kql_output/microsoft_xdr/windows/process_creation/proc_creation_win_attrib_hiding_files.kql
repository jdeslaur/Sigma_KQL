// Title: Hiding Files with Attrib.exe
// Rule ID: 4281cb20-2994-4580-aa63-c8b86d019934
// Severity: medium
// Tags: attack.defense-evasion, attack.t1564.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_attrib_hiding_files.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\attrib.exe" or ProcessVersionInfoOriginalFileName =~ "ATTRIB.EXE") and ProcessCommandLine contains " +h ") and (not(ProcessCommandLine contains "\\desktop.ini ")) and (not((InitiatingProcessFolderPath endswith "\\cmd.exe" and ProcessCommandLine =~ "+R +H +S +A \\*.cui" and InitiatingProcessCommandLine =~ "C:\\WINDOWS\\system32\\*.bat")))