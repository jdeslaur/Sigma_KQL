// Title: Potentially Suspicious DLL Registered Via Odbcconf.EXE
// Rule ID: ba4cfc11-d0fa-4d94-bf20-7c332c412e76
// Severity: high
// Tags: attack.defense-evasion, attack.t1218.008
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_odbcconf_register_dll_regsvr_susp.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\odbcconf.exe" or ProcessVersionInfoOriginalFileName =~ "odbcconf.exe") and ProcessCommandLine contains "REGSVR ") and (not(ProcessCommandLine contains ".dll"))