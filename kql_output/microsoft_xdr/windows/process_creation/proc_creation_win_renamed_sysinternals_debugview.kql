// Title: Renamed SysInternals DebugView Execution
// Rule ID: cd764533-2e07-40d6-a718-cfeec7f2da7f
// Severity: high
// Tags: attack.resource-development, attack.t1588.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_renamed_sysinternals_debugview.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ProcessVersionInfoProductName =~ "Sysinternals DebugView" and (not((ProcessVersionInfoOriginalFileName =~ "Dbgview.exe" and FolderPath endswith "\\Dbgview.exe")))