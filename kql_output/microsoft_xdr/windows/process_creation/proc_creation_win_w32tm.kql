// Title: Use of W32tm as Timer
// Rule ID: 6da2c9f5-7c53-401b-aacb-92c040ce1215
// Severity: high
// Tags: attack.discovery, attack.t1124
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_w32tm.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\w32tm.exe" or ProcessVersionInfoOriginalFileName =~ "w32time.dll") and (ProcessCommandLine contains "/stripchart" and ProcessCommandLine contains "/computer:" and ProcessCommandLine contains "/period:" and ProcessCommandLine contains "/dataonly" and ProcessCommandLine contains "/samples:")