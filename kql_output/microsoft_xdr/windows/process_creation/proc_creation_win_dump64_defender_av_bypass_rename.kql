// Title: Potential Windows Defender AV Bypass Via Dump64.EXE Rename
// Rule ID: 129966c9-de17-4334-a123-8b58172e664d
// Severity: high
// Tags: attack.credential-access, attack.t1003.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_dump64_defender_av_bypass_rename.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath startswith ":\\Program Files" and FolderPath contains "\\Microsoft Visual Studio\\" and FolderPath endswith "\\dump64.exe") and (ProcessVersionInfoOriginalFileName =~ "procdump" or (ProcessCommandLine contains " -ma " or ProcessCommandLine contains " -mp "))