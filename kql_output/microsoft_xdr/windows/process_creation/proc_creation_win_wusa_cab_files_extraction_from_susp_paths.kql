// Title: Cab File Extraction Via Wusa.EXE From Potentially Suspicious Paths
// Rule ID: c74c0390-3e20-41fd-a69a-128f0275a5ea
// Severity: high
// Tags: attack.execution
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wusa_cab_files_extraction_from_susp_paths.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\wusa.exe" and ProcessCommandLine contains "/extract:") and (ProcessCommandLine contains ":\\PerfLogs\\" or ProcessCommandLine contains ":\\Users\\Public\\" or ProcessCommandLine contains ":\\Windows\\Temp\\" or ProcessCommandLine contains "\\Appdata\\Local\\Temp\\")