// Title: File And SubFolder Enumeration Via Dir Command
// Rule ID: 7c9340a9-e2ee-4e43-94c5-c54ebbea1006
// Severity: low
// Tags: attack.discovery, attack.t1217
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_cmd_dir_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\cmd.exe" or ProcessVersionInfoOriginalFileName =~ "Cmd.Exe") and (ProcessCommandLine matches regex ".*dir.*-s.*" or ProcessCommandLine matches regex ".*dir.*/s.*" or ProcessCommandLine matches regex ".*dir.*–s.*" or ProcessCommandLine matches regex ".*dir.*—s.*" or ProcessCommandLine matches regex ".*dir.*―s.*")