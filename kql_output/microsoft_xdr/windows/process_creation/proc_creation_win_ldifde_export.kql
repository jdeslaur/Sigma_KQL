DeviceProcessEvents
| where ((FolderPath endswith "\\ldifde.exe" or ProcessVersionInfoOriginalFileName =~ "ldifde.exe") and ProcessCommandLine contains "-f") and (not(ProcessCommandLine contains " -i"))