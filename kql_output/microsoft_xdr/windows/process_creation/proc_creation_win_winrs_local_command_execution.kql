// Title: Winrs Local Command Execution
// Rule ID: bcfece3d-56fe-4545-9931-3b8e92927db1
// Severity: high
// Tags: attack.lateral-movement, attack.defense-evasion, attack.t1021.006, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_winrs_local_command_execution.yml
//
// Generated by sigma-to-kql converter
