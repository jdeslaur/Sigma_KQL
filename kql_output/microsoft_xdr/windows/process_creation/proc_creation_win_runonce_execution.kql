// Title: Run Once Task Execution as Configured in Registry
// Rule ID: 198effb6-6c98-4d0c-9ea3-451fa143c45c
// Severity: low
// Tags: attack.persistence, attack.defense-evasion, attack.t1112
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_runonce_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\runonce.exe" or ProcessVersionInfoFileDescription =~ "Run Once Wrapper") and (ProcessCommandLine contains "/AlternateShellStartup" or ProcessCommandLine endswith "/r")