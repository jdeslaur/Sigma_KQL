// Title: Verclsid.exe Runs COM Object
// Rule ID: d06be4b9-8045-428b-a567-740a26d9db25
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_verclsid_runs_com.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\verclsid.exe" or ProcessVersionInfoOriginalFileName =~ "verclsid.exe") and (ProcessCommandLine contains "/S" and ProcessCommandLine contains "/C")) and (not((InitiatingProcessFolderPath endswith "C:\\Windows\\System32\\RuntimeBroker.exe" and (ProcessCommandLine contains "verclsid.exe\" /S /C {" and ProcessCommandLine contains "} /I {"))))