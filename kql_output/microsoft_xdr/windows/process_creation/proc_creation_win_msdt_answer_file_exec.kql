// Title: MSDT Execution Via Answer File
// Rule ID: 9c8c7000-3065-44a8-a555-79bcba5d9955
// Severity: high
// Tags: attack.defense-evasion, attack.t1218, attack.execution
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_msdt_answer_file_exec.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\msdt.exe" and ProcessCommandLine contains "\\WINDOWS\\diagnostics\\index\\PCWDiagnostic.xml" and (ProcessCommandLine contains " -af " or ProcessCommandLine contains " /af " or ProcessCommandLine contains " –af " or ProcessCommandLine contains " —af " or ProcessCommandLine contains " ―af ")) and (not(InitiatingProcessFolderPath endswith "\\pcwrun.exe"))