// Title: Security Service Disabled Via Reg.EXE
// Rule ID: 5e95028c-5229-4214-afae-d653d573d0ec
// Severity: high
// Tags: attack.defense-evasion, attack.t1562.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_reg_disable_sec_services.yml
//
// Generated by sigma-to-kql converter
