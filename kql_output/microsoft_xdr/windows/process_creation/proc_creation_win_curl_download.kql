// Title: File Download Via Curl.EXE
// Rule ID: 9a517fca-4ba3-4629-9278-a68694697b81
// Severity: medium
// Tags: attack.command-and-control, attack.t1105, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_curl_download.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\curl.exe" or ProcessVersionInfoProductName =~ "The curl executable") and (ProcessCommandLine contains " -O" or ProcessCommandLine contains "--remote-name" or ProcessCommandLine contains "--output")