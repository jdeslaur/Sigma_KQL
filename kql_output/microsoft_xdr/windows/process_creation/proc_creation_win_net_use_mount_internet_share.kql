// Title: Windows Internet Hosted WebDav Share Mount Via Net.EXE
// Rule ID: 7e6237fe-3ddb-438f-9381-9bf9de5af8d0
// Severity: high
// Tags: attack.lateral-movement, attack.t1021.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_net_use_mount_internet_share.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains " use " and ProcessCommandLine contains " http")