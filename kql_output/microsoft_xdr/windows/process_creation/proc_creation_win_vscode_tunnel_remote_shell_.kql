// Title: Visual Studio Code Tunnel Shell Execution
// Rule ID: f4a623c2-4ef5-4c33-b811-0642f702c9f1
// Severity: medium
// Tags: attack.command-and-control, attack.t1071.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_vscode_tunnel_remote_shell_.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (InitiatingProcessFolderPath contains "\\servers\\Stable-" and InitiatingProcessFolderPath endswith "\\server\\node.exe" and InitiatingProcessCommandLine contains ".vscode-server") and (((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") and ProcessCommandLine contains "\\terminal\\browser\\media\\shellIntegration.ps1") or (FolderPath endswith "\\wsl.exe" or FolderPath endswith "\\bash.exe"))