// Title: Password Provided In Command Line Of Net.EXE
// Rule ID: d4498716-1d52-438f-8084-4a603157d131
// Severity: medium
// Tags: attack.defense-evasion, attack.initial-access, attack.persistence, attack.privilege-escalation, attack.lateral-movement, attack.t1021.002, attack.t1078
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_net_use_password_plaintext.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains " use " and (ProcessCommandLine contains ":" and ProcessCommandLine contains "\\") and (ProcessCommandLine contains "/USER:" and ProcessCommandLine contains " "))) and (not(ProcessCommandLine endswith " "))