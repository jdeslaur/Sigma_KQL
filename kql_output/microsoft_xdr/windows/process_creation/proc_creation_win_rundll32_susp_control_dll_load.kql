// Title: Suspicious Control Panel DLL Load
// Rule ID: d7eb979b-c2b5-4a6f-a3a7-c87ce6763819
// Severity: high
// Tags: attack.defense-evasion, attack.t1218.011
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_rundll32_susp_control_dll_load.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\System32\\control.exe" and (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE")) and (not(ProcessCommandLine contains "Shell32.dll"))