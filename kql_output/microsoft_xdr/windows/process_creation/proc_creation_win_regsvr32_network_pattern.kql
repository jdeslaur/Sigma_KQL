// Title: Potentially Suspicious Regsvr32 HTTP/FTP Pattern
// Rule ID: 867356ee-9352-41c9-a8f2-1be690d78216
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218.010
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_regsvr32_network_pattern.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\regsvr32.exe" or ProcessVersionInfoOriginalFileName =~ "REGSVR32.EXE") and (ProcessCommandLine contains " /i" or ProcessCommandLine contains " -i") and (ProcessCommandLine contains "ftp" or ProcessCommandLine contains "http")