DeviceProcessEvents
| where (FolderPath endswith "\\print.exe" and ProcessCommandLine startswith "print" and (ProcessCommandLine contains "/D" and ProcessCommandLine contains ".exe")) and (not(ProcessCommandLine contains "print.exe"))