// Title: New Remote Desktop Connection Initiated Via Mstsc.EXE
// Rule ID: 954f0af7-62dd-418f-b3df-a84bc2c7a774
// Severity: medium
// Tags: attack.lateral-movement, attack.t1021.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_mstsc_remote_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\mstsc.exe" or ProcessVersionInfoOriginalFileName =~ "mstsc.exe") and (ProcessCommandLine contains " -v:" or ProcessCommandLine contains " /v:" or ProcessCommandLine contains " –v:" or ProcessCommandLine contains " —v:" or ProcessCommandLine contains " ―v:")) and (not((InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\lxss\\wslhost.exe" and ProcessCommandLine contains "C:\\ProgramData\\Microsoft\\WSL\\wslg.rdp")))