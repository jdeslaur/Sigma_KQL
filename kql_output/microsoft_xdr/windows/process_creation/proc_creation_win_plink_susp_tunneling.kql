// Title: Potential RDP Tunneling Via Plink
// Rule ID: f38ce0b9-5e97-4b47-a211-7dc8d8b871da
// Severity: high
// Tags: attack.command-and-control, attack.t1572
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_plink_susp_tunneling.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\plink.exe" and ProcessCommandLine contains ":127.0.0.1:3389") or ((FolderPath endswith "\\plink.exe" and ProcessCommandLine contains ":3389") and (ProcessCommandLine contains " -P 443" or ProcessCommandLine contains " -P 22"))