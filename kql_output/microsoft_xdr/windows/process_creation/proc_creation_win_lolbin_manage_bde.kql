// Title: Potential Manage-bde.wsf Abuse To Proxy Execution
// Rule ID: c363385c-f75d-4753-a108-c1a8e28bdbda
// Severity: high
// Tags: attack.defense-evasion, attack.t1216
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_lolbin_manage_bde.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\wscript.exe" or ProcessVersionInfoOriginalFileName =~ "wscript.exe") and ProcessCommandLine contains "manage-bde.wsf") or (((InitiatingProcessFolderPath endswith "\\cscript.exe" or InitiatingProcessFolderPath endswith "\\wscript.exe") and InitiatingProcessCommandLine contains "manage-bde.wsf") and (not(FolderPath endswith "\\cmd.exe")))