DeviceProcessEvents
| where FolderPath endswith "\\SepRemovalToolNative_x64.exe" or (FolderPath endswith "\\CATClean.exe" and ProcessCommandLine contains "--uninstall") or (FolderPath endswith "\\NetInstaller.exe" and ProcessCommandLine contains "-r") or (FolderPath endswith "\\WFPUnins.exe" and (ProcessCommandLine contains "/uninstall" and ProcessCommandLine contains "/enterprise"))