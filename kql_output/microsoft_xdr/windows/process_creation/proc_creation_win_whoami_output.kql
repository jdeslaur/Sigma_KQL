// Title: Whoami.EXE Execution With Output Option
// Rule ID: c30fb093-1109-4dc8-88a8-b30d11c95a5d
// Severity: medium
// Tags: attack.discovery, attack.t1033, car.2016-03-001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_whoami_output.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\whoami.exe" or ProcessVersionInfoOriginalFileName =~ "whoami.exe") and (ProcessCommandLine contains " /FO CSV" or ProcessCommandLine contains " -FO CSV")) or ProcessCommandLine matches regex ".*whoami.*>.*"