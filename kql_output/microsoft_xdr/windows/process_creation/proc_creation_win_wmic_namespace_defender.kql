// Title: Potential Windows Defender Tampering Via Wmic.EXE
// Rule ID: 51cbac1e-eee3-4a90-b1b7-358efb81fa0a
// Severity: high
// Tags: attack.defense-evasion, attack.execution, attack.t1047, attack.t1562
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wmic_namespace_defender.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "wmic.exe" or FolderPath endswith "\\WMIC.exe") and ProcessCommandLine contains "/Namespace:\\\\root\\Microsoft\\Windows\\Defender"