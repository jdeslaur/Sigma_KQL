// Title: Remote Access Tool - ScreenConnect Remote Command Execution
// Rule ID: b1f73849-6329-4069-bc8f-78a604bb8b23
// Severity: low
// Tags: attack.execution, attack.t1059.003
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_remote_access_tools_screenconnect_remote_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\ScreenConnect.ClientService.exe" and (FolderPath endswith "\\cmd.exe" or ProcessVersionInfoOriginalFileName =~ "Cmd.Exe") and ProcessCommandLine contains "\\TEMP\\ScreenConnect\\"