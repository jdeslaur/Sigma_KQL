// Title: Arbitrary Command Execution Using WSL
// Rule ID: dec44ca7-61ad-493c-bfd7-8819c5faa09b
// Severity: medium
// Tags: attack.execution, attack.defense-evasion, attack.t1218, attack.t1202, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_wsl_arbitrary_command_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\wsl.exe" or ProcessVersionInfoOriginalFileName =~ "wsl.exe") and (ProcessCommandLine contains " -e " or ProcessCommandLine contains " --exec" or ProcessCommandLine contains " --system" or ProcessCommandLine contains " --shell-type " or ProcessCommandLine contains " /mnt/c" or ProcessCommandLine contains " --user root" or ProcessCommandLine contains " -u root" or ProcessCommandLine contains "--debug-shell")) and (not((InitiatingProcessFolderPath endswith "\\cmd.exe" and (ProcessCommandLine contains " -d " and ProcessCommandLine contains " -e kill "))))