// Title: Suspicious Process Masquerading As SvcHost.EXE
// Rule ID: be58d2e2-06c8-4f58-b666-b99f6dc3b6cd
// Severity: high
// Tags: attack.defense-evasion, attack.t1036.005
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_svchost_masqueraded_execution.yml
//
