// Title: Dism Remove Online Package
// Rule ID: 43e32da2-fdd0-4156-90de-50dfd62636f9
// Severity: medium
// Tags: attack.defense-evasion, attack.t1562.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_dism_remove.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\DismHost.exe" and (InitiatingProcessCommandLine contains "/Online" and InitiatingProcessCommandLine contains "/Disable-Feature")) or (FolderPath endswith "\\Dism.exe" and (ProcessCommandLine contains "/Online" and ProcessCommandLine contains "/Disable-Feature"))