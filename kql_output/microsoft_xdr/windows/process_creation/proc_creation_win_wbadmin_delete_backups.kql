// Title: Windows Backup Deleted Via Wbadmin.EXE
// Rule ID: 89f75308-5b1b-4390-b2d8-d6b2340efaf8
// Severity: medium
// Tags: attack.impact, attack.t1490
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wbadmin_delete_backups.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\wbadmin.exe" or ProcessVersionInfoOriginalFileName =~ "WBADMIN.EXE") and (ProcessCommandLine contains "delete " and ProcessCommandLine contains "backup")) and (not(ProcessCommandLine contains "keepVersions:0"))