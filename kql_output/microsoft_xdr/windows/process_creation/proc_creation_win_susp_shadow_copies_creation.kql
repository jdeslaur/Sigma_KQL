// Title: Shadow Copies Creation Using Operating Systems Utilities
// Rule ID: b17ea6f7-6e90-447e-a799-e6c0a493d6ce
// Severity: medium
// Tags: attack.credential-access, attack.t1003, attack.t1003.002, attack.t1003.003
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_shadow_copies_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wmic.exe" or FolderPath endswith "\\vssadmin.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll", "wmic.exe", "VSSADMIN.EXE"))) and (ProcessCommandLine contains "shadow" and ProcessCommandLine contains "create")