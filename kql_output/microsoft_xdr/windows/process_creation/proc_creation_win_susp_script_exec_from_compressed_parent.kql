// Title: Manual Execution of Script Inside of a Compressed File
// Rule ID: 95724fc1-a258-4674-97db-a30351981c5a
// Severity: medium
// Tags: attack.execution, attack.t1059, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_susp_script_exec_from_compressed_parent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((InitiatingProcessFolderPath matches regex ".*\\\\7z.*\\.exe" and ProcessCommandLine matches regex ".*\\\\AppData\\\\local\\\\temp\\\\7z.*\\\\.*") or (InitiatingProcessFolderPath endswith "\\winrar.exe" and ProcessCommandLine matches regex ".*\\\\AppData\\\\local\\\\temp\\\\rar.*\\\\.*") or (InitiatingProcessFolderPath endswith "\\explorer.exe" and (ProcessCommandLine contains "\\AppData\\local\\temp*.rar\\" or ProcessCommandLine contains "\\AppData\\local\\temp*.zip\\"))) and ((FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\mshta.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wscript.exe") and (ProcessCommandLine endswith ".hta" or ProcessCommandLine endswith ".js" or ProcessCommandLine endswith ".jse" or ProcessCommandLine endswith ".ps1" or ProcessCommandLine endswith ".vbe" or ProcessCommandLine endswith ".vbs" or ProcessCommandLine endswith ".wsf" or ProcessCommandLine endswith ".wsh"))