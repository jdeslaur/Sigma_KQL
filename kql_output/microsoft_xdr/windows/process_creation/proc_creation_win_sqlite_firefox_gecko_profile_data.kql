// Title: SQLite Firefox Profile Data DB Access
// Rule ID: 4833155a-4053-4c9c-a997-777fcea0baa7
// Severity: high
// Tags: attack.credential-access, attack.t1539, attack.collection, attack.t1005
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_sqlite_firefox_gecko_profile_data.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (ProcessVersionInfoProductName =~ "SQLite" or (FolderPath endswith "\\sqlite.exe" or FolderPath endswith "\\sqlite3.exe")) and (ProcessCommandLine contains "cookies.sqlite" or ProcessCommandLine contains "places.sqlite")