// Title: Explorer NOUACCHECK Flag
// Rule ID: 534f2ef7-e8a2-4433-816d-c91bccde289b
// Severity: high
// Tags: attack.privilege-escalation, attack.defense-evasion, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_explorer_nouaccheck.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\explorer.exe" and ProcessCommandLine contains "/NOUACCHECK") and (not((InitiatingProcessCommandLine =~ "C:\\Windows\\system32\\svchost.exe -k netsvcs -p -s Schedule" or InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\svchost.exe")))