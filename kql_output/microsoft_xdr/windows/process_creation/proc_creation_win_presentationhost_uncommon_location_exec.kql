// Title: XBAP Execution From Uncommon Locations Via PresentationHost.EXE
// Rule ID: d22e2925-cfd8-463f-96f6-89cec9d9bc5f
// Severity: medium
// Tags: attack.defense-evasion, attack.execution, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_presentationhost_uncommon_location_exec.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\presentationhost.exe" or ProcessVersionInfoOriginalFileName =~ "PresentationHost.exe") and ProcessCommandLine contains ".xbap") and (not((ProcessCommandLine contains " C:\\Windows\\" or ProcessCommandLine contains " C:\\Program Files")))