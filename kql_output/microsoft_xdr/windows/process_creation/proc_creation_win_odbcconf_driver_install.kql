// Title: Driver/DLL Installation Via Odbcconf.EXE
// Rule ID: 3f5491e2-8db8-496b-9e95-1029fce852d4
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218.008
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_odbcconf_driver_install.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\odbcconf.exe" or ProcessVersionInfoOriginalFileName =~ "odbcconf.exe") and (ProcessCommandLine contains "INSTALLDRIVER " and ProcessCommandLine contains ".dll")