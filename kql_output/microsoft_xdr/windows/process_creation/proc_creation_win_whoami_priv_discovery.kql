// Title: Security Privileges Enumeration Via Whoami.EXE
// Rule ID: 97a80ec7-0e2f-4d05-9ef4-65760e634f6b
// Severity: high
// Tags: attack.privilege-escalation, attack.discovery, attack.t1033
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_whoami_priv_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\whoami.exe" or ProcessVersionInfoOriginalFileName =~ "whoami.exe") and (ProcessCommandLine contains " /priv" or ProcessCommandLine contains " -priv")