// Title: Potential Credential Dumping Via WER
// Rule ID: 9a4ccd1a-3526-4d99-b980-9f9c5d3a6ff3
// Severity: high
// Tags: attack.credential-access, attack.t1003.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_werfault_lsass_shtinkering.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\Werfault.exe" or ProcessVersionInfoOriginalFileName =~ "WerFault.exe") and ((InitiatingProcessAccountName contains "AUTHORI" or InitiatingProcessAccountName contains "AUTORI") and (AccountName contains "AUTHORI" or AccountName contains "AUTORI") and (ProcessCommandLine contains " -u -p " and ProcessCommandLine contains " -ip " and ProcessCommandLine contains " -s "))) and (not(InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\lsass.exe"))