// Title: Github Self-Hosted Runner Execution
// Rule ID: 5bac7a56-da88-4c27-922e-c81e113b20cb
// Severity: medium
// Tags: attack.command-and-control, attack.t1102.002, attack.t1071
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_github_self_hosted_runner.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\Runner.Worker.exe" or ProcessVersionInfoOriginalFileName =~ "Runner.Worker.dll") and ProcessCommandLine contains "spawnclient") or ((FolderPath endswith "\\Runner.Listener.exe" or ProcessVersionInfoOriginalFileName =~ "Runner.Listener.dll") and (ProcessCommandLine contains "run" or ProcessCommandLine contains "configure"))