DeviceProcessEvents
| where (FolderPath endswith "\\sc.exe" and (ProcessCommandLine contains "create" and ProcessCommandLine contains "binPath")) and (not(((InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\Dropbox\\Client\\" or InitiatingProcessFolderPath startswith "C:\\Program Files\\Dropbox\\Client\\") and InitiatingProcessFolderPath endswith "\\Dropbox.exe")))