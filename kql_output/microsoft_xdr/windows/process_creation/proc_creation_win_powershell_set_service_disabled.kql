// Title: Service StartupType Change Via PowerShell Set-Service
// Rule ID: 62b20d44-1546-4e61-afce-8e175eb9473c
// Severity: medium
// Tags: attack.execution, attack.defense-evasion, attack.t1562.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_set_service_disabled.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\powershell.exe" or ProcessVersionInfoOriginalFileName =~ "PowerShell.EXE") and ((ProcessCommandLine contains "Set-Service" and ProcessCommandLine contains "-StartupType") and (ProcessCommandLine contains "Disabled" or ProcessCommandLine contains "Manual"))