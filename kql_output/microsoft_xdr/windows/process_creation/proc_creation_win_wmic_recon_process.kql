DeviceProcessEvents
| where ((FolderPath endswith "\\WMIC.exe" or ProcessVersionInfoOriginalFileName =~ "wmic.exe") and ProcessCommandLine contains "process") and (not((ProcessCommandLine contains "call" and ProcessCommandLine contains "create")))