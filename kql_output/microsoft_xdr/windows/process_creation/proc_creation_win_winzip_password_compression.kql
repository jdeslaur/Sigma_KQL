DeviceProcessEvents
| where (ProcessCommandLine contains "winzip.exe" or ProcessCommandLine contains "winzip64.exe") and ProcessCommandLine contains "-s\"" and (ProcessCommandLine contains " -min " or ProcessCommandLine contains " -a ")