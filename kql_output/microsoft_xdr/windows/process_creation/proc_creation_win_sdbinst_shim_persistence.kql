// Title: Potential Shim Database Persistence via Sdbinst.EXE
// Rule ID: 517490a7-115a-48c6-8862-1a481504d5a8
// Severity: medium
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.011
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_sdbinst_shim_persistence.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\sdbinst.exe" or ProcessVersionInfoOriginalFileName =~ "sdbinst.exe") and ProcessCommandLine contains ".sdb") and (not((InitiatingProcessFolderPath endswith "\\msiexec.exe" and (ProcessCommandLine contains ":\\Program Files (x86)\\IIS Express\\iisexpressshim.sdb" or ProcessCommandLine contains ":\\Program Files\\IIS Express\\iisexpressshim.sdb"))))