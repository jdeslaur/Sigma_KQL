// Title: Windows AMSI Related Registry Tampering Via CommandLine
// Rule ID: 7dbbcac2-57a0-45ac-b306-ff30a8bd2981
// Severity: high
// Tags: attack.defense-evasion, attack.t1562.001, attack.t1562.006
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_amsi_registry_tampering.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (ProcessCommandLine contains "\\Software\\Microsoft\\Windows Script\\Settings" and ProcessCommandLine contains "AmsiEnable") and ((((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains "Set-ItemProperty" or ProcessCommandLine contains "New-ItemProperty" or ProcessCommandLine contains "sp ")) or ((FolderPath endswith "\\reg.exe" or ProcessVersionInfoOriginalFileName =~ "reg.exe") and ProcessCommandLine contains "add"))