// Title: Forfiles Command Execution
// Rule ID: 9aa5106d-bce3-4b13-86df-3a20f1d5cf0b
// Severity: medium
// Tags: attack.execution, attack.t1059
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_forfiles_proxy_execution_.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\forfiles.exe" or ProcessVersionInfoOriginalFileName =~ "forfiles.exe") and (ProcessCommandLine contains " -c " or ProcessCommandLine contains " /c " or ProcessCommandLine contains " –c " or ProcessCommandLine contains " —c " or ProcessCommandLine contains " ―c ")