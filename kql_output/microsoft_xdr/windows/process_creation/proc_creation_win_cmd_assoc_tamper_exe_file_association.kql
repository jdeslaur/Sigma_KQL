// Title: Change Default File Association To Executable Via Assoc
// Rule ID: ae6f14e6-14de-45b0-9f44-c0986f50dc89
// Severity: high
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_cmd_assoc_tamper_exe_file_association.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\cmd.exe" or ProcessVersionInfoOriginalFileName =~ "Cmd.Exe") and (ProcessCommandLine contains "assoc " and ProcessCommandLine contains "exefile")) and (not(ProcessCommandLine contains ".exe=exefile"))