// Title: Windows Default Domain GPO Modification via GPME
// Rule ID: dcff7e85-d01f-4eb5-badd-84e2e6be8294
// Severity: medium
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1484.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_mmc_default_domain_gpo_modification_via_gpme.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\mmc.exe" or ProcessVersionInfoOriginalFileName =~ "MMC.exe") and (ProcessCommandLine contains "gpme.msc" and ProcessCommandLine contains "gpobject:") and (ProcessCommandLine contains "31B2F340-016D-11D2-945F-00C04FB984F9" or ProcessCommandLine contains "6AC1786C-016F-11D2-945F-00C04FB984F9")