// Title: Service Started/Stopped Via Wmic.EXE
// Rule ID: 0b7163dc-7eee-4960-af17-c0cd517f92da
// Severity: medium
// Tags: attack.execution, attack.t1047
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wmic_service_manipulation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "wmic.exe" or FolderPath endswith "\\WMIC.exe") and ((ProcessCommandLine contains " service " and ProcessCommandLine contains " call ") and (ProcessCommandLine contains "stopservice" or ProcessCommandLine contains "startservice"))