// Title: HackTool - Rubeus Execution
// Rule ID: 7ec2c172-dceb-4c10-92c9-87c1881b7e18
// Severity: critical
// Tags: attack.defense-evasion, attack.credential-access, attack.t1003, attack.t1558.003, attack.lateral-movement, attack.t1550.003
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_hktl_rubeus.yml
