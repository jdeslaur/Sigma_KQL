// Title: All Backups Deleted Via Wbadmin.EXE
// Rule ID: 639c9081-f482-47d3-a0bd-ddee3d4ecd76
// Severity: high
// Tags: attack.impact, attack.t1490
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wbadmin_delete_all_backups.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\wbadmin.exe" or ProcessVersionInfoOriginalFileName =~ "WBADMIN.EXE") and ((ProcessCommandLine contains "delete" and ProcessCommandLine contains "backup") and ProcessCommandLine contains "keepVersions:0")