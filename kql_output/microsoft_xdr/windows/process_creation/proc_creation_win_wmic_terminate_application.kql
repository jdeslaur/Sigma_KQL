// Title: Application Terminated Via Wmic.EXE
// Rule ID: 49d9671b-0a0a-4c09-8280-d215bfd30662
// Severity: medium
// Tags: attack.execution, attack.t1047
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wmic_terminate_application.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where (FolderPath endswith "\\WMIC.exe" or ProcessVersionInfoOriginalFileName =~ "wmic.exe") and (ProcessCommandLine contains "call" and ProcessCommandLine contains "terminate")