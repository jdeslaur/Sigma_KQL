DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\services.exe" and (((ProcessCommandLine contains "/c" and ProcessCommandLine contains "echo" and ProcessCommandLine contains "\\pipe\\") and (ProcessCommandLine contains "cmd" or ProcessCommandLine contains "%COMSPEC%")) or (ProcessCommandLine contains "rundll32" and ProcessCommandLine contains ".dll,a" and ProcessCommandLine contains "/p:")) and (not(ProcessCommandLine contains "MpCmdRun"))