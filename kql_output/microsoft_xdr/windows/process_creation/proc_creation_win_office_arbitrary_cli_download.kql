// Title: Potential Arbitrary File Download Using Office Application
// Rule ID: 4ae3e30b-b03f-43aa-87e3-b622f4048eed
// Severity: high
// Tags: attack.defense-evasion, attack.t1202
// Category: process_creation
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_office_arbitrary_cli_download.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where ((FolderPath endswith "\\EXCEL.EXE" or FolderPath endswith "\\POWERPNT.EXE" or FolderPath endswith "\\WINWORD.exe") or (ProcessVersionInfoOriginalFileName in~ ("Excel.exe", "POWERPNT.EXE", "WinWord.exe"))) and (ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://")