// Title: PowerShell Script Dropped Via PowerShell.EXE
// Rule ID: 576426ad-0131-4001-ae01-be175da0c108
// Severity: low
// Tags: attack.persistence
// Category: file_event
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_powershell_drop_powershell.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceFileEvents
| where ((InitiatingProcessFolderPath endswith "\\powershell.exe" or InitiatingProcessFolderPath endswith "\\pwsh.exe") and FolderPath endswith ".ps1") and (not((FolderPath contains "__PSScriptPolicyTest_" or (FolderPath startswith "C:\\Users\\" and FolderPath contains "\\AppData\\Local\\Temp\\") or FolderPath startswith "C:\\Windows\\Temp\\")))