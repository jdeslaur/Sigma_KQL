// Title: WScript or CScript Dropper - File
// Rule ID: 002bdb95-0cf1-46a6-9e08-d38c128a6127
// Severity: high
// Tags: attack.execution, attack.t1059.005, attack.t1059.007
// Category: file_event
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_cscript_wscript_dropper.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceFileEvents
| where (InitiatingProcessFolderPath endswith "\\wscript.exe" or InitiatingProcessFolderPath endswith "\\cscript.exe") and (FolderPath startswith "C:\\Users\\" or FolderPath startswith "C:\\ProgramData") and (FolderPath endswith ".jse" or FolderPath endswith ".vbe" or FolderPath endswith ".js" or FolderPath endswith ".vba" or FolderPath endswith ".vbs")