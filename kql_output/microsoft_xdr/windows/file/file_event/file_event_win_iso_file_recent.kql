// Title: ISO or Image Mount Indicator in Recent Files
// Rule ID: 4358e5a5-7542-4dcb-b9f3-87667371839b
// Severity: medium
// Tags: attack.initial-access, attack.t1566.001
// Category: file_event
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_iso_file_recent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceFileEvents
| where (FolderPath endswith ".iso.lnk" or FolderPath endswith ".img.lnk" or FolderPath endswith ".vhd.lnk" or FolderPath endswith ".vhdx.lnk") and FolderPath contains "\\Microsoft\\Windows\\Recent\\"