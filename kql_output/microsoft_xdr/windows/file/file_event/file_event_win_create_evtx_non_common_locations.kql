DeviceFileEvents
| where FolderPath endswith ".evtx" and (not((FolderPath startswith "C:\\Windows\\System32\\winevt\\Logs\\" or (FolderPath startswith "C:\\ProgramData\\Microsoft\\Windows\\Containers\\BaseImages\\" and FolderPath endswith "\\Windows\\System32\\winevt\\Logs\\"))))