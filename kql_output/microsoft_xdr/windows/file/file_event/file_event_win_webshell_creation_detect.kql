// Title: Potential Webshell Creation On Static Website
// Rule ID: 39f1f9f2-9636-45de-98f6-a4046aa8e4b9
// Severity: medium
// Tags: attack.persistence, attack.t1505.003
// Category: file_event
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_webshell_creation_detect.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceFileEvents
| where ((FolderPath contains "\\inetpub\\wwwroot\\" and (FolderPath contains ".ashx" or FolderPath contains ".asp" or FolderPath contains ".ph" or FolderPath contains ".soap")) or ((FolderPath contains "\\www\\" or FolderPath contains "\\htdocs\\" or FolderPath contains "\\html\\") and FolderPath contains ".ph")) and (not(((FolderPath contains "\\AppData\\Local\\Temp\\" or FolderPath contains "\\Windows\\Temp\\") or InitiatingProcessFolderPath =~ "System" or FolderPath contains "\\xampp")))