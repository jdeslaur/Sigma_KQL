// Title: Suspicious Creation TXT File in User Desktop
// Rule ID: caf02a0a-1e1c-4552-9b48-5e070bd88d11
// Severity: high
// Tags: attack.impact, attack.t1486
// Category: file_event
// Product: windows
// Pipeline: microsoft_xdr
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_desktop_txt.yml
//
