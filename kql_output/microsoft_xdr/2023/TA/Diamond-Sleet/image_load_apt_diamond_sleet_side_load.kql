DeviceImageLoadEvents
| where (InitiatingProcessFolderPath endswith ":\\ProgramData\\clip.exe" and FolderPath endswith ":\\ProgramData\\Version.dll") or (InitiatingProcessFolderPath endswith ":\\ProgramData\\wsmprovhost.exe" and FolderPath endswith ":\\ProgramData\\DSROLE.dll")