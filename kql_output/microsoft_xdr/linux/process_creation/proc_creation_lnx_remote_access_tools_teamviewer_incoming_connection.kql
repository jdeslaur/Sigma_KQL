// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "/TeamViewer_Service" and FolderPath endswith "/TeamViewer_Desktop" and ProcessCommandLine endswith "/TeamViewer_Desktop --IPCport 5939 --Module 1"