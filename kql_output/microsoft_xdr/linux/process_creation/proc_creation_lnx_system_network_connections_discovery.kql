DeviceProcessEvents
| where (FolderPath endswith "/who" or FolderPath endswith "/w" or FolderPath endswith "/last" or FolderPath endswith "/lsof" or FolderPath endswith "/netstat") and (not((InitiatingProcessCommandLine contains "/usr/bin/landscape-sysinfo" and FolderPath endswith "/who")))