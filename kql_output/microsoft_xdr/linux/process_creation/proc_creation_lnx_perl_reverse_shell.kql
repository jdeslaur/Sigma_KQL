DeviceProcessEvents
| where (FolderPath endswith "/perl" and ProcessCommandLine contains " -e ") and ((ProcessCommandLine contains "fdopen(" and ProcessCommandLine contains "::Socket::INET") or (ProcessCommandLine contains "Socket" and ProcessCommandLine contains "connect" and ProcessCommandLine contains "open" and ProcessCommandLine contains "exec"))