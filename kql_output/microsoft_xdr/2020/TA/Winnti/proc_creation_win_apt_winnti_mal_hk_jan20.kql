DeviceProcessEvents
| where ((InitiatingProcessFolderPath contains "C:\\Windows\\Temp" or InitiatingProcessFolderPath contains "\\hpqhvind.exe") and FolderPath startswith "C:\\ProgramData\\DRM") or (InitiatingProcessFolderPath startswith "C:\\ProgramData\\DRM" and FolderPath endswith "\\wmplayer.exe") or (InitiatingProcessFolderPath endswith "\\Test.exe" and FolderPath endswith "\\wmplayer.exe") or FolderPath =~ "C:\\ProgramData\\DRM\\CLR\\CLR.exe" or (InitiatingProcessFolderPath startswith "C:\\ProgramData\\DRM\\Windows" and FolderPath endswith "\\SearchFilterHost.exe")