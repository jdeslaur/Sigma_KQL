imProcessCreate
| where (TargetProcessCommandLine contains "tracert -h 10 yahoo.com" or TargetProcessCommandLine contains ".WSqmCons))|iex;" or TargetProcessCommandLine contains "Fr`omBa`se6`4Str`ing") or (TargetProcessCommandLine matches regex "net\\s+use\\s+https://docs.live.net" and TargetProcessCommandLine contains "@aol.co.uk")