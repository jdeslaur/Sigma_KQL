imProcessCreate
| where (TargetProcessSHA256 startswith "6b311c0a977d21e772ac4e99762234da852bbf84293386fbe78622a96c0b052f" or TargetProcessSHA256 startswith "c60ead92cd376b689d1b4450f2578b36ea0bf64f3963cfa5546279fa4424c2a5") or (TargetProcessName endswith "\\schtasks.exe" and (TargetProcessCommandLine contains "Create" and TargetProcessCommandLine contains "/RU" and TargetProcessCommandLine contains "SYSTEM" and TargetProcessCommandLine contains "\\Microsoft\\Windows\\WinSrv") and (TargetProcessCommandLine contains "servtask.bat" or TargetProcessCommandLine contains "execute.bat" or TargetProcessCommandLine contains "doit.bat")) or (TargetProcessName endswith "\\schtasks.exe" and (TargetProcessCommandLine contains "Delete" and TargetProcessCommandLine contains "/F " and TargetProcessCommandLine contains "\\Microsoft\\Windows\\WinSrv")) or (TargetProcessCommandLine contains "Get-ChildItem" and TargetProcessCommandLine contains ".save" and TargetProcessCommandLine contains "Compress-Archive -DestinationPath C:\\ProgramData\\")