imFileEvent
| where ((TargetFileName startswith "C:\\ProgramData\\Microsoft\\v" or TargetFileName startswith "C:\\ProgramData\\Adobe\\v" or TargetFileName startswith "C:\\ProgramData\\Comms\\v" or TargetFileName startswith "C:\\ProgramData\\Intel\\v" or TargetFileName startswith "C:\\ProgramData\\Kaspersky Lab\\v" or TargetFileName startswith "C:\\ProgramData\\Bitdefender\\v" or TargetFileName startswith "C:\\ProgramData\\ESET\\v" or TargetFileName startswith "C:\\ProgramData\\NVIDIA\\v" or TargetFileName startswith "C:\\ProgramData\\UbiSoft\\v" or TargetFileName startswith "C:\\ProgramData\\Steam\\v") and (TargetFileName contains "\\prnms003.inf_" or TargetFileName contains "\\prnms009.inf_")) or (TargetFileName startswith "C:\\ProgramData\\" and ((TargetFileName endswith ".save" or TargetFileName endswith "\\doit.bat" or TargetFileName endswith "\\execute.bat" or TargetFileName endswith "\\servtask.bat") or (TargetFileName contains "\\wayzgoose" and TargetFileName endswith ".dll")))