// Title: HAFNIUM Exchange Exploitation Activity
// Rule ID: bbb2dedd-a0e3-46ab-ba6c-6c82ae7a9aa7
// Severity: critical
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1546, attack.t1053, attack.g0125, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2021/TA/HAFNIUM/proc_creation_win_apt_hafnium.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "attrib" and TargetProcessCommandLine contains " +h " and TargetProcessCommandLine contains " +s " and TargetProcessCommandLine contains " +r " and TargetProcessCommandLine contains ".aspx") or (TargetProcessName contains "\\ProgramData\\VSPerfMon\\" or (TargetProcessCommandLine contains "schtasks" and TargetProcessCommandLine contains "VSPerfMon")) or (TargetProcessName endswith "Opera_browser.exe" and ((ParentProcessName endswith "\\services.exe" or ParentProcessName endswith "\\svchost.exe") or (ActingProcessName endswith "\\services.exe" or ActingProcessName endswith "\\svchost.exe"))) or TargetProcessName endswith "Users\\Public\\opera\\Opera_browser.exe" or (TargetProcessCommandLine contains "vssadmin list shadows" and TargetProcessCommandLine contains "Temp\\__output") or (TargetProcessName endswith "\\makecab.exe" and (TargetProcessCommandLine contains "inetpub\\wwwroot\\" and TargetProcessCommandLine contains ".dmp.zip")) or (TargetProcessName endswith "\\makecab.exe" and (TargetProcessCommandLine contains "Microsoft\\Exchange Server\\" or TargetProcessCommandLine contains "compressionmemory" or TargetProcessCommandLine contains ".gif")) or (TargetProcessCommandLine contains " -t7z " and TargetProcessCommandLine contains "C:\\Programdata\\pst" and TargetProcessCommandLine contains "\\it.zip") or (TargetProcessCommandLine contains "\\comsvcs.dll" and TargetProcessCommandLine contains "Minidump" and TargetProcessCommandLine contains "full " and TargetProcessCommandLine contains "\\inetpub\\wwwroot") or (TargetProcessCommandLine contains "Windows\\Temp\\xx.bat" or TargetProcessCommandLine contains "Windows\\WwanSvcdcs" or TargetProcessCommandLine contains "Windows\\Temp\\cw.exe")