imProcessCreate
| where (TargetProcessCommandLine contains "C:\\Windows\\cert.exe" or TargetProcessCommandLine contains "del /q /f c:\\kworking\\agent.crt" or TargetProcessCommandLine contains "Kaseya VSA Agent Hot-fix" or TargetProcessCommandLine contains "\\AppData\\Local\\Temp\\MsMpEng.exe" or TargetProcessCommandLine contains "rmdir /s /q %SystemDrive%\\inetpub\\logs" or (TargetProcessCommandLine contains "del /s /q /f %SystemDrive%\\" and TargetProcessCommandLine contains ".log") or TargetProcessCommandLine contains "c:\\kworking1\\agent.exe" or TargetProcessCommandLine contains "c:\\kworking1\\agent.crt") or (TargetProcessName in~ ("C:\\Windows\\MsMpEng.exe", "C:\\Windows\\cert.exe", "C:\\kworking\\agent.exe", "C:\\kworking1\\agent.exe")) or (TargetProcessCommandLine contains "del /s /q /f" and TargetProcessCommandLine contains "WebPages\\Errors\\webErrorLog.txt")