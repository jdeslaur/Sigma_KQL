// Title: Sofacy Trojan Loader Activity
// Rule ID: ba778144-5e3d-40cf-8af9-e28fb1df1e20
// Severity: high
// Tags: attack.defense-evasion, attack.execution, attack.g0007, attack.t1059.003, attack.t1218.011, car.2013-10-002, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2018/TA/APT28/proc_creation_win_apt_sofacy.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\rundll32.exe" and (TargetProcessCommandLine contains "%LOCALAPPDATA%" or TargetProcessCommandLine contains "\\AppData\\Local\\")) and (TargetProcessCommandLine contains ".dat\"," or (TargetProcessCommandLine endswith ".dll #1" or TargetProcessCommandLine endswith ".dll\" #1" or TargetProcessCommandLine endswith ".dll\",#1"))) and (not(TargetProcessCommandLine contains "\\AppData\\Local\\Temp\\"))