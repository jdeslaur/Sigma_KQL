imProcessCreate
| where ((ParentProcessName endswith "\\sllauncher.exe" or ActingProcessName endswith "\\sllauncher.exe") and TargetProcessName endswith "\\svchost.exe") or ((ParentProcessName contains "\\AppData\\Roaming\\" or ActingProcessName contains "\\AppData\\Roaming\\") and TargetProcessName endswith "\\svchost.exe" and TargetProcessCommandLine contains "-k")