// Title: Potential MuddyWater APT Activity
// Rule ID: 36222790-0d43-4fe8-86e4-674b27809543
// Severity: high
// Tags: attack.defense-evasion, attack.execution, attack.g0069, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2018/TA/MuddyWater/proc_creation_win_apt_muddywater_activity.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "vbscript:Close(Execute(\"CreateObject(" and TargetProcessCommandLine contains "powershell" and TargetProcessCommandLine contains "-w 1 -exec Bypass" and TargetProcessCommandLine contains "\\ProgramData\\") or (TargetProcessCommandLine contains "Win32_OperatingSystem" and TargetProcessCommandLine contains "Win32_NetworkAdapterConfiguration" and TargetProcessCommandLine contains "root\\SecurityCenter2" and TargetProcessCommandLine contains "[System.Net.DNS]") or (TargetProcessCommandLine contains "[Convert]::ToBase64String" and TargetProcessCommandLine contains "[System.Text.Encoding]::UTF8.GetString]" and TargetProcessCommandLine contains "GetResponse().GetResponseStream()" and TargetProcessCommandLine contains "[System.Net.HttpWebRequest]::Create(" and TargetProcessCommandLine contains "-bxor ")