// Title: OilRig APT Activity
// Rule ID: ce6e34ca-966d-41c9-8d93-5b06c8b97a06
// Severity: critical
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.g0049, attack.t1053.005, attack.s0111, attack.t1543.003, attack.defense-evasion, attack.t1112, attack.command-and-control, attack.t1071.004, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2018/TA/OilRig/proc_creation_win_apt_oilrig_mar18.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "SC Scheduled Scan" and TargetProcessCommandLine contains "\\microsoft\\Taskbar\\autoit3.exe") or (TargetProcessName contains "\\Windows\\Temp\\DB\\" and TargetProcessName endswith ".exe") or (TargetProcessName =~ "C:\\Windows\\system32\\Service.exe" and (TargetProcessCommandLine contains "i" or TargetProcessCommandLine contains "u")) or ((ParentProcessName endswith "\\local\\microsoft\\Taskbar\\autoit3.exe" or ActingProcessName endswith "\\local\\microsoft\\Taskbar\\autoit3.exe") and (TargetProcessCommandLine contains "nslookup.exe" and TargetProcessCommandLine contains "-q=TXT"))