// Title: Mustang Panda Dropper
// Rule ID: 2d87d610-d760-45ee-a7e6-7a6f2a65de00
// Severity: high
// Tags: attack.t1587.001, attack.resource-development, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2019/TA/MustangPanda/proc_creation_win_apt_mustangpanda.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessCommandLine contains "Temp\\wtask.exe /create" or TargetProcessCommandLine contains "%windir:~-3,1%%PUBLIC:~-9,1%" or TargetProcessCommandLine contains "/tn \"Security Script " or TargetProcessCommandLine contains "%windir:~-1,1%") or (TargetProcessCommandLine contains "/E:vbscript" and TargetProcessCommandLine contains "C:\\Users\\" and TargetProcessCommandLine contains ".txt" and TargetProcessCommandLine contains "/F")) or TargetProcessName endswith "Temp\\winwsh.exe"