// Title: Operation Wocao Activity
// Rule ID: 1cfac73c-be78-4f9a-9b08-5bde0c3953ab
// Severity: high
// Tags: attack.privilege-escalation, attack.persistence, attack.discovery, attack.t1012, attack.defense-evasion, attack.t1036.004, attack.t1027, attack.execution, attack.t1053.005, attack.t1059.001, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2019/TA/Operation-Wocao/proc_creation_win_apt_wocao.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessCommandLine contains "checkadmin.exe 127.0.0.1 -all" or TargetProcessCommandLine contains "netsh advfirewall firewall add rule name=powershell dir=in" or TargetProcessCommandLine contains "cmd /c powershell.exe -ep bypass -file c:\\s.ps1" or TargetProcessCommandLine contains "/tn win32times /f" or TargetProcessCommandLine contains "create win32times binPath=" or TargetProcessCommandLine contains "\\c$\\windows\\system32\\devmgr.dll" or TargetProcessCommandLine contains " -exec bypass -enc JgAg" or (TargetProcessCommandLine contains "type " and TargetProcessCommandLine contains "keepass\\KeePass.config.xml") or TargetProcessCommandLine contains "iie.exe iie.txt" or (TargetProcessCommandLine contains "reg query HKEY_CURRENT_USER\\Software\\" and TargetProcessCommandLine contains "\\PuTTY\\Sessions\\")