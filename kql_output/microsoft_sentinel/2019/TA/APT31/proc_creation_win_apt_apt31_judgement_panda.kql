imProcessCreate
| where (TargetProcessCommandLine contains "ldifde" and TargetProcessCommandLine contains "-f -n" and TargetProcessCommandLine contains "eprod.ldf") or ((TargetProcessCommandLine contains "copy \\\\" and TargetProcessCommandLine contains "c$") and (TargetProcessCommandLine contains "\\aaaa\\procdump64.exe" or TargetProcessCommandLine contains "\\aaaa\\netsess.exe" or TargetProcessCommandLine contains "\\aaaa\\7za.exe" or TargetProcessCommandLine contains "\\c$\\aaaa\\"))