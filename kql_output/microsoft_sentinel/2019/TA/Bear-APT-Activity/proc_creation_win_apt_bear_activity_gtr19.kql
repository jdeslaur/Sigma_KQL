// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "xcopy /S /E /C /Q /H \\\\" and TargetProcessCommandLine contains "\\sysvol\\") or (TargetProcessCommandLine contains "adexplorer -snapshot \"\" c:\\users\\" and TargetProcessCommandLine contains "\\downloads\\" and TargetProcessCommandLine contains ".snp")