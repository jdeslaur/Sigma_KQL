imProcessCreate
| where TargetProcessName endswith "/atop" or TargetProcessName endswith "/htop" or TargetProcessName endswith "/pgrep" or TargetProcessName endswith "/ps" or TargetProcessName endswith "/pstree" or TargetProcessName endswith "/top"