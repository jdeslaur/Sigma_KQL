imProcessCreate
| where (TargetProcessName endswith "/who" or TargetProcessName endswith "/w" or TargetProcessName endswith "/last" or TargetProcessName endswith "/lsof" or TargetProcessName endswith "/netstat") and (not((ActingProcessCommandLine contains "/usr/bin/landscape-sysinfo" and TargetProcessName endswith "/who")))