// Title: Interactive Bash Suspicious Children
// Rule ID: ea3ecad2-db86-4a89-ad0b-132a10d2db55
// Severity: medium
// Tags: attack.execution, attack.defense-evasion, attack.t1059.004, attack.t1036
// Category: process_creation
// Product: linux
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_susp_interactive_bash.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ActingProcessCommandLine =~ "bash -i" and ((TargetProcessCommandLine contains "-c import " or TargetProcessCommandLine contains "base64" or TargetProcessCommandLine contains "pty.spawn") or (TargetProcessName endswith "whoami" or TargetProcessName endswith "iptables" or TargetProcessName endswith "/ncat" or TargetProcessName endswith "/nc" or TargetProcessName endswith "/netcat"))