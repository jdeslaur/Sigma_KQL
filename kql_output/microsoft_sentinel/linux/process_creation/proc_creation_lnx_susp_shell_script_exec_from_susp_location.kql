imProcessCreate
| where (TargetProcessName endswith "/bash" or TargetProcessName endswith "/csh" or TargetProcessName endswith "/dash" or TargetProcessName endswith "/fish" or TargetProcessName endswith "/ksh" or TargetProcessName endswith "/sh" or TargetProcessName endswith "/zsh") and TargetProcessCommandLine contains " -c " and TargetProcessCommandLine contains "/tmp/"