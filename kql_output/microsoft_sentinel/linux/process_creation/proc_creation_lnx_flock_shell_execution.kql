// Title: Shell Execution via Flock - Linux
// Rule ID: 4b09c71e-4269-4111-9cdd-107d8867f0cc
// Severity: high
// Tags: attack.discovery, attack.t1083
// Category: process_creation
// Product: linux
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_flock_shell_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "/flock" and TargetProcessCommandLine contains " -u ") and (TargetProcessCommandLine contains "/bin/bash" or TargetProcessCommandLine contains "/bin/dash" or TargetProcessCommandLine contains "/bin/fish" or TargetProcessCommandLine contains "/bin/sh" or TargetProcessCommandLine contains "/bin/zsh")