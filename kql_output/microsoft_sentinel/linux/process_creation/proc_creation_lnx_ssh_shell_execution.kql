// Title: Shell Invocation Via Ssh - Linux
// Rule ID: 8737b7f6-8df3-4bb7-b1da-06019b99b687
// Severity: high
// Tags: attack.execution, attack.t1059
// Category: process_creation
// Product: linux
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_ssh_shell_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "/ssh" and (TargetProcessCommandLine contains "ProxyCommand=;" or TargetProcessCommandLine contains "permitlocalcommand=yes" or TargetProcessCommandLine contains "localhost")) and (TargetProcessCommandLine contains "/bin/bash" or TargetProcessCommandLine contains "/bin/dash" or TargetProcessCommandLine contains "/bin/fish" or TargetProcessCommandLine contains "/bin/sh" or TargetProcessCommandLine contains "/bin/zsh" or TargetProcessCommandLine contains "sh 0<&2 1>&2" or TargetProcessCommandLine contains "sh 1>&2 0<&2")