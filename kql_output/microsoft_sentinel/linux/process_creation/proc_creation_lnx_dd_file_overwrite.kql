imProcessCreate
| where (TargetProcessName in~ ("/bin/dd", "/usr/bin/dd")) and TargetProcessCommandLine contains "of=" and (TargetProcessCommandLine contains "if=/dev/zero" or TargetProcessCommandLine contains "if=/dev/null")