// Title: Mint Sandstorm - ManageEngine Suspicious Process Execution
// Rule ID: 58d8341a-5849-44cd-8ac8-8b020413a31b
// Severity: critical
// Tags: attack.execution, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2023/TA/Mint-Sandstorm/proc_creation_win_apt_mint_sandstorm_manage_engine_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (((ParentProcessName contains "manageengine" or ParentProcessName contains "ServiceDesk") or (ActingProcessName contains "manageengine" or ActingProcessName contains "ServiceDesk")) and (ParentProcessName contains "\\java" or ActingProcessName contains "\\java")) and (((TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\powershell_ise.exe") and ((TargetProcessCommandLine contains " echo " or TargetProcessCommandLine contains "-dumpmode" or TargetProcessCommandLine contains "-ssh" or TargetProcessCommandLine contains ".dmp" or TargetProcessCommandLine contains "add-MpPreference" or TargetProcessCommandLine contains "adscredentials" or TargetProcessCommandLine contains "bitsadmin" or TargetProcessCommandLine contains "certutil" or TargetProcessCommandLine contains "csvhost.exe" or TargetProcessCommandLine contains "DownloadFile" or TargetProcessCommandLine contains "DownloadString" or TargetProcessCommandLine contains "dsquery" or TargetProcessCommandLine contains "ekern.exe" or TargetProcessCommandLine contains "FromBase64String" or TargetProcessCommandLine contains "iex " or TargetProcessCommandLine contains "iex(" or TargetProcessCommandLine contains "Invoke-Expression" or TargetProcessCommandLine contains "Invoke-WebRequest" or TargetProcessCommandLine contains "localgroup administrators" or TargetProcessCommandLine contains "o365accountconfiguration" or TargetProcessCommandLine contains "samaccountname=" or TargetProcessCommandLine contains "set-MpPreference" or TargetProcessCommandLine contains "svhost.exe" or TargetProcessCommandLine contains "System.IO.Compression" or TargetProcessCommandLine contains "System.IO.MemoryStream" or TargetProcessCommandLine contains "usoprivate" or TargetProcessCommandLine contains "usoshared" or TargetProcessCommandLine contains "whoami") or TargetProcessCommandLine matches regex "[-/–][Ee^]{1,2}[ncodema^]*\\s[A-Za-z0-9+/=]{15,}" or TargetProcessCommandLine matches regex "net\\s+user" or TargetProcessCommandLine matches regex "net\\s+group" or TargetProcessCommandLine matches regex "query\\ssession")) or (TargetProcessCommandLine contains "lsass" and (TargetProcessCommandLine contains "procdump" or TargetProcessCommandLine contains "tasklist" or TargetProcessCommandLine contains "findstr")) or ((TargetProcessName endswith "\\wget.exe" and TargetProcessCommandLine contains "http") or (TargetProcessName endswith "\\curl.exe" and TargetProcessCommandLine contains "http") or (TargetProcessCommandLine contains "E:jscript" or TargetProcessCommandLine contains "e:vbscript") or (TargetProcessCommandLine contains "localgroup Administrators" and TargetProcessCommandLine contains "/add") or (TargetProcessCommandLine contains "net" and (TargetProcessCommandLine contains "user" and TargetProcessCommandLine contains "/add")) or ((TargetProcessCommandLine contains "reg add" and TargetProcessCommandLine contains "DisableAntiSpyware" and TargetProcessCommandLine contains "\\Microsoft\\Windows Defender") or (TargetProcessCommandLine contains "reg add" and TargetProcessCommandLine contains "DisableRestrictedAdmin" and TargetProcessCommandLine contains "CurrentControlSet\\Control\\Lsa")) or (TargetProcessCommandLine contains "wmic" and TargetProcessCommandLine contains "process call create") or (TargetProcessCommandLine contains "wmic" and TargetProcessCommandLine contains "delete" and TargetProcessCommandLine contains "shadowcopy") or (TargetProcessCommandLine contains "vssadmin" and TargetProcessCommandLine contains "delete" and TargetProcessCommandLine contains "shadows") or (TargetProcessCommandLine contains "wbadmin" and TargetProcessCommandLine contains "delete" and TargetProcessCommandLine contains "catalog"))) and (not((TargetProcessCommandLine contains "download.microsoft.com" and TargetProcessCommandLine contains "manageengine.com" and TargetProcessCommandLine contains "msiexec")))