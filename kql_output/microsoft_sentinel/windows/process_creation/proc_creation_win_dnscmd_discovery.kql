// Title: Potential Discovery Activity Via Dnscmd.EXE
// Rule ID: b6457d63-d2a2-4e29-859d-4e7affc153d1
// Severity: medium
// Tags: attack.discovery, attack.execution
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_dnscmd_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\dnscmd.exe" and (TargetProcessCommandLine contains "/enumrecords" or TargetProcessCommandLine contains "/enumzones" or TargetProcessCommandLine contains "/ZonePrint" or TargetProcessCommandLine contains "/info")