imProcessCreate
| where TargetProcessCommandLine contains "ˣ" or TargetProcessCommandLine contains "˪" or TargetProcessCommandLine contains "ˢ" or TargetProcessCommandLine contains "∕" or TargetProcessCommandLine contains "⁄" or TargetProcessCommandLine contains "―" or TargetProcessCommandLine contains "—" or TargetProcessCommandLine contains " " or TargetProcessCommandLine contains "¯" or TargetProcessCommandLine contains "®" or TargetProcessCommandLine contains "¶"