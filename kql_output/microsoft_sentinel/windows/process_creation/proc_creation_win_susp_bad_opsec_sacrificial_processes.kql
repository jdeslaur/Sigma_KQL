// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\WerFault.exe" and TargetProcessCommandLine endswith "WerFault.exe") or (TargetProcessName endswith "\\rundll32.exe" and TargetProcessCommandLine endswith "rundll32.exe") or (TargetProcessName endswith "\\regsvcs.exe" and TargetProcessCommandLine endswith "regsvcs.exe") or (TargetProcessName endswith "\\regasm.exe" and TargetProcessCommandLine endswith "regasm.exe") or (TargetProcessName endswith "\\regsvr32.exe" and TargetProcessCommandLine endswith "regsvr32.exe")) and (not((((ParentProcessName contains "\\AppData\\Local\\Microsoft\\EdgeUpdate\\Install\\{" or ActingProcessName contains "\\AppData\\Local\\Microsoft\\EdgeUpdate\\Install\\{") and TargetProcessName endswith "\\rundll32.exe" and TargetProcessCommandLine endswith "rundll32.exe") or (((ParentProcessName contains "\\AppData\\Local\\BraveSoftware\\Brave-Browser\\Application\\" or ParentProcessName contains "\\AppData\\Local\\Google\\Chrome\\Application\\") or (ActingProcessName contains "\\AppData\\Local\\BraveSoftware\\Brave-Browser\\Application\\" or ActingProcessName contains "\\AppData\\Local\\Google\\Chrome\\Application\\")) and (ParentProcessName endswith "\\Installer\\setup.exe" or ActingProcessName endswith "\\Installer\\setup.exe") and ActingProcessCommandLine contains "--uninstall " and TargetProcessName endswith "\\rundll32.exe" and TargetProcessCommandLine endswith "rundll32.exe"))))