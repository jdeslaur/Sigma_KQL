// Title: Suspicious Execution of Powershell with Base64
// Rule ID: fb843269-508c-4b76-8b8d-88679db22ce7
// Severity: medium
// Tags: attack.execution, attack.t1059.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_encode.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe") and (TargetProcessCommandLine contains " -e " or TargetProcessCommandLine contains " -en " or TargetProcessCommandLine contains " -enc " or TargetProcessCommandLine contains " -enco" or TargetProcessCommandLine contains " -ec ")) and (not((TargetProcessCommandLine contains " -Encoding " or ((ParentProcessName contains "C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\" or ParentProcessName contains "\\gc_worker.exe") or (ActingProcessName contains "C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\" or ActingProcessName contains "\\gc_worker.exe")))))