// Title: Python Spawning Pretty TTY on Windows
// Rule ID: 480e7e51-e797-47e3-8d72-ebfce65b6d8d
// Severity: high
// Tags: attack.execution, attack.t1059
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_python_pty_spawn.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "python.exe" or TargetProcessName endswith "python3.exe" or TargetProcessName endswith "python2.exe") and ((TargetProcessCommandLine contains "import pty" and TargetProcessCommandLine contains ".spawn(") or TargetProcessCommandLine contains "from pty import spawn")