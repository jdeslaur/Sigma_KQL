// Title: WinRAR Execution in Non-Standard Folder
// Rule ID: 4ede543c-e098-43d9-a28f-dd784a13132f
// Severity: medium
// Tags: attack.collection, attack.t1560.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_winrar_uncommon_folder_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\rar.exe" or TargetProcessName endswith "\\winrar.exe") or (TargetProcessFileDescription in~ ("Command line RAR", "WinRAR"))) and (not((TargetProcessName endswith "\\UnRAR.exe" or (TargetProcessName contains ":\\Program Files (x86)\\WinRAR\\" or TargetProcessName contains ":\\Program Files\\WinRAR\\")))) and (not(TargetProcessName contains ":\\Windows\\Temp\\"))