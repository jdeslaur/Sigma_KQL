imProcessCreate
| where ((ParentProcessName endswith "\\explorer.exe" or ActingProcessName endswith "\\explorer.exe") and TargetProcessCommandLine contains "#") and (TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            " or TargetProcessCommandLine contains "            ")