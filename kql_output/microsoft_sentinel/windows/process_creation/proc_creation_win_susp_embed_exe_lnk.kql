// Title: Hidden Powershell in Link File Pattern
// Rule ID: 30e92f50-bb5a-4884-98b5-d20aa80f3d7a
// Severity: medium
// Tags: attack.execution, attack.t1059.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_embed_exe_lnk.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (ParentProcessName =~ "C:\\Windows\\explorer.exe" or ActingProcessName =~ "C:\\Windows\\explorer.exe") and TargetProcessName =~ "C:\\Windows\\System32\\cmd.exe" and (TargetProcessCommandLine contains "powershell" and TargetProcessCommandLine contains ".lnk")