// Title: Run PowerShell Script from ADS
// Rule ID: 45a594aa-1fbd-4972-a809-ff5a99dd81b8
// Severity: high
// Tags: attack.defense-evasion, attack.t1564.004
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_run_script_from_ads.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName endswith "\\powershell.exe" or ParentProcessName endswith "\\pwsh.exe") or (ActingProcessName endswith "\\powershell.exe" or ActingProcessName endswith "\\pwsh.exe")) and (TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe") and (TargetProcessCommandLine contains "Get-Content" and TargetProcessCommandLine contains "-Stream")