imProcessCreate
| where (TargetProcessCommandLine contains "/EXEFilename" or TargetProcessCommandLine contains "/CommandLine") and ((TargetProcessCommandLine contains " /RunAs 8 " or TargetProcessCommandLine contains " /RunAs 4 " or TargetProcessCommandLine contains " /RunAs 10 " or TargetProcessCommandLine contains " /RunAs 11 ") or (TargetProcessCommandLine endswith "/RunAs 8" or TargetProcessCommandLine endswith "/RunAs 4" or TargetProcessCommandLine endswith "/RunAs 10" or TargetProcessCommandLine endswith "/RunAs 11"))