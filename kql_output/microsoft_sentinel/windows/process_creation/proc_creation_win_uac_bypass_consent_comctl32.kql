imProcessCreate
| where (ParentProcessName endswith "\\consent.exe" or ActingProcessName endswith "\\consent.exe") and TargetProcessName endswith "\\werfault.exe" and (TargetProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))