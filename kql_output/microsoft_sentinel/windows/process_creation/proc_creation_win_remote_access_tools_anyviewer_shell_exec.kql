imProcessCreate
| where (ParentProcessName endswith "\\AVCore.exe" or ActingProcessName endswith "\\AVCore.exe") and ActingProcessCommandLine contains "AVCore.exe\" -d" and TargetProcessName endswith "\\cmd.exe"