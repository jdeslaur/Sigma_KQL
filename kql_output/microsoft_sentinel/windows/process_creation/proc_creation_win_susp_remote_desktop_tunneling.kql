imProcessCreate
| where TargetProcessCommandLine contains ":3389" and (TargetProcessCommandLine contains " -L " or TargetProcessCommandLine contains " -P " or TargetProcessCommandLine contains " -R " or TargetProcessCommandLine contains " -pw " or TargetProcessCommandLine contains " -ssh ")