// Title: Suspicious Scheduled Task Name As GUID
// Rule ID: ff2fff64-4cd6-4a2b-ba7d-e28a30bbe66b
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_schtasks_guid_task_name.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\schtasks.exe" and TargetProcessCommandLine contains "/Create ") and (TargetProcessCommandLine contains "/TN \"{" or TargetProcessCommandLine contains "/TN '{" or TargetProcessCommandLine contains "/TN {") and (TargetProcessCommandLine contains "}\"" or TargetProcessCommandLine contains "}'" or TargetProcessCommandLine contains "} ")