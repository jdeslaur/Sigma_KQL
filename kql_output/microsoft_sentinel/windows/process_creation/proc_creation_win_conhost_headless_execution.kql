// Title: Headless Process Launched Via Conhost.EXE
// Rule ID: 00ca75ab-d5ce-43be-b86c-55ff39c6abfc
// Severity: medium
// Tags: attack.defense-evasion, attack.execution, attack.t1059.001, attack.t1059.003, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_conhost_headless_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (ParentProcessName endswith "\\conhost.exe" or ActingProcessName endswith "\\conhost.exe") and ActingProcessCommandLine contains "--headless"