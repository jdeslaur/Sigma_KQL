// Title: Disable Important Scheduled Task
// Rule ID: 9ac94dc8-9042-493c-ba45-3b5e7c86b980
// Severity: high
// Tags: attack.impact, attack.t1489
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_schtasks_disable.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\schtasks.exe" and (TargetProcessCommandLine contains "/Change" and TargetProcessCommandLine contains "/TN" and TargetProcessCommandLine contains "/disable") and (TargetProcessCommandLine contains "\\Windows\\BitLocker" or TargetProcessCommandLine contains "\\Windows\\ExploitGuard" or TargetProcessCommandLine contains "\\Windows\\ExploitGuard\\ExploitGuard MDM policy Refresh" or TargetProcessCommandLine contains "\\Windows\\SystemRestore\\SR" or TargetProcessCommandLine contains "\\Windows\\UpdateOrchestrator\\" or TargetProcessCommandLine contains "\\Windows\\Windows Defender\\" or TargetProcessCommandLine contains "\\Windows\\WindowsBackup\\" or TargetProcessCommandLine contains "\\Windows\\WindowsUpdate\\")