// Title: Execution via WorkFolders.exe
// Rule ID: 0bbc6369-43e3-453d-9944-cae58821c173
// Severity: high
// Tags: attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_workfolders.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\control.exe" and (ParentProcessName endswith "\\WorkFolders.exe" or ActingProcessName endswith "\\WorkFolders.exe")) and (not(TargetProcessName =~ "C:\\Windows\\System32\\control.exe"))