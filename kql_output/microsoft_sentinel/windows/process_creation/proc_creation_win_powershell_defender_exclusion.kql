imProcessCreate
| where (TargetProcessCommandLine contains "Add-MpPreference " or TargetProcessCommandLine contains "Set-MpPreference ") and (TargetProcessCommandLine contains " -ExclusionPath " or TargetProcessCommandLine contains " -ExclusionExtension " or TargetProcessCommandLine contains " -ExclusionProcess " or TargetProcessCommandLine contains " -ExclusionIpAddress ")