// Title: UAC Bypass Using ChangePK and SLUI
// Rule ID: 503d581c-7df0-4bbe-b9be-5840c0ecc1fc
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_uac_bypass_changepk_slui.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\changepk.exe" and (ParentProcessName endswith "\\slui.exe" or ActingProcessName endswith "\\slui.exe") and (TargetProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))