// Title: Forfiles.EXE Child Process Masquerading
// Rule ID: f53714ec-5077-420e-ad20-907ff9bb2958
// Severity: high
// Tags: attack.defense-evasion, attack.t1036
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_forfiles_child_process_masquerading.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ActingProcessCommandLine endswith ".exe" or ActingProcessCommandLine endswith ".exe\"") and TargetProcessName endswith "\\cmd.exe" and TargetProcessCommandLine startswith "/c echo \"") and (not((((ParentProcessName contains ":\\Windows\\System32\\" or ParentProcessName contains ":\\Windows\\SysWOW64\\") or (ActingProcessName contains ":\\Windows\\System32\\" or ActingProcessName contains ":\\Windows\\SysWOW64\\")) and (ParentProcessName endswith "\\forfiles.exe" or ActingProcessName endswith "\\forfiles.exe") and (TargetProcessName contains ":\\Windows\\System32\\" or TargetProcessName contains ":\\Windows\\SysWOW64\\") and TargetProcessName endswith "\\cmd.exe")))