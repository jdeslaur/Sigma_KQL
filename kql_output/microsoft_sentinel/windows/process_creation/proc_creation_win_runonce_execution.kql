// Title: Run Once Task Execution as Configured in Registry
// Rule ID: 198effb6-6c98-4d0c-9ea3-451fa143c45c
// Severity: low
// Tags: attack.persistence, attack.defense-evasion, attack.t1112
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_runonce_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\runonce.exe" or TargetProcessFileDescription =~ "Run Once Wrapper") and (TargetProcessCommandLine contains "/AlternateShellStartup" or TargetProcessCommandLine endswith "/r")