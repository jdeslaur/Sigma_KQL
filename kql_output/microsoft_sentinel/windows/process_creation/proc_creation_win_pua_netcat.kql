// Title: PUA - Netcat Suspicious Execution
// Rule ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Severity: high
// Tags: attack.command-and-control, attack.t1095
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_pua_netcat.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\nc.exe" or TargetProcessName endswith "\\ncat.exe" or TargetProcessName endswith "\\netcat.exe") or (TargetProcessCommandLine contains " -lvp " or TargetProcessCommandLine contains " -lvnp" or TargetProcessCommandLine contains " -l -v -p " or TargetProcessCommandLine contains " -lv -p " or TargetProcessCommandLine contains " -l --proxy-type http " or TargetProcessCommandLine contains " -vnl --exec " or TargetProcessCommandLine contains " -vnl -e " or TargetProcessCommandLine contains " --lua-exec " or TargetProcessCommandLine contains " --sh-exec ")