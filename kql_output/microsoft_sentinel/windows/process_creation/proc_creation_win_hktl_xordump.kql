imProcessCreate
| where TargetProcessName endswith "\\xordump.exe" or (TargetProcessCommandLine contains " -process lsass.exe " or TargetProcessCommandLine contains " -m comsvcs " or TargetProcessCommandLine contains " -m dbghelp " or TargetProcessCommandLine contains " -m dbgcore ")