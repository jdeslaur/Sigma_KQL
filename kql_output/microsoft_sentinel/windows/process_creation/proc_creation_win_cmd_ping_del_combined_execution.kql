// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains " -n " or TargetProcessCommandLine contains " /n " or TargetProcessCommandLine contains " –n " or TargetProcessCommandLine contains " —n " or TargetProcessCommandLine contains " ―n ") and TargetProcessCommandLine contains "Nul" and (TargetProcessCommandLine contains " -f " or TargetProcessCommandLine contains " /f " or TargetProcessCommandLine contains " –f " or TargetProcessCommandLine contains " —f " or TargetProcessCommandLine contains " ―f " or TargetProcessCommandLine contains " -q " or TargetProcessCommandLine contains " /q " or TargetProcessCommandLine contains " –q " or TargetProcessCommandLine contains " —q " or TargetProcessCommandLine contains " ―q ") and (TargetProcessCommandLine contains "ping" and TargetProcessCommandLine contains "del ")