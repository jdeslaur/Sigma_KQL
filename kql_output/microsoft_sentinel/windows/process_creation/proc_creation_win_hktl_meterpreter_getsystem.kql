imProcessCreate
| where (ParentProcessName endswith "\\services.exe" or ActingProcessName endswith "\\services.exe") and (((TargetProcessCommandLine contains "/c" and TargetProcessCommandLine contains "echo" and TargetProcessCommandLine contains "\\pipe\\") and (TargetProcessCommandLine contains "cmd" or TargetProcessCommandLine contains "%COMSPEC%")) or (TargetProcessCommandLine contains "rundll32" and TargetProcessCommandLine contains ".dll,a" and TargetProcessCommandLine contains "/p:")) and (not(TargetProcessCommandLine contains "MpCmdRun"))