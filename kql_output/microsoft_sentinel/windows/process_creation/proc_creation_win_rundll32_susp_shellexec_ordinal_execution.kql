// Title: Suspicious ShellExec_RunDLL Call Via Ordinal
// Rule ID: 8823e85d-31d8-473e-b7f4-92da070f0fc6
// Severity: high
// Tags: attack.defense-evasion, attack.t1218.011
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_rundll32_susp_shellexec_ordinal_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (ActingProcessCommandLine contains "SHELL32.DLL" and (ActingProcessCommandLine contains "#568" or ActingProcessCommandLine contains "#570" or ActingProcessCommandLine contains "#572" or ActingProcessCommandLine contains "#576")) and (((ActingProcessCommandLine contains "comspec" or ActingProcessCommandLine contains "iex" or ActingProcessCommandLine contains "Invoke-" or ActingProcessCommandLine contains "msiexec" or ActingProcessCommandLine contains "odbcconf" or ActingProcessCommandLine contains "regsvr32") or (ActingProcessCommandLine contains "\\Desktop\\" or ActingProcessCommandLine contains "\\ProgramData\\" or ActingProcessCommandLine contains "\\Temp\\" or ActingProcessCommandLine contains "\\Users\\Public\\")) or (TargetProcessName endswith "\\bash.exe" or TargetProcessName endswith "\\bitsadmin.exe" or TargetProcessName endswith "\\cmd.exe" or TargetProcessName endswith "\\cscript.exe" or TargetProcessName endswith "\\curl.exe" or TargetProcessName endswith "\\mshta.exe" or TargetProcessName endswith "\\msiexec.exe" or TargetProcessName endswith "\\msxsl.exe" or TargetProcessName endswith "\\odbcconf.exe" or TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe" or TargetProcessName endswith "\\regsvr32.exe" or TargetProcessName endswith "\\schtasks.exe" or TargetProcessName endswith "\\wmic.exe" or TargetProcessName endswith "\\wscript.exe"))