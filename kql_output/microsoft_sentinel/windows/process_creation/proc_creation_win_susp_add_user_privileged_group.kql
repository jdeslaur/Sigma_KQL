imProcessCreate
| where ((TargetProcessCommandLine contains "localgroup " and TargetProcessCommandLine contains " /add") or (TargetProcessCommandLine contains "Add-LocalGroupMember " and TargetProcessCommandLine contains " -Group ")) and (TargetProcessCommandLine contains "Group Policy Creator Owners" or TargetProcessCommandLine contains "Schema Admins")