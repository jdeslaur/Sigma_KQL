imProcessCreate
| where TargetProcessName endswith "\\QuarksPwDump.exe" or (TargetProcessCommandLine in~ (" -dhl", " --dump-hash-local", " -dhdc", " --dump-hash-domain-cached", " --dump-bitlocker", " -dhd ", " --dump-hash-domain ", "--ntds-file"))