// Title: File Explorer Folder Opened Using Explorer Folder Shortcut Via Shell
// Rule ID: c3d76afc-93df-461e-8e67-9b2bad3f2ac4
// Severity: high
// Tags: attack.discovery, attack.t1135
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_explorer_folder_shortcut_via_shell_binary.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName endswith "\\cmd.exe" or ParentProcessName endswith "\\powershell.exe" or ParentProcessName endswith "\\pwsh.exe") or (ActingProcessName endswith "\\cmd.exe" or ActingProcessName endswith "\\powershell.exe" or ActingProcessName endswith "\\pwsh.exe")) and TargetProcessName endswith "\\explorer.exe" and TargetProcessCommandLine contains "shell:mycomputerfolder"