imProcessCreate
| where TargetProcessName endswith "\\CoercedPotato.exe" or TargetProcessCommandLine contains " --exploitId " or (TargetProcessIMPHASH startswith "A75D7669DB6B2E107A44C4057FF7F7D6" or TargetProcessIMPHASH startswith "F91624350E2C678C5DCBE5E1F24E22C9" or TargetProcessIMPHASH startswith "14C81850A079A87E83D50CA41C709A15")