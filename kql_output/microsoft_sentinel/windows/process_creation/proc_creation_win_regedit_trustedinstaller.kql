// Title: Regedit as Trusted Installer
// Rule ID: 883835a7-df45-43e4-bf1d-4268768afda4
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_regedit_trustedinstaller.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\regedit.exe" and ((ParentProcessName endswith "\\TrustedInstaller.exe" or ParentProcessName endswith "\\ProcessHacker.exe") or (ActingProcessName endswith "\\TrustedInstaller.exe" or ActingProcessName endswith "\\ProcessHacker.exe"))