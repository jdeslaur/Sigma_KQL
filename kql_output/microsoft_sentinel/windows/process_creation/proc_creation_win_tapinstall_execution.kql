imProcessCreate
| where TargetProcessName endswith "\\tapinstall.exe" and (not(((TargetProcessName contains ":\\Program Files\\Avast Software\\SecureLine VPN\\" or TargetProcessName contains ":\\Program Files (x86)\\Avast Software\\SecureLine VPN\\") or TargetProcessName contains ":\\Program Files\\OpenVPN Connect\\drivers\\tap\\" or TargetProcessName contains ":\\Program Files (x86)\\Proton Technologies\\ProtonVPNTap\\installer\\")))