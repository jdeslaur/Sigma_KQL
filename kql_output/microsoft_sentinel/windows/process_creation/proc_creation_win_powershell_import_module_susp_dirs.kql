// Title: Import PowerShell Modules From Suspicious Directories - ProcCreation
// Rule ID: c31364f7-8be6-4b77-8483-dd2b5a7b69a3
// Severity: medium
// Tags: attack.execution, attack.t1059.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_import_module_susp_dirs.yml
//
