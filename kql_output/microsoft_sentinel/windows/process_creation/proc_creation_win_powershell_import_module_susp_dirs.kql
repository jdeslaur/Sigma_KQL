imProcessCreate
| where TargetProcessCommandLine contains "Import-Module \"$Env:Temp\\" or TargetProcessCommandLine contains "Import-Module '$Env:Temp\\" or TargetProcessCommandLine contains "Import-Module $Env:Temp\\" or TargetProcessCommandLine contains "Import-Module \"$Env:Appdata\\" or TargetProcessCommandLine contains "Import-Module '$Env:Appdata\\" or TargetProcessCommandLine contains "Import-Module $Env:Appdata\\" or TargetProcessCommandLine contains "Import-Module C:\\Users\\Public\\" or TargetProcessCommandLine contains "ipmo \"$Env:Temp\\" or TargetProcessCommandLine contains "ipmo '$Env:Temp\\" or TargetProcessCommandLine contains "ipmo $Env:Temp\\" or TargetProcessCommandLine contains "ipmo \"$Env:Appdata\\" or TargetProcessCommandLine contains "ipmo '$Env:Appdata\\" or TargetProcessCommandLine contains "ipmo $Env:Appdata\\" or TargetProcessCommandLine contains "ipmo C:\\Users\\Public\\"