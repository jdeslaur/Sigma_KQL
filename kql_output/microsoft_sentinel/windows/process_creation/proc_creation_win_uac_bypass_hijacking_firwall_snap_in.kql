imProcessCreate
| where ((ParentProcessName endswith "\\mmc.exe" or ActingProcessName endswith "\\mmc.exe") and ActingProcessCommandLine contains "WF.msc") and (not(TargetProcessName endswith "\\WerFault.exe"))