// Title: Execution via stordiag.exe
// Rule ID: 961e0abb-1b1e-4c84-a453-aafe56ad0d34
// Severity: high
// Tags: attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_stordiag_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName endswith "\\stordiag.exe" or ActingProcessName endswith "\\stordiag.exe") and (TargetProcessName endswith "\\schtasks.exe" or TargetProcessName endswith "\\systeminfo.exe" or TargetProcessName endswith "\\fltmc.exe")) and (not(((ParentProcessName startswith "c:\\windows\\system32\\" or ParentProcessName startswith "c:\\windows\\syswow64\\") or (ActingProcessName startswith "c:\\windows\\system32\\" or ActingProcessName startswith "c:\\windows\\syswow64\\"))))