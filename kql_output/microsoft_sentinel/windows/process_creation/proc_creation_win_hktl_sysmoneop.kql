imProcessCreate
| where TargetProcessName endswith "\\SysmonEOP.exe" or (TargetProcessIMPHASH startswith "22F4089EB8ABA31E1BB162C6D9BF72E5" or TargetProcessIMPHASH startswith "5123FA4C4384D431CD0D893EEB49BBEC")