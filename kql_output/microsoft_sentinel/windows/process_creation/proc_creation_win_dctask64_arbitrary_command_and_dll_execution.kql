imProcessCreate
| where (TargetProcessName endswith "\\dctask64.exe" or (TargetProcessIMPHASH startswith "6834B1B94E49701D77CCB3C0895E1AFD" or TargetProcessIMPHASH startswith "1BB6F93B129F398C7C4A76BB97450BBA" or TargetProcessIMPHASH startswith "FAA2AC19875FADE461C8D89DCF2710A3" or TargetProcessIMPHASH startswith "F1039CED4B91572AB7847D26032E6BBF")) and (TargetProcessCommandLine contains " executecmd64 " or TargetProcessCommandLine contains " invokeexe " or TargetProcessCommandLine contains " injectDll ")