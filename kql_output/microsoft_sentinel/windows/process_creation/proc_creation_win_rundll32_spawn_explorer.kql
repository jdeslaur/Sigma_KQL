// Title: RunDLL32 Spawning Explorer
// Rule ID: caa06de8-fdef-4c91-826a-7f9e163eef4b
// Severity: high
// Tags: attack.defense-evasion, attack.t1218.011
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_rundll32_spawn_explorer.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName endswith "\\rundll32.exe" or ActingProcessName endswith "\\rundll32.exe") and TargetProcessName endswith "\\explorer.exe") and (not(ActingProcessCommandLine contains "\\shell32.dll,Control_RunDLL"))