// Title: Suspicious ArcSOC.exe Child Process
// Rule ID: 8e95e73e-ba02-4a87-b4d7-0929b8053038
// Severity: high
// Tags: attack.execution, attack.t1059, attack.t1203
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_arcsoc_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName endswith "\\ArcSOC.exe" or ActingProcessName endswith "\\ArcSOC.exe") and (TargetProcessName endswith "\\cmd.exe" or TargetProcessName endswith "\\cscript.exe" or TargetProcessName endswith "\\mshta.exe" or TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe" or TargetProcessName endswith "\\regsvr32.exe" or TargetProcessName endswith "\\rundll32.exe" or TargetProcessName endswith "\\wmic.exe" or TargetProcessName endswith "\\wscript.exe")) and (not((TargetProcessName endswith "\\cmd.exe" and TargetProcessCommandLine =~ "cmd.exe /c \"ver\"")))