imProcessCreate
| where ((TargetProcessFileDescription =~ "?" and TargetProcessFileVersion =~ "?") or (TargetProcessFileDescription =~ "?" and TargetProcessFileProduct =~ "?") or (TargetProcessFileDescription =~ "?" and TargetProcessFileCompany =~ "?")) and TargetProcessName contains "\\Downloads\\"