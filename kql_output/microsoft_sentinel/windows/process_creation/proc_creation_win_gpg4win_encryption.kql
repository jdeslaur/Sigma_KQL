// Title: File Encryption Using Gpg4win
// Rule ID: 550bbb84-ce5d-4e61-84ad-e590f0024dcd
// Severity: medium
// Tags: attack.execution
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_gpg4win_encryption.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\gpg.exe" or TargetProcessName endswith "\\gpg2.exe") or TargetProcessFileDescription =~ "GnuPG’s OpenPGP tool") and (TargetProcessCommandLine contains " -c " and TargetProcessCommandLine contains "passphrase")