// Title: Cab File Extraction Via Wusa.EXE From Potentially Suspicious Paths
// Rule ID: c74c0390-3e20-41fd-a69a-128f0275a5ea
// Severity: high
// Tags: attack.execution
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wusa_cab_files_extraction_from_susp_paths.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\wusa.exe" and TargetProcessCommandLine contains "/extract:") and (TargetProcessCommandLine contains ":\\PerfLogs\\" or TargetProcessCommandLine contains ":\\Users\\Public\\" or TargetProcessCommandLine contains ":\\Windows\\Temp\\" or TargetProcessCommandLine contains "\\Appdata\\Local\\Temp\\")