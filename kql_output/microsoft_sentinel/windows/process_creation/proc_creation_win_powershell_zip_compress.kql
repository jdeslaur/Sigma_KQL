// Title: Folder Compress To Potentially Suspicious Output Via Compress-Archive Cmdlet
// Rule ID: 85a8e5ba-bd03-4bfb-bbfa-a4409a8f8b98
// Severity: medium
// Tags: attack.collection, attack.t1074.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_zip_compress.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "Compress-Archive -Path" and TargetProcessCommandLine contains "-DestinationPath $env:TEMP") or (TargetProcessCommandLine contains "Compress-Archive -Path" and TargetProcessCommandLine contains "-DestinationPath" and TargetProcessCommandLine contains "\\AppData\\Local\\Temp\\") or (TargetProcessCommandLine contains "Compress-Archive -Path" and TargetProcessCommandLine contains "-DestinationPath" and TargetProcessCommandLine contains ":\\Windows\\Temp\\")