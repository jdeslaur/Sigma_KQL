// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\regsvr32.exe" and (TargetProcessCommandLine contains " -i:" or TargetProcessCommandLine contains " /i:" or TargetProcessCommandLine contains " –i:" or TargetProcessCommandLine contains " —i:" or TargetProcessCommandLine contains " ―i:")) and (not(TargetProcessCommandLine contains " -n " or TargetProcessCommandLine contains " /n " or TargetProcessCommandLine contains " –n " or TargetProcessCommandLine contains " —n " or TargetProcessCommandLine contains " ―n "))