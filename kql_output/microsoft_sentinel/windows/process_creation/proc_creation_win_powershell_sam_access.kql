// Title: PowerShell SAM Copy
// Rule ID: 1af57a4b-460a-4738-9034-db68b880c665
// Severity: high
// Tags: attack.credential-access, attack.t1003.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_sam_access.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "\\HarddiskVolumeShadowCopy" and TargetProcessCommandLine contains "System32\\config\\sam") and (TargetProcessCommandLine contains "Copy-Item" or TargetProcessCommandLine contains "cp $_." or TargetProcessCommandLine contains "cpi $_." or TargetProcessCommandLine contains "copy $_." or TargetProcessCommandLine contains ".File]::Copy(")