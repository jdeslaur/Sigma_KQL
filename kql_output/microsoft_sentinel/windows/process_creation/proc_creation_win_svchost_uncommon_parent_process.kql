// Title: Uncommon Svchost Parent Process
// Rule ID: 01d2e2a1-5f09-44f7-9fc1-24faa7479b6d
// Severity: medium
// Tags: attack.defense-evasion, attack.t1036.005
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_svchost_uncommon_parent_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\svchost.exe" and (not((((ParentProcessName endswith "\\Mrt.exe" or ParentProcessName endswith "\\MsMpEng.exe" or ParentProcessName endswith "\\ngen.exe" or ParentProcessName endswith "\\rpcnet.exe" or ParentProcessName endswith "\\services.exe" or ParentProcessName endswith "\\TiWorker.exe") or (ActingProcessName endswith "\\Mrt.exe" or ActingProcessName endswith "\\MsMpEng.exe" or ActingProcessName endswith "\\ngen.exe" or ActingProcessName endswith "\\rpcnet.exe" or ActingProcessName endswith "\\services.exe" or ActingProcessName endswith "\\TiWorker.exe")) or (isnull(ParentProcessName) or isnull(ActingProcessName)) or ((ParentProcessName in~ ("-", "")) or (ActingProcessName in~ ("-", ""))))))