// Title: Curl.EXE Execution With Custom UserAgent
// Rule ID: 3286d37a-00fd-41c2-a624-a672dcd34e60
// Severity: medium
// Tags: attack.command-and-control, attack.t1071.001, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_curl_useragent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\curl.exe" or TargetProcessFileProduct =~ "The curl executable") and (TargetProcessCommandLine contains " -A " or TargetProcessCommandLine contains " --user-agent ")