// Title: Suspicious Vsls-Agent Command With AgentExtensionPath Load
// Rule ID: 43103702-5886-11ed-9b6a-0242ac120002
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_vslsagent_agentextensionpath_load.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\vsls-agent.exe" and TargetProcessCommandLine contains "--agentExtensionPath") and (not(TargetProcessCommandLine contains "Microsoft.VisualStudio.LiveShare.Agent."))