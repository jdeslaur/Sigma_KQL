imProcessCreate
| where (TargetProcessName endswith "\\DismHost.exe" and (ActingProcessCommandLine contains "/Online" and ActingProcessCommandLine contains "/Disable-Feature")) or (TargetProcessName endswith "\\Dism.exe" and (TargetProcessCommandLine contains "/Online" and TargetProcessCommandLine contains "/Disable-Feature"))