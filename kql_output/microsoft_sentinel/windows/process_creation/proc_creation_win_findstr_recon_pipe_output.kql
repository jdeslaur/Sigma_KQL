// Title: Recon Command Output Piped To Findstr.EXE
// Rule ID: ccb5742c-c248-4982-8c5c-5571b9275ad3
// Severity: medium
// Tags: attack.discovery, attack.t1057
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_findstr_recon_pipe_output.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessCommandLine contains "ipconfig" and TargetProcessCommandLine contains "|" and TargetProcessCommandLine contains "find") or (TargetProcessCommandLine contains "net" and TargetProcessCommandLine contains "|" and TargetProcessCommandLine contains "find") or (TargetProcessCommandLine contains "netstat" and TargetProcessCommandLine contains "|" and TargetProcessCommandLine contains "find") or (TargetProcessCommandLine contains "ping" and TargetProcessCommandLine contains "|" and TargetProcessCommandLine contains "find") or (TargetProcessCommandLine contains "systeminfo" and TargetProcessCommandLine contains "|" and TargetProcessCommandLine contains "find") or (TargetProcessCommandLine contains "tasklist" and TargetProcessCommandLine contains "|" and TargetProcessCommandLine contains "find") or (TargetProcessCommandLine contains "whoami" and TargetProcessCommandLine contains "|" and TargetProcessCommandLine contains "find")) and (not((TargetProcessCommandLine contains "cmd.exe /c TASKLIST /V |" and TargetProcessCommandLine contains "FIND /I" and TargetProcessCommandLine contains "\\xampp\\" and TargetProcessCommandLine contains "\\catalina_start.bat")))