// Title: Remote Access Tool - Anydesk Execution From Suspicious Folder
// Rule ID: 065b00ca-5d5c-4557-ac95-64a6d0b64d86
// Severity: high
// Tags: attack.command-and-control, attack.t1219.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_remote_access_tools_anydesk_susp_exec.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\AnyDesk.exe" or TargetProcessName endswith "\\AnyDeskMSI.exe") or TargetProcessFileDescription =~ "AnyDesk" or TargetProcessFileProduct =~ "AnyDesk" or TargetProcessFileCompany =~ "AnyDesk Software GmbH") and (not((TargetProcessName contains "\\AppData\\" or TargetProcessName contains "Program Files (x86)\\AnyDesk" or TargetProcessName contains "Program Files\\AnyDesk")))