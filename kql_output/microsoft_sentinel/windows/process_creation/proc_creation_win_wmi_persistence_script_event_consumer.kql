imProcessCreate
| where TargetProcessName =~ "C:\\WINDOWS\\system32\\wbem\\scrcons.exe" and (ParentProcessName =~ "C:\\Windows\\System32\\svchost.exe" or ActingProcessName =~ "C:\\Windows\\System32\\svchost.exe")