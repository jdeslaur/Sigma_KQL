// Title: Schtasks Creation Or Modification With SYSTEM Privileges
// Rule ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
// Severity: high
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_schtasks_system.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\schtasks.exe" and (TargetProcessCommandLine contains " /change " or TargetProcessCommandLine contains " /create ")) and TargetProcessCommandLine contains "/ru " and (TargetProcessCommandLine contains "NT AUT" or TargetProcessCommandLine contains " SYSTEM ")) and (not(((TargetProcessName endswith "\\schtasks.exe" and (TargetProcessCommandLine contains "/TN TVInstallRestore" and TargetProcessCommandLine contains "\\TeamViewer_.exe")) or (TargetProcessCommandLine contains "Subscription Heartbeat" and TargetProcessCommandLine contains "\\HeartbeatConfig.xml" and TargetProcessCommandLine contains "\\Microsoft Shared\\OFFICE") or (TargetProcessCommandLine contains "/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR " or TargetProcessCommandLine contains ":\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe" or TargetProcessCommandLine contains "/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST"))))