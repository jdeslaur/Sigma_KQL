imProcessCreate
| where (TargetProcessCommandLine contains "iex " or TargetProcessCommandLine contains "Invoke-Expression " or TargetProcessCommandLine contains "Invoke-Command " or TargetProcessCommandLine contains "icm ") and (TargetProcessCommandLine contains "cat " or TargetProcessCommandLine contains "get-content " or TargetProcessCommandLine contains "type ") and TargetProcessCommandLine contains " -raw"