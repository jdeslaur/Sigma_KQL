// Title: File Encryption/Decryption Via Gpg4win From Suspicious Locations
// Rule ID: e1e0b7d7-e10b-4ee4-ac49-a4bda05d320d
// Severity: high
// Tags: attack.execution
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_gpg4win_susp_location.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\gpg.exe" or TargetProcessName endswith "\\gpg2.exe") or TargetProcessFileProduct =~ "GNU Privacy Guard (GnuPG)" or TargetProcessFileDescription =~ "GnuPG’s OpenPGP tool") and TargetProcessCommandLine contains "-passphrase" and (TargetProcessCommandLine contains ":\\PerfLogs\\" or TargetProcessCommandLine contains ":\\Temp\\" or TargetProcessCommandLine contains ":\\Users\\Public\\" or TargetProcessCommandLine contains ":\\Windows\\Temp\\" or TargetProcessCommandLine contains "\\AppData\\Local\\Temp\\" or TargetProcessCommandLine contains "\\AppData\\Roaming\\")