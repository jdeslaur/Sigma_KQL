// Title: New Service Creation Using Sc.EXE
// Rule ID: 85ff530b-261d-48c6-a441-facaa2e81e48
// Severity: low
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_sc_create_service.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\sc.exe" and (TargetProcessCommandLine contains "create" and TargetProcessCommandLine contains "binPath")) and (not((((ParentProcessName startswith "C:\\Program Files (x86)\\Dropbox\\Client\\" or ParentProcessName startswith "C:\\Program Files\\Dropbox\\Client\\") or (ActingProcessName startswith "C:\\Program Files (x86)\\Dropbox\\Client\\" or ActingProcessName startswith "C:\\Program Files\\Dropbox\\Client\\")) and (ParentProcessName endswith "\\Dropbox.exe" or ActingProcessName endswith "\\Dropbox.exe"))))