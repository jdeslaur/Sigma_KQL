// Title: Suspicious Rundll32 Setupapi.dll Activity
// Rule ID: 285b85b1-a555-4095-8652-a8a4106af63f
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218.011
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_rundll32_setupapi_installhinfsection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\runonce.exe" and (ParentProcessName endswith "\\rundll32.exe" or ActingProcessName endswith "\\rundll32.exe") and (ActingProcessCommandLine contains "setupapi.dll" and ActingProcessCommandLine contains "InstallHinfSection")