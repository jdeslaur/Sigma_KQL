// Title: UAC Bypass Using Windows Media Player - Process
// Rule ID: 0058b9e5-bcd7-40d4-9205-95ca5a16d7b2
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_uac_bypass_wmp.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName =~ "C:\\Program Files\\Windows Media Player\\osk.exe" or (TargetProcessName =~ "C:\\Windows\\System32\\cmd.exe" and ActingProcessCommandLine =~ "\"C:\\Windows\\system32\\mmc.exe\" \"C:\\Windows\\system32\\eventvwr.msc\" /s")) and (TargetProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))