// Title: Potential DLL Injection Or Execution Using Tracker.exe
// Rule ID: 148431ce-4b70-403d-8525-fcc2993f29ea
// Severity: medium
// Tags: attack.privilege-escalation, attack.defense-evasion, attack.t1055.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_lolbin_tracker.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\tracker.exe" or TargetProcessFileDescription =~ "Tracker") and (TargetProcessCommandLine contains " /d " or TargetProcessCommandLine contains " /c ")) and (not((TargetProcessCommandLine contains " /ERRORREPORT:PROMPT " or ((ParentProcessName endswith "\\Msbuild\\Current\\Bin\\MSBuild.exe" or ParentProcessName endswith "\\Msbuild\\Current\\Bin\\amd64\\MSBuild.exe") or (ActingProcessName endswith "\\Msbuild\\Current\\Bin\\MSBuild.exe" or ActingProcessName endswith "\\Msbuild\\Current\\Bin\\amd64\\MSBuild.exe")))))