// Title: UAC Bypass Tools Using ComputerDefaults
// Rule ID: 3c05e90d-7eba-4324-9972-5d7f711a60a8
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_uac_bypass_computerdefaults.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288")) and TargetProcessName =~ "C:\\Windows\\System32\\ComputerDefaults.exe") and (not(((ParentProcessName contains ":\\Windows\\System32" or ParentProcessName contains ":\\Program Files") or (ActingProcessName contains ":\\Windows\\System32" or ActingProcessName contains ":\\Program Files"))))