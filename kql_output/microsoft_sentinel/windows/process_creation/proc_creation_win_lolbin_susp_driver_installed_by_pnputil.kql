// Title: Suspicious Driver Install by pnputil.exe
// Rule ID: a2ea3ae7-d3d0-40a0-a55c-25a45c87cac1
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_lolbin_susp_driver_installed_by_pnputil.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "-i" or TargetProcessCommandLine contains "/install" or TargetProcessCommandLine contains "-a" or TargetProcessCommandLine contains "/add-driver" or TargetProcessCommandLine contains ".inf") and TargetProcessName endswith "\\pnputil.exe"