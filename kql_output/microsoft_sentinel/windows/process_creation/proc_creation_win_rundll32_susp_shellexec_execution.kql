// Title: Suspicious Usage Of ShellExec_RunDLL
// Rule ID: d87bd452-6da1-456e-8155-7dc988157b7d
// Severity: high
// Tags: attack.defense-evasion
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_rundll32_susp_shellexec_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessCommandLine contains "ShellExec_RunDLL" and (TargetProcessCommandLine contains "\\Desktop\\" or TargetProcessCommandLine contains "\\Temp\\" or TargetProcessCommandLine contains "\\Users\\Public\\" or TargetProcessCommandLine contains "comspec" or TargetProcessCommandLine contains "iex" or TargetProcessCommandLine contains "Invoke-" or TargetProcessCommandLine contains "msiexec" or TargetProcessCommandLine contains "odbcconf" or TargetProcessCommandLine contains "regsvr32")