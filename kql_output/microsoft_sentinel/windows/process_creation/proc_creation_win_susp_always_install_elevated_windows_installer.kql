// Title: Always Install Elevated Windows Installer
// Rule ID: cd951fdc-4b2f-47f5-ba99-a33bf61e3770
// Severity: medium
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_always_install_elevated_windows_installer.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (((TargetProcessName contains "\\Windows\\Installer\\" and TargetProcessName contains "msi") and TargetProcessName endswith "tmp") or (TargetProcessName endswith "\\msiexec.exe" and (TargetProcessIntegrityLevel in~ ("System", "S-1-16-16384")))) and (TargetUsername contains "AUTHORI" or TargetUsername contains "AUTORI") and (not(((ParentProcessName =~ "C:\\Windows\\System32\\services.exe" or ActingProcessName =~ "C:\\Windows\\System32\\services.exe") or (TargetProcessCommandLine endswith "\\system32\\msiexec.exe /V" or ActingProcessCommandLine endswith "\\system32\\msiexec.exe /V") or (ParentProcessName startswith "C:\\ProgramData\\Sophos\\" or ActingProcessName startswith "C:\\ProgramData\\Sophos\\") or (ParentProcessName startswith "C:\\ProgramData\\Avira\\" or ActingProcessName startswith "C:\\ProgramData\\Avira\\") or ((ParentProcessName startswith "C:\\Program Files\\Avast Software\\" or ParentProcessName startswith "C:\\Program Files (x86)\\Avast Software\\") or (ActingProcessName startswith "C:\\Program Files\\Avast Software\\" or ActingProcessName startswith "C:\\Program Files (x86)\\Avast Software\\")) or ((ParentProcessName startswith "C:\\Program Files\\Google\\Update\\" or ParentProcessName startswith "C:\\Program Files (x86)\\Google\\Update\\") or (ActingProcessName startswith "C:\\Program Files\\Google\\Update\\" or ActingProcessName startswith "C:\\Program Files (x86)\\Google\\Update\\")))))