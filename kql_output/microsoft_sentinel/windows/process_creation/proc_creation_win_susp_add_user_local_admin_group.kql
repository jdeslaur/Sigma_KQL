imProcessCreate
| where ((TargetProcessCommandLine contains "localgroup " and TargetProcessCommandLine contains " /add") or (TargetProcessCommandLine contains "Add-LocalGroupMember " and TargetProcessCommandLine contains " -Group ")) and (TargetProcessCommandLine contains " administrators " or TargetProcessCommandLine contains " administrateur")