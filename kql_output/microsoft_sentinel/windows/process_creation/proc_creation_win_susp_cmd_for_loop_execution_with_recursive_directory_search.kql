// Title: Suspicious Usage of For Loop with Recursive Directory Search in CMD
// Rule ID: 2782fbd8-b662-4eb5-9962-5bfbfb671e7b
// Severity: medium
// Tags: attack.execution, attack.t1059.003, attack.defense-evasion, attack.t1027.010
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_cmd_for_loop_execution_with_recursive_directory_search.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "for /f" and TargetProcessCommandLine contains "tokens=" and TargetProcessCommandLine contains "in (" and TargetProcessCommandLine contains "dir") or (ActingProcessCommandLine contains "for /f" and ActingProcessCommandLine contains "tokens=" and ActingProcessCommandLine contains "in (" and ActingProcessCommandLine contains "dir")