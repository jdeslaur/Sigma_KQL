imProcessCreate
| where (TargetProcessCommandLine contains "accepteula" and TargetProcessCommandLine contains " -u " and TargetProcessCommandLine contains " -p " and TargetProcessCommandLine contains " \\\\") and (not((TargetProcessCommandLine contains "\\\\localhost" or TargetProcessCommandLine contains "\\\\127.")))