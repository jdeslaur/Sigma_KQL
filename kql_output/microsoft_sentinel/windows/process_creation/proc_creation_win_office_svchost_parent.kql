// Title: Suspicious New Instance Of An Office COM Object
// Rule ID: 9bdaf1e9-fdef-443b-8081-4341b74a7e28
// Severity: medium
// Tags: attack.execution, attack.defense-evasion, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_office_svchost_parent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (ParentProcessName endswith "\\svchost.exe" or ActingProcessName endswith "\\svchost.exe") and (TargetProcessName endswith "\\eqnedt32.exe" or TargetProcessName endswith "\\excel.exe" or TargetProcessName endswith "\\msaccess.exe" or TargetProcessName endswith "\\mspub.exe" or TargetProcessName endswith "\\powerpnt.exe" or TargetProcessName endswith "\\visio.exe" or TargetProcessName endswith "\\winword.exe")