imProcessCreate
| where (TargetProcessCommandLine contains "cmd" and TargetProcessCommandLine contains "&&" and TargetProcessCommandLine contains "clipboard]::" and TargetProcessCommandLine contains "-f") and (TargetProcessCommandLine contains "/c" or TargetProcessCommandLine contains "/r")