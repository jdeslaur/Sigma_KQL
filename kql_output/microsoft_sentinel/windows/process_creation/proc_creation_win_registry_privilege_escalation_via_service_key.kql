imProcessCreate
| where (TargetProcessIntegrityLevel in~ ("Medium", "S-1-16-8192")) and (TargetProcessCommandLine contains "ControlSet" and TargetProcessCommandLine contains "services") and (TargetProcessCommandLine contains "\\ImagePath" or TargetProcessCommandLine contains "\\FailureCommand" or TargetProcessCommandLine contains "\\ServiceDll")