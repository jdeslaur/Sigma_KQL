imProcessCreate
| where (ParentProcessName =~ "C:\\Windows\\PSEXESVC.exe" or ActingProcessName =~ "C:\\Windows\\PSEXESVC.exe") and (TargetUsername contains "AUTHORI" or TargetUsername contains "AUTORI")