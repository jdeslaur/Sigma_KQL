// Title: Potential Dropper Script Execution Via WScript/CScript
// Rule ID: cea72823-df4d-4567-950c-0b579eaf0846
// Severity: medium
// Tags: attack.execution, attack.t1059.005, attack.t1059.007
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wscript_cscript_dropper.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\wscript.exe" or TargetProcessName endswith "\\cscript.exe") and (TargetProcessCommandLine contains ":\\Temp\\" or TargetProcessCommandLine contains ":\\Tmp\\" or TargetProcessCommandLine contains ":\\Users\\Public\\" or TargetProcessCommandLine contains ":\\Windows\\Temp\\" or TargetProcessCommandLine contains "\\AppData\\Local\\Temp\\") and (TargetProcessCommandLine contains ".js" or TargetProcessCommandLine contains ".jse" or TargetProcessCommandLine contains ".vba" or TargetProcessCommandLine contains ".vbe" or TargetProcessCommandLine contains ".vbs" or TargetProcessCommandLine contains ".wsf")