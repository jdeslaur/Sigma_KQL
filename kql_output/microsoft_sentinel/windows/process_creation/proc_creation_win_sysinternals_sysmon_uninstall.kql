// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\Sysmon64.exe" or TargetProcessName endswith "\\Sysmon.exe") or TargetProcessFileDescription =~ "System activity monitor") and (TargetProcessCommandLine contains "-u" or TargetProcessCommandLine contains "/u" or TargetProcessCommandLine contains "–u" or TargetProcessCommandLine contains "—u" or TargetProcessCommandLine contains "―u")