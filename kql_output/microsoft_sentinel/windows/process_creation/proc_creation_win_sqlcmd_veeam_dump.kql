imProcessCreate
| where TargetProcessName endswith "\\sqlcmd.exe" and (TargetProcessCommandLine contains "SELECT" and TargetProcessCommandLine contains "TOP" and TargetProcessCommandLine contains "[VeeamBackup].[dbo].[Credentials]")