// Title: Potential Data Exfiltration Via Curl.EXE
// Rule ID: 00bca14a-df4e-4649-9054-3f2aa676bc04
// Severity: medium
// Tags: attack.exfiltration, attack.command-and-control, attack.t1567, attack.t1105, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_curl_fileupload.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\curl.exe" or TargetProcessFileProduct =~ "The curl executable") and ((TargetProcessCommandLine contains " --form" or TargetProcessCommandLine contains " --upload-file " or TargetProcessCommandLine contains " --data " or TargetProcessCommandLine contains " --data-") or TargetProcessCommandLine matches regex "\\s-[FTd]\\s")) and (not((TargetProcessCommandLine contains "://localhost" or TargetProcessCommandLine contains "://127.0.0.1")))