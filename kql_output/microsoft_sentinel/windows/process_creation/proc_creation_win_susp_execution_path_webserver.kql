// Title: Execution From Webserver Root Folder
// Rule ID: 35efb964-e6a5-47ad-bbcd-19661854018d
// Severity: medium
// Tags: attack.persistence, attack.t1505.003, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_susp_execution_path_webserver.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName contains "\\wwwroot\\" or TargetProcessName contains "\\wmpub\\" or TargetProcessName contains "\\htdocs\\") and (not(((TargetProcessName contains "bin\\" or TargetProcessName contains "\\Tools\\" or TargetProcessName contains "\\SMSComponent\\") and (ParentProcessName endswith "\\services.exe" or ActingProcessName endswith "\\services.exe"))))