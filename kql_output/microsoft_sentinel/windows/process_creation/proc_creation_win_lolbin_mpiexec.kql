imProcessCreate
| where (TargetProcessName endswith "\\mpiexec.exe" or TargetProcessIMPHASH startswith "d8b52ef6aaa3a81501bdfff9dbb96217") and (TargetProcessCommandLine contains " /n 1 " or TargetProcessCommandLine contains " -n 1 ")