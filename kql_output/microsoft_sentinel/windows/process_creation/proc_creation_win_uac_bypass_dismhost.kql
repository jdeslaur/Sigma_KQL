// Title: UAC Bypass Using DismHost
// Rule ID: 853e74f9-9392-4935-ad3b-2e8c040dae86
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_uac_bypass_dismhost.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName contains "C:\\Users\\" and ParentProcessName contains "\\AppData\\Local\\Temp\\" and ParentProcessName contains "\\DismHost.exe") or (ActingProcessName contains "C:\\Users\\" and ActingProcessName contains "\\AppData\\Local\\Temp\\" and ActingProcessName contains "\\DismHost.exe")) and (TargetProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))