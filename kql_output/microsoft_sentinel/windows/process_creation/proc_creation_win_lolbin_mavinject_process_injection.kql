// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessCommandLine contains " /INJECTRUNNING " and (not((ParentProcessName =~ "C:\\Windows\\System32\\AppVClient.exe" or ActingProcessName =~ "C:\\Windows\\System32\\AppVClient.exe")))