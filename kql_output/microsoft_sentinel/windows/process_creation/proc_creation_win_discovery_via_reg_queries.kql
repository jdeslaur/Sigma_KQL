// Title: System Information Discovery via Registry Queries
// Rule ID: 0022869c-49f7-4ff2-ba03-85ac42ddac58
// Severity: low
// Tags: attack.discovery, attack.t1082
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_discovery_via_reg_queries.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\reg.exe" and TargetProcessCommandLine contains "query" and (TargetProcessCommandLine contains "-v" or TargetProcessCommandLine contains "/v" or TargetProcessCommandLine contains "–v" or TargetProcessCommandLine contains "—v" or TargetProcessCommandLine contains "―v")) or ((TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe") and (TargetProcessCommandLine contains "Get-ItemPropertyValue" or TargetProcessCommandLine contains "gpv"))) and (TargetProcessCommandLine contains "\\SOFTWARE\\Microsoft\\Windows Defender" or TargetProcessCommandLine contains "\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion" or TargetProcessCommandLine contains "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall" or TargetProcessCommandLine contains "\\SYSTEM\\CurrentControlSet\\Control\\TimeZoneInformation" or TargetProcessCommandLine contains "\\SYSTEM\\CurrentControlSet\\Services")