imProcessCreate
| where (ParentProcessName endswith "\\SndVol.exe" or ActingProcessName endswith "\\SndVol.exe") and (not((TargetProcessName endswith "\\rundll32.exe" and TargetProcessCommandLine contains " shell32.dll,Control_RunDLL ")))