// Title: Manual Execution of Script Inside of a Compressed File
// Rule ID: 95724fc1-a258-4674-97db-a30351981c5a
// Severity: medium
// Tags: attack.execution, attack.t1059, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_susp_script_exec_from_compressed_parent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (((ParentProcessName matches regex ".*\\\\7z.*\\.exe" or ActingProcessName matches regex ".*\\\\7z.*\\.exe") and TargetProcessCommandLine matches regex ".*\\\\AppData\\\\local\\\\temp\\\\7z.*\\\\.*") or ((ParentProcessName endswith "\\winrar.exe" or ActingProcessName endswith "\\winrar.exe") and TargetProcessCommandLine matches regex ".*\\\\AppData\\\\local\\\\temp\\\\rar.*\\\\.*") or ((ParentProcessName endswith "\\explorer.exe" or ActingProcessName endswith "\\explorer.exe") and (TargetProcessCommandLine contains "\\AppData\\local\\temp*.rar\\" or TargetProcessCommandLine contains "\\AppData\\local\\temp*.zip\\"))) and ((TargetProcessName endswith "\\cscript.exe" or TargetProcessName endswith "\\mshta.exe" or TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe" or TargetProcessName endswith "\\wscript.exe") and (TargetProcessCommandLine endswith ".hta" or TargetProcessCommandLine endswith ".js" or TargetProcessCommandLine endswith ".jse" or TargetProcessCommandLine endswith ".ps1" or TargetProcessCommandLine endswith ".vbe" or TargetProcessCommandLine endswith ".vbs" or TargetProcessCommandLine endswith ".wsf" or TargetProcessCommandLine endswith ".wsh"))