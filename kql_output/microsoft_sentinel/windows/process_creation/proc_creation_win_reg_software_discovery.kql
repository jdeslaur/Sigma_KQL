// Title: Detected Windows Software Discovery
// Rule ID: e13f668e-7f95-443d-98d2-1816a7648a7b
// Severity: medium
// Tags: attack.discovery, attack.t1518
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_reg_software_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\reg.exe" and (TargetProcessCommandLine contains "query" and TargetProcessCommandLine contains "\\software\\" and TargetProcessCommandLine contains "/v" and TargetProcessCommandLine contains "svcversion")