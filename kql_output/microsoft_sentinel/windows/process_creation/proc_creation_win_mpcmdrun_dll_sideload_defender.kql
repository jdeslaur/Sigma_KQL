// Title: Potential Mpclient.DLL Sideloading Via Defender Binaries
// Rule ID: 7002aa10-b8d4-47ae-b5ba-51ab07e228b9
// Severity: high
// Tags: attack.privilege-escalation, attack.persistence, attack.defense-evasion, attack.t1574.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_mpcmdrun_dll_sideload_defender.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\MpCmdRun.exe" or TargetProcessName endswith "\\NisSrv.exe") and (not((TargetProcessName startswith "C:\\Program Files (x86)\\Windows Defender\\" or TargetProcessName startswith "C:\\Program Files\\Microsoft Security Client\\" or TargetProcessName startswith "C:\\Program Files\\Windows Defender\\" or TargetProcessName startswith "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" or TargetProcessName startswith "C:\\Windows\\WinSxS\\")))