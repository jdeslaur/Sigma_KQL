// Title: Suspicious LNK Command-Line Padding with Whitespace Characters
// Rule ID: dd8756e7-a3a0-4768-b47e-8f545d1a751c
// Severity: high
// Tags: attack.initial-access, attack.execution, attack.t1204.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_lnk_exec_hidden_cmd.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName endswith "\\explorer.exe" or ActingProcessName endswith "\\explorer.exe") or ActingProcessCommandLine contains ".lnk") and ((TargetProcessCommandLine contains "                 " or TargetProcessCommandLine contains "\\u0009" or TargetProcessCommandLine contains "\\u000A" or TargetProcessCommandLine contains "\\u0011" or TargetProcessCommandLine contains "\\u0012" or TargetProcessCommandLine contains "\\u0013" or TargetProcessCommandLine contains "\\u000B" or TargetProcessCommandLine contains "\\u000C" or TargetProcessCommandLine contains "\\u000D") or TargetProcessCommandLine matches regex "\\n\\n\\n\\n\\n\\n")