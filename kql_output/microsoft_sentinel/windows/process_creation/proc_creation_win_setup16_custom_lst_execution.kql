imProcessCreate
| where ((ParentProcessName =~ "C:\\Windows\\SysWOW64\\setup16.exe" or ActingProcessName =~ "C:\\Windows\\SysWOW64\\setup16.exe") and ActingProcessCommandLine contains " -m ") and (not(TargetProcessName startswith "C:\\~MSSETUP.T\\"))