// Title: Potential Process Injection Via Msra.EXE
// Rule ID: 744a188b-0415-4792-896f-11ddb0588dbc
// Severity: high
// Tags: attack.privilege-escalation, attack.defense-evasion, attack.t1055
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_msra_process_injection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (ParentProcessName endswith "\\msra.exe" or ActingProcessName endswith "\\msra.exe") and ActingProcessCommandLine endswith "msra.exe" and (TargetProcessName endswith "\\arp.exe" or TargetProcessName endswith "\\cmd.exe" or TargetProcessName endswith "\\net.exe" or TargetProcessName endswith "\\netstat.exe" or TargetProcessName endswith "\\nslookup.exe" or TargetProcessName endswith "\\route.exe" or TargetProcessName endswith "\\schtasks.exe" or TargetProcessName endswith "\\whoami.exe")