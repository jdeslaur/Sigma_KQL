// Title: Chromium Browser Headless Execution To Mockbin Like Site
// Rule ID: 1c526788-0abe-4713-862f-b520da5e5316
// Severity: high
// Tags: attack.execution
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_browsers_chromium_mockbin_abuse.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\brave.exe" or TargetProcessName endswith "\\chrome.exe" or TargetProcessName endswith "\\msedge.exe" or TargetProcessName endswith "\\opera.exe" or TargetProcessName endswith "\\vivaldi.exe") and TargetProcessCommandLine contains "--headless" and (TargetProcessCommandLine contains "://run.mocky" or TargetProcessCommandLine contains "://mockbin")