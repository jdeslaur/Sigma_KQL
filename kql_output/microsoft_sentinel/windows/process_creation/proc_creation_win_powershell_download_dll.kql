imProcessCreate
| where (TargetProcessCommandLine contains "Invoke-RestMethod " or TargetProcessCommandLine contains "Invoke-WebRequest " or TargetProcessCommandLine contains "IRM " or TargetProcessCommandLine contains "IWR ") and (TargetProcessCommandLine contains "http" and TargetProcessCommandLine contains "OutFile" and TargetProcessCommandLine contains ".dll")