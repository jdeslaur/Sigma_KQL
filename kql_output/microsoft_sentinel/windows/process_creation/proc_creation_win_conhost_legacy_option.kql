imProcessCreate
| where (TargetProcessIntegrityLevel in~ ("High", "S-1-16-12288")) and (TargetProcessCommandLine contains "conhost.exe" and TargetProcessCommandLine contains "0xffffffff" and TargetProcessCommandLine contains "-ForceV1")