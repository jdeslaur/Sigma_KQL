// Title: Arbitrary File Download Via Squirrel.EXE
// Rule ID: 1e75c1cc-c5d4-42aa-ac3d-91b0b68b3b4c
// Severity: medium
// Tags: attack.defense-evasion, attack.execution, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_squirrel_download.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\squirrel.exe" or TargetProcessName endswith "\\update.exe") and (TargetProcessCommandLine contains " --download " or TargetProcessCommandLine contains " --update " or TargetProcessCommandLine contains " --updateRollback=") and TargetProcessCommandLine contains "http"