// Title: Suspicious Query of MachineGUID
// Rule ID: f5240972-3938-4e56-8e4b-e33893176c1f
// Severity: low
// Tags: attack.discovery, attack.t1082
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_reg_machineguid.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\reg.exe" and (TargetProcessCommandLine contains "SOFTWARE\\Microsoft\\Cryptography" and TargetProcessCommandLine contains "/v " and TargetProcessCommandLine contains "MachineGuid")