imProcessCreate
| where (TargetProcessCommandLine contains "~1\\" or TargetProcessCommandLine contains "~2\\") and (not((((ParentProcessName in~ ("C:\\Windows\\System32\\Dism.exe", "C:\\Windows\\System32\\cleanmgr.exe")) or (ActingProcessName in~ ("C:\\Windows\\System32\\Dism.exe", "C:\\Windows\\System32\\cleanmgr.exe"))) or ((ParentProcessName endswith "\\winget.exe" or ActingProcessName endswith "\\winget.exe") or (ParentProcessName contains "\\AppData\\Local\\Temp\\WinGet\\" or ActingProcessName contains "\\AppData\\Local\\Temp\\WinGet\\")) or ((ParentProcessName startswith "C:\\Windows\\Microsoft.NET\\Framework64\\v" or ActingProcessName startswith "C:\\Windows\\Microsoft.NET\\Framework64\\v") and (ParentProcessName endswith "\\csc.exe" or ActingProcessName endswith "\\csc.exe")) or ((TargetProcessName contains "\\AppData\\" and TargetProcessName contains "\\Temp\\") or TargetProcessCommandLine contains "\\AppData\\Local\\Temp\\")))) and (not(((ParentProcessName =~ "C:\\Program Files\\GPSoftware\\Directory Opus\\dopus.exe" or ActingProcessName =~ "C:\\Program Files\\GPSoftware\\Directory Opus\\dopus.exe") or ((ParentProcessName endswith "\\aurora-agent-64.exe" or ParentProcessName endswith "\\aurora-agent.exe") or (ActingProcessName endswith "\\aurora-agent-64.exe" or ActingProcessName endswith "\\aurora-agent.exe")) or (ParentProcessName endswith "\\thor\\thor64.exe" or ActingProcessName endswith "\\thor\\thor64.exe") or (TargetProcessCommandLine contains "C:\\Program Files\\Git\\post-install.bat" or TargetProcessCommandLine contains "C:\\Program Files\\Git\\cmd\\scalar.exe") or ((ParentProcessName endswith "\\WebEx\\webexhost.exe" or ActingProcessName endswith "\\WebEx\\webexhost.exe") or TargetProcessCommandLine contains "\\appdata\\local\\webex\\webex64\\meetings\\wbxreport.exe") or (ParentProcessName endswith "\\veeam.backup.shell.exe" or ActingProcessName endswith "\\veeam.backup.shell.exe") or (ParentProcessName endswith "\\Everything\\Everything.exe" or ActingProcessName endswith "\\Everything\\Everything.exe"))))