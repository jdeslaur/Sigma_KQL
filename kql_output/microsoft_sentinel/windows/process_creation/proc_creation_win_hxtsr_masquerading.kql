imProcessCreate
| where TargetProcessName endswith "\\hxtsr.exe" and (not((TargetProcessName contains ":\\program files\\windowsapps\\microsoft.windowscommunicationsapps_" and TargetProcessName endswith "\\hxtsr.exe")))