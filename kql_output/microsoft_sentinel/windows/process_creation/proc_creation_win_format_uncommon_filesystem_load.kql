imProcessCreate
| where (TargetProcessName endswith "\\format.com" and TargetProcessCommandLine contains "/fs:") and (not((TargetProcessCommandLine contains "/fs:exFAT" or TargetProcessCommandLine contains "/fs:FAT" or TargetProcessCommandLine contains "/fs:NTFS" or TargetProcessCommandLine contains "/fs:ReFS" or TargetProcessCommandLine contains "/fs:UDF")))