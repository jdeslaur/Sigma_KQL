imProcessCreate
| where TargetProcessCommandLine contains "set" and TargetProcessCommandLine contains "&&" and TargetProcessCommandLine contains "mshta" and TargetProcessCommandLine contains "vbscript:createobject" and TargetProcessCommandLine contains ".run" and TargetProcessCommandLine contains "(window.close)"