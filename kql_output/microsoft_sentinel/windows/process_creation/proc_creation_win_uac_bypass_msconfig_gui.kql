// Title: UAC Bypass Using MSConfig Token Modification - Process
// Rule ID: ad92e3f9-7eb6-460e-96b1-582b0ccbb980
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_uac_bypass_msconfig_gui.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288")) and (ParentProcessName endswith "\\AppData\\Local\\Temp\\pkgmgr.exe" or ActingProcessName endswith "\\AppData\\Local\\Temp\\pkgmgr.exe") and TargetProcessCommandLine =~ "\"C:\\Windows\\system32\\msconfig.exe\" -5"