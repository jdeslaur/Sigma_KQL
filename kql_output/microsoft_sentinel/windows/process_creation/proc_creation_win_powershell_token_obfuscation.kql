// Title: Powershell Token Obfuscation - Process Creation
// Rule ID: deb9b646-a508-44ee-b7c9-d8965921c6b6
// Severity: high
// Tags: attack.defense-evasion, attack.t1027.009
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_token_obfuscation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine matches regex "\\w+`(\\w+|-|.)`[\\w+|\\s]" or TargetProcessCommandLine matches regex "\"(\\{\\d\\})+\"\\s*-f" or TargetProcessCommandLine matches regex "(?i)\\$\\{`?e`?n`?v`?:`?p`?a`?t`?h`?\\}") and (not(TargetProcessCommandLine contains "${env:path}"))