imProcessCreate
| where (TargetProcessCommandLine contains " -Inject " and (TargetProcessCommandLine contains " -PayloadArgs " or TargetProcessCommandLine contains " -PayloadFile ")) or ((TargetProcessCommandLine contains " approve " or TargetProcessCommandLine contains " create " or TargetProcessCommandLine contains " check " or TargetProcessCommandLine contains " delete ") and (TargetProcessCommandLine contains " /payload:" or TargetProcessCommandLine contains " /payload=" or TargetProcessCommandLine contains " /updateid:" or TargetProcessCommandLine contains " /updateid="))