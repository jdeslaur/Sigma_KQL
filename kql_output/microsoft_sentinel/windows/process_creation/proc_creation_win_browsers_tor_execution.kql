imProcessCreate
| where TargetProcessFileDescription =~ "Tor Browser" or TargetProcessFileProduct =~ "Tor Browser" or (TargetProcessName endswith "\\tor.exe" or TargetProcessName endswith "\\Tor Browser\\Browser\\firefox.exe")