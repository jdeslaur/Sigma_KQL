// Title: Visual Studio Code Tunnel Shell Execution
// Rule ID: f4a623c2-4ef5-4c33-b811-0642f702c9f1
// Severity: medium
// Tags: attack.command-and-control, attack.t1071.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_vscode_tunnel_remote_shell_.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName contains "\\servers\\Stable-" or ActingProcessName contains "\\servers\\Stable-") and (ParentProcessName endswith "\\server\\node.exe" or ActingProcessName endswith "\\server\\node.exe") and ActingProcessCommandLine contains ".vscode-server") and (((TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe") and TargetProcessCommandLine contains "\\terminal\\browser\\media\\shellIntegration.ps1") or (TargetProcessName endswith "\\wsl.exe" or TargetProcessName endswith "\\bash.exe"))