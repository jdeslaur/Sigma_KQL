| where (TargetProcessCommandLine contains " tunnel " and TargetProcessCommandLine contains " run ") and (TargetProcessCommandLine contains "-config " or TargetProcessCommandLine contains "-credentials-contents " or TargetProcessCommandLine contains "-credentials-file " or TargetProcessCommandLine contains "-token ")