// Title: Enumeration for Credentials in Registry
// Rule ID: e0b0c2ab-3d52-46d9-8cb7-049dc775fbd1
// Severity: medium
// Tags: attack.credential-access, attack.t1552.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_reg_enumeration_for_credentials_in_registry.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\reg.exe" and (TargetProcessCommandLine contains " query " and TargetProcessCommandLine contains "/t " and TargetProcessCommandLine contains "REG_SZ" and TargetProcessCommandLine contains "/s")) and ((TargetProcessCommandLine contains "/f " and TargetProcessCommandLine contains "HKLM") or (TargetProcessCommandLine contains "/f " and TargetProcessCommandLine contains "HKCU") or TargetProcessCommandLine contains "HKCU\\Software\\SimonTatham\\PuTTY\\Sessions")