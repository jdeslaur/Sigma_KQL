// Title: Deletion of Volume Shadow Copies via WMI with PowerShell
// Rule ID: 21ff4ca9-f13a-41ad-b828-0077b2af2e40
// Severity: high
// Tags: attack.impact, attack.t1490
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_shadowcopy_deletion.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "Get-WmiObject" or TargetProcessCommandLine contains "gwmi" or TargetProcessCommandLine contains "Get-CimInstance" or TargetProcessCommandLine contains "gcim") and TargetProcessCommandLine contains "Win32_ShadowCopy" and (TargetProcessCommandLine contains ".Delete()" or TargetProcessCommandLine contains "Remove-WmiObject" or TargetProcessCommandLine contains "rwmi" or TargetProcessCommandLine contains "Remove-CimInstance" or TargetProcessCommandLine contains "rcim")