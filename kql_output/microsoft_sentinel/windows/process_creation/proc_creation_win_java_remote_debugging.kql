// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "transport=dt_socket,address=" and (TargetProcessCommandLine contains "jre1." or TargetProcessCommandLine contains "jdk1.")) and (not((TargetProcessCommandLine contains "address=127.0.0.1" or TargetProcessCommandLine contains "address=localhost")))