imProcessCreate
| where TargetProcessName endswith "\\replace.exe" and (TargetProcessCommandLine contains "-a" or TargetProcessCommandLine contains "/a" or TargetProcessCommandLine contains "–a" or TargetProcessCommandLine contains "—a" or TargetProcessCommandLine contains "―a")