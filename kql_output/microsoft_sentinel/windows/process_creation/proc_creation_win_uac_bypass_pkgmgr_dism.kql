// Title: UAC Bypass Using PkgMgr and DISM
// Rule ID: a743ceba-c771-4d75-97eb-8a90f7f4844c
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_uac_bypass_pkgmgr_dism.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (ParentProcessName endswith "\\pkgmgr.exe" or ActingProcessName endswith "\\pkgmgr.exe") and TargetProcessName endswith "\\dism.exe" and (TargetProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))