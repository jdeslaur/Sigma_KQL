// Title: Suspicious IIS Module Registration
// Rule ID: 043c4b8b-3a54-4780-9682-081cb6b8185c
// Severity: high
// Tags: attack.persistence, attack.t1505.004
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_iis_susp_module_registration.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (ParentProcessName endswith "\\w3wp.exe" or ActingProcessName endswith "\\w3wp.exe") and (TargetProcessCommandLine contains "appcmd.exe add module" or (TargetProcessCommandLine contains " system.enterpriseservices.internal.publish" and TargetProcessName endswith "\\powershell.exe") or (TargetProcessCommandLine contains "gacutil" and TargetProcessCommandLine contains " /I"))