// Title: Terminal Service Process Spawn
// Rule ID: 1012f107-b8f1-4271-af30-5aed2de89b39
// Severity: high
// Tags: attack.initial-access, attack.t1190, attack.lateral-movement, attack.t1210, car.2013-07-002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_svchost_termserv_proc_spawn.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (ActingProcessCommandLine contains "\\svchost.exe" and ActingProcessCommandLine contains "termsvcs") and (not(((TargetProcessName endswith "\\rdpclip.exe" or TargetProcessName endswith ":\\Windows\\System32\\csrss.exe" or TargetProcessName endswith ":\\Windows\\System32\\wininit.exe" or TargetProcessName endswith ":\\Windows\\System32\\winlogon.exe") or isnull(TargetProcessName))))