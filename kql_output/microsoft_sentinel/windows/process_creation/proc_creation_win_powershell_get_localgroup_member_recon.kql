// Title: Suspicious Reconnaissance Activity Using Get-LocalGroupMember Cmdlet
// Rule ID: c8a180d6-47a3-4345-a609-53f9c3d834fc
// Severity: medium
// Tags: attack.discovery, attack.t1087.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_get_localgroup_member_recon.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessCommandLine contains "Get-LocalGroupMember " and (TargetProcessCommandLine contains "domain admins" or TargetProcessCommandLine contains " administrator" or TargetProcessCommandLine contains " administrateur" or TargetProcessCommandLine contains "enterprise admins" or TargetProcessCommandLine contains "Exchange Trusted Subsystem" or TargetProcessCommandLine contains "Remote Desktop Users" or TargetProcessCommandLine contains "Utilisateurs du Bureau à distance" or TargetProcessCommandLine contains "Usuarios de escritorio remoto")