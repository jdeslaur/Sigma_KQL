// Title: Obfuscated IP Via CLI
// Rule ID: 56d19cb4-6414-4769-9644-1ed35ffbb148
// Severity: medium
// Tags: attack.discovery
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_obfuscated_ip_via_cli.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "\\ping.exe" or TargetProcessName endswith "\\arp.exe") and ((TargetProcessCommandLine contains " 0x" or TargetProcessCommandLine contains "//0x" or TargetProcessCommandLine contains ".0x" or TargetProcessCommandLine contains ".00x") or (TargetProcessCommandLine contains "http://%" and TargetProcessCommandLine contains "%2e") or (TargetProcessCommandLine matches regex "https?://[0-9]{1,3}\\.[0-9]{1,3}\\.0[0-9]{3,4}" or TargetProcessCommandLine matches regex "https?://[0-9]{1,3}\\.0[0-9]{3,7}" or TargetProcessCommandLine matches regex "https?://0[0-9]{3,11}" or TargetProcessCommandLine matches regex "https?://(0[0-9]{1,11}\\.){3}0[0-9]{1,11}" or TargetProcessCommandLine matches regex "https?://0[0-9]{1,11}" or TargetProcessCommandLine matches regex " [0-7]{7,13}")) and (not(TargetProcessCommandLine matches regex "https?://((25[0-5]|(2[0-4]|1\\d|[1-9])?\\d)(\\.|\\b)){4}"))