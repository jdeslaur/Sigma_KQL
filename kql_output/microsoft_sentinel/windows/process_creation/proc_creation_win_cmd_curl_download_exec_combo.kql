imProcessCreate
| where (TargetProcessCommandLine contains " -c " or TargetProcessCommandLine contains " /c " or TargetProcessCommandLine contains " –c " or TargetProcessCommandLine contains " —c " or TargetProcessCommandLine contains " ―c ") and (TargetProcessCommandLine contains "curl " and TargetProcessCommandLine contains "http" and TargetProcessCommandLine contains "-o" and TargetProcessCommandLine contains "&")