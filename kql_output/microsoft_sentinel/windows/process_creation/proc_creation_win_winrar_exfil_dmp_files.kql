// Title: Winrar Compressing Dump Files
// Rule ID: 1ac14d38-3dfc-4635-92c7-e3fd1c5f5bfc
// Severity: medium
// Tags: attack.collection, attack.t1560.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_winrar_exfil_dmp_files.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "\\rar.exe" or TargetProcessName endswith "\\winrar.exe") or TargetProcessFileDescription =~ "Command line RAR") and (TargetProcessCommandLine contains ".dmp" or TargetProcessCommandLine contains ".dump" or TargetProcessCommandLine contains ".hdmp")