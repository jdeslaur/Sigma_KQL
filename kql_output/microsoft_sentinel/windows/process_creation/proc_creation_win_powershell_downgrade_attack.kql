// Title: Potential PowerShell Downgrade Attack
// Rule ID: b3512211-c67e-4707-bedc-66efc7848863
// Severity: medium
// Tags: attack.defense-evasion, attack.execution, attack.t1059.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_downgrade_attack.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\powershell.exe" and (TargetProcessCommandLine contains " -version 2 " or TargetProcessCommandLine contains " -versio 2 " or TargetProcessCommandLine contains " -versi 2 " or TargetProcessCommandLine contains " -vers 2 " or TargetProcessCommandLine contains " -ver 2 " or TargetProcessCommandLine contains " -ve 2 " or TargetProcessCommandLine contains " -v 2 ")