// Title: UAC Bypass Abusing Winsat Path Parsing - Process
// Rule ID: 7a01183d-71a2-46ad-ad5c-acd989ac1793
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548.002
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_uac_bypass_winsat.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288")) and (ParentProcessName endswith "\\AppData\\Local\\Temp\\system32\\winsat.exe" or ActingProcessName endswith "\\AppData\\Local\\Temp\\system32\\winsat.exe") and ActingProcessCommandLine contains "C:\\Windows \\system32\\winsat.exe"