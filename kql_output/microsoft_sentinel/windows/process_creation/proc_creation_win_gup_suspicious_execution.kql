// Title: Suspicious GUP Usage
// Rule ID: 0a4f6091-223b-41f6-8743-f322ec84930b
// Severity: high
// Tags: attack.privilege-escalation, attack.persistence, attack.defense-evasion, attack.t1574.001
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_gup_suspicious_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "\\GUP.exe" and (not(((TargetProcessName endswith "\\Program Files\\Notepad++\\updater\\GUP.exe" or TargetProcessName endswith "\\Program Files (x86)\\Notepad++\\updater\\GUP.exe") or (TargetProcessName contains "\\Users\\" and (TargetProcessName endswith "\\AppData\\Local\\Notepad++\\updater\\GUP.exe" or TargetProcessName endswith "\\AppData\\Roaming\\Notepad++\\updater\\GUP.exe")))))