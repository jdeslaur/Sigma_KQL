// Title: Uncommon File Created by Notepad++ Updater Gup.EXE
// Rule ID: 3b8f4c92-6a51-4d7e-9c3a-8e2d1f5a7b09
// Severity: high
// Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_gup_uncommon_file_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where TargetFilePath endswith "\\gup.exe" and (not(((TargetFileName startswith "C:\\Program Files\\Notepad++\\" or TargetFileName startswith "C:\\Program Files (x86)\\Notepad++\\") or (TargetFileName startswith "C:\\Users\\" and (TargetFileName contains "\\AppData\\Local\\Temp\\" and TargetFileName contains "npp." and TargetFileName contains ".Installer." and TargetFileName contains ".exe")) or (TargetFileName startswith "C:\\Users\\" and (TargetFileName contains "\\AppData\\Local\\Temp\\" and TargetFileName contains ".zip")) or TargetFileName startswith "C:\\$Recycle.Bin\\S-1-5-21")))