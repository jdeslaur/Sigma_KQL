// Title: NTDS.DIT Creation By Uncommon Process
// Rule ID: 11b1ed55-154d-4e82-8ad7-83739298f720
// Severity: high
// Tags: attack.credential-access, attack.t1003.002, attack.t1003.003
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_ntds_dit_uncommon_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where TargetFileName endswith "\\ntds.dit" and ((TargetFilePath endswith "\\cmd.exe" or TargetFilePath endswith "\\cscript.exe" or TargetFilePath endswith "\\mshta.exe" or TargetFilePath endswith "\\powershell.exe" or TargetFilePath endswith "\\pwsh.exe" or TargetFilePath endswith "\\regsvr32.exe" or TargetFilePath endswith "\\rundll32.exe" or TargetFilePath endswith "\\wscript.exe" or TargetFilePath endswith "\\wsl.exe" or TargetFilePath endswith "\\wt.exe") or (TargetFilePath contains "\\AppData\\" or TargetFilePath contains "\\Temp\\" or TargetFilePath contains "\\Public\\" or TargetFilePath contains "\\PerfLogs\\"))