// Title: Suspicious File Write to Webapps Root Directory
// Rule ID: 89c42960-f244-4dad-9151-ae9b1a3287a2
// Severity: medium
// Tags: attack.persistence, attack.t1505.003, attack.initial-access, attack.t1190
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_file_write_in_webapps_root.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where (TargetFilePath endswith "\\dotnet.exe" or TargetFilePath endswith "\\w3wp.exe" or TargetFilePath endswith "\\java.exe") and (TargetFileName contains "\\apache" or TargetFileName contains "\\tomcat") and TargetFileName contains "\\webapps\\ROOT\\" and TargetFileName endswith ".jsp"