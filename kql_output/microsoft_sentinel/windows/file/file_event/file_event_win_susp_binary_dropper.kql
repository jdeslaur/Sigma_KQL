imFileEvent
| where (TargetFilePath endswith ".exe" and TargetFileName endswith ".exe") and (not(((TargetFilePath endswith ":\\Windows\\System32\\msiexec.exe" or TargetFilePath endswith ":\\Windows\\system32\\cleanmgr.exe" or TargetFilePath endswith ":\\Windows\\explorer.exe" or TargetFilePath endswith ":\\WINDOWS\\system32\\dxgiadaptercache.exe" or TargetFilePath endswith ":\\WINDOWS\\system32\\Dism.exe" or TargetFilePath endswith ":\\Windows\\System32\\wuauclt.exe") or (TargetFilePath endswith ":\\WINDOWS\\system32\\svchost.exe" and TargetFileName contains ":\\Windows\\SoftwareDistribution\\Download\\") or (TargetFilePath endswith ":\\Windows\\system32\\svchost.exe" and (TargetFileName contains ":\\WUDownloadCache\\" and TargetFileName contains "\\WindowsUpdateBox.exe")) or (TargetFilePath contains ":\\WINDOWS\\SoftwareDistribution\\Download\\" and TargetFilePath endswith "\\WindowsUpdateBox.Exe" and TargetFileName contains ":\\$WINDOWS.~BT\\Sources\\") or (TargetFilePath contains ":\\Windows\\WinSxS\\" and TargetFilePath endswith "\\TiWorker.exe") or ((TargetFilePath contains ":\\Program Files\\" or TargetFilePath contains ":\\Program Files (x86)\\") or (TargetFileName contains ":\\Program Files\\" or TargetFileName contains ":\\Program Files (x86)\\")) or (TargetFilePath contains ":\\ProgramData\\Microsoft\\Windows Defender\\" or TargetFilePath contains ":\\Program Files\\Windows Defender\\") or TargetFileName contains "\\AppData\\Local\\Microsoft\\WindowsApps\\" or (TargetFilePath endswith "\\AppData\\Local\\Microsoft\\Teams\\Update.exe" and (TargetFileName endswith "\\AppData\\Local\\Microsoft\\Teams\\stage\\Teams.exe" or TargetFileName endswith "\\AppData\\Local\\Microsoft\\Teams\\stage\\Squirrel.exe" or TargetFileName endswith "\\AppData\\Local\\Microsoft\\SquirrelTemp\\tempb\\")) or ((TargetFilePath contains ":\\Windows\\Microsoft.NET\\Framework\\" or TargetFilePath contains ":\\Windows\\Microsoft.NET\\Framework64\\" or TargetFilePath contains ":\\Windows\\Microsoft.NET\\FrameworkArm\\" or TargetFilePath contains ":\\Windows\\Microsoft.NET\\FrameworkArm64\\") and TargetFilePath endswith "\\mscorsvw.exe" and TargetFileName contains ":\\Windows\\assembly\\NativeImages_") or (TargetFilePath contains "\\AppData\\Local\\" and TargetFilePath endswith "\\Microsoft VS Code\\Code.exe" and TargetFileName contains "\\.vscode\\extensions\\") or (TargetFilePath endswith "\\AppData\\Local\\GitHubDesktop\\Update.exe" and TargetFileName contains "\\AppData\\Local\\SquirrelTemp\\") or (TargetFilePath contains ":\\WINDOWS\\TEMP\\" or TargetFileName contains ":\\WINDOWS\\TEMP\\") or (TargetFilePath contains "\\AppData\\Local\\Temp\\" or TargetFileName contains "\\AppData\\Local\\Temp\\") or (TargetFilePath contains ":\\Windows\\Microsoft.NET\\Framework" and TargetFilePath endswith "\\mscorsvw.exe" and TargetFileName contains ":\\Windows\\assembly")))) and (not(((TargetFilePath contains "\\Python27\\python.exe" and (TargetFileName contains "\\Python27\\Lib\\site-packages\\" or TargetFileName contains "\\Python27\\Scripts\\" or TargetFileName contains "\\AppData\\Local\\Temp\\")) or (TargetFilePath contains "\\AppData\\Local\\SquirrelTemp\\Update.exe" and TargetFileName contains "\\AppData\\Local") or (TargetFilePath endswith "\\ChromeSetup.exe" and TargetFileName contains "\\Google"))))