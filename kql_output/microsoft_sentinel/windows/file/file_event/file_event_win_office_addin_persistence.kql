// Title: Potential Persistence Via Microsoft Office Add-In
// Rule ID: 8e1cb247-6cf6-42fa-b440-3f27d57e9936
// Severity: high
// Tags: attack.persistence, attack.t1137.006
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_office_addin_persistence.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where (TargetFileName contains "\\Microsoft\\Word\\Startup\\" and TargetFileName endswith ".wll") or (TargetFileName contains "\\Microsoft\\Excel\\Startup\\" and TargetFileName endswith ".xll") or (TargetFileName contains "Microsoft\\Excel\\XLSTART\\" and TargetFileName endswith ".xlam") or (TargetFileName contains "\\Microsoft\\Addins\\" and (TargetFileName endswith ".xlam" or TargetFileName endswith ".xla" or TargetFileName endswith ".ppam"))