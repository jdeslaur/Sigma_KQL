// Title: PFX File Creation
// Rule ID: dca1b3e8-e043-4ec8-85d7-867f334b5724
// Severity: low
// Tags: attack.credential-access, attack.t1552.004, detection.threat-hunting
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/file/file_event/file_event_win_pfx_file_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where TargetFileName endswith ".pfx" and (not((((TargetFilePath in~ ("C:\\Program Files\\Microsoft OneDrive\\OneDrive.exe", "C:\\Program Files (x86)\\Microsoft OneDrive\\OneDrive.exe")) and TargetFileName endswith "\\OneDrive\\CodeSigning.pfx") or (TargetFileName startswith "C:\\Program Files (x86)\\Microsoft Visual Studio\\" or TargetFileName startswith "C:\\Program Files\\Microsoft Visual Studio\\") or TargetFileName startswith "C:\\Program Files\\CMake\\")))