// Title: WebDAV Temporary Local File Creation
// Rule ID: 4c55738d-72d8-490e-a2db-7969654e375f
// Severity: medium
// Tags: attack.initial-access, attack.resource-development, attack.t1584, attack.t1566, detection.threat-hunting
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/file/file_event/file_event_win_webdav_tmpfile_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where TargetFileName contains "\\AppData\\Local\\Temp\\TfsStore\\Tfs_DAV\\" and (TargetFileName endswith ".7z" or TargetFileName endswith ".bat" or TargetFileName endswith ".dat" or TargetFileName endswith ".ico" or TargetFileName endswith ".js" or TargetFileName endswith ".lnk" or TargetFileName endswith ".ps1" or TargetFileName endswith ".rar" or TargetFileName endswith ".vbe" or TargetFileName endswith ".vbs" or TargetFileName endswith ".zip")