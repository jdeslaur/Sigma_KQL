imFileEvent
| where (TargetFileName endswith "WsmPty.xsl" or TargetFileName endswith "WsmTxt.xsl") and (not((TargetFileName startswith "C:\\Windows\\System32\\" or TargetFileName startswith "C:\\Windows\\SysWOW64\\")))