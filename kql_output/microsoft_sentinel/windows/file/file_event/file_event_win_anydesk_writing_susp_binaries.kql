imFileEvent
| where ((TargetFilePath endswith "\\AnyDesk.exe" or TargetFilePath endswith "\\AnyDeskMSI.exe") and (TargetFileName endswith ".dll" or TargetFileName endswith ".exe")) and (not(TargetFileName endswith "\\gcapi.dll"))