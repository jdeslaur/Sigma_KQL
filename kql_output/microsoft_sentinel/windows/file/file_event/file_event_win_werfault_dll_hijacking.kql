// Title: Creation of WerFault.exe/Wer.dll in Unusual Folder
// Rule ID: 28a452f3-786c-4fd8-b8f2-bddbe9d616d1
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.defense-evasion, attack.t1574.001
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_werfault_dll_hijacking.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where (TargetFileName endswith "\\WerFault.exe" or TargetFileName endswith "\\wer.dll") and (not((TargetFileName startswith "C:\\Windows\\SoftwareDistribution\\" or TargetFileName startswith "C:\\Windows\\System32\\" or TargetFileName startswith "C:\\Windows\\SysWOW64\\" or TargetFileName startswith "C:\\Windows\\WinSxS\\" or TargetFileName startswith "C:\\Windows\\UUS\\arm64\\")))