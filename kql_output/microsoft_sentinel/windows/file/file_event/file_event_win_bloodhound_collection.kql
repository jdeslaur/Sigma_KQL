// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where (TargetFileName endswith "BloodHound.zip" or TargetFileName endswith "_computers.json" or TargetFileName endswith "_containers.json" or TargetFileName endswith "_domains.json" or TargetFileName endswith "_gpos.json" or TargetFileName endswith "_groups.json" or TargetFileName endswith "_ous.json" or TargetFileName endswith "_users.json") and (not((TargetFilePath endswith "\\svchost.exe" and TargetFileName startswith "C:\\Program Files\\WindowsApps\\Microsoft." and TargetFileName endswith "\\pocket_containers.json")))