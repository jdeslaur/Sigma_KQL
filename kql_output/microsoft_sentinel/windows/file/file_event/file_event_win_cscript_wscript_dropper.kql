// Title: WScript or CScript Dropper - File
// Rule ID: 002bdb95-0cf1-46a6-9e08-d38c128a6127
// Severity: high
// Tags: attack.execution, attack.t1059.005, attack.t1059.007
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_cscript_wscript_dropper.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where (TargetFilePath endswith "\\wscript.exe" or TargetFilePath endswith "\\cscript.exe") and (TargetFileName startswith "C:\\Users\\" or TargetFileName startswith "C:\\ProgramData") and (TargetFileName endswith ".jse" or TargetFileName endswith ".vbe" or TargetFileName endswith ".js" or TargetFileName endswith ".vba" or TargetFileName endswith ".vbs")