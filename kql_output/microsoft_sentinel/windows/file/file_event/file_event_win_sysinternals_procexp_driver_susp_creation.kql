// Title: Process Explorer Driver Creation By Non-Sysinternals Binary
// Rule ID: de46c52b-0bf8-4936-a327-aace94f94ac6
// Severity: high
// Tags: attack.persistence, attack.privilege-escalation, attack.t1068
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_sysinternals_procexp_driver_susp_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where (TargetFileName contains "\\PROCEXP" and TargetFileName endswith ".sys") and (not((TargetFilePath endswith "\\procexp.exe" or TargetFilePath endswith "\\procexp64.exe")))