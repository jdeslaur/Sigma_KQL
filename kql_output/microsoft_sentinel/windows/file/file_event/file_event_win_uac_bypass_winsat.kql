imFileEvent
| where TargetFileName startswith "C:\\Users\\" and (TargetFileName endswith "\\AppData\\Local\\Temp\\system32\\winsat.exe" or TargetFileName endswith "\\AppData\\Local\\Temp\\system32\\winmm.dll")