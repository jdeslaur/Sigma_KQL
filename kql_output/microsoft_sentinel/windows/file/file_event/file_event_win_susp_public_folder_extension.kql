// Title: Suspicious Binaries and Scripts in Public Folder
// Rule ID: b447f7de-1e53-4cbf-bfb4-f1f6d0b04e4e
// Severity: high
// Tags: attack.execution, attack.t1204
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_public_folder_extension.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where TargetFileName contains ":\\Users\\Public\\" and (TargetFileName endswith ".bat" or TargetFileName endswith ".dll" or TargetFileName endswith ".exe" or TargetFileName endswith ".hta" or TargetFileName endswith ".js" or TargetFileName endswith ".ps1" or TargetFileName endswith ".vbe" or TargetFileName endswith ".vbs")