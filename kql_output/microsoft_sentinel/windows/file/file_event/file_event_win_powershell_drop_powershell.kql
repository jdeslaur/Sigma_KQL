// Title: PowerShell Script Dropped Via PowerShell.EXE
// Rule ID: 576426ad-0131-4001-ae01-be175da0c108
// Severity: low
// Tags: attack.persistence
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_powershell_drop_powershell.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where ((TargetFilePath endswith "\\powershell.exe" or TargetFilePath endswith "\\pwsh.exe") and TargetFileName endswith ".ps1") and (not((TargetFileName contains "__PSScriptPolicyTest_" or (TargetFileName startswith "C:\\Users\\" and TargetFileName contains "\\AppData\\Local\\Temp\\") or TargetFileName startswith "C:\\Windows\\Temp\\")))