// Title: Startup Folder File Write
// Rule ID: 2aa0a6b4-a865-495b-ab51-c28249537b75
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Category: file_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_startup_folder_file_write.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imFileEvent
| where TargetFileName contains "\\Microsoft\\Windows\\Start Menu\\Programs\\StartUp" and (not(((TargetFilePath in~ ("C:\\Windows\\System32\\wuauclt.exe", "C:\\Windows\\uus\\ARM64\\wuaucltcore.exe")) or (TargetFileName startswith "C:\\$WINDOWS.~BT\\NewOS\\" or TargetFileName startswith "C:\\$WinREAgent\\Scratch\\Mount\\")))) and (not((TargetFilePath endswith "\\ONENOTE.EXE" and TargetFileName endswith "\\Send to OneNote.lnk")))