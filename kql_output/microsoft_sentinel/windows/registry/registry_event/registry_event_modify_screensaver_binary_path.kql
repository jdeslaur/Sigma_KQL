// Title: Path To Screensaver Binary Modified
// Rule ID: 67a6c006-3fbe-46a7-9074-2ba3b82c3000
// Severity: medium
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.002
// Category: registry_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_event/registry_event_modify_screensaver_binary_path.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where RegistryKey endswith "\\Control Panel\\Desktop\\SCRNSAVE.EXE" and (not((ActingProcessName endswith "\\rundll32.exe" or ActingProcessName endswith "\\explorer.exe")))