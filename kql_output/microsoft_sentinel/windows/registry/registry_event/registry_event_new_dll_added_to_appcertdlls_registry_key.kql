imRegistry
| where RegistryKey in~ ("HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet001\\Control\\Session Manager\\AppCertDlls", "HKEY_LOCAL_MACHINE\\SYSTEM\\CurentControlSet\\Control\\Session Manager\\AppCertDlls")