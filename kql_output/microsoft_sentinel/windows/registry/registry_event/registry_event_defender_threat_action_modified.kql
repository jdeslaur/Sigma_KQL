// Title: Windows Defender Threat Severity Default Action Modified
// Rule ID: 5a9e1b2c-8f7d-4a1e-9b3c-0f6d7e5a4b1f
// Severity: high
// Tags: attack.defense-evasion, attack.t1562.001
// Category: registry_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_event/registry_event_defender_threat_action_modified.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where RegistryKey endswith "\\Microsoft\\Windows Defender\\Threats\\ThreatSeverityDefaultAction*" and (RegistryKey endswith "\\1" or RegistryKey endswith "\\2" or RegistryKey endswith "\\4" or RegistryKey endswith "\\5") and (RegistryValueData in~ ("DWORD (0x00000006)", "DWORD (0x00000009)"))