// Title: HybridConnectionManager Service Installation - Registry
// Rule ID: ac8866c7-ce44-46fd-8c17-b24acff96ca8
// Severity: high
// Tags: attack.resource-development, attack.t1608
// Category: registry_event
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_event/registry_event_hybridconnectionmgr_svc_installation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where RegistryKey contains "\\Services\\HybridConnectionManager" or (EventType =~ "RegistryValueSet" and RegistryValueData contains "Microsoft.HybridConnectionManager.Listener.exe")