imRegistry
| where RegistryKey contains "shellex\\ContextMenuHandlers\\EPP" and (not(((ActingProcessName startswith "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" or ActingProcessName startswith "C:\\Program Files\\Windows Defender\\" or ActingProcessName startswith "C:\\Program Files (x86)\\Windows Defender\\") and ActingProcessName endswith "\\MsMpEng.exe")))