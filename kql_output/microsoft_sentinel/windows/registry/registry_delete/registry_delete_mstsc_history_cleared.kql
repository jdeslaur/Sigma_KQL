// Title: Terminal Server Client Connection History Cleared - Registry
// Rule ID: 07bdd2f5-9c58-4f38-aec8-e101bb79ef8d
// Severity: high
// Tags: attack.persistence, attack.defense-evasion, attack.t1070, attack.t1112
// Category: registry_delete
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_delete/registry_delete_mstsc_history_cleared.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where (EventType =~ "DeleteValue" and RegistryKey contains "\\Microsoft\\Terminal Server Client\\Default\\MRU") or ((EventType in~ ("RegistryKeyDeleted", "RegistryValueDeleted")) and RegistryKey endswith "\\Microsoft\\Terminal Server Client\\Servers*")