// Title: Removal of Potential COM Hijacking Registry Keys
// Rule ID: 96f697b0-b499-4e5d-9908-a67bec11cdb6
// Severity: medium
// Tags: attack.persistence, attack.defense-evasion, attack.t1112
// Category: registry_delete
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_delete/registry_delete_removal_com_hijacking_registry_key.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where RegistryKey endswith "\\shell\\open\\command" and (not((ActingProcessName endswith "C:\\Windows\\explorer.exe" or ActingProcessName =~ "C:\\Windows\\system32\\svchost.exe" or (ActingProcessName in~ ("C:\\Windows\\System32\\msiexec.exe", "C:\\Windows\\SysWOW64\\msiexec.exe")) or (ActingProcessName startswith "C:\\Program Files\\" or ActingProcessName startswith "C:\\Program Files (x86)\\") or ActingProcessName =~ "C:\\Windows\\System32\\OpenWith.exe"))) and (not(((ActingProcessName endswith "\\Dropbox.exe" and RegistryKey contains "\\Dropbox.") or (ActingProcessName endswith "\\AppData\\Local\\Temp\\Wireshark_uninstaller.exe" and RegistryKey endswith "\\wireshark-capture-file*") or (ActingProcessName contains "peazip" and RegistryKey contains "\\PeaZip.") or (ActingProcessName endswith "\\Everything.exe" and RegistryKey contains "\\Everything.") or ActingProcessName startswith "C:\\Windows\\Installer\\MSI" or (ActingProcessName startswith "C:\\Program Files (x86)\\Java\\" and ActingProcessName endswith "\\installer.exe" and RegistryKey contains "\\Classes\\WOW6432Node\\CLSID\\{4299124F-F2C3-41b4-9C73-9236B2AD0E8F}") or ActingProcessName contains "\\Microsoft\\EdgeUpdate\\Install" or ((ActingProcessName in~ ("C:\\Program Files (x86)\\Avira\\Antivirus\\", "C:\\Program Files\\Avira\\Antivirus\\")) and (RegistryKey endswith "\\CLSID\\{305CA226-D286-468e-B848-2B2E8E697B74}\\Shell\\Open\\Command" or RegistryKey endswith "\\AntiVir.Keyfile\\shell\\open\\command")) or ((ActingProcessName contains "AppData\\Local\\Temp" and ActingProcessName contains "\\setup.exe") or (ActingProcessName contains "\\Temp\\is-" and ActingProcessName contains "\\target.tmp")) or ActingProcessName endswith "\\ninite.exe" or (ActingProcessName endswith "\\reg.exe" and RegistryKey endswith "\\Discord\\shell\\open\\command") or (ActingProcessName endswith "\\Spotify.exe" and RegistryKey endswith "\\Spotify\\shell\\open\\command") or (ActingProcessName endswith "C:\\eclipse\\eclipse.exe" and RegistryKey contains "_Classes\\eclipse+") or (ActingProcessName contains "\\Temp" and ActingProcessName contains "\\TeamViewer"))))