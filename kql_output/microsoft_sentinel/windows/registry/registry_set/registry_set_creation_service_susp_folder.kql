// Title: Service Binary in Suspicious Folder
// Rule ID: a07f0359-4c90-4dc4-a681-8ffea40b4f47
// Severity: high
// Tags: attack.persistence, attack.defense-evasion, attack.t1112
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_creation_service_susp_folder.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where ((RegistryKey =~ "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet001\\Services*" and RegistryKey endswith "\\Start" and (ActingProcessName contains "\\Users\\Public\\" or ActingProcessName contains "\\Perflogs\\" or ActingProcessName contains "\\ADMIN$\\" or ActingProcessName contains "\\Temp\\") and (RegistryValueData in~ ("DWORD (0x00000000)", "DWORD (0x00000001)", "DWORD (0x00000002)"))) or (RegistryKey =~ "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet001\\Services*" and RegistryKey endswith "\\ImagePath" and (RegistryValueData contains "\\Users\\Public\\" or RegistryValueData contains "\\Perflogs\\" or RegistryValueData contains "\\ADMIN$\\" or RegistryValueData contains "\\Temp\\"))) and (not(((ActingProcessName contains "\\Common Files\\" and ActingProcessName contains "\\Temp\\") or (RegistryKey endswith "\\CurrentControlSet\\Services\\MBAMInstallerService\\ImagePath" and RegistryValueData endswith "\\AppData\\Local\\Temp\\MBAMInstallerService.exe\"" and ActingProcessName =~ "C:\\Windows\\system32\\services.exe"))))