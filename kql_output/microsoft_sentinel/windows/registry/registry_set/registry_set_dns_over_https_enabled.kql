// Title: DNS-over-HTTPS Enabled by Registry
// Rule ID: 04b45a8a-d11d-49e4-9acc-4a1b524407a5
// Severity: medium
// Tags: attack.persistence, attack.defense-evasion, attack.t1140, attack.t1112
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_dns_over_https_enabled.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where (RegistryKey endswith "\\SOFTWARE\\Policies\\Microsoft\\Edge\\BuiltInDnsClientEnabled" and RegistryValueData =~ "DWORD (0x00000001)") or (RegistryKey endswith "\\SOFTWARE\\Google\\Chrome\\DnsOverHttpsMode" and RegistryValueData =~ "secure") or (RegistryKey endswith "\\SOFTWARE\\Policies\\Mozilla\\Firefox\\DNSOverHTTPS\\Enabled" and RegistryValueData =~ "DWORD (0x00000001)")