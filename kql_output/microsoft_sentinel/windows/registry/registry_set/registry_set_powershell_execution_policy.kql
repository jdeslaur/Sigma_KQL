// Title: Potential PowerShell Execution Policy Tampering
// Rule ID: fad91067-08c5-4d1a-8d8c-d96a21b37814
// Severity: medium
// Tags: attack.defense-evasion
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_powershell_execution_policy.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where ((RegistryKey endswith "\\ShellIds\\Microsoft.PowerShell\\ExecutionPolicy" or RegistryKey endswith "\\Policies\\Microsoft\\Windows\\PowerShell\\ExecutionPolicy") and (RegistryValueData contains "Bypass" or RegistryValueData contains "Unrestricted")) and (not((ActingProcessName contains ":\\Windows\\System32\\" or ActingProcessName contains ":\\Windows\\SysWOW64\\")))