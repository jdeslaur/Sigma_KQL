// Title: Potentially Suspicious Desktop Background Change Via Registry
// Rule ID: 85b88e05-dadc-430b-8a9e-53ff1cd30aae
// Severity: medium
// Tags: attack.persistence, attack.defense-evasion, attack.impact, attack.t1112, attack.t1491.001
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_desktop_background_change.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where (RegistryKey contains "Control Panel\\Desktop" or RegistryKey contains "CurrentVersion\\Policies\\ActiveDesktop" or RegistryKey contains "CurrentVersion\\Policies\\System") and ((RegistryKey endswith "NoChangingWallpaper" and RegistryValueData =~ "DWORD (0x00000001)") or RegistryKey endswith "\\Wallpaper" or (RegistryKey endswith "\\WallpaperStyle" and RegistryValueData =~ "2")) and (not((ActingProcessName endswith "\\svchost.exe" or (RegistryKey endswith "\\Control Panel\\Desktop\\Wallpaper" and RegistryValueData =~ "(Empty)") or ActingProcessName endswith "C:\\Windows\\Explorer.EXE"))) and (not(((ActingProcessName in~ ("C:\\Program Files\\Amazon\\EC2Launch\\EC2Launch.exe", "C:\\Program Files (x86)\\Amazon\\EC2Launch\\EC2Launch.exe")) and RegistryKey endswith "\\Control Panel\\Desktop\\Wallpaper")))