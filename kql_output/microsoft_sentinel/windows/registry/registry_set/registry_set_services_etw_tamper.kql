// Title: ETW Logging Disabled For SCM
// Rule ID: 4f281b83-0200-4b34-bf35-d24687ea57c2
// Severity: low
// Tags: attack.persistence, attack.defense-evasion, attack.t1112, attack.t1562
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_services_etw_tamper.yml
