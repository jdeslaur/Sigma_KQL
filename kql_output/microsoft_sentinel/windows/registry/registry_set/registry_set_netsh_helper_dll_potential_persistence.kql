// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where (RegistryKey contains "\\SOFTWARE\\Microsoft\\NetSh" and RegistryValueData contains ".dll") and (not((ActingProcessName =~ "C:\\Windows\\System32\\poqexec.exe" and (RegistryValueData in~ ("ipmontr.dll", "iasmontr.dll", "ippromon.dll")))))