// Title: Hiding User Account Via SpecialAccounts Registry Key
// Rule ID: f8aebc67-a56d-4ec9-9fbe-7b0e8b7b4efd
// Severity: high
// Tags: attack.defense-evasion, attack.t1564.002
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_special_accounts.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where RegistryKey contains "\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\SpecialAccounts\\UserList" and RegistryValueData =~ "DWORD (0x00000000)"