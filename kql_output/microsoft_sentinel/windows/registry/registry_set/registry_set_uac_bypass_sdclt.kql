imRegistry
| where RegistryKey endswith "Software\\Classes\\exefile\\shell\\runas\\command\\isolatedCommand" or (RegistryKey endswith "Software\\Classes\\Folder\\shell\\open\\command\\SymbolicLinkValue" and RegistryValueData matches regex "-1[0-9]{3}\\\\Software\\\\Classes\\\\")