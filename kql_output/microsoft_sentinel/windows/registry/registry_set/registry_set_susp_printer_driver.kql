// Title: Suspicious Printer Driver Empty Manufacturer
// Rule ID: e0813366-0407-449a-9869-a2db1119dc41
// Severity: high
// Tags: attack.persistence, attack.defense-evasion, attack.privilege-escalation, attack.t1574, cve.2021-1675
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_susp_printer_driver.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where ((RegistryKey contains "\\Control\\Print\\Environments\\Windows x64\\Drivers" and RegistryKey contains "\\Manufacturer") and RegistryValueData =~ "(Empty)") and (not((RegistryKey endswith "\\CutePDF Writer v4.0*" or (RegistryKey endswith "\\VNC Printer (PS)*" or RegistryKey endswith "\\VNC Printer (UD)*") or RegistryKey endswith "\\Version-3\\PDF24*")))