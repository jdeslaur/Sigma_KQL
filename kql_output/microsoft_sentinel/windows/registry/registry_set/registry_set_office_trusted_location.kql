// Title: Microsoft Office Trusted Location Updated
// Rule ID: a0bed973-45fa-4625-adb5-6ecdf9be70ac
// Severity: medium
// Tags: attack.defense-evasion, attack.persistence, attack.t1112, detection.threat-hunting
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/registry/registry_set/registry_set_office_trusted_location.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where (RegistryKey contains "Security\\Trusted Locations\\Location" and RegistryKey endswith "\\Path") and (not(((ActingProcessName contains ":\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" and ActingProcessName endswith "\\OfficeClickToRun.exe") or (ActingProcessName contains ":\\Program Files\\Microsoft Office\\" or ActingProcessName contains ":\\Program Files (x86)\\Microsoft Office\\"))))