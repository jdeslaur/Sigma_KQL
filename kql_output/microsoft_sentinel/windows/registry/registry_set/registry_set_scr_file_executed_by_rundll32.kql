// Title: ScreenSaver Registry Key Set
// Rule ID: 40b6e656-4e11-4c0c-8772-c1cc6dae34ce
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218.011
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_scr_file_executed_by_rundll32.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where ActingProcessName endswith "\\rundll32.exe" and (RegistryKey contains "\\Control Panel\\Desktop\\SCRNSAVE.EXE" and RegistryValueData endswith ".scr") and (not((RegistryValueData contains "C:\\Windows\\System32\\" or RegistryValueData contains "C:\\Windows\\SysWOW64\\")))