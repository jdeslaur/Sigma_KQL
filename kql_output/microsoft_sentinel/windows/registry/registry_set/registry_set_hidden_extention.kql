// Title: Registry Modification to Hidden File Extension
// Rule ID: 5df86130-4e95-4a54-90f7-26541b40aec2
// Severity: medium
// Tags: attack.persistence, attack.t1137
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_hidden_extention.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where (RegistryKey endswith "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\HideFileExt" and RegistryValueData =~ "DWORD (0x00000001)") or (RegistryKey endswith "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\Hidden" and RegistryValueData =~ "DWORD (0x00000002)")