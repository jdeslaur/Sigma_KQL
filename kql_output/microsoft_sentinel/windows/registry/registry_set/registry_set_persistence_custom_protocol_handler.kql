imRegistry
| where (RegistryKey =~ "HKEY_LOCAL_MACHINE\\CLASSES*" and RegistryValueData startswith "URL:") and (not((RegistryValueData startswith "URL:ms-" or (ActingProcessName startswith "C:\\Program Files (x86)" or ActingProcessName startswith "C:\\Program Files\\" or ActingProcessName startswith "C:\\Windows\\System32\\" or ActingProcessName startswith "C:\\Windows\\SysWOW64\\"))))