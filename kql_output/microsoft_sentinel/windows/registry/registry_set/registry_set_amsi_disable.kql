// Title: AMSI Disabled via Registry Modification
// Rule ID: aa37cbb0-da36-42cb-a90f-fdf216fc7467
// Severity: high
// Tags: attack.defense-evasion, attack.t1562.001, attack.t1562.006
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_amsi_disable.yml
