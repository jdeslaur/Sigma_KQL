// Title: Disabled Windows Defender Eventlog
// Rule ID: fcddca7c-b9c0-4ddf-98da-e1e2d18b0157
// Severity: high
// Tags: attack.defense-evasion, attack.t1562.001
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_disabled_microsoft_defender_eventlog.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where RegistryKey contains "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Windows Defender/Operational\\Enabled" and RegistryValueData =~ "DWORD (0x00000000)"