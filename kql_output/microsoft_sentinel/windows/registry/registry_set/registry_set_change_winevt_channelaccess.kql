// Title: Change Winevt Channel Access Permission Via Registry
// Rule ID: 7d9263bd-dc47-4a58-bc92-5474abab390c
// Severity: high
// Tags: attack.defense-evasion, attack.t1562.002
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_change_winevt_channelaccess.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where (RegistryKey endswith "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels*" and RegistryKey endswith "\\ChannelAccess" and (RegistryValueData contains "(A;;0x1;;;LA)" or RegistryValueData contains "(A;;0x1;;;SY)" or RegistryValueData contains "(A;;0x5;;;BA)")) and (not((ActingProcessName =~ "C:\\Windows\\servicing\\TrustedInstaller.exe" or (ActingProcessName startswith "C:\\Windows\\WinSxS\\" and ActingProcessName endswith "\\TiWorker.exe"))))