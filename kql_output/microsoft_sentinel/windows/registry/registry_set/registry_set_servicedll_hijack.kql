// Title: ServiceDll Hijack
// Rule ID: 612e47e9-8a59-43a6-b404-f48683f45bd6
// Severity: medium
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_servicedll_hijack.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where ((RegistryKey endswith "\\System*" and RegistryKey contains "ControlSet" and RegistryKey endswith "\\Services*") and RegistryKey endswith "\\Parameters\\ServiceDll") and (not((RegistryValueData =~ "C:\\Windows\\system32\\spool\\drivers\\x64\\3\\PrintConfig.dll" or (ActingProcessName =~ "C:\\Windows\\system32\\lsass.exe" and RegistryKey endswith "\\Services\\NTDS\\Parameters\\ServiceDll" and RegistryValueData =~ "%%systemroot%%\\system32\\ntdsa.dll") or ActingProcessName =~ "C:\\Windows\\System32\\poqexec.exe"))) and (not((ActingProcessName endswith "\\regsvr32.exe" and RegistryValueData =~ "C:\\Windows\\System32\\STAgent.dll")))