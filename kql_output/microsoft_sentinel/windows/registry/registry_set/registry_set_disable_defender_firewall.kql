// Title: Disable Microsoft Defender Firewall via Registry
// Rule ID: 974515da-6cc5-4c95-ae65-f97f9150ec7f
// Severity: medium
// Tags: attack.defense-evasion, attack.t1562.004
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_disable_defender_firewall.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imRegistry
| where RegistryKey endswith "\\Services\\SharedAccess\\Parameters\\FirewallPolicy*" and RegistryKey endswith "\\EnableFirewall" and RegistryValueData =~ "DWORD (0x00000000)"