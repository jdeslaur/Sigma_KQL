// Title: Potential COM Object Hijacking Via TreatAs Subkey - Registry
// Rule ID: 9b0f8a61-91b2-464f-aceb-0527e0a45020
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Category: registry_set
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_persistence_com_key_linking.yml
//
// Generated by sigma-to-kql converter
