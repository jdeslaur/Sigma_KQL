// Title: Potentially Suspicious Azure Front Door Connection
// Rule ID: 8cb4d14e-776e-43c2-8fb9-91e7fcea32b4
// Severity: medium
// Tags: attack.command-and-control, attack.t1102.002, attack.t1090.004, detection.threat-hunting
// Category: network_connection
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/network_connection/net_connection_win_susp_azurefd_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where DstHostname contains "azurefd.net" and (not((((SrcProcessName endswith "brave.exe" or SrcProcessName endswith "chrome.exe" or SrcProcessName endswith "chromium.exe" or SrcProcessName endswith "firefox.exe" or SrcProcessName endswith "msedge.exe" or SrcProcessName endswith "msedgewebview2.exe" or SrcProcessName endswith "opera.exe" or SrcProcessName endswith "vivaldi.exe") or (DstProcessName endswith "brave.exe" or DstProcessName endswith "chrome.exe" or DstProcessName endswith "chromium.exe" or DstProcessName endswith "firefox.exe" or DstProcessName endswith "msedge.exe" or DstProcessName endswith "msedgewebview2.exe" or DstProcessName endswith "opera.exe" or DstProcessName endswith "vivaldi.exe")) or (SrcProcessName endswith "searchapp.exe" or DstProcessName endswith "searchapp.exe") or (DstHostname contains "afdxtest.z01.azurefd.net" or DstHostname contains "fp-afd.azurefd.net" or DstHostname contains "fp-afdx-bpdee4gtg6frejfd.z01.azurefd.net" or DstHostname contains "roxy.azurefd.net" or DstHostname contains "powershellinfraartifacts-gkhedzdeaghdezhr.z01.azurefd.net" or DstHostname contains "storage-explorer-publishing-feapcgfgbzc2cjek.b01.azurefd.net" or DstHostname contains "graph.azurefd.net"))))