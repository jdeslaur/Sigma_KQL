// Title: Outbound Network Connection Initiated By Script Interpreter
// Rule ID: 992a6cae-db6a-43c8-9cec-76d7195c96fc
// Severity: high
// Tags: attack.command-and-control, attack.t1105
// Category: network_connection
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_wscript_cscript_outbound_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where (NetworkDirection =~ "true" and ((SrcProcessName endswith "\\wscript.exe" or SrcProcessName endswith "\\cscript.exe") or (DstProcessName endswith "\\wscript.exe" or DstProcessName endswith "\\cscript.exe"))) and (not(((ipv4_is_in_range(DstIpAddr, "127.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "10.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "172.16.0.0/12") or ipv4_is_in_range(DstIpAddr, "192.168.0.0/16") or ipv4_is_in_range(DstIpAddr, "169.254.0.0/16") or ipv4_is_in_range(DstIpAddr, "::1/128") or ipv4_is_in_range(DstIpAddr, "fe80::/10") or ipv4_is_in_range(DstIpAddr, "fc00::/7")) or ipv4_is_in_range(DstIpAddr, "20.0.0.0/11"))))