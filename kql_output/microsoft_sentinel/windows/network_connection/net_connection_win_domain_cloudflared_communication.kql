// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where NetworkDirection =~ "true" and (DstHostname endswith ".v2.argotunnel.com" or DstHostname endswith "protocol-v2.argotunnel.com" or DstHostname endswith "trycloudflare.com" or DstHostname endswith "update.argotunnel.com")