// Title: Local Network Connection Initiated By Script Interpreter
// Rule ID: 08249dc0-a28d-4555-8ba5-9255a198e08c
// Severity: medium
// Tags: attack.command-and-control, attack.t1105
// Category: network_connection
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_wscript_cscript_local_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where NetworkDirection =~ "true" and ((SrcProcessName endswith "\\wscript.exe" or SrcProcessName endswith "\\cscript.exe") or (DstProcessName endswith "\\wscript.exe" or DstProcessName endswith "\\cscript.exe")) and (ipv4_is_in_range(DstIpAddr, "127.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "10.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "172.16.0.0/12") or ipv4_is_in_range(DstIpAddr, "192.168.0.0/16") or ipv4_is_in_range(DstIpAddr, "169.254.0.0/16") or ipv4_is_in_range(DstIpAddr, "::1/128") or ipv4_is_in_range(DstIpAddr, "fe80::/10") or ipv4_is_in_range(DstIpAddr, "fc00::/7"))