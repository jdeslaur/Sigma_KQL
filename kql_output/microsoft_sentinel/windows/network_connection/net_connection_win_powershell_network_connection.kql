// Title: Network Connection Initiated By PowerShell Process
// Rule ID: 1f21ec3f-810d-4b0e-8045-322202e22b4b
// Severity: low
// Tags: attack.execution, attack.t1059.001, detection.threat-hunting
// Category: network_connection
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/network_connection/net_connection_win_powershell_network_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where (((SrcProcessName endswith "\\powershell.exe" or SrcProcessName endswith "\\pwsh.exe") or (DstProcessName endswith "\\powershell.exe" or DstProcessName endswith "\\pwsh.exe")) and NetworkDirection =~ "true") and (not((((ipv4_is_in_range(DstIpAddr, "127.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "10.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "169.254.0.0/16") or ipv4_is_in_range(DstIpAddr, "172.16.0.0/12") or ipv4_is_in_range(DstIpAddr, "192.168.0.0/16") or ipv4_is_in_range(DstIpAddr, "::1/128") or ipv4_is_in_range(DstIpAddr, "fe80::/10") or ipv4_is_in_range(DstIpAddr, "fc00::/7")) and ((SrcUsername contains "AUTHORI" or SrcUsername contains "AUTORI") or (DstUsername contains "AUTHORI" or DstUsername contains "AUTORI"))) or (ipv4_is_in_range(DstIpAddr, "20.184.0.0/13") or ipv4_is_in_range(DstIpAddr, "51.103.210.0/23")))))