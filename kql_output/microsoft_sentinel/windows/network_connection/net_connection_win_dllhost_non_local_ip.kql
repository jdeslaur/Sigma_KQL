// Title: Dllhost.EXE Initiated Network Connection To Non-Local IP Address
// Rule ID: cfed2f44-16df-4bf3-833a-79405198b277
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218, attack.execution, attack.t1559.001, detection.threat-hunting
// Category: network_connection
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/network_connection/net_connection_win_dllhost_non_local_ip.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where ((SrcProcessName endswith "\\dllhost.exe" or DstProcessName endswith "\\dllhost.exe") and NetworkDirection =~ "true") and (not(((ipv4_is_in_range(DstIpAddr, "::1/128") or ipv4_is_in_range(DstIpAddr, "10.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "127.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "172.16.0.0/12") or ipv4_is_in_range(DstIpAddr, "192.168.0.0/16") or ipv4_is_in_range(DstIpAddr, "169.254.0.0/16") or ipv4_is_in_range(DstIpAddr, "fc00::/7") or ipv4_is_in_range(DstIpAddr, "fe80::/10")) or (ipv4_is_in_range(DstIpAddr, "20.184.0.0/13") or ipv4_is_in_range(DstIpAddr, "20.192.0.0/10") or ipv4_is_in_range(DstIpAddr, "23.72.0.0/13") or ipv4_is_in_range(DstIpAddr, "51.10.0.0/15") or ipv4_is_in_range(DstIpAddr, "51.103.0.0/16") or ipv4_is_in_range(DstIpAddr, "51.104.0.0/15") or ipv4_is_in_range(DstIpAddr, "52.224.0.0/11") or ipv4_is_in_range(DstIpAddr, "150.171.0.0/19") or ipv4_is_in_range(DstIpAddr, "204.79.197.0/24")))))