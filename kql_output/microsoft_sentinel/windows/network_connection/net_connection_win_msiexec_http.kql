// Title: Msiexec.EXE Initiated Network Connection Over HTTP
// Rule ID: 8e5e38e4-5350-4c0b-895a-e872ce0dd54f
// Severity: low
// Tags: attack.defense-evasion, attack.t1218.007, detection.threat-hunting
// Category: network_connection
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/network_connection/net_connection_win_msiexec_http.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where NetworkDirection =~ "true" and (SrcProcessName endswith "\\msiexec.exe" or DstProcessName endswith "\\msiexec.exe") and (DstPortNumber in~ ("80", "443"))