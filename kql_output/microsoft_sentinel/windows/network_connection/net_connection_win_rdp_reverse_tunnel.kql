// Title: RDP Over Reverse SSH Tunnel
// Rule ID: 5f699bc5-5446-4a4a-a0b7-5ef2885a3eb4
// Severity: high
// Tags: attack.command-and-control, attack.t1572, attack.lateral-movement, attack.t1021.001, car.2013-07-002
// Category: network_connection
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_rdp_reverse_tunnel.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where ((SrcProcessName endswith "\\svchost.exe" or DstProcessName endswith "\\svchost.exe") and NetworkDirection =~ "true" and SrcPortNumber == 3389) and (ipv4_is_in_range(DstIpAddr, "127.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "::1/128"))