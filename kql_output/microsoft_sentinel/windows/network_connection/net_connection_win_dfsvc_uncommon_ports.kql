// Title: Dfsvc.EXE Initiated Network Connection Over Uncommon Port
// Rule ID: 4c5fba4a-9ef6-4f16-823d-606246054741
// Severity: high
// Tags: attack.execution, attack.t1203, detection.threat-hunting
// Category: network_connection
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/network_connection/net_connection_win_dfsvc_uncommon_ports.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where ((SrcProcessName contains ":\\Windows\\Microsoft.NET\\" or DstProcessName contains ":\\Windows\\Microsoft.NET\\") and (SrcProcessName endswith "\\dfsvc.exe" or DstProcessName endswith "\\dfsvc.exe") and NetworkDirection =~ "true") and (not((DstPortNumber in~ ("80", "443")))) and (not((NetworkProtocolVersion =~ "true" and DstPortNumber == 53)))