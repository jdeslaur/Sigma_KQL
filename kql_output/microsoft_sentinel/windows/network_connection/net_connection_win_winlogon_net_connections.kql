// Title: Outbound Network Connection To Public IP Via Winlogon
// Rule ID: 7610a4ea-c06d-495f-a2ac-0a696abcfd3b
// Severity: medium
// Tags: attack.defense-evasion, attack.execution, attack.command-and-control, attack.t1218.011
// Category: network_connection
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_winlogon_net_connections.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imNetworkSession
| where ((SrcProcessName endswith "\\winlogon.exe" or DstProcessName endswith "\\winlogon.exe") and NetworkDirection =~ "true") and (not((ipv4_is_in_range(DstIpAddr, "127.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "10.0.0.0/8") or ipv4_is_in_range(DstIpAddr, "172.16.0.0/12") or ipv4_is_in_range(DstIpAddr, "192.168.0.0/16") or ipv4_is_in_range(DstIpAddr, "169.254.0.0/16") or ipv4_is_in_range(DstIpAddr, "::1/128") or ipv4_is_in_range(DstIpAddr, "fe80::/10") or ipv4_is_in_range(DstIpAddr, "fc00::/7"))))