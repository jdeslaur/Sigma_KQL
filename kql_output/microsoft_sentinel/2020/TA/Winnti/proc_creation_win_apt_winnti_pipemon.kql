imProcessCreate
| where TargetProcessCommandLine contains "setup0.exe -p" or (TargetProcessCommandLine contains "setup.exe" and (TargetProcessCommandLine endswith "-x:0" or TargetProcessCommandLine endswith "-x:1" or TargetProcessCommandLine endswith "-x:2"))