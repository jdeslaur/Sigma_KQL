imProcessCreate
| where (((ParentProcessName contains "C:\\Windows\\Temp" or ParentProcessName contains "\\hpqhvind.exe") or (ActingProcessName contains "C:\\Windows\\Temp" or ActingProcessName contains "\\hpqhvind.exe")) and TargetProcessName startswith "C:\\ProgramData\\DRM") or ((ParentProcessName startswith "C:\\ProgramData\\DRM" or ActingProcessName startswith "C:\\ProgramData\\DRM") and TargetProcessName endswith "\\wmplayer.exe") or ((ParentProcessName endswith "\\Test.exe" or ActingProcessName endswith "\\Test.exe") and TargetProcessName endswith "\\wmplayer.exe") or TargetProcessName =~ "C:\\ProgramData\\DRM\\CLR\\CLR.exe" or ((ParentProcessName startswith "C:\\ProgramData\\DRM\\Windows" or ActingProcessName startswith "C:\\ProgramData\\DRM\\Windows") and TargetProcessName endswith "\\SearchFilterHost.exe")