imProcessCreate
| where (TargetProcessName endswith ":\\ProgramData\\adobe\\Adobe.exe" or TargetProcessName endswith ":\\ProgramData\\oracle\\local.exe" or TargetProcessName endswith "\\revshell.exe" or TargetProcessName endswith "\\infopagesbackup\\ncat.exe" or TargetProcessName endswith ":\\ProgramData\\comms\\comms.exe") or (TargetProcessCommandLine contains "-ExecutionPolicy Bypass -File" and TargetProcessCommandLine contains "\\msf.ps1") or (TargetProcessCommandLine contains "infopagesbackup" and TargetProcessCommandLine contains "\\ncat" and TargetProcessCommandLine contains "-e cmd.exe") or (TargetProcessCommandLine contains "system.Data.SqlClient.SqlDataAdapter($cmd); [void]$da.fill" or TargetProcessCommandLine contains "-nop -w hidden -c $k=new-object" or TargetProcessCommandLine contains "[Net.CredentialCache]::DefaultCredentials;IEX " or TargetProcessCommandLine contains " -nop -w hidden -c $m=new-object net.webclient;$m" or TargetProcessCommandLine contains "-noninteractive -executionpolicy bypass whoami" or TargetProcessCommandLine contains "-noninteractive -executionpolicy bypass netstat -a") or TargetProcessCommandLine contains "L3NlcnZlcj1"