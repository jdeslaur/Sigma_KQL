// Title: Lazarus Group Activity
// Rule ID: 24c4d154-05a4-4b99-b57d-9b977472443a
// Severity: critical
// Tags: attack.g0032, attack.execution, attack.t1059, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2020/TA/Lazarus/proc_creation_win_apt_lazarus_group_activity.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessCommandLine contains "reg.exe save hklm\\sam %temp%\\~reg_sam.save" or TargetProcessCommandLine contains "1q2w3e4r@#$@#$@#$" or TargetProcessCommandLine contains " -hp1q2w3e4 " or TargetProcessCommandLine contains ".dat data03 10000 -p ") or (TargetProcessCommandLine contains "netstat -aon | find " and TargetProcessCommandLine contains "ESTA" and TargetProcessCommandLine contains " > %temp%\\~") or (TargetProcessCommandLine contains ".255 10 C:\\ProgramData\\IBM\\" and TargetProcessCommandLine contains ".DAT") or ((TargetProcessCommandLine contains " /c " and TargetProcessCommandLine contains " -p 0x") and (TargetProcessCommandLine contains "C:\\ProgramData\\" or TargetProcessCommandLine contains "C:\\RECYCLER\\")) or ((TargetProcessCommandLine contains "rundll32 " and TargetProcessCommandLine contains "C:\\ProgramData\\") and (TargetProcessCommandLine contains ".bin," or TargetProcessCommandLine contains ".tmp," or TargetProcessCommandLine contains ".dat," or TargetProcessCommandLine contains ".io," or TargetProcessCommandLine contains ".ini," or TargetProcessCommandLine contains ".db,"))