imProcessCreate
| where (TargetProcessCommandLine contains "Execute" and TargetProcessCommandLine contains "CreateObject" and TargetProcessCommandLine contains "RegRead" and TargetProcessCommandLine contains "window.close" and TargetProcessCommandLine contains "\\Microsoft\\Windows\\CurrentVersion") and (not(TargetProcessCommandLine contains "\\Software\\Microsoft\\Windows\\CurrentVersion\\Run"))