// Title: UNC2452 Process Creation Patterns
// Rule ID: 9be34ad0-b6a7-4fbd-91cf-fc7ec1047f5f
// Severity: high
// Tags: attack.execution, attack.t1059.001, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2020/TA/SolarWinds-Supply-Chain/proc_creation_win_apt_unc2452_cmds.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessCommandLine contains "7z.exe a -v500m -mx9 -r0 -p" or TargetProcessCommandLine contains "7z.exe a -mx9 -r0 -p") and (TargetProcessCommandLine contains ".zip" and TargetProcessCommandLine contains ".txt")) or ((TargetProcessCommandLine contains "7z.exe a -v500m -mx9 -r0 -p" or TargetProcessCommandLine contains "7z.exe a -mx9 -r0 -p") and (TargetProcessCommandLine contains ".zip" and TargetProcessCommandLine contains ".log")) or ((ActingProcessCommandLine contains "wscript.exe" and ActingProcessCommandLine contains ".vbs") and (TargetProcessCommandLine contains "rundll32.exe" and TargetProcessCommandLine contains "C:\\Windows" and TargetProcessCommandLine contains ".dll,Tk_")) or ((ParentProcessName endswith "\\rundll32.exe" or ActingProcessName endswith "\\rundll32.exe") and (ActingProcessCommandLine contains "C:\\Windows" and ActingProcessCommandLine contains ".dll") and TargetProcessCommandLine contains "cmd.exe /C ") or ((ParentProcessName endswith "\\rundll32.exe" or ActingProcessName endswith "\\rundll32.exe") and TargetProcessName endswith "\\dllhost.exe" and TargetProcessCommandLine =~ "")