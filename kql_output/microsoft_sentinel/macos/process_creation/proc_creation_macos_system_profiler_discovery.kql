// Title: System Information Discovery Using System_Profiler
// Rule ID: 4809c683-059b-4935-879d-36835986f8cf
// Severity: medium
// Tags: attack.discovery, attack.defense-evasion, attack.t1082, attack.t1497.001
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_system_profiler_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "/system_profiler" or TargetProcessCommandLine contains "system_profiler") and (TargetProcessCommandLine contains "SPApplicationsDataType" or TargetProcessCommandLine contains "SPHardwareDataType" or TargetProcessCommandLine contains "SPNetworkDataType" or TargetProcessCommandLine contains "SPUSBDataType")