// Title: Local System Accounts Discovery - MacOs
// Rule ID: ddf36b67-e872-4507-ab2e-46bda21b842c
// Severity: low
// Tags: attack.discovery, attack.t1087.001
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_local_account.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "/dscl" and (TargetProcessCommandLine contains "list" and TargetProcessCommandLine contains "/users")) or (TargetProcessName endswith "/dscacheutil" and (TargetProcessCommandLine contains "-q" and TargetProcessCommandLine contains "user")) or TargetProcessCommandLine contains "'x:0:'" or (TargetProcessName endswith "/cat" and (TargetProcessCommandLine contains "/etc/passwd" or TargetProcessCommandLine contains "/etc/sudoers")) or TargetProcessName endswith "/id" or (TargetProcessName endswith "/lsof" and TargetProcessCommandLine contains "-u")