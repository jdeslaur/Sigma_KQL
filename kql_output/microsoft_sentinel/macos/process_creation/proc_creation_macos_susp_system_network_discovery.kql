// Title: System Network Discovery - macOS
// Rule ID: 58800443-f9fc-4d55-ae0c-98a3966dfb97
// Severity: informational
// Tags: attack.discovery, attack.t1016
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_susp_system_network_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "/arp" or TargetProcessName endswith "/ifconfig" or TargetProcessName endswith "/netstat" or TargetProcessName endswith "/networksetup" or TargetProcessName endswith "/socketfilterfw") or (TargetProcessName =~ "/usr/bin/defaults" and (TargetProcessCommandLine contains "/Library/Preferences/com.apple.alf" and TargetProcessCommandLine contains "read"))) and (not((ParentProcessName endswith "/wifivelocityd" or ActingProcessName endswith "/wifivelocityd")))