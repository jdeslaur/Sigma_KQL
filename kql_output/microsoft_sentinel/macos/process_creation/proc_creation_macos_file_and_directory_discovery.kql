// Title: File and Directory Discovery - MacOS
// Rule ID: 089dbdf6-b960-4bcc-90e3-ffc3480c20f6
// Severity: informational
// Tags: attack.discovery, attack.t1083
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_file_and_directory_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName =~ "/usr/bin/file" and TargetProcessCommandLine matches regex "(.){200,}") or (TargetProcessName =~ "/bin/ls" and TargetProcessCommandLine contains "-R") or TargetProcessName =~ "/usr/bin/find" or TargetProcessName =~ "/usr/bin/mdfind" or TargetProcessName =~ "/tree"