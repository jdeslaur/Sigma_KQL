imProcessCreate
| where (TargetProcessCommandLine contains "osascript" and TargetProcessCommandLine contains " -e " and TargetProcessCommandLine contains "eval" and TargetProcessCommandLine contains "NSData.dataWithContentsOfURL") and ((TargetProcessCommandLine contains " -l " and TargetProcessCommandLine contains "JavaScript") or TargetProcessCommandLine contains ".js")