imProcessCreate
| where TargetProcessName endswith "/touch" and (TargetProcessCommandLine contains "-t" or TargetProcessCommandLine contains "-acmr" or TargetProcessCommandLine contains "-d" or TargetProcessCommandLine contains "-r")