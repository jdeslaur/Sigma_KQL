// Title: Credentials from Password Stores - Keychain
// Rule ID: b120b587-a4c2-4b94-875d-99c9807d6955
// Severity: medium
// Tags: attack.credential-access, attack.t1555.001
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_creds_from_keychain.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName =~ "/usr/bin/security" and (TargetProcessCommandLine contains "find-certificate" or TargetProcessCommandLine contains " export ")) or (TargetProcessCommandLine contains " dump-keychain " or TargetProcessCommandLine contains " login-keychain ")