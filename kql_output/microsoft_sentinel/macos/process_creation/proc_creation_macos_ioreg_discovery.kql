// Title: System Information Discovery Using Ioreg
// Rule ID: 2d5e7a8b-f484-4a24-945d-7f0efd52eab0
// Severity: medium
// Tags: attack.discovery, attack.t1082
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_ioreg_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "/ioreg" or TargetProcessCommandLine contains "ioreg") and (TargetProcessCommandLine contains "-l" or TargetProcessCommandLine contains "-c") and (TargetProcessCommandLine contains "AppleAHCIDiskDriver" or TargetProcessCommandLine contains "IOPlatformExpertDevice" or TargetProcessCommandLine contains "Oracle" or TargetProcessCommandLine contains "Parallels" or TargetProcessCommandLine contains "USB Vendor Name" or TargetProcessCommandLine contains "VirtualBox" or TargetProcessCommandLine contains "VMware")