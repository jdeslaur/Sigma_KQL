// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "/nscurl" and (TargetProcessCommandLine contains "--download " or TargetProcessCommandLine contains "--download-directory " or TargetProcessCommandLine contains "--output " or TargetProcessCommandLine contains "-dir " or TargetProcessCommandLine contains "-dl " or TargetProcessCommandLine contains "-ld" or TargetProcessCommandLine contains "-o ")