// Title: Suspicious MacOS Firmware Activity
// Rule ID: 7ed2c9f7-c59d-4c82-a7e2-f859aa676099
// Severity: medium
// Tags: attack.impact
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_susp_macos_firmware_activity.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName =~ "/usr/sbin/firmwarepasswd" and (TargetProcessCommandLine contains "setpasswd" or TargetProcessCommandLine contains "full" or TargetProcessCommandLine contains "delete" or TargetProcessCommandLine contains "check")