imProcessCreate
| where (TargetProcessName endswith "/truncate" and TargetProcessCommandLine contains "-s +") or (TargetProcessName endswith "/dd" and (TargetProcessCommandLine contains "if=/dev/zero" or TargetProcessCommandLine contains "if=/dev/random" or TargetProcessCommandLine contains "if=/dev/urandom"))