imProcessCreate
| where ((TargetProcessName endswith "/nc" or TargetProcessName endswith "/netcat") and (not(TargetProcessCommandLine contains "l"))) or (TargetProcessName endswith "/nmap" or TargetProcessName endswith "/telnet")