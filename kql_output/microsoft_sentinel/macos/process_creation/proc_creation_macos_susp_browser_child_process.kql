// Title: Suspicious Browser Child Process - MacOS
// Rule ID: 0250638a-2b28-4541-86fc-ea4c558fa0c6
// Severity: medium
// Tags: attack.initial-access, attack.execution, attack.t1189, attack.t1203, attack.t1059
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_susp_browser_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (((ParentProcessName contains "com.apple.WebKit.WebContent" or ParentProcessName contains "firefox" or ParentProcessName contains "Google Chrome Helper" or ParentProcessName contains "Google Chrome" or ParentProcessName contains "Microsoft Edge" or ParentProcessName contains "Opera" or ParentProcessName contains "Safari" or ParentProcessName contains "Tor Browser") or (ActingProcessName contains "com.apple.WebKit.WebContent" or ActingProcessName contains "firefox" or ActingProcessName contains "Google Chrome Helper" or ActingProcessName contains "Google Chrome" or ActingProcessName contains "Microsoft Edge" or ActingProcessName contains "Opera" or ActingProcessName contains "Safari" or ActingProcessName contains "Tor Browser")) and (TargetProcessName endswith "/bash" or TargetProcessName endswith "/curl" or TargetProcessName endswith "/dash" or TargetProcessName endswith "/ksh" or TargetProcessName endswith "/osascript" or TargetProcessName endswith "/perl" or TargetProcessName endswith "/php" or TargetProcessName endswith "/pwsh" or TargetProcessName endswith "/python" or TargetProcessName endswith "/sh" or TargetProcessName endswith "/tcsh" or TargetProcessName endswith "/wget" or TargetProcessName endswith "/zsh")) and (not((TargetProcessCommandLine contains "--defaults-torrc" or TargetProcessCommandLine matches regex ".*/Library/Application Support/Microsoft/MAU.*/Microsoft AutoUpdate\\.app/Contents/MacOS/msupdate.*" or (((ParentProcessName contains "Google Chrome Helper" or ParentProcessName contains "Google Chrome") or (ActingProcessName contains "Google Chrome Helper" or ActingProcessName contains "Google Chrome")) and ((TargetProcessCommandLine contains "/Volumes/Google Chrome/Google Chrome.app/Contents/Frameworks/" and TargetProcessCommandLine contains "/Resources/install.sh") or (TargetProcessCommandLine contains "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/" and TargetProcessCommandLine contains "/Resources/keystone_promote_preflight.sh") or (TargetProcessCommandLine contains "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/" and TargetProcessCommandLine contains "/Resources/keystone_promote_postflight.sh"))) or ((ParentProcessName contains "Microsoft Edge" or ActingProcessName contains "Microsoft Edge") and (TargetProcessCommandLine contains "IOPlatformExpertDevice" or TargetProcessCommandLine contains "hw.model")) or (((ParentProcessName contains "Google Chrome Helper" or ParentProcessName contains "Google Chrome") or (ActingProcessName contains "Google Chrome Helper" or ActingProcessName contains "Google Chrome")) and (TargetProcessCommandLine contains "/Users/" and TargetProcessCommandLine contains "/Library/Application Support/Google/Chrome/recovery/" and TargetProcessCommandLine contains "/ChromeRecovery"))))) and (not((isnull(TargetProcessCommandLine) or TargetProcessCommandLine =~ "")))