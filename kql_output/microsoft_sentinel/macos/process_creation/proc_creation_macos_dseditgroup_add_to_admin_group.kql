// Title: User Added To Admin Group Via DseditGroup
// Rule ID: 5d0fdb62-f225-42fb-8402-3dfe64da468a
// Severity: medium
// Tags: attack.persistence, attack.defense-evasion, attack.initial-access, attack.privilege-escalation, attack.t1078.003
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_dseditgroup_add_to_admin_group.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "/dseditgroup" and (TargetProcessCommandLine contains " -o edit " and TargetProcessCommandLine contains " -a " and TargetProcessCommandLine contains " -t user" and TargetProcessCommandLine contains "admin")