// Title: Hidden User Creation
// Rule ID: b22a5b36-2431-493a-8be1-0bae56c28ef3
// Severity: medium
// Tags: attack.defense-evasion, attack.t1564.002
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_create_hidden_account.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName endswith "/dscl" and TargetProcessCommandLine contains "create") and (TargetProcessCommandLine contains "UniqueID" and TargetProcessCommandLine matches regex "([0-9]|[1-9][0-9]|[1-4][0-9]{2})")) or ((TargetProcessName endswith "/dscl" and TargetProcessCommandLine contains "create") and (TargetProcessCommandLine contains "IsHidden" and (TargetProcessCommandLine contains "true" or TargetProcessCommandLine contains "yes" or TargetProcessCommandLine contains "1")))