// Title: Local Groups Discovery - MacOs
// Rule ID: 89bb1f97-c7b9-40e8-b52b-7d6afbd67276
// Severity: informational
// Tags: attack.discovery, attack.t1069.001
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_local_groups.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "/dscacheutil" and (TargetProcessCommandLine contains "-q" and TargetProcessCommandLine contains "group")) or (TargetProcessName endswith "/cat" and TargetProcessCommandLine contains "/etc/group") or (TargetProcessName endswith "/dscl" and (TargetProcessCommandLine contains "-list" and TargetProcessCommandLine contains "/groups"))