// Title: System Information Discovery Via Sysctl - MacOS
// Rule ID: 6ff08e55-ea53-4f27-94a1-eff92e6d9d5c
// Severity: medium
// Tags: attack.defense-evasion, attack.t1497.001, attack.discovery, attack.t1082
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_sysctl_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "/sysctl" or TargetProcessCommandLine contains "sysctl") and (TargetProcessCommandLine contains "hw." or TargetProcessCommandLine contains "kern." or TargetProcessCommandLine contains "machdep.")