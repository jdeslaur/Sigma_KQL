// Title: Guest Account Enabled Via Sysadminctl
// Rule ID: d7329412-13bd-44ba-a072-3387f804a106
// Severity: low
// Tags: attack.privilege-escalation, attack.persistence, attack.defense-evasion, attack.initial-access, attack.t1078, attack.t1078.001
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_sysadminctl_enable_guest_account.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "/sysadminctl" and (TargetProcessCommandLine contains " -guestAccount" and TargetProcessCommandLine contains " on")