// Title: GUI Input Capture - macOS
// Rule ID: 60f1ce20-484e-41bd-85f4-ac4afec2c541
// Severity: low
// Tags: attack.collection, attack.credential-access, attack.t1056.002
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_gui_input_capture.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "/osascript" and (TargetProcessCommandLine contains "-e" and TargetProcessCommandLine contains "display" and TargetProcessCommandLine contains "dialog" and TargetProcessCommandLine contains "answer") and (TargetProcessCommandLine contains "admin" or TargetProcessCommandLine contains "administrator" or TargetProcessCommandLine contains "authenticate" or TargetProcessCommandLine contains "authentication" or TargetProcessCommandLine contains "credentials" or TargetProcessCommandLine contains "pass" or TargetProcessCommandLine contains "password" or TargetProcessCommandLine contains "unlock")