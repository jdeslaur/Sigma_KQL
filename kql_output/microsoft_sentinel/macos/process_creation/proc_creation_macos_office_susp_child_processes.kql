// Title: Suspicious Microsoft Office Child Process - MacOS
// Rule ID: 69483748-1525-4a6c-95ca-90dc8d431b68
// Severity: high
// Tags: attack.execution, attack.persistence, attack.t1059.002, attack.t1137.002, attack.t1204.002
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_office_susp_child_processes.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName contains "Microsoft Word" or ParentProcessName contains "Microsoft Excel" or ParentProcessName contains "Microsoft PowerPoint" or ParentProcessName contains "Microsoft OneNote") or (ActingProcessName contains "Microsoft Word" or ActingProcessName contains "Microsoft Excel" or ActingProcessName contains "Microsoft PowerPoint" or ActingProcessName contains "Microsoft OneNote")) and (TargetProcessName endswith "/bash" or TargetProcessName endswith "/curl" or TargetProcessName endswith "/dash" or TargetProcessName endswith "/fish" or TargetProcessName endswith "/osacompile" or TargetProcessName endswith "/osascript" or TargetProcessName endswith "/sh" or TargetProcessName endswith "/zsh" or TargetProcessName endswith "/python" or TargetProcessName endswith "/python3" or TargetProcessName endswith "/wget")