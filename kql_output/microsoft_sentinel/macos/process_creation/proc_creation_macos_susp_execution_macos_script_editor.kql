// Title: Suspicious Execution via macOS Script Editor
// Rule ID: 6e4dcdd1-e48b-42f7-b2d8-3b413fc58cb4
// Severity: medium
// Tags: attack.t1566, attack.t1566.002, attack.initial-access, attack.t1059, attack.t1059.002, attack.t1204, attack.t1204.001, attack.execution, attack.persistence, attack.t1553, attack.defense-evasion
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_susp_execution_macos_script_editor.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (ParentProcessName endswith "/Script Editor" or ActingProcessName endswith "/Script Editor") and ((TargetProcessName endswith "/curl" or TargetProcessName endswith "/bash" or TargetProcessName endswith "/sh" or TargetProcessName endswith "/zsh" or TargetProcessName endswith "/dash" or TargetProcessName endswith "/fish" or TargetProcessName endswith "/osascript" or TargetProcessName endswith "/mktemp" or TargetProcessName endswith "/chmod" or TargetProcessName endswith "/php" or TargetProcessName endswith "/nohup" or TargetProcessName endswith "/openssl" or TargetProcessName endswith "/plutil" or TargetProcessName endswith "/PlistBuddy" or TargetProcessName endswith "/xattr" or TargetProcessName endswith "/sqlite" or TargetProcessName endswith "/funzip" or TargetProcessName endswith "/popen") or (TargetProcessName contains "python" or TargetProcessName contains "perl"))