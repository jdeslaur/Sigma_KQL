// Title: Indicator Removal on Host - Clear Mac System Logs
// Rule ID: acf61bd8-d814-4272-81f0-a7a269aa69aa
// Severity: medium
// Tags: attack.defense-evasion, attack.t1070.002
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_clear_system_logs.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where (TargetProcessName endswith "/rm" or TargetProcessName endswith "/unlink" or TargetProcessName endswith "/shred") and (TargetProcessCommandLine contains "/var/log" or (TargetProcessCommandLine contains "/Users/" and TargetProcessCommandLine contains "/Library/Logs/"))