// Title: JAMF MDM Execution
// Rule ID: be2e3a5c-9cc7-4d02-842a-68e9cb26ec49
// Severity: low
// Tags: attack.execution
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_jamf_usage.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "/jamf" and (TargetProcessCommandLine contains "createAccount" or TargetProcessCommandLine contains "manage" or TargetProcessCommandLine contains "removeFramework" or TargetProcessCommandLine contains "removeMdmProfile" or TargetProcessCommandLine contains "resetPassword" or TargetProcessCommandLine contains "setComputerName")