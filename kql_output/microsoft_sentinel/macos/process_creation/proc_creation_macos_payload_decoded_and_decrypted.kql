imProcessCreate
| where TargetProcessName endswith "/openssl" and (TargetProcessCommandLine contains "/Volumes/" and TargetProcessCommandLine contains "enc" and TargetProcessCommandLine contains "-base64" and TargetProcessCommandLine contains " -d ")