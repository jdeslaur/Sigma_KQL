// Title: Disable Security Tools
// Rule ID: ff39f1a6-84ac-476f-a1af-37fcdf53d7c0
// Severity: medium
// Tags: attack.defense-evasion, attack.t1562.001
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_disable_security_tools.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((TargetProcessName =~ "/bin/launchctl" and TargetProcessCommandLine contains "unload") and (TargetProcessCommandLine contains "com.objective-see.lulu.plist" or TargetProcessCommandLine contains "com.objective-see.blockblock.plist" or TargetProcessCommandLine contains "com.google.santad.plist" or TargetProcessCommandLine contains "com.carbonblack.defense.daemon.plist" or TargetProcessCommandLine contains "com.carbonblack.daemon.plist" or TargetProcessCommandLine contains "at.obdev.littlesnitchd.plist" or TargetProcessCommandLine contains "com.tenablesecurity.nessusagent.plist" or TargetProcessCommandLine contains "com.opendns.osx.RoamingClientConfigUpdater.plist" or TargetProcessCommandLine contains "com.crowdstrike.falcond.plist" or TargetProcessCommandLine contains "com.crowdstrike.userdaemon.plist" or TargetProcessCommandLine contains "osquery" or TargetProcessCommandLine contains "filebeat" or TargetProcessCommandLine contains "auditbeat" or TargetProcessCommandLine contains "packetbeat" or TargetProcessCommandLine contains "td-agent")) or (TargetProcessName =~ "/usr/sbin/spctl" and TargetProcessCommandLine contains "disable")