// Title: Potential Base64 Decoded From Images
// Rule ID: 09a910bf-f71f-4737-9c40-88880ba5913d
// Severity: high
// Tags: attack.defense-evasion, attack.t1140
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_tail_base64_decode_from_image.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where TargetProcessName endswith "/bash" and (TargetProcessCommandLine contains "tail" and TargetProcessCommandLine contains "-c") and (TargetProcessCommandLine contains "base64" and TargetProcessCommandLine contains "-d" and TargetProcessCommandLine contains ">") and (TargetProcessCommandLine contains ".avif" or TargetProcessCommandLine contains ".gif" or TargetProcessCommandLine contains ".jfif" or TargetProcessCommandLine contains ".jpeg" or TargetProcessCommandLine contains ".jpg" or TargetProcessCommandLine contains ".pjp" or TargetProcessCommandLine contains ".pjpeg" or TargetProcessCommandLine contains ".png" or TargetProcessCommandLine contains ".svg" or TargetProcessCommandLine contains ".webp")