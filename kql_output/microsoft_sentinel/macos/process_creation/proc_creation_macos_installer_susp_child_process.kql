// Title: Suspicious Installer Package Child Process
// Rule ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
// Severity: medium
// Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
// Category: process_creation
// Product: macos
// Pipeline: microsoft_sentinel
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_installer_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

imProcessCreate
| where ((ParentProcessName endswith "/package_script_service" or ParentProcessName endswith "/installer") or (ActingProcessName endswith "/package_script_service" or ActingProcessName endswith "/installer")) and (TargetProcessName endswith "/sh" or TargetProcessName endswith "/bash" or TargetProcessName endswith "/dash" or TargetProcessName endswith "/python" or TargetProcessName endswith "/ruby" or TargetProcessName endswith "/perl" or TargetProcessName endswith "/php" or TargetProcessName endswith "/javascript" or TargetProcessName endswith "/osascript" or TargetProcessName endswith "/tclsh" or TargetProcessName endswith "/curl" or TargetProcessName endswith "/wget") and (TargetProcessCommandLine contains "preinstall" or TargetProcessCommandLine contains "postinstall")