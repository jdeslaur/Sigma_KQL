// Title: Macos Remote System Discovery
// Rule ID: 10227522-8429-47e6-a301-f2b2d014e7ad
// Severity: informational
// Tags: attack.discovery, attack.t1018
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_remote_system_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "/arp" and CommandLine contains "-a") or (NewProcessName endswith "/ping" and (CommandLine contains " 10." or CommandLine contains " 192.168." or CommandLine contains " 172.16." or CommandLine contains " 172.17." or CommandLine contains " 172.18." or CommandLine contains " 172.19." or CommandLine contains " 172.20." or CommandLine contains " 172.21." or CommandLine contains " 172.22." or CommandLine contains " 172.23." or CommandLine contains " 172.24." or CommandLine contains " 172.25." or CommandLine contains " 172.26." or CommandLine contains " 172.27." or CommandLine contains " 172.28." or CommandLine contains " 172.29." or CommandLine contains " 172.30." or CommandLine contains " 172.31." or CommandLine contains " 127." or CommandLine contains " 169.254."))