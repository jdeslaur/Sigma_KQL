// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "/nscurl" and (CommandLine contains "--download " or CommandLine contains "--download-directory " or CommandLine contains "--output " or CommandLine contains "-dir " or CommandLine contains "-dl " or CommandLine contains "-ld" or CommandLine contains "-o ")