// Title: Suspicious Installer Package Child Process
// Rule ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
// Severity: medium
// Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_installer_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "/package_script_service" or ParentProcessName endswith "/installer") and (NewProcessName endswith "/sh" or NewProcessName endswith "/bash" or NewProcessName endswith "/dash" or NewProcessName endswith "/python" or NewProcessName endswith "/ruby" or NewProcessName endswith "/perl" or NewProcessName endswith "/php" or NewProcessName endswith "/javascript" or NewProcessName endswith "/osascript" or NewProcessName endswith "/tclsh" or NewProcessName endswith "/curl" or NewProcessName endswith "/wget") and (CommandLine contains "preinstall" or CommandLine contains "postinstall")