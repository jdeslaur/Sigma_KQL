SecurityEvent
| where (NewProcessName endswith "/rm" or NewProcessName endswith "/unlink" or NewProcessName endswith "/shred") and (CommandLine contains "/var/log" or (CommandLine contains "/Users/" and CommandLine contains "/Library/Logs/"))