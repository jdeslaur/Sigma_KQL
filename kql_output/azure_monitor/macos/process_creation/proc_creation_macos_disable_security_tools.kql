// Title: Disable Security Tools
// Rule ID: ff39f1a6-84ac-476f-a1af-37fcdf53d7c0
// Severity: medium
// Tags: attack.defense-evasion, attack.t1562.001
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_disable_security_tools.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName =~ "/bin/launchctl" and CommandLine contains "unload") and (CommandLine contains "com.objective-see.lulu.plist" or CommandLine contains "com.objective-see.blockblock.plist" or CommandLine contains "com.google.santad.plist" or CommandLine contains "com.carbonblack.defense.daemon.plist" or CommandLine contains "com.carbonblack.daemon.plist" or CommandLine contains "at.obdev.littlesnitchd.plist" or CommandLine contains "com.tenablesecurity.nessusagent.plist" or CommandLine contains "com.opendns.osx.RoamingClientConfigUpdater.plist" or CommandLine contains "com.crowdstrike.falcond.plist" or CommandLine contains "com.crowdstrike.userdaemon.plist" or CommandLine contains "osquery" or CommandLine contains "filebeat" or CommandLine contains "auditbeat" or CommandLine contains "packetbeat" or CommandLine contains "td-agent")) or (NewProcessName =~ "/usr/sbin/spctl" and CommandLine contains "disable")