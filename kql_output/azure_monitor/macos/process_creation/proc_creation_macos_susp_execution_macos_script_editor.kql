// Title: Suspicious Execution via macOS Script Editor
// Rule ID: 6e4dcdd1-e48b-42f7-b2d8-3b413fc58cb4
// Severity: medium
// Tags: attack.t1566, attack.t1566.002, attack.initial-access, attack.t1059, attack.t1059.002, attack.t1204, attack.t1204.001, attack.execution, attack.persistence, attack.t1553, attack.defense-evasion
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_susp_execution_macos_script_editor.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "/Script Editor" and ((NewProcessName endswith "/curl" or NewProcessName endswith "/bash" or NewProcessName endswith "/sh" or NewProcessName endswith "/zsh" or NewProcessName endswith "/dash" or NewProcessName endswith "/fish" or NewProcessName endswith "/osascript" or NewProcessName endswith "/mktemp" or NewProcessName endswith "/chmod" or NewProcessName endswith "/php" or NewProcessName endswith "/nohup" or NewProcessName endswith "/openssl" or NewProcessName endswith "/plutil" or NewProcessName endswith "/PlistBuddy" or NewProcessName endswith "/xattr" or NewProcessName endswith "/sqlite" or NewProcessName endswith "/funzip" or NewProcessName endswith "/popen") or (NewProcessName contains "python" or NewProcessName contains "perl"))