// Title: Hidden User Creation
// Rule ID: b22a5b36-2431-493a-8be1-0bae56c28ef3
// Severity: medium
// Tags: attack.defense-evasion, attack.t1564.002
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_create_hidden_account.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "/dscl" and CommandLine contains "create") and (CommandLine contains "UniqueID" and CommandLine matches regex "([0-9]|[1-9][0-9]|[1-4][0-9]{2})")) or ((NewProcessName endswith "/dscl" and CommandLine contains "create") and (CommandLine contains "IsHidden" and (CommandLine contains "true" or CommandLine contains "yes" or CommandLine contains "1")))