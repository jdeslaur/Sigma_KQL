SecurityEvent
| where NewProcessName endswith "/jamf" and (CommandLine contains "createAccount" or CommandLine contains "manage" or CommandLine contains "removeFramework" or CommandLine contains "removeMdmProfile" or CommandLine contains "resetPassword" or CommandLine contains "setComputerName")