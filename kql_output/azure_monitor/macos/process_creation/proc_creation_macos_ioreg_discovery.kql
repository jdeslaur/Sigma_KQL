// Title: System Information Discovery Using Ioreg
// Rule ID: 2d5e7a8b-f484-4a24-945d-7f0efd52eab0
// Severity: medium
// Tags: attack.discovery, attack.t1082
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_ioreg_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "/ioreg" or CommandLine contains "ioreg") and (CommandLine contains "-l" or CommandLine contains "-c") and (CommandLine contains "AppleAHCIDiskDriver" or CommandLine contains "IOPlatformExpertDevice" or CommandLine contains "Oracle" or CommandLine contains "Parallels" or CommandLine contains "USB Vendor Name" or CommandLine contains "VirtualBox" or CommandLine contains "VMware")