// Title: GUI Input Capture - macOS
// Rule ID: 60f1ce20-484e-41bd-85f4-ac4afec2c541
// Severity: low
// Tags: attack.collection, attack.credential-access, attack.t1056.002
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_gui_input_capture.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "/osascript" and (CommandLine contains "-e" and CommandLine contains "display" and CommandLine contains "dialog" and CommandLine contains "answer") and (CommandLine contains "admin" or CommandLine contains "administrator" or CommandLine contains "authenticate" or CommandLine contains "authentication" or CommandLine contains "credentials" or CommandLine contains "pass" or CommandLine contains "password" or CommandLine contains "unlock")