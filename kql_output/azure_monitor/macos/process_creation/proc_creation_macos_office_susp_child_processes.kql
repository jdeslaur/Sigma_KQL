// Title: Suspicious Microsoft Office Child Process - MacOS
// Rule ID: 69483748-1525-4a6c-95ca-90dc8d431b68
// Severity: high
// Tags: attack.execution, attack.persistence, attack.t1059.002, attack.t1137.002, attack.t1204.002
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_office_susp_child_processes.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName contains "Microsoft Word" or ParentProcessName contains "Microsoft Excel" or ParentProcessName contains "Microsoft PowerPoint" or ParentProcessName contains "Microsoft OneNote") and (NewProcessName endswith "/bash" or NewProcessName endswith "/curl" or NewProcessName endswith "/dash" or NewProcessName endswith "/fish" or NewProcessName endswith "/osacompile" or NewProcessName endswith "/osascript" or NewProcessName endswith "/sh" or NewProcessName endswith "/zsh" or NewProcessName endswith "/python" or NewProcessName endswith "/python3" or NewProcessName endswith "/wget")