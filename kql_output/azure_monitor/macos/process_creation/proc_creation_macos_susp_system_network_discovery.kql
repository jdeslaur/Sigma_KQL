// Title: System Network Discovery - macOS
// Rule ID: 58800443-f9fc-4d55-ae0c-98a3966dfb97
// Severity: informational
// Tags: attack.discovery, attack.t1016
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_susp_system_network_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "/arp" or NewProcessName endswith "/ifconfig" or NewProcessName endswith "/netstat" or NewProcessName endswith "/networksetup" or NewProcessName endswith "/socketfilterfw") or (NewProcessName =~ "/usr/bin/defaults" and (CommandLine contains "/Library/Preferences/com.apple.alf" and CommandLine contains "read"))) and (not(ParentProcessName endswith "/wifivelocityd"))