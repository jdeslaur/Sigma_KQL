// Title: Local System Accounts Discovery - MacOs
// Rule ID: ddf36b67-e872-4507-ab2e-46bda21b842c
// Severity: low
// Tags: attack.discovery, attack.t1087.001
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_local_account.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "/dscl" and (CommandLine contains "list" and CommandLine contains "/users")) or (NewProcessName endswith "/dscacheutil" and (CommandLine contains "-q" and CommandLine contains "user")) or CommandLine contains "'x:0:'" or (NewProcessName endswith "/cat" and (CommandLine contains "/etc/passwd" or CommandLine contains "/etc/sudoers")) or NewProcessName endswith "/id" or (NewProcessName endswith "/lsof" and CommandLine contains "-u")