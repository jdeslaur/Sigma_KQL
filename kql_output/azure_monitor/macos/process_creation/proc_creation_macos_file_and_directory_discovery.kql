SecurityEvent
| where (NewProcessName =~ "/usr/bin/file" and CommandLine matches regex "(.){200,}") or (NewProcessName =~ "/bin/ls" and CommandLine contains "-R") or NewProcessName =~ "/usr/bin/find" or NewProcessName =~ "/usr/bin/mdfind" or NewProcessName =~ "/tree"