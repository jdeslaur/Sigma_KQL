// Title: Potential Base64 Decoded From Images
// Rule ID: 09a910bf-f71f-4737-9c40-88880ba5913d
// Severity: high
// Tags: attack.defense-evasion, attack.t1140
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_tail_base64_decode_from_image.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "/bash" and (CommandLine contains "tail" and CommandLine contains "-c") and (CommandLine contains "base64" and CommandLine contains "-d" and CommandLine contains ">") and (CommandLine contains ".avif" or CommandLine contains ".gif" or CommandLine contains ".jfif" or CommandLine contains ".jpeg" or CommandLine contains ".jpg" or CommandLine contains ".pjp" or CommandLine contains ".pjpeg" or CommandLine contains ".png" or CommandLine contains ".svg" or CommandLine contains ".webp")