SecurityEvent
| where (NewProcessName endswith "/truncate" and CommandLine contains "-s +") or (NewProcessName endswith "/dd" and (CommandLine contains "if=/dev/zero" or CommandLine contains "if=/dev/random" or CommandLine contains "if=/dev/urandom"))