SecurityEvent
| where (NewProcessName endswith "/dscacheutil" and (CommandLine contains "-q" and CommandLine contains "group")) or (NewProcessName endswith "/cat" and CommandLine contains "/etc/group") or (NewProcessName endswith "/dscl" and (CommandLine contains "-list" and CommandLine contains "/groups"))