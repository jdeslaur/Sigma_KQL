// Title: Suspicious Browser Child Process - MacOS
// Rule ID: 0250638a-2b28-4541-86fc-ea4c558fa0c6
// Severity: medium
// Tags: attack.initial-access, attack.execution, attack.t1189, attack.t1203, attack.t1059
// Category: process_creation
// Product: macos
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/macos/process_creation/proc_creation_macos_susp_browser_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName contains "com.apple.WebKit.WebContent" or ParentProcessName contains "firefox" or ParentProcessName contains "Google Chrome Helper" or ParentProcessName contains "Google Chrome" or ParentProcessName contains "Microsoft Edge" or ParentProcessName contains "Opera" or ParentProcessName contains "Safari" or ParentProcessName contains "Tor Browser") and (NewProcessName endswith "/bash" or NewProcessName endswith "/curl" or NewProcessName endswith "/dash" or NewProcessName endswith "/ksh" or NewProcessName endswith "/osascript" or NewProcessName endswith "/perl" or NewProcessName endswith "/php" or NewProcessName endswith "/pwsh" or NewProcessName endswith "/python" or NewProcessName endswith "/sh" or NewProcessName endswith "/tcsh" or NewProcessName endswith "/wget" or NewProcessName endswith "/zsh")) and (not((CommandLine contains "--defaults-torrc" or CommandLine matches regex ".*/Library/Application Support/Microsoft/MAU.*/Microsoft AutoUpdate\\.app/Contents/MacOS/msupdate.*" or ((ParentProcessName contains "Google Chrome Helper" or ParentProcessName contains "Google Chrome") and ((CommandLine contains "/Volumes/Google Chrome/Google Chrome.app/Contents/Frameworks/" and CommandLine contains "/Resources/install.sh") or (CommandLine contains "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/" and CommandLine contains "/Resources/keystone_promote_preflight.sh") or (CommandLine contains "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/" and CommandLine contains "/Resources/keystone_promote_postflight.sh"))) or (ParentProcessName contains "Microsoft Edge" and (CommandLine contains "IOPlatformExpertDevice" or CommandLine contains "hw.model")) or ((ParentProcessName contains "Google Chrome Helper" or ParentProcessName contains "Google Chrome") and (CommandLine contains "/Users/" and CommandLine contains "/Library/Application Support/Google/Chrome/recovery/" and CommandLine contains "/ChromeRecovery"))))) and (not((isnull(CommandLine) or CommandLine =~ "")))