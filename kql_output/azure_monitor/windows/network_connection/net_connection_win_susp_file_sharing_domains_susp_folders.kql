SecurityEvent
| where (NewProcessName contains ":\\$Recycle.bin" or NewProcessName contains ":\\Perflogs\\" or NewProcessName contains ":\\Temp\\" or NewProcessName contains ":\\Users\\Default\\" or NewProcessName contains ":\\Users\\Public\\" or NewProcessName contains ":\\Windows\\Fonts\\" or NewProcessName contains ":\\Windows\\IME\\" or NewProcessName contains ":\\Windows\\System32\\Tasks\\" or NewProcessName contains ":\\Windows\\Tasks\\" or NewProcessName contains ":\\Windows\\Temp\\" or NewProcessName contains "\\AppData\\Temp\\" or NewProcessName contains "\\config\\systemprofile\\" or NewProcessName contains "\\Windows\\addins\\") and (DestinationHostname endswith ".githubusercontent.com" or DestinationHostname endswith "anonfiles.com" or DestinationHostname endswith "cdn.discordapp.com" or DestinationHostname endswith "ddns.net" or DestinationHostname endswith "dl.dropboxusercontent.com" or DestinationHostname endswith "ghostbin.co" or DestinationHostname endswith "github.com" or DestinationHostname endswith "glitch.me" or DestinationHostname endswith "gofile.io" or DestinationHostname endswith "hastebin.com" or DestinationHostname endswith "mediafire.com" or DestinationHostname endswith "mega.co.nz" or DestinationHostname endswith "mega.nz" or DestinationHostname endswith "onrender.com" or DestinationHostname endswith "pages.dev" or DestinationHostname endswith "paste.ee" or DestinationHostname endswith "pastebin.com" or DestinationHostname endswith "pastebin.pl" or DestinationHostname endswith "pastetext.net" or DestinationHostname endswith "pixeldrain.com" or DestinationHostname endswith "privatlab.com" or DestinationHostname endswith "privatlab.net" or DestinationHostname endswith "send.exploit.in" or DestinationHostname endswith "sendspace.com" or DestinationHostname endswith "storage.googleapis.com" or DestinationHostname endswith "storjshare.io" or DestinationHostname endswith "supabase.co" or DestinationHostname endswith "temp.sh" or DestinationHostname endswith "transfer.sh" or DestinationHostname endswith "trycloudflare.com" or DestinationHostname endswith "ufile.io" or DestinationHostname endswith "w3spaces.com" or DestinationHostname endswith "workers.dev")