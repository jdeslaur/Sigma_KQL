// Title: Microsoft Sync Center Suspicious Network Connections
// Rule ID: 9f2cc74d-78af-4eb2-bb64-9cd1d292b87b
// Severity: medium
// Tags: attack.privilege-escalation, attack.t1055, attack.t1218, attack.execution, attack.defense-evasion
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_susp_outbound_mobsync_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\mobsync.exe" and (not((ipv4_is_in_range(DestinationIp, "127.0.0.0/8") or ipv4_is_in_range(DestinationIp, "10.0.0.0/8") or ipv4_is_in_range(DestinationIp, "172.16.0.0/12") or ipv4_is_in_range(DestinationIp, "192.168.0.0/16") or ipv4_is_in_range(DestinationIp, "169.254.0.0/16") or ipv4_is_in_range(DestinationIp, "::1/128") or ipv4_is_in_range(DestinationIp, "fe80::/10") or ipv4_is_in_range(DestinationIp, "fc00::/7"))))