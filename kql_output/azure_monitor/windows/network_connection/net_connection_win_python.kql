// Title: Python Initiated Connection
// Rule ID: bef0bc5a-b9ae-425d-85c6-7b2d705980c6
// Severity: medium
// Tags: attack.discovery, attack.t1046
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_python.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName contains "\\python" and NewProcessName contains ".exe") and (not(((DestinationIp =~ "127.0.0.1" and IpAddress =~ "127.0.0.1") or (CommandLine contains "pip.exe" and CommandLine contains "install")))) and (not(((ParentProcessName =~ "C:\\ProgramData\\Anaconda3\\Scripts\\conda.exe" and (CommandLine contains ":\\ProgramData\\Anaconda3\\Scripts\\conda-script.py" and CommandLine contains "update")) or (ParentProcessName =~ "C:\\ProgramData\\Anaconda3\\python.exe" and CommandLine contains "C:\\ProgramData\\Anaconda3\\Scripts\\jupyter-notebook-script.py"))))