// Title: Potentially Suspicious Wuauclt Network Connection
// Rule ID: c649a6c7-cd8c-4a78-9c04-000fc76df954
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_wuauclt_network_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName contains "wuauclt" and CommandLine contains " /RunHandlerComServer") and (not(((ipv4_is_in_range(DestinationIp, "127.0.0.0/8") or ipv4_is_in_range(DestinationIp, "10.0.0.0/8") or ipv4_is_in_range(DestinationIp, "169.254.0.0/16") or ipv4_is_in_range(DestinationIp, "172.16.0.0/12") or ipv4_is_in_range(DestinationIp, "192.168.0.0/16") or ipv4_is_in_range(DestinationIp, "::1/128") or ipv4_is_in_range(DestinationIp, "fe80::/10") or ipv4_is_in_range(DestinationIp, "fc00::/7")) or (ipv4_is_in_range(DestinationIp, "20.184.0.0/13") or ipv4_is_in_range(DestinationIp, "20.192.0.0/10") or ipv4_is_in_range(DestinationIp, "23.79.0.0/16") or ipv4_is_in_range(DestinationIp, "51.10.0.0/15") or ipv4_is_in_range(DestinationIp, "51.103.0.0/16") or ipv4_is_in_range(DestinationIp, "51.104.0.0/15") or ipv4_is_in_range(DestinationIp, "52.224.0.0/11")) or (CommandLine contains ":\\Windows\\UUS\\Packages\\Preview\\amd64\\updatedeploy.dll /ClassId" or CommandLine contains ":\\Windows\\UUS\\amd64\\UpdateDeploy.dll /ClassId") or (CommandLine contains ":\\Windows\\WinSxS\\" and CommandLine contains "\\UpdateDeploy.dll /ClassId ") or isnull(CommandLine) or CommandLine =~ "")))