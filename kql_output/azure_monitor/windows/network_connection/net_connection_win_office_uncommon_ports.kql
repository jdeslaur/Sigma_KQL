// Title: Office Application Initiated Network Connection Over Uncommon Ports
// Rule ID: 3b5ba899-9842-4bc2-acc2-12308498bf42
// Severity: medium
// Tags: attack.defense-evasion, attack.command-and-control
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_office_uncommon_ports.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\excel.exe" or NewProcessName endswith "\\outlook.exe" or NewProcessName endswith "\\powerpnt.exe" or NewProcessName endswith "\\winword.exe" or NewProcessName endswith "\\wordview.exe") and (not(((DestinationPort in~ ("53", "80", "139", "389", "443", "445", "3268")) or (NewProcessName contains ":\\Program Files\\Microsoft Office\\" and NewProcessName endswith "\\OUTLOOK.EXE" and (DestinationPort in~ ("143", "465", "587", "993", "995"))))))