// Title: Potentially Suspicious Azure Front Door Connection
// Rule ID: 8cb4d14e-776e-43c2-8fb9-91e7fcea32b4
// Severity: medium
// Tags: attack.command-and-control, attack.t1102.002, attack.t1090.004, detection.threat-hunting
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/network_connection/net_connection_win_susp_azurefd_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where DestinationHostname contains "azurefd.net" and (not(((NewProcessName endswith "brave.exe" or NewProcessName endswith "chrome.exe" or NewProcessName endswith "chromium.exe" or NewProcessName endswith "firefox.exe" or NewProcessName endswith "msedge.exe" or NewProcessName endswith "msedgewebview2.exe" or NewProcessName endswith "opera.exe" or NewProcessName endswith "vivaldi.exe") or NewProcessName endswith "searchapp.exe" or (DestinationHostname contains "afdxtest.z01.azurefd.net" or DestinationHostname contains "fp-afd.azurefd.net" or DestinationHostname contains "fp-afdx-bpdee4gtg6frejfd.z01.azurefd.net" or DestinationHostname contains "roxy.azurefd.net" or DestinationHostname contains "powershellinfraartifacts-gkhedzdeaghdezhr.z01.azurefd.net" or DestinationHostname contains "storage-explorer-publishing-feapcgfgbzc2cjek.b01.azurefd.net" or DestinationHostname contains "graph.azurefd.net"))))