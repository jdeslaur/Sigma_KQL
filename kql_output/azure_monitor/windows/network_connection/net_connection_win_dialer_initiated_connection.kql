// Title: Outbound Network Connection Initiated By Microsoft Dialer
// Rule ID: 37e4024a-6c80-4d8f-b95d-2e7e94f3a8d1
// Severity: high
// Tags: attack.execution, attack.command-and-control, attack.t1071.001
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_dialer_initiated_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith ":\\Windows\\System32\\dialer.exe" and (not((ipv4_is_in_range(DestinationIp, "127.0.0.0/8") or ipv4_is_in_range(DestinationIp, "10.0.0.0/8") or ipv4_is_in_range(DestinationIp, "172.16.0.0/12") or ipv4_is_in_range(DestinationIp, "192.168.0.0/16") or ipv4_is_in_range(DestinationIp, "169.254.0.0/16") or ipv4_is_in_range(DestinationIp, "::1/128") or ipv4_is_in_range(DestinationIp, "fe80::/10") or ipv4_is_in_range(DestinationIp, "fc00::/7"))))