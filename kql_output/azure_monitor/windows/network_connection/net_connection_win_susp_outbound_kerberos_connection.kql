// Title: Uncommon Outbound Kerberos Connection
// Rule ID: e54979bd-c5f9-4d6c-967b-a04b19ac4c74
// Severity: medium
// Tags: attack.defense-evasion, attack.credential-access, attack.t1558, attack.lateral-movement, attack.t1550.003
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_susp_outbound_kerberos_connection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where DestinationPort == 88 and (not(NewProcessName =~ "C:\\Windows\\System32\\lsass.exe")) and (not(((NewProcessName in~ ("C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe", "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe")) or (NewProcessName in~ ("C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe", "C:\\Program Files\\Mozilla Firefox\\firefox.exe")) or NewProcessName endswith "\\tomcat\\bin\\tomcat8.exe")))