// Title: Suspicious Non-Browser Network Communication With Google API
// Rule ID: 7e9cf7b6-e827-11ed-a05b-0242ac120003
// Severity: medium
// Tags: attack.command-and-control, attack.t1102
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_domain_google_api_non_browser_access.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (DestinationHostname contains "drive.googleapis.com" or DestinationHostname contains "oauth2.googleapis.com" or DestinationHostname contains "sheets.googleapis.com" or DestinationHostname contains "www.googleapis.com") and (not((isnull(NewProcessName) or NewProcessName =~ ""))) and (not((NewProcessName endswith "\\brave.exe" or (NewProcessName endswith ":\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or NewProcessName endswith ":\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe") or (NewProcessName contains ":\\Program Files\\Google\\Drive File Stream\\" and NewProcessName endswith "\\GoogleDriveFS.exe") or (NewProcessName endswith ":\\Program Files\\Mozilla Firefox\\firefox.exe" or NewProcessName endswith ":\\Program Files (x86)\\Mozilla Firefox\\firefox.exe") or (NewProcessName endswith ":\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or NewProcessName endswith ":\\Program Files\\Internet Explorer\\iexplore.exe") or NewProcessName endswith "\\maxthon.exe" or (NewProcessName contains ":\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\" or (NewProcessName endswith ":\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or NewProcessName endswith ":\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe" or NewProcessName endswith "\\WindowsApps\\MicrosoftEdge.exe")) or ((NewProcessName contains ":\\Program Files (x86)\\Microsoft\\EdgeCore\\" or NewProcessName contains ":\\Program Files\\Microsoft\\EdgeCore\\") and (NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\msedgewebview2.exe")) or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\safari.exe" or NewProcessName endswith "\\seamonkey.exe" or NewProcessName endswith "\\vivaldi.exe" or NewProcessName endswith "\\whale.exe" or NewProcessName endswith "\\GoogleUpdate.exe" or NewProcessName endswith "\\outlook.exe")))