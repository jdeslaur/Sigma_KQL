// Title: Suspicious Wordpad Outbound Connections
// Rule ID: 786cdae8-fefb-4eb2-9227-04e34060db01
// Severity: medium
// Tags: attack.defense-evasion, attack.command-and-control
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_wordpad_uncommon_ports.yml
//
