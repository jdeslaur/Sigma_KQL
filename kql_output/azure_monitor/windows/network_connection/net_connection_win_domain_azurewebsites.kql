SecurityEvent
| where DestinationHostname endswith "azurewebsites.net" and (not(((NewProcessName in~ ("C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (NewProcessName startswith "C:\\Users\\" and NewProcessName endswith "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") or (NewProcessName in~ ("C:\\Program Files\\Mozilla Firefox\\firefox.exe", "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (NewProcessName startswith "C:\\Users\\" and NewProcessName endswith "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") or (NewProcessName in~ ("C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe", "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (NewProcessName startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\" or NewProcessName endswith "\\WindowsApps\\MicrosoftEdge.exe" or (NewProcessName in~ ("C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((NewProcessName startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or NewProcessName startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\msedgewebview2.exe")) or ((NewProcessName contains "C:\\Program Files (x86)\\Safari\\" or NewProcessName contains "C:\\Program Files\\Safari\\") and NewProcessName endswith "\\safari.exe") or ((NewProcessName contains "C:\\Program Files\\Windows Defender Advanced Threat Protection\\" or NewProcessName contains "C:\\Program Files\\Windows Defender\\" or NewProcessName contains "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") and (NewProcessName endswith "\\MsMpEng.exe" or NewProcessName endswith "\\MsSense.exe")) or (NewProcessName endswith "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" or NewProcessName endswith "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe") or (NewProcessName startswith "C:\\Program Files\\BraveSoftware\\" and NewProcessName endswith "\\brave.exe") or (NewProcessName contains "\\AppData\\Local\\Maxthon\\" and NewProcessName endswith "\\maxthon.exe") or (NewProcessName contains "\\AppData\\Local\\Programs\\Opera\\" and NewProcessName endswith "\\opera.exe") or ((NewProcessName startswith "C:\\Program Files\\SeaMonkey\\" or NewProcessName startswith "C:\\Program Files (x86)\\SeaMonkey\\") and NewProcessName endswith "\\seamonkey.exe") or (NewProcessName contains "\\AppData\\Local\\Vivaldi\\" and NewProcessName endswith "\\vivaldi.exe") or ((NewProcessName startswith "C:\\Program Files\\Naver\\Naver Whale\\" or NewProcessName startswith "C:\\Program Files (x86)\\Naver\\Naver Whale\\") and NewProcessName endswith "\\whale.exe") or ((NewProcessName startswith "C:\\Program Files\\Waterfox\\" or NewProcessName startswith "C:\\Program Files (x86)\\Waterfox\\") and NewProcessName endswith "\\Waterfox.exe") or ((NewProcessName startswith "C:\\Program Files\\SlimBrowser\\" or NewProcessName startswith "C:\\Program Files (x86)\\SlimBrowser\\") and NewProcessName endswith "\\slimbrowser.exe") or (NewProcessName contains "\\AppData\\Local\\Flock\\" and NewProcessName endswith "\\Flock.exe") or (NewProcessName contains "\\AppData\\Local\\Phoebe\\" and NewProcessName endswith "\\Phoebe.exe") or ((NewProcessName startswith "C:\\Program Files\\Falkon\\" or NewProcessName startswith "C:\\Program Files (x86)\\Falkon\\") and NewProcessName endswith "\\falkon.exe") or ((NewProcessName startswith "C:\\Program Files (x86)\\QtWeb\\" or NewProcessName startswith "C:\\Program Files\\QtWeb\\") and NewProcessName endswith "\\QtWeb.exe") or ((NewProcessName startswith "C:\\Program Files (x86)\\Avant Browser\\" or NewProcessName startswith "C:\\Program Files\\Avant Browser\\") and NewProcessName endswith "\\avant.exe") or (NewProcessName contains "\\AppData\\Local\\Discord\\" and NewProcessName endswith "\\Discord.exe") or isnull(NewProcessName) or NewProcessName =~ "")))