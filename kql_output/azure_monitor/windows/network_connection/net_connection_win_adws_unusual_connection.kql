SecurityEvent
| where DestinationPort == 9389 and (not((NewProcessName =~ "C:\\Windows\\system32\\dsac.exe" or NewProcessName =~ "C:\\Program Files\\Microsoft Monitoring Agent\\" or (NewProcessName startswith "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or NewProcessName startswith "C:\\Program Files\\PowerShell\\7-preview\\pwsh.ex" or NewProcessName startswith "C:\\Windows\\System32\\WindowsPowerShell\\" or NewProcessName startswith "C:\\Windows\\SysWOW64\\WindowsPowerShell\\"))))