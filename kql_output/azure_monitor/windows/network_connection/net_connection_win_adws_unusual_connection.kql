// Title: Uncommon Connection to Active Directory Web Services
// Rule ID: b3ad3c0f-c949-47a1-a30e-b0491ccae876
// Severity: medium
// Tags: attack.discovery, attack.t1087
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_adws_unusual_connection.yml
//
// Generated by sigma-to-kql converter
