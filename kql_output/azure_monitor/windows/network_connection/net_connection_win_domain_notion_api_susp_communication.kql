// Title: Potentially Suspicious Network Connection To Notion API
// Rule ID: 7e9cf7b6-e827-11ed-a05b-15959c120003
// Severity: low
// Tags: attack.command-and-control, attack.t1102
// Category: network_connection
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/network_connection/net_connection_win_domain_notion_api_susp_communication.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where DestinationHostname contains "api.notion.com" and (not((NewProcessName endswith "\\AppData\\Local\\Programs\\Notion\\Notion.exe" or NewProcessName endswith "\\brave.exe" or (NewProcessName in~ ("C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (NewProcessName in~ ("C:\\Program Files\\Mozilla Firefox\\firefox.exe", "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (NewProcessName in~ ("C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe", "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or NewProcessName endswith "\\maxthon.exe" or (NewProcessName startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\" or NewProcessName endswith "\\WindowsApps\\MicrosoftEdge.exe" or (NewProcessName in~ ("C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((NewProcessName startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or NewProcessName startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\msedgewebview2.exe")) or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\safari.exe" or NewProcessName endswith "\\seamonkey.exe" or NewProcessName endswith "\\vivaldi.exe" or NewProcessName endswith "\\whale.exe")))