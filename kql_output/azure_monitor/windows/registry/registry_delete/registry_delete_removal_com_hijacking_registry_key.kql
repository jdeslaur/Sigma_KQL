// Title: Removal of Potential COM Hijacking Registry Keys
// Rule ID: 96f697b0-b499-4e5d-9908-a67bec11cdb6
// Severity: medium
// Tags: attack.persistence, attack.defense-evasion, attack.t1112
// Category: registry_delete
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_delete/registry_delete_removal_com_hijacking_registry_key.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith "\\shell\\open\\command" and (not((NewProcessName endswith "C:\\Windows\\explorer.exe" or NewProcessName =~ "C:\\Windows\\system32\\svchost.exe" or (NewProcessName in~ ("C:\\Windows\\System32\\msiexec.exe", "C:\\Windows\\SysWOW64\\msiexec.exe")) or (NewProcessName startswith "C:\\Program Files\\" or NewProcessName startswith "C:\\Program Files (x86)\\") or NewProcessName =~ "C:\\Windows\\System32\\OpenWith.exe"))) and (not(((NewProcessName endswith "\\Dropbox.exe" and ObjectName contains "\\Dropbox.") or (NewProcessName endswith "\\AppData\\Local\\Temp\\Wireshark_uninstaller.exe" and ObjectName endswith "\\wireshark-capture-file*") or (NewProcessName contains "peazip" and ObjectName contains "\\PeaZip.") or (NewProcessName endswith "\\Everything.exe" and ObjectName contains "\\Everything.") or NewProcessName startswith "C:\\Windows\\Installer\\MSI" or (NewProcessName startswith "C:\\Program Files (x86)\\Java\\" and NewProcessName endswith "\\installer.exe" and ObjectName contains "\\Classes\\WOW6432Node\\CLSID\\{4299124F-F2C3-41b4-9C73-9236B2AD0E8F}") or NewProcessName contains "\\Microsoft\\EdgeUpdate\\Install" or ((NewProcessName in~ ("C:\\Program Files (x86)\\Avira\\Antivirus\\", "C:\\Program Files\\Avira\\Antivirus\\")) and (ObjectName endswith "\\CLSID\\{305CA226-D286-468e-B848-2B2E8E697B74}\\Shell\\Open\\Command" or ObjectName endswith "\\AntiVir.Keyfile\\shell\\open\\command")) or ((NewProcessName contains "AppData\\Local\\Temp" and NewProcessName contains "\\setup.exe") or (NewProcessName contains "\\Temp\\is-" and NewProcessName contains "\\target.tmp")) or NewProcessName endswith "\\ninite.exe" or (NewProcessName endswith "\\reg.exe" and ObjectName endswith "\\Discord\\shell\\open\\command") or (NewProcessName endswith "\\Spotify.exe" and ObjectName endswith "\\Spotify\\shell\\open\\command") or (NewProcessName endswith "C:\\eclipse\\eclipse.exe" and ObjectName contains "_Classes\\eclipse+") or (NewProcessName contains "\\Temp" and NewProcessName contains "\\TeamViewer"))))