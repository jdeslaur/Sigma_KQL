SecurityEvent
| where ObjectName endswith "\\DeviceGuard\\EnableVirtualizationBasedSecurity" or ObjectName endswith "\\DeviceGuard\\LsaCfgFlags" or ObjectName endswith "\\DeviceGuard\\RequirePlatformSecurityFeatures" or ObjectName endswith "\\Lsa\\LsaCfgFlags"