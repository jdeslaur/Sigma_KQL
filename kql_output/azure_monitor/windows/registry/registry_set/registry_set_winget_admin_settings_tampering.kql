// Title: Winget Admin Settings Modification
// Rule ID: 6db5eaf9-88f7-4ed9-af7d-9ef2ad12f236
// Severity: low
// Tags: attack.defense-evasion, attack.persistence
// Category: registry_set
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_winget_admin_settings_tampering.yml
//
