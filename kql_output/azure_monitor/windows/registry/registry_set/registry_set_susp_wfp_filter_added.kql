SecurityEvent
| where ObjectName endswith "\\BFE\\Parameters\\Policy\\Persistent\\Filter*" and (not((NewProcessName in~ ("C:\\Windows\\System32\\svchost.exe", "C:\\Windows\\SysWOW64\\svchost.exe"))))