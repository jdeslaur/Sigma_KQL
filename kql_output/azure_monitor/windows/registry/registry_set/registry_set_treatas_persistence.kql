// Title: COM Hijacking via TreatAs
// Rule ID: dc5c24af-6995-49b2-86eb-a9ff62199e82
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Category: registry_set
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_treatas_persistence.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith "TreatAs\\(Default)" and (not(((NewProcessName startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" and NewProcessName endswith "\\OfficeClickToRun.exe") or (NewProcessName in~ ("C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe", "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe")) or NewProcessName =~ "C:\\Windows\\system32\\svchost.exe" or (NewProcessName in~ ("C:\\Windows\\system32\\msiexec.exe", "C:\\Windows\\SysWOW64\\msiexec.exe")))))