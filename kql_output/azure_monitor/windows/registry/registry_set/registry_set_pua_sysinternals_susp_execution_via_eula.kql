SecurityEvent
| where (ObjectName contains "\\Active Directory Explorer" or ObjectName contains "\\Handle" or ObjectName contains "\\LiveKd" or ObjectName contains "\\Process Explorer" or ObjectName contains "\\ProcDump" or ObjectName contains "\\PsExec" or ObjectName contains "\\PsLoglist" or ObjectName contains "\\PsPasswd" or ObjectName contains "\\SDelete" or ObjectName contains "\\Sysinternals") and ObjectName endswith "\\EulaAccepted"