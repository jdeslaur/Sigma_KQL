// Title: Potential Credential Dumping Attempt Using New NetworkProvider - REG
// Rule ID: 0442defa-b4a2-41c9-ae2c-ea7042fc4701
// Severity: medium
// Tags: attack.credential-access, attack.t1003
// Category: registry_set
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_new_network_provider.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\System\\CurrentControlSet\\Services*" and ObjectName contains "\\NetworkProvider") and (not(((ObjectName contains "\\System\\CurrentControlSet\\Services\\WebClient\\NetworkProvider" or ObjectName contains "\\System\\CurrentControlSet\\Services\\LanmanWorkstation\\NetworkProvider" or ObjectName contains "\\System\\CurrentControlSet\\Services\\RDPNP\\NetworkProvider") or NewProcessName =~ "C:\\Windows\\System32\\poqexec.exe")))