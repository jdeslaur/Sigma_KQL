SecurityEvent
| where ObjectName endswith "\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Custom*" and (ObjectName endswith "\\csrss.exe" or ObjectName endswith "\\dllhost.exe" or ObjectName endswith "\\explorer.exe" or ObjectName endswith "\\RuntimeBroker.exe" or ObjectName endswith "\\services.exe" or ObjectName endswith "\\sihost.exe" or ObjectName endswith "\\svchost.exe" or ObjectName endswith "\\taskhostw.exe" or ObjectName endswith "\\winlogon.exe" or ObjectName endswith "\\WmiPrvSe.exe")