// Title: Suspicious Execution Of Renamed Sysinternals Tools - Registry
// Rule ID: f50f3c09-557d-492d-81db-9064a8d4e211
// Severity: high
// Tags: attack.resource-development, attack.t1588.002
// Category: registry_set
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_pua_sysinternals_renamed_execution_via_eula.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ObjectName contains "\\Active Directory Explorer" or ObjectName contains "\\Handle" or ObjectName contains "\\LiveKd" or ObjectName contains "\\ProcDump" or ObjectName contains "\\Process Explorer" or ObjectName contains "\\PsExec" or ObjectName contains "\\PsLoggedon" or ObjectName contains "\\PsLoglist" or ObjectName contains "\\PsPasswd" or ObjectName contains "\\PsPing" or ObjectName contains "\\PsService" or ObjectName contains "\\SDelete") and ObjectName endswith "\\EulaAccepted") and (not((NewProcessName endswith "\\ADExplorer.exe" or NewProcessName endswith "\\ADExplorer64.exe" or NewProcessName endswith "\\handle.exe" or NewProcessName endswith "\\handle64.exe" or NewProcessName endswith "\\livekd.exe" or NewProcessName endswith "\\livekd64.exe" or NewProcessName endswith "\\procdump.exe" or NewProcessName endswith "\\procdump64.exe" or NewProcessName endswith "\\procexp.exe" or NewProcessName endswith "\\procexp64.exe" or NewProcessName endswith "\\PsExec.exe" or NewProcessName endswith "\\PsExec64.exe" or NewProcessName endswith "\\PsLoggedon.exe" or NewProcessName endswith "\\PsLoggedon64.exe" or NewProcessName endswith "\\psloglist.exe" or NewProcessName endswith "\\psloglist64.exe" or NewProcessName endswith "\\pspasswd.exe" or NewProcessName endswith "\\pspasswd64.exe" or NewProcessName endswith "\\PsPing.exe" or NewProcessName endswith "\\PsPing64.exe" or NewProcessName endswith "\\PsService.exe" or NewProcessName endswith "\\PsService64.exe" or NewProcessName endswith "\\sdelete.exe")))