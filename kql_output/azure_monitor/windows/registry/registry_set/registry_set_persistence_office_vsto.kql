// Title: Potential Persistence Via Visual Studio Tools for Office
// Rule ID: 9d15044a-7cfe-4d23-8085-6ebc11df7685
// Severity: medium
// Tags: attack.t1137.006, attack.persistence
// Category: registry_set
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_persistence_office_vsto.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\Software\\Microsoft\\Office\\Outlook\\Addins*" or ObjectName endswith "\\Software\\Microsoft\\Office\\Word\\Addins*" or ObjectName endswith "\\Software\\Microsoft\\Office\\Excel\\Addins*" or ObjectName endswith "\\Software\\Microsoft\\Office\\Powerpoint\\Addins*" or ObjectName endswith "\\Software\\Microsoft\\VSTO\\Security\\Inclusion*") and (not(((NewProcessName in~ ("C:\\Windows\\System32\\msiexec.exe", "C:\\Windows\\SysWOW64\\msiexec.exe", "C:\\Windows\\System32\\regsvr32.exe", "C:\\Windows\\SysWOW64\\regsvr32.exe")) or ((NewProcessName startswith "C:\\Program Files\\Common Files (x86)\\Microsoft Shared\\ClickToRun\\" or NewProcessName startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\") and NewProcessName endswith "\\OfficeClickToRun.exe") or (NewProcessName in~ ("C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe", "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) or ((NewProcessName startswith "C:\\Program Files\\Microsoft Office\\OFFICE" or NewProcessName startswith "C:\\Program Files (x86)\\Microsoft Office\\OFFICE" or NewProcessName startswith "C:\\Program Files\\Microsoft Office\\Root\\OFFICE" or NewProcessName startswith "C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE") and (NewProcessName endswith "\\excel.exe" or NewProcessName endswith "\\Integrator.exe" or NewProcessName endswith "\\outlook.exe" or NewProcessName endswith "\\powerpnt.exe" or NewProcessName endswith "\\Teams.exe" or NewProcessName endswith "\\visio.exe" or NewProcessName endswith "\\winword.exe"))))) and (not((((NewProcessName in~ ("C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe", "C:\\Program Files (x86)\\AVG\\Antivirus\\RegSvr.exe")) and ObjectName endswith "\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt*") or ((NewProcessName in~ ("C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe", "C:\\Program Files (x86)\\Avast Software\\Avast\\RegSvr.exe")) and ObjectName endswith "\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt*"))))