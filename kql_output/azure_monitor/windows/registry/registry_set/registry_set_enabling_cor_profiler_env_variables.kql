SecurityEvent
| where (ObjectName endswith "\\COR_ENABLE_PROFILING" or ObjectName endswith "\\COR_PROFILER" or ObjectName endswith "\\CORECLR_ENABLE_PROFILING") or ObjectName contains "\\CORECLR_PROFILER_PATH"