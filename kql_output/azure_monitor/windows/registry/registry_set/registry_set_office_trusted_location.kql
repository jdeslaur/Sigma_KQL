// Title: Microsoft Office Trusted Location Updated
// Rule ID: a0bed973-45fa-4625-adb5-6ecdf9be70ac
// Severity: medium
// Tags: attack.defense-evasion, attack.persistence, attack.t1112, detection.threat-hunting
// Category: registry_set
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/registry/registry_set/registry_set_office_trusted_location.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName contains "Security\\Trusted Locations\\Location" and ObjectName endswith "\\Path") and (not(((NewProcessName contains ":\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" and NewProcessName endswith "\\OfficeClickToRun.exe") or (NewProcessName contains ":\\Program Files\\Microsoft Office\\" or NewProcessName contains ":\\Program Files (x86)\\Microsoft Office\\"))))