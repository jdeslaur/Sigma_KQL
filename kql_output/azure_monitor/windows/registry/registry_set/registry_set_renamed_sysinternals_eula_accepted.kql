// Title: Usage of Renamed Sysinternals Tools - RegistrySet
// Rule ID: 8023f872-3f1d-4301-a384-801889917ab4
// Severity: high
// Tags: attack.resource-development, attack.t1588.002
// Category: registry_set
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_set/registry_set_renamed_sysinternals_eula_accepted.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ObjectName contains "\\PsExec" or ObjectName contains "\\ProcDump" or ObjectName contains "\\Handle" or ObjectName contains "\\LiveKd" or ObjectName contains "\\Process Explorer" or ObjectName contains "\\PsLoglist" or ObjectName contains "\\PsPasswd" or ObjectName contains "\\Active Directory Explorer") and ObjectName endswith "\\EulaAccepted") and (not((NewProcessName endswith "\\PsExec.exe" or NewProcessName endswith "\\PsExec64.exe" or NewProcessName endswith "\\procdump.exe" or NewProcessName endswith "\\procdump64.exe" or NewProcessName endswith "\\handle.exe" or NewProcessName endswith "\\handle64.exe" or NewProcessName endswith "\\livekd.exe" or NewProcessName endswith "\\livekd64.exe" or NewProcessName endswith "\\procexp.exe" or NewProcessName endswith "\\procexp64.exe" or NewProcessName endswith "\\psloglist.exe" or NewProcessName endswith "\\psloglist64.exe" or NewProcessName endswith "\\pspasswd.exe" or NewProcessName endswith "\\pspasswd64.exe" or NewProcessName endswith "\\ADExplorer.exe" or NewProcessName endswith "\\ADExplorer64.exe"))) and (not(isnull(NewProcessName)))