// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\Microsoft\\Windows NT\\CurrentVersion*" and ObjectName endswith "\\Image File Execution Options*" and ObjectName contains "\\GlobalFlag") or ((ObjectName endswith "\\Microsoft\\Windows NT\\CurrentVersion*" and ObjectName endswith "\\SilentProcessExit*") and (ObjectName contains "\\ReportingMode" or ObjectName contains "\\MonitorProcess"))