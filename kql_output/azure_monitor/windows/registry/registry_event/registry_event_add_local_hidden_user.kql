// Title: Creation of a Local Hidden User Account by Registry
// Rule ID: 460479f3-80b7-42da-9c43-2cc1d54dbccd
// Severity: high
// Tags: attack.persistence, attack.t1136.001
// Category: registry_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_event/registry_event_add_local_hidden_user.yml
//
