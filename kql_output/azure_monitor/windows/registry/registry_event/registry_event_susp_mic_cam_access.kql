// Title: Suspicious Camera and Microphone Access
// Rule ID: 62120148-6b7a-42be-8b91-271c04e281a3
// Severity: high
// Tags: attack.collection, attack.t1125, attack.t1123
// Category: registry_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_event/registry_event_susp_mic_cam_access.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore*" and ObjectName contains "\\NonPackaged") and (ObjectName contains "microphone" or ObjectName contains "webcam") and (ObjectName contains ":#Windows#Temp#" or ObjectName contains ":#$Recycle.bin#" or ObjectName contains ":#Temp#" or ObjectName contains ":#Users#Public#" or ObjectName contains ":#Users#Default#" or ObjectName contains ":#Users#Desktop#")