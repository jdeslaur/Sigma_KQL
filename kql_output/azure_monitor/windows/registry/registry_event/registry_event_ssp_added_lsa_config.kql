SecurityEvent
| where (ObjectName endswith "\\Control\\Lsa\\Security Packages" or ObjectName endswith "\\Control\\Lsa\\OSConfig\\Security Packages") and (not((NewProcessName in~ ("C:\\Windows\\system32\\msiexec.exe", "C:\\Windows\\syswow64\\MsiExec.exe"))))