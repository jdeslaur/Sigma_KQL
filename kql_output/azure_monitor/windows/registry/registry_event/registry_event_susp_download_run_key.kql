// Title: Suspicious Run Key from Download
// Rule ID: 9c5037d1-c568-49b3-88c7-9846a5bdc2be
// Severity: high
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Category: registry_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/registry/registry_event/registry_event_susp_download_run_key.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName contains "\\AppData\\Local\\Packages\\Microsoft.Outlook_" or NewProcessName contains "\\AppData\\Local\\Microsoft\\Olk\\Attachments\\" or NewProcessName contains "\\Downloads\\" or NewProcessName contains "\\Temporary Internet Files\\Content.Outlook\\" or NewProcessName contains "\\Local Settings\\Temporary Internet Files\\") and (ObjectName contains "\\Software\\Microsoft\\Windows\\CurrentVersion\\Run" or ObjectName contains "\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run" or ObjectName contains "\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run")