// Title: Suspicious Scheduled Task Creation Involving Temp Folder
// Rule ID: 39019a4e-317f-4ce3-ae63-309a8c6b53c5
// Severity: high
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_schtasks_creation_temp_folder.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\schtasks.exe" and (CommandLine contains " /create " and CommandLine contains " /sc once " and CommandLine contains "\\Temp\\")