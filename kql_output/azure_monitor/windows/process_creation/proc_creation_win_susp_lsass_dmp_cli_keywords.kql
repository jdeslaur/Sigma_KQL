SecurityEvent
| where (CommandLine contains "lsass.dmp" or CommandLine contains "lsass.zip" or CommandLine contains "lsass.rar" or CommandLine contains "Andrew.dmp" or CommandLine contains "Coredump.dmp" or CommandLine contains "NotLSASS.zip" or CommandLine contains "lsass_2" or CommandLine contains "lsassdump" or CommandLine contains "lsassdmp") or (CommandLine contains "lsass" and CommandLine contains ".dmp") or (CommandLine contains "SQLDmpr" and CommandLine contains ".mdmp") or (CommandLine contains "nanodump" and CommandLine contains ".dmp")