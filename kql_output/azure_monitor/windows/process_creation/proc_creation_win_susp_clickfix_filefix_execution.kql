SecurityEvent
| where (ParentProcessName endswith "\\explorer.exe" and CommandLine contains "#") and (CommandLine contains "account" or CommandLine contains "anti-bot" or CommandLine contains "botcheck" or CommandLine contains "captcha" or CommandLine contains "challenge" or CommandLine contains "confirmation" or CommandLine contains "fraud" or CommandLine contains "human" or CommandLine contains "identification" or CommandLine contains "identificator" or CommandLine contains "identity" or CommandLine contains "robot" or CommandLine contains "validation" or CommandLine contains "verification" or CommandLine contains "verify")