// Title: Suspicious Processes Spawned by WinRM
// Rule ID: 5cc2cda8-f261-4d88-a2de-e9e193c86716
// Severity: high
// Tags: attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_winrm_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\wsmprovhost.exe" and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\sh.exe" or NewProcessName endswith "\\bash.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wsl.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\whoami.exe" or NewProcessName endswith "\\bitsadmin.exe")