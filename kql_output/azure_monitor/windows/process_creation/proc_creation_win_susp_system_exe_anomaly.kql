SecurityEvent
| where (NewProcessName endswith "\\atbroker.exe" or NewProcessName endswith "\\audiodg.exe" or NewProcessName endswith "\\bcdedit.exe" or NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\certreq.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\cmstp.exe" or NewProcessName endswith "\\conhost.exe" or NewProcessName endswith "\\consent.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\csrss.exe" or NewProcessName endswith "\\dashost.exe" or NewProcessName endswith "\\defrag.exe" or NewProcessName endswith "\\dfrgui.exe" or NewProcessName endswith "\\dism.exe" or NewProcessName endswith "\\dllhost.exe" or NewProcessName endswith "\\dllhst3g.exe" or NewProcessName endswith "\\dwm.exe" or NewProcessName endswith "\\eventvwr.exe" or NewProcessName endswith "\\finger.exe" or NewProcessName endswith "\\logonui.exe" or NewProcessName endswith "\\LsaIso.exe" or NewProcessName endswith "\\lsass.exe" or NewProcessName endswith "\\lsm.exe" or NewProcessName endswith "\\msiexec.exe" or NewProcessName endswith "\\ntoskrnl.exe" or NewProcessName endswith "\\powershell_ise.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\runonce.exe" or NewProcessName endswith "\\RuntimeBroker.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\services.exe" or NewProcessName endswith "\\sihost.exe" or NewProcessName endswith "\\smartscreen.exe" or NewProcessName endswith "\\smss.exe" or NewProcessName endswith "\\spoolsv.exe" or NewProcessName endswith "\\svchost.exe" or NewProcessName endswith "\\taskhost.exe" or NewProcessName endswith "\\taskhostw.exe" or NewProcessName endswith "\\Taskmgr.exe" or NewProcessName endswith "\\userinit.exe" or NewProcessName endswith "\\werfault.exe" or NewProcessName endswith "\\werfaultsecure.exe" or NewProcessName endswith "\\wininit.exe" or NewProcessName endswith "\\winlogon.exe" or NewProcessName endswith "\\winver.exe" or NewProcessName endswith "\\wlanext.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\wsl.exe" or NewProcessName endswith "\\wsmprovhost.exe") and (not(((NewProcessName startswith "C:\\$WINDOWS.~BT\\" or NewProcessName startswith "C:\\$WinREAgent\\" or NewProcessName startswith "C:\\Windows\\SoftwareDistribution\\" or NewProcessName startswith "C:\\Windows\\System32\\" or NewProcessName startswith "C:\\Windows\\SystemTemp\\" or NewProcessName startswith "C:\\Windows\\SysWOW64\\" or NewProcessName startswith "C:\\Windows\\uus\\" or NewProcessName startswith "C:\\Windows\\WinSxS\\") or ((NewProcessName contains "C:\\Program Files\\PowerShell\\7\\" or NewProcessName contains "C:\\Program Files\\PowerShell\\7-preview\\" or NewProcessName contains "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" or NewProcessName contains "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview") and NewProcessName endswith "\\pwsh.exe") or ((NewProcessName startswith "C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux" or NewProcessName startswith "C:\\Program Files\\WSL\\") and NewProcessName endswith "\\wsl.exe") or (NewProcessName startswith "C:\\Users\\'" and NewProcessName contains "\\AppData\\Local\\Microsoft\\WindowsApps\\" and NewProcessName endswith "\\wsl.exe")))) and (not(NewProcessName contains "\\SystemRoot\\System32\\"))