// Title: Chopper Webshell Process Pattern
// Rule ID: fa3c117a-bc0d-416e-a31b-0c0e80653efb
// Severity: high
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_webshell_chopper.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\w3wp.exe" or ParentProcessName endswith "\\w3wp.exe") and (CommandLine contains "&ipconfig&echo" or CommandLine contains "&quser&echo" or CommandLine contains "&whoami&echo" or CommandLine contains "&c:&echo" or CommandLine contains "&cd&echo" or CommandLine contains "&dir&echo" or CommandLine contains "&echo [E]" or CommandLine contains "&echo [S]")