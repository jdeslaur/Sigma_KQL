SecurityEvent
| where (NewProcessName contains "\\wwwroot\\" or NewProcessName contains "\\wmpub\\" or NewProcessName contains "\\htdocs\\") and (not(((NewProcessName contains "bin\\" or NewProcessName contains "\\Tools\\" or NewProcessName contains "\\SMSComponent\\") and ParentProcessName endswith "\\services.exe")))