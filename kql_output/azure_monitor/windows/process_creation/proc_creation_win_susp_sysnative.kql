// Title: Process Creation Using Sysnative Folder
// Rule ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
// Severity: medium
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1055
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_sysnative.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains ":\\Windows\\Sysnative\\" or NewProcessName contains ":\\Windows\\Sysnative\\") and (not(((NewProcessName contains "C:\\Windows\\Microsoft.NET\\Framework64\\v" or NewProcessName contains "C:\\Windows\\Microsoft.NET\\Framework\\v" or NewProcessName contains "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v" or NewProcessName contains "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v") and NewProcessName endswith "\\ngen.exe" and CommandLine contains "install"))) and (not((CommandLine contains "\"C:\\Windows\\sysnative\\cmd.exe\"" and CommandLine contains "\\xampp\\" and CommandLine contains "\\catalina_start.bat")))