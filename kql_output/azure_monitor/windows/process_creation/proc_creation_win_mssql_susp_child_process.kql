// Title: Suspicious Child Process Of SQL Server
// Rule ID: 869b9ca7-9ea2-4a5a-8325-e80e62f75445
// Severity: high
// Tags: attack.t1505.003, attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_mssql_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\sqlservr.exe" and (NewProcessName endswith "\\bash.exe" or NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\netstat.exe" or NewProcessName endswith "\\nltest.exe" or NewProcessName endswith "\\ping.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\sh.exe" or NewProcessName endswith "\\systeminfo.exe" or NewProcessName endswith "\\tasklist.exe" or NewProcessName endswith "\\wsl.exe")) and (not((ParentProcessName startswith "C:\\Program Files\\Microsoft SQL Server\\" and ParentProcessName endswith "DATEV_DBENGINE\\MSSQL\\Binn\\sqlservr.exe" and NewProcessName =~ "C:\\Windows\\System32\\cmd.exe" and CommandLine startswith "\"C:\\Windows\\system32\\cmd.exe\" ")))