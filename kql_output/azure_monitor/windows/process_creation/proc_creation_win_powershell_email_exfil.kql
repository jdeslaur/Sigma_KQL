// Title: Email Exifiltration Via Powershell
// Rule ID: 312d0384-401c-4b8b-abdf-685ffba9a332
// Severity: high
// Tags: attack.exfiltration
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_email_exfil.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and (CommandLine contains "Add-PSSnapin" and CommandLine contains "Get-Recipient" and CommandLine contains "-ExpandProperty" and CommandLine contains "EmailAddresses" and CommandLine contains "SmtpAddress" and CommandLine contains "-hidetableheaders")