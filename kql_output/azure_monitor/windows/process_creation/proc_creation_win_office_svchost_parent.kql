// Title: Suspicious New Instance Of An Office COM Object
// Rule ID: 9bdaf1e9-fdef-443b-8081-4341b74a7e28
// Severity: medium
// Tags: attack.execution, attack.defense-evasion, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_office_svchost_parent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\svchost.exe" and (NewProcessName endswith "\\eqnedt32.exe" or NewProcessName endswith "\\excel.exe" or NewProcessName endswith "\\msaccess.exe" or NewProcessName endswith "\\mspub.exe" or NewProcessName endswith "\\powerpnt.exe" or NewProcessName endswith "\\visio.exe" or NewProcessName endswith "\\winword.exe")