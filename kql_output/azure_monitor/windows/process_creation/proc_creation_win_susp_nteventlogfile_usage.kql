SecurityEvent
| where CommandLine contains "Win32_NTEventlogFile" and (CommandLine contains ".BackupEventlog(" or CommandLine contains ".ChangeSecurityPermissions(" or CommandLine contains ".ChangeSecurityPermissionsEx(" or CommandLine contains ".ClearEventLog(" or CommandLine contains ".Delete(" or CommandLine contains ".DeleteEx(" or CommandLine contains ".Rename(" or CommandLine contains ".TakeOwnerShip(" or CommandLine contains ".TakeOwnerShipEx(")