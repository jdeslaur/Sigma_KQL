// Title: Obfuscated IP Via CLI
// Rule ID: 56d19cb4-6414-4769-9644-1ed35ffbb148
// Severity: medium
// Tags: attack.discovery
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_obfuscated_ip_via_cli.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\ping.exe" or NewProcessName endswith "\\arp.exe") and ((CommandLine contains " 0x" or CommandLine contains "//0x" or CommandLine contains ".0x" or CommandLine contains ".00x") or (CommandLine contains "http://%" and CommandLine contains "%2e") or (CommandLine matches regex "https?://[0-9]{1,3}\\.[0-9]{1,3}\\.0[0-9]{3,4}" or CommandLine matches regex "https?://[0-9]{1,3}\\.0[0-9]{3,7}" or CommandLine matches regex "https?://0[0-9]{3,11}" or CommandLine matches regex "https?://(0[0-9]{1,11}\\.){3}0[0-9]{1,11}" or CommandLine matches regex "https?://0[0-9]{1,11}" or CommandLine matches regex " [0-7]{7,13}")) and (not(CommandLine matches regex "https?://((25[0-5]|(2[0-4]|1\\d|[1-9])?\\d)(\\.|\\b)){4}"))