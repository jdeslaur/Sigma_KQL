SecurityEvent
| where CommandLine contains "type %windir%\\system32\\ntdll.dll" or CommandLine contains "type %systemroot%\\system32\\ntdll.dll" or CommandLine contains "type c:\\windows\\system32\\ntdll.dll" or CommandLine contains "\\ntdll.dll > \\\\.\\pipe\\"