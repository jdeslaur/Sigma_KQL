// Title: Manual Execution of Script Inside of a Compressed File
// Rule ID: 95724fc1-a258-4674-97db-a30351981c5a
// Severity: medium
// Tags: attack.execution, attack.t1059, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_susp_script_exec_from_compressed_parent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName matches regex ".*\\\\7z.*\\.exe" and CommandLine matches regex ".*\\\\AppData\\\\local\\\\temp\\\\7z.*\\\\.*") or (ParentProcessName endswith "\\winrar.exe" and CommandLine matches regex ".*\\\\AppData\\\\local\\\\temp\\\\rar.*\\\\.*") or (ParentProcessName endswith "\\explorer.exe" and (CommandLine contains "\\AppData\\local\\temp*.rar\\" or CommandLine contains "\\AppData\\local\\temp*.zip\\"))) and ((NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wscript.exe") and (CommandLine endswith ".hta" or CommandLine endswith ".js" or CommandLine endswith ".jse" or CommandLine endswith ".ps1" or CommandLine endswith ".vbe" or CommandLine endswith ".vbs" or CommandLine endswith ".wsf" or CommandLine endswith ".wsh"))