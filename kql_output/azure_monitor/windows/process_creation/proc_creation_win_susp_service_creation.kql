// Title: Suspicious New Service Creation
// Rule ID: 17a1be64-8d88-40bf-b5ff-a4f7a50ebcc8
// Severity: high
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_service_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\sc.exe" and (CommandLine contains "create" and CommandLine contains "binPath=")) or (CommandLine contains "New-Service" and CommandLine contains "-BinaryPathName")) and (CommandLine contains "powershell" or CommandLine contains "mshta" or CommandLine contains "wscript" or CommandLine contains "cscript" or CommandLine contains "svchost" or CommandLine contains "dllhost" or CommandLine contains "cmd " or CommandLine contains "cmd.exe /c" or CommandLine contains "cmd.exe /k" or CommandLine contains "cmd.exe /r" or CommandLine contains "rundll32" or CommandLine contains "C:\\Users\\Public" or CommandLine contains "\\Downloads\\" or CommandLine contains "\\Desktop\\" or CommandLine contains "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\" or CommandLine contains "C:\\Windows\\TEMP\\" or CommandLine contains "\\AppData\\Local\\Temp")