// Title: PowerShell SAM Copy
// Rule ID: 1af57a4b-460a-4738-9034-db68b880c665
// Severity: high
// Tags: attack.credential-access, attack.t1003.002
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_sam_access.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains "\\HarddiskVolumeShadowCopy" and CommandLine contains "System32\\config\\sam") and (CommandLine contains "Copy-Item" or CommandLine contains "cp $_." or CommandLine contains "cpi $_." or CommandLine contains "copy $_." or CommandLine contains ".File]::Copy(")