// Title: File or Folder Permissions Modifications
// Rule ID: 37ae075c-271b-459b-8d7b-55ad5f993dd8
// Severity: medium
// Tags: attack.defense-evasion, attack.t1222.001, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_susp_file_permission_modifications.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (((NewProcessName endswith "\\cacls.exe" or NewProcessName endswith "\\icacls.exe" or NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe") and (CommandLine contains "/grant" or CommandLine contains "/setowner" or CommandLine contains "/inheritance:r")) or (NewProcessName endswith "\\attrib.exe" and CommandLine contains "-r") or NewProcessName endswith "\\takeown.exe") and (not((CommandLine endswith "ICACLS C:\\ProgramData\\dynatrace\\gateway\\config\\connectivity.history /reset" or (CommandLine contains "ICACLS C:\\ProgramData\\dynatrace\\gateway\\config\\config.properties /grant :r " and CommandLine contains "S-1-5-19:F") or (CommandLine contains "\\AppData\\Local\\Programs\\Microsoft VS Code" or CommandLine contains ":\\Program Files\\Microsoft VS Code") or (CommandLine contains ":\\Program Files (x86)\\Avira" or CommandLine contains ":\\Program Files\\Avira"))))