SecurityEvent
| where (CommandLine endswith "svchost.exe" and NewProcessName endswith "\\svchost.exe") and (not(((ParentProcessName endswith "\\rpcnet.exe" or ParentProcessName endswith "\\rpcnetp.exe") or isnull(CommandLine))))