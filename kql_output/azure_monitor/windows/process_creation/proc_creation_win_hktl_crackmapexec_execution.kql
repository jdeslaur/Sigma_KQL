// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\crackmapexec.exe" or CommandLine contains " -M pe_inject " or (CommandLine contains " --local-auth" and CommandLine contains " -u " and CommandLine contains " -x ") or (CommandLine contains " --local-auth" and CommandLine contains " -u " and CommandLine contains " -p " and CommandLine contains " -H 'NTHASH'") or (CommandLine contains " mssql " and CommandLine contains " -u " and CommandLine contains " -p " and CommandLine contains " -M " and CommandLine contains " -d ") or (CommandLine contains " smb " and CommandLine contains " -u " and CommandLine contains " -H " and CommandLine contains " -M " and CommandLine contains " -o ") or (CommandLine contains " smb " and CommandLine contains " -u " and CommandLine contains " -p " and CommandLine contains " --local-auth")) or ((CommandLine contains " --local-auth" and CommandLine contains " -u " and CommandLine contains " -p ") and (CommandLine contains " 10." and CommandLine contains " 192.168." and CommandLine contains "/24 "))