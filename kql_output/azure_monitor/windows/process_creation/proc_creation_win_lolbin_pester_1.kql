// Title: Execute Code with Pester.bat
// Rule ID: 59e938ff-0d6d-4dc3-b13f-36cc28734d4e
// Severity: medium
// Tags: attack.execution, attack.t1059.001, attack.defense-evasion, attack.t1216
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_lolbin_pester_1.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and (CommandLine contains "Pester" and CommandLine contains "Get-Help")) or ((NewProcessName endswith "\\cmd.exe" and (CommandLine contains "pester" and CommandLine contains ";")) and (CommandLine contains "help" or CommandLine contains "?"))