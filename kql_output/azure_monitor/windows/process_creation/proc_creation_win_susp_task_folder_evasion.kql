SecurityEvent
| where (CommandLine contains "echo " or CommandLine contains "copy " or CommandLine contains "type " or CommandLine contains "file createnew") and (CommandLine contains " C:\\Windows\\System32\\Tasks\\" or CommandLine contains " C:\\Windows\\SysWow64\\Tasks\\")