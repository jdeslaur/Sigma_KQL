// Title: File Download with Headless Browser
// Rule ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
// Severity: high
// Tags: attack.defense-evasion, attack.command-and-control, attack.t1105, attack.t1564.003
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_browsers_chromium_headless_file_download.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\chrome.exe" or NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\vivaldi.exe") and (CommandLine contains "--headless" and CommandLine contains "dump-dom" and CommandLine contains "http")) and (not((((NewProcessName startswith "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\" or NewProcessName startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or NewProcessName startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\" or NewProcessName startswith "C:\\Program Files\\Microsoft\\Edge\\Application\\" or NewProcessName startswith "C:\\Program Files\\Microsoft\\EdgeCore\\" or NewProcessName startswith "C:\\Program Files\\Microsoft\\EdgeWebView\\" or NewProcessName startswith "C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge") and (NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\msedgewebview2.exe" or NewProcessName endswith "\\MicrosoftEdge.exe") and CommandLine contains "--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom") or ((NewProcessName contains "\\AppData\\Local\\Microsoft\\WindowsApps\\" or NewProcessName contains "\\Windows\\SystemApps\\Microsoft.MicrosoftEdge") and (NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\MicrosoftEdge.exe") and CommandLine contains "--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom"))))