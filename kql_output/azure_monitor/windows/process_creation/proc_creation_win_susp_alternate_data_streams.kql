SecurityEvent
| where CommandLine contains "txt:" and ((CommandLine contains "type " and CommandLine contains " > ") or (CommandLine contains "makecab " and CommandLine contains ".cab") or (CommandLine contains "reg " and CommandLine contains " export ") or (CommandLine contains "regedit " and CommandLine contains " /E ") or (CommandLine contains "esentutl " and CommandLine contains " /y " and CommandLine contains " /d " and CommandLine contains " /o "))