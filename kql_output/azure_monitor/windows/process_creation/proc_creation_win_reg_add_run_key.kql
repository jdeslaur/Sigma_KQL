// Title: Potential Persistence Attempt Via Run Keys Using Reg.EXE
// Rule ID: de587dce-915e-4218-aac4-835ca6af6f70
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_reg_add_run_key.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\reg.exe" and (CommandLine contains "reg" and CommandLine contains " add ") and (CommandLine contains "Software\\Microsoft\\Windows\\CurrentVersion\\Run" or CommandLine contains "\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run" or CommandLine contains "\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run")