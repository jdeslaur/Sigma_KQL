SecurityEvent
| where (NewProcessName contains "\\goldenPac" or NewProcessName contains "\\karmaSMB" or NewProcessName contains "\\kintercept" or NewProcessName contains "\\ntlmrelayx" or NewProcessName contains "\\rpcdump" or NewProcessName contains "\\samrdump" or NewProcessName contains "\\secretsdump" or NewProcessName contains "\\smbexec" or NewProcessName contains "\\smbrelayx" or NewProcessName contains "\\wmiexec" or NewProcessName contains "\\wmipersist") or (NewProcessName endswith "\\atexec_windows.exe" or NewProcessName endswith "\\dcomexec_windows.exe" or NewProcessName endswith "\\dpapi_windows.exe" or NewProcessName endswith "\\findDelegation_windows.exe" or NewProcessName endswith "\\GetADUsers_windows.exe" or NewProcessName endswith "\\GetNPUsers_windows.exe" or NewProcessName endswith "\\getPac_windows.exe" or NewProcessName endswith "\\getST_windows.exe" or NewProcessName endswith "\\getTGT_windows.exe" or NewProcessName endswith "\\GetUserSPNs_windows.exe" or NewProcessName endswith "\\ifmap_windows.exe" or NewProcessName endswith "\\mimikatz_windows.exe" or NewProcessName endswith "\\netview_windows.exe" or NewProcessName endswith "\\nmapAnswerMachine_windows.exe" or NewProcessName endswith "\\opdump_windows.exe" or NewProcessName endswith "\\psexec_windows.exe" or NewProcessName endswith "\\rdp_check_windows.exe" or NewProcessName endswith "\\sambaPipe_windows.exe" or NewProcessName endswith "\\smbclient_windows.exe" or NewProcessName endswith "\\smbserver_windows.exe" or NewProcessName endswith "\\sniff_windows.exe" or NewProcessName endswith "\\sniffer_windows.exe" or NewProcessName endswith "\\split_windows.exe" or NewProcessName endswith "\\ticketer_windows.exe")