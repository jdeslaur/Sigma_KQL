// Title: Suspicious Shells Spawn by Java Utility Keytool
// Rule ID: 90fb5e62-ca1f-4e22-b42e-cc521874c938
// Severity: high
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_java_keytool_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\keytool.exe" and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\sh.exe" or NewProcessName endswith "\\bash.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\whoami.exe" or NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\scrcons.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\hh.exe" or NewProcessName endswith "\\wmic.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\forfiles.exe" or NewProcessName endswith "\\scriptrunner.exe" or NewProcessName endswith "\\mftrace.exe" or NewProcessName endswith "\\AppVLP.exe" or NewProcessName endswith "\\systeminfo.exe" or NewProcessName endswith "\\reg.exe" or NewProcessName endswith "\\query.exe")