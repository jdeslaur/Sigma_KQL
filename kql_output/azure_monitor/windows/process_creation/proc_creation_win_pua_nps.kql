SecurityEvent
| where NewProcessName endswith "\\npc.exe" or (CommandLine contains " -server=" and CommandLine contains " -vkey=" and CommandLine contains " -password=") or CommandLine contains " -config=npc" or (FileHash startswith "AE8ACF66BFE3A44148964048B826D005" or FileHash startswith "CEA49E9B9B67F3A13AD0BE1C2655293EA3C18181" or FileHash startswith "5A456283392FFCEEEACA3D3426C306EB470304637520D72FED1CC1FEBBBD6856")