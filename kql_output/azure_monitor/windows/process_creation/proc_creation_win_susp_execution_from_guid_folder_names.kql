// Title: Potential Suspicious Execution From GUID Like Folder Names
// Rule ID: 90b63c33-2b97-4631-a011-ceb0f47b77c3
// Severity: low
// Tags: attack.defense-evasion, attack.t1027, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_susp_execution_from_guid_folder_names.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((CommandLine contains "\\AppData\\Roaming\\" or CommandLine contains "\\AppData\\Local\\Temp\\") and (CommandLine contains "\\{" and CommandLine contains "}\\")) and (not(((NewProcessName contains "\\{" and NewProcessName contains "}\\") or isnull(NewProcessName) or NewProcessName =~ "C:\\Windows\\System32\\drvinst.exe" or (NewProcessName in~ ("C:\\Windows\\System32\\msiexec.exe", "C:\\Windows\\SysWOW64\\msiexec.exe")))))