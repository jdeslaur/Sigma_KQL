// Title: Potential Provlaunch.EXE Binary Proxy Execution Abuse
// Rule ID: 7f5d1c9a-3e83-48df-95a7-2b98aae6c13c
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_provlaunch_potential_abuse.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\provlaunch.exe" and (not(((NewProcessName endswith "\\calc.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\notepad.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\wscript.exe") or (NewProcessName contains ":\\PerfLogs\\" or NewProcessName contains ":\\Temp\\" or NewProcessName contains ":\\Users\\Public\\" or NewProcessName contains "\\AppData\\Temp\\" or NewProcessName contains "\\Windows\\System32\\Tasks\\" or NewProcessName contains "\\Windows\\Tasks\\" or NewProcessName contains "\\Windows\\Temp\\"))))