// Title: Browser Execution In Headless Mode
// Rule ID: ef9dcfed-690c-4c5d-a9d1-482cd422225c
// Severity: low
// Tags: attack.defense-evasion, attack.command-and-control, attack.t1105, attack.t1564.003
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_browsers_chromium_headless_exec.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\chrome.exe" or NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\vivaldi.exe") and CommandLine contains "--headless"