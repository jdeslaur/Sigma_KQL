// Title: Suspicious Child Process of Notepad++ Updater - GUP.Exe
// Rule ID: bb0e87ce-c89f-4857-84fa-095e4483e9cb
// Severity: high
// Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_gup_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\gup.exe" and ((NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\mshta.exe") or (CommandLine contains "bitsadmin" or CommandLine contains "certutil" or CommandLine contains "curl" or CommandLine contains "finger" or CommandLine contains "forfiles" or CommandLine contains "regsvr32" or CommandLine contains "rundll32" or CommandLine contains "wget"))