SecurityEvent
| where (CommandLine contains "\\ShellIds\\Microsoft.PowerShell\\ExecutionPolicy" or CommandLine contains "\\Policies\\Microsoft\\Windows\\PowerShell\\ExecutionPolicy") and (CommandLine contains "Bypass" or CommandLine contains "RemoteSigned" or CommandLine contains "Unrestricted")