// Title: Deletion of Volume Shadow Copies via WMI with PowerShell
// Rule ID: 21ff4ca9-f13a-41ad-b828-0077b2af2e40
// Severity: high
// Tags: attack.impact, attack.t1490
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_shadowcopy_deletion.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains "Get-WmiObject" or CommandLine contains "gwmi" or CommandLine contains "Get-CimInstance" or CommandLine contains "gcim") and CommandLine contains "Win32_ShadowCopy" and (CommandLine contains ".Delete()" or CommandLine contains "Remove-WmiObject" or CommandLine contains "rwmi" or CommandLine contains "Remove-CimInstance" or CommandLine contains "rcim")