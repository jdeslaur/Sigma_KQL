SecurityEvent
| where (CommandLine endswith "\\rundll32.exe" or CommandLine endswith "\\rundll32.exe\"" or CommandLine endswith "\\rundll32") and (not((ParentProcessName contains "\\AppData\\Local\\" or ParentProcessName contains "\\Microsoft\\Edge\\")))