// Title: Process Execution From A Potentially Suspicious Folder
// Rule ID: 3dfd06d2-eaf4-4532-9555-68aca59f57c4
// Severity: high
// Tags: attack.defense-evasion, attack.t1036
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_execution_path.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName contains ":\\Perflogs\\" or NewProcessName contains ":\\Users\\All Users\\" or NewProcessName contains ":\\Users\\Default\\" or NewProcessName contains ":\\Users\\NetworkService\\" or NewProcessName contains ":\\Windows\\addins\\" or NewProcessName contains ":\\Windows\\debug\\" or NewProcessName contains ":\\Windows\\Fonts\\" or NewProcessName contains ":\\Windows\\Help\\" or NewProcessName contains ":\\Windows\\IME\\" or NewProcessName contains ":\\Windows\\Media\\" or NewProcessName contains ":\\Windows\\repair\\" or NewProcessName contains ":\\Windows\\security\\" or NewProcessName contains ":\\Windows\\System32\\Tasks\\" or NewProcessName contains ":\\Windows\\Tasks\\" or NewProcessName contains "$Recycle.bin" or NewProcessName contains "\\config\\systemprofile\\" or NewProcessName contains "\\Intel\\Logs\\" or NewProcessName contains "\\RSA\\MachineKeys\\") and (not((NewProcessName startswith "C:\\Users\\Public\\IBM\\ClientSolutions\\Start_Programs\\" or (NewProcessName startswith "C:\\Windows\\SysWOW64\\config\\systemprofile\\Citrix\\UpdaterBinaries\\" and NewProcessName endswith "\\CitrixReceiverUpdater.exe"))))