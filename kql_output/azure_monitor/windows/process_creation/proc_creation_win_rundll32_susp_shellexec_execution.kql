SecurityEvent
| where CommandLine contains "ShellExec_RunDLL" and (CommandLine contains "\\Desktop\\" or CommandLine contains "\\Temp\\" or CommandLine contains "\\Users\\Public\\" or CommandLine contains "comspec" or CommandLine contains "iex" or CommandLine contains "Invoke-" or CommandLine contains "msiexec" or CommandLine contains "odbcconf" or CommandLine contains "regsvr32")