// Title: MSDT Execution Via Answer File
// Rule ID: 9c8c7000-3065-44a8-a555-79bcba5d9955
// Severity: high
// Tags: attack.defense-evasion, attack.t1218, attack.execution
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_msdt_answer_file_exec.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\msdt.exe" and CommandLine contains "\\WINDOWS\\diagnostics\\index\\PCWDiagnostic.xml" and (CommandLine contains " -af " or CommandLine contains " /af " or CommandLine contains " –af " or CommandLine contains " —af " or CommandLine contains " ―af ")) and (not(ParentProcessName endswith "\\pcwrun.exe"))