// Title: Suspicious Download from Office Domain
// Rule ID: 00d49ed5-4491-4271-a8db-650a4ef6f8c1
// Severity: high
// Tags: attack.command-and-control, attack.resource-development, attack.t1105, attack.t1608
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_download_office_domain.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\curl.exe" or NewProcessName endswith "\\wget.exe") or (CommandLine contains "Invoke-WebRequest" or CommandLine contains "iwr " or CommandLine contains "curl " or CommandLine contains "wget " or CommandLine contains "Start-BitsTransfer" or CommandLine contains ".DownloadFile(" or CommandLine contains ".DownloadString(")) and (CommandLine contains "https://attachment.outlook.live.net/owa/" or CommandLine contains "https://onenoteonlinesync.onenote.com/onenoteonlinesync/")