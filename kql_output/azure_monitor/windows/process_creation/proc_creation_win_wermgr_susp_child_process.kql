// Title: Suspicious Child Process Of Wermgr.EXE
// Rule ID: 396f6630-f3ac-44e3-bfc8-1b161bc00c4e
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1055, attack.t1036
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wermgr_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\wermgr.exe" and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\ipconfig.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe" or NewProcessName endswith "\\netstat.exe" or NewProcessName endswith "\\nslookup.exe" or NewProcessName endswith "\\powershell_ise.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\systeminfo.exe" or NewProcessName endswith "\\whoami.exe" or NewProcessName endswith "\\wscript.exe")) and (not((NewProcessName endswith "\\rundll32.exe" and (CommandLine contains "C:\\Windows\\system32\\WerConCpl.dll" and CommandLine contains "LaunchErcApp ") and (CommandLine contains "-queuereporting" or CommandLine contains "-responsepester"))))