SecurityEvent
| where (CommandLine contains "REG" and CommandLine contains "ADD" and CommandLine contains "\\SOFTWARE\\Policies\\Microsoft\\FVE" and CommandLine contains "/v" and CommandLine contains "/f") and (CommandLine contains "EnableBDEWithNoTPM" or CommandLine contains "UseAdvancedStartup" or CommandLine contains "UseTPM" or CommandLine contains "UseTPMKey" or CommandLine contains "UseTPMKeyPIN" or CommandLine contains "RecoveryKeyMessageSource" or CommandLine contains "UseTPMPIN" or CommandLine contains "RecoveryKeyMessage")