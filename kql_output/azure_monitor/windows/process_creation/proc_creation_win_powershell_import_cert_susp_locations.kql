SecurityEvent
| where (CommandLine contains "Import-Certificate" and CommandLine contains " -FilePath " and CommandLine contains "Cert:\\LocalMachine\\Root") and (CommandLine contains "\\AppData\\Local\\Temp\\" or CommandLine contains ":\\Windows\\TEMP\\" or CommandLine contains "\\Desktop\\" or CommandLine contains "\\Downloads\\" or CommandLine contains "\\Perflogs\\" or CommandLine contains ":\\Users\\Public\\")