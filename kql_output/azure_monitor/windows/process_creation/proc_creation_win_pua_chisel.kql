// Title: PUA - Chisel Tunneling Tool Execution
// Rule ID: 8b0e12da-d3c3-49db-bb4f-256703f380e5
// Severity: high
// Tags: attack.command-and-control, attack.t1090.001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_pua_chisel.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\chisel.exe" or ((CommandLine contains "exe client " or CommandLine contains "exe server ") and (CommandLine contains "-socks5" or CommandLine contains "-reverse" or CommandLine contains " r:" or CommandLine contains ":127.0.0.1:" or CommandLine contains "-tls-skip-verify " or CommandLine contains ":socks"))