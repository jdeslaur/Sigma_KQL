// Title: Suspicious Script Execution From Temp Folder
// Rule ID: a6a39bdb-935c-4f0a-ab77-35f4bbf44d33
// Severity: high
// Tags: attack.execution, attack.t1059
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_script_exec_from_temp.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe") and (CommandLine contains "\\Windows\\Temp" or CommandLine contains "\\Temporary Internet" or CommandLine contains "\\AppData\\Local\\Temp" or CommandLine contains "\\AppData\\Roaming\\Temp" or CommandLine contains "%TEMP%" or CommandLine contains "%TMP%" or CommandLine contains "%LocalAppData%\\Temp")) and (not((CommandLine contains " >" or CommandLine contains "Out-File" or CommandLine contains "ConvertTo-Json" or CommandLine contains "-WindowStyle hidden -Verb runAs" or CommandLine contains "\\Windows\\system32\\config\\systemprofile\\AppData\\Local\\Temp\\Amazon\\EC2-Windows\\")))