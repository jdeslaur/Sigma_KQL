// Title: Suspicious Electron Application Child Processes
// Rule ID: f26eb764-fd89-464b-85e2-dc4a8e6e77b8
// Severity: medium
// Tags: attack.execution
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_electron_app_children.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\chrome.exe" or ParentProcessName endswith "\\discord.exe" or ParentProcessName endswith "\\GitHubDesktop.exe" or ParentProcessName endswith "\\keybase.exe" or ParentProcessName endswith "\\msedge.exe" or ParentProcessName endswith "\\msedgewebview2.exe" or ParentProcessName endswith "\\msteams.exe" or ParentProcessName endswith "\\slack.exe" or ParentProcessName endswith "\\teams.exe") and ((NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\whoami.exe" or NewProcessName endswith "\\wscript.exe") or (NewProcessName contains ":\\ProgramData\\" or NewProcessName contains ":\\Temp\\" or NewProcessName contains "\\AppData\\Local\\Temp\\" or NewProcessName contains "\\Users\\Public\\" or NewProcessName contains "\\Windows\\Temp\\")) and (not((ParentProcessName endswith "\\Discord.exe" and NewProcessName endswith "\\cmd.exe" and CommandLine contains "\\NVSMI\\nvidia-smi.exe")))