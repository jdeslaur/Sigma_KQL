// Title: Webshell Tool Reconnaissance Activity
// Rule ID: f64e5c19-879c-4bae-b471-6d84c8339677
// Severity: high
// Tags: attack.persistence, attack.t1505.003
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_webshell_tool_recon.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName endswith "\\caddy.exe" or ParentProcessName endswith "\\httpd.exe" or ParentProcessName endswith "\\nginx.exe" or ParentProcessName endswith "\\php-cgi.exe" or ParentProcessName endswith "\\w3wp.exe" or ParentProcessName endswith "\\ws_tomcatservice.exe") or ((ParentProcessName endswith "\\java.exe" or ParentProcessName endswith "\\javaw.exe") and (ParentProcessName contains "-tomcat-" or ParentProcessName contains "\\tomcat")) or ((ParentProcessName endswith "\\java.exe" or ParentProcessName endswith "\\javaw.exe") and (CommandLine contains "CATALINA_HOME" or CommandLine contains "catalina.jar"))) and (CommandLine contains "perl --help" or CommandLine contains "perl -h" or CommandLine contains "python --help" or CommandLine contains "python -h" or CommandLine contains "python3 --help" or CommandLine contains "python3 -h" or CommandLine contains "wget --help")