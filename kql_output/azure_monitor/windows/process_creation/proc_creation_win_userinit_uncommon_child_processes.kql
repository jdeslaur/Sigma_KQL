// Title: Uncommon Userinit Child Process
// Rule ID: 0a98a10c-685d-4ab0-bddc-b6bdd1d48458
// Severity: high
// Tags: attack.privilege-escalation, attack.t1037.001, attack.persistence
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_userinit_uncommon_child_processes.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\userinit.exe" and (not(NewProcessName endswith ":\\WINDOWS\\explorer.exe")) and (not(((CommandLine contains "netlogon.bat" or CommandLine contains "UsrLogon.cmd") or CommandLine =~ "PowerShell.exe" or (NewProcessName endswith ":\\Windows\\System32\\proquota.exe" or NewProcessName endswith ":\\Windows\\SysWOW64\\proquota.exe") or (NewProcessName endswith ":\\Program Files (x86)\\Citrix\\HDX\\bin\\cmstart.exe" or NewProcessName endswith ":\\Program Files (x86)\\Citrix\\HDX\\bin\\icast.exe" or NewProcessName endswith ":\\Program Files (x86)\\Citrix\\System32\\icast.exe" or NewProcessName endswith ":\\Program Files\\Citrix\\HDX\\bin\\cmstart.exe" or NewProcessName endswith ":\\Program Files\\Citrix\\HDX\\bin\\icast.exe" or NewProcessName endswith ":\\Program Files\\Citrix\\System32\\icast.exe") or isnull(NewProcessName))))