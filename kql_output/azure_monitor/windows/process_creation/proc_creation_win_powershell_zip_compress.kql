// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains "Compress-Archive -Path" and CommandLine contains "-DestinationPath $env:TEMP") or (CommandLine contains "Compress-Archive -Path" and CommandLine contains "-DestinationPath" and CommandLine contains "\\AppData\\Local\\Temp\\") or (CommandLine contains "Compress-Archive -Path" and CommandLine contains "-DestinationPath" and CommandLine contains ":\\Windows\\Temp\\")