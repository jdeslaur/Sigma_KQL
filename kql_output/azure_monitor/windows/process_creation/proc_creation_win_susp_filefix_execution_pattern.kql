// Title: Suspicious FileFix Execution Pattern
// Rule ID: b5b29e4e-31fa-4fdf-b058-296e7a1aa0c2
// Severity: high
// Tags: attack.execution, attack.t1204.004
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_filefix_execution_pattern.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName endswith "\\brave.exe" or ParentProcessName endswith "\\chrome.exe" or ParentProcessName endswith "\\firefox.exe" or ParentProcessName endswith "\\msedge.exe") and CommandLine contains "#") and ((CommandLine contains "%comspec%" or CommandLine contains "bitsadmin" or CommandLine contains "certutil" or CommandLine contains "cmd" or CommandLine contains "cscript" or CommandLine contains "curl" or CommandLine contains "finger" or CommandLine contains "mshta" or CommandLine contains "powershell" or CommandLine contains "pwsh" or CommandLine contains "regsvr32" or CommandLine contains "rundll32" or CommandLine contains "schtasks" or CommandLine contains "wget" or CommandLine contains "wscript") or (CommandLine contains "account" or CommandLine contains "anti-bot" or CommandLine contains "botcheck" or CommandLine contains "captcha" or CommandLine contains "challenge" or CommandLine contains "confirmation" or CommandLine contains "fraud" or CommandLine contains "human" or CommandLine contains "identification" or CommandLine contains "identificator" or CommandLine contains "identity" or CommandLine contains "robot" or CommandLine contains "validation" or CommandLine contains "verification" or CommandLine contains "verify"))