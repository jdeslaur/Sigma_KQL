SecurityEvent
| where ((CommandLine contains "rundll32" and CommandLine contains "apphelp.dll") and (CommandLine contains "ShimFlushCache" or CommandLine contains "#250")) or ((CommandLine contains "rundll32" and CommandLine contains "kernel32.dll") and (CommandLine contains "BaseFlushAppcompatCache" or CommandLine contains "#46"))