// Title: Potentially Suspicious Event Viewer Child Process
// Rule ID: be344333-921d-4c4d-8bb8-e584cf584780
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation, attack.t1548.002, car.2019-04-001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_eventvwr_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\eventvwr.exe" and (not((NewProcessName endswith ":\\Windows\\System32\\mmc.exe" or NewProcessName endswith ":\\Windows\\System32\\WerFault.exe" or NewProcessName endswith ":\\Windows\\SysWOW64\\WerFault.exe")))