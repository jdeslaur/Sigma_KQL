// Title: Potentially Suspicious WebDAV LNK Execution
// Rule ID: 1412aa78-a24c-4abd-83df-767dfb2c5bbe
// Severity: medium
// Tags: attack.execution, attack.t1059.001, attack.t1204
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_webdav_lnk_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\explorer.exe" and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wscript.exe") and CommandLine contains "\\DavWWWRoot\\"