SecurityEvent
| where (CommandLine contains "~1\\" or CommandLine contains "~2\\") and (not(((ParentProcessName in~ ("C:\\Windows\\System32\\Dism.exe", "C:\\Windows\\System32\\cleanmgr.exe")) or (ParentProcessName endswith "\\winget.exe" or ParentProcessName contains "\\AppData\\Local\\Temp\\WinGet\\") or (ParentProcessName startswith "C:\\Windows\\Microsoft.NET\\Framework64\\v" and ParentProcessName endswith "\\csc.exe") or ((NewProcessName contains "\\AppData\\" and NewProcessName contains "\\Temp\\") or CommandLine contains "\\AppData\\Local\\Temp\\")))) and (not((ParentProcessName =~ "C:\\Program Files\\GPSoftware\\Directory Opus\\dopus.exe" or (ParentProcessName endswith "\\aurora-agent-64.exe" or ParentProcessName endswith "\\aurora-agent.exe") or ParentProcessName endswith "\\thor\\thor64.exe" or (CommandLine contains "C:\\Program Files\\Git\\post-install.bat" or CommandLine contains "C:\\Program Files\\Git\\cmd\\scalar.exe") or (ParentProcessName endswith "\\WebEx\\webexhost.exe" or CommandLine contains "\\appdata\\local\\webex\\webex64\\meetings\\wbxreport.exe") or ParentProcessName endswith "\\veeam.backup.shell.exe" or ParentProcessName endswith "\\Everything\\Everything.exe")))