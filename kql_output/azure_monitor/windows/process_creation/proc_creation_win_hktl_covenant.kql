SecurityEvent
| where ((CommandLine contains "-Sta" and CommandLine contains "-Nop" and CommandLine contains "-Window" and CommandLine contains "Hidden") and (CommandLine contains "-Command" or CommandLine contains "-EncodedCommand")) or (CommandLine contains "sv o (New-Object IO.MemorySteam);sv d " or CommandLine contains "mshta file.hta" or CommandLine contains "GruntHTTP" or CommandLine contains "-EncodedCommand cwB2ACAAbwAgA")