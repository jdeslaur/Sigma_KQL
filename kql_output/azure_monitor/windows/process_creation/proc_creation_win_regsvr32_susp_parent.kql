// Title: Scripting/CommandLine Process Spawned Regsvr32
// Rule ID: ab37a6ec-6068-432b-a64e-2c7bf95b1d22
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218.010
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_regsvr32_susp_parent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName endswith "\\cmd.exe" or ParentProcessName endswith "\\cscript.exe" or ParentProcessName endswith "\\mshta.exe" or ParentProcessName endswith "\\powershell_ise.exe" or ParentProcessName endswith "\\powershell.exe" or ParentProcessName endswith "\\pwsh.exe" or ParentProcessName endswith "\\wscript.exe") and NewProcessName endswith "\\regsvr32.exe") and (not((ParentProcessName =~ "C:\\Windows\\System32\\cmd.exe" and CommandLine endswith " /s C:\\Windows\\System32\\RpcProxy\\RpcProxy.dll")))