SecurityEvent
| where (CommandLine contains "iex " or CommandLine contains "Invoke-Expression " or CommandLine contains "Invoke-Command " or CommandLine contains "icm ") and (CommandLine contains "cat " or CommandLine contains "get-content " or CommandLine contains "type ") and CommandLine contains " -raw"