// Title: Suspicious IIS Module Registration
// Rule ID: 043c4b8b-3a54-4780-9682-081cb6b8185c
// Severity: high
// Tags: attack.persistence, attack.t1505.004
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_iis_susp_module_registration.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\w3wp.exe" and (CommandLine contains "appcmd.exe add module" or (CommandLine contains " system.enterpriseservices.internal.publish" and NewProcessName endswith "\\powershell.exe") or (CommandLine contains "gacutil" and CommandLine contains " /I"))