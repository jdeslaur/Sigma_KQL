// Title: Suspicious Msiexec Execute Arbitrary DLL
// Rule ID: 6f4191bb-912b-48a8-9ce7-682769541e6d
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218.007
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_msiexec_execute_dll.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\msiexec.exe" and (CommandLine contains " -y" or CommandLine contains " /y" or CommandLine contains " –y" or CommandLine contains " —y" or CommandLine contains " ―y")) and (not((CommandLine contains "\\MsiExec.exe\" /Y \"C:\\Program Files\\Bonjour\\mdnsNSP.dll" or CommandLine contains "\\MsiExec.exe\" /Y \"C:\\Program Files (x86)\\Bonjour\\mdnsNSP.dll" or CommandLine contains "\\MsiExec.exe\" /Y \"C:\\Program Files (x86)\\Apple Software Update\\ScriptingObjectModel.dll" or CommandLine contains "\\MsiExec.exe\" /Y \"C:\\Program Files (x86)\\Apple Software Update\\SoftwareUpdateAdmin.dll" or CommandLine contains "\\MsiExec.exe\" /Y \"C:\\Windows\\CCM\\" or CommandLine contains "\\MsiExec.exe\" /Y C:\\Windows\\CCM\\" or CommandLine contains "\\MsiExec.exe\" -Y \"C:\\Program Files\\Bonjour\\mdnsNSP.dll" or CommandLine contains "\\MsiExec.exe\" -Y \"C:\\Program Files (x86)\\Bonjour\\mdnsNSP.dll" or CommandLine contains "\\MsiExec.exe\" -Y \"C:\\Program Files (x86)\\Apple Software Update\\ScriptingObjectModel.dll" or CommandLine contains "\\MsiExec.exe\" -Y \"C:\\Program Files (x86)\\Apple Software Update\\SoftwareUpdateAdmin.dll" or CommandLine contains "\\MsiExec.exe\" -Y \"C:\\Windows\\CCM\\" or CommandLine contains "\\MsiExec.exe\" -Y C:\\Windows\\CCM\\")))