// Title: Potentially Suspicious Windows App Activity
// Rule ID: f91ed517-a6ba-471d-9910-b3b4a398c0f3
// Severity: medium
// Tags: attack.defense-evasion
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_appx_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName contains "C:\\Program Files\\WindowsApps\\" and ((NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\powershell_ise.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\wscript.exe") or (CommandLine contains "cmd /c" or CommandLine contains "Invoke-" or CommandLine contains "Base64")) and (not(((ParentProcessName contains ":\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal" and ParentProcessName endswith "\\WindowsTerminal.exe" and (NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\pwsh.exe")) or (ParentProcessName startswith "C:\\Program Files\\WindowsApps\\Microsoft.SysinternalsSuite" and NewProcessName endswith "\\cmd.exe"))))