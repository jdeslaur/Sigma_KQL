SecurityEvent
| where (NewProcessName endswith "\\lazagne.exe" or ((NewProcessName contains ":\\PerfLogs\\" or NewProcessName contains ":\\ProgramData\\" or NewProcessName contains ":\\Temp\\" or NewProcessName contains ":\\Tmp\\" or NewProcessName contains ":\\Users\\Public\\" or NewProcessName contains ":\\Windows\\Temp\\" or NewProcessName contains "\\$Recycle.bin" or NewProcessName contains "\\AppData\\" or NewProcessName contains "\\Desktop\\" or NewProcessName contains "\\Downloads\\" or NewProcessName contains "\\Favorites\\" or NewProcessName contains "\\Links\\" or NewProcessName contains "\\Music\\" or NewProcessName contains "\\Photos\\" or NewProcessName contains "\\Pictures\\" or NewProcessName contains "\\Saved Games\\" or NewProcessName contains "\\Searches\\" or NewProcessName contains "\\Users\\Contacts\\" or NewProcessName contains "\\Users\\Default\\" or NewProcessName contains "\\Users\\Searches\\" or NewProcessName contains "\\Videos\\" or NewProcessName contains "\\Windows\\addins\\" or NewProcessName contains "\\Windows\\Fonts\\" or NewProcessName contains "\\Windows\\IME\\") and (CommandLine endswith ".exe all" or CommandLine endswith ".exe browsers" or CommandLine endswith ".exe chats" or CommandLine endswith ".exe databases" or CommandLine endswith ".exe games" or CommandLine endswith ".exe git" or CommandLine endswith ".exe mails" or CommandLine endswith ".exe maven" or CommandLine endswith ".exe memory" or CommandLine endswith ".exe multimedia" or CommandLine endswith ".exe sysadmin" or CommandLine endswith ".exe unused" or CommandLine endswith ".exe wifi" or CommandLine endswith ".exe windows"))) or ((CommandLine contains " all " or CommandLine contains " browsers " or CommandLine contains " chats " or CommandLine contains " databases " or CommandLine contains " games " or CommandLine contains " mails " or CommandLine contains " maven " or CommandLine contains " memory " or CommandLine contains " multimedia " or CommandLine contains " php " or CommandLine contains " svn " or CommandLine contains " sysadmin " or CommandLine contains " unused " or CommandLine contains " wifi ") and (CommandLine contains "-1Password" or CommandLine contains "-apachedirectorystudio" or CommandLine contains "-autologon" or CommandLine contains "-ChromiumBased" or CommandLine contains "-coreftp" or CommandLine contains "-credfiles" or CommandLine contains "-credman" or CommandLine contains "-cyberduck" or CommandLine contains "-dbvis" or CommandLine contains "-EyeCon" or CommandLine contains "-filezilla" or CommandLine contains "-filezillaserver" or CommandLine contains "-ftpnavigator" or CommandLine contains "-galconfusion" or CommandLine contains "-gitforwindows" or CommandLine contains "-hashdump" or CommandLine contains "-iisapppool" or CommandLine contains "-IISCentralCertP" or CommandLine contains "-kalypsomedia" or CommandLine contains "-keepass" or CommandLine contains "-keepassconfig" or CommandLine contains "-lsa_secrets" or CommandLine contains "-mavenrepositories" or CommandLine contains "-memory_dump" or CommandLine contains "-Mozilla" or CommandLine contains "-mRemoteNG" or CommandLine contains "-mscache" or CommandLine contains "-opensshforwindows" or CommandLine contains "-openvpn" or CommandLine contains "-outlook" or CommandLine contains "-pidgin" or CommandLine contains "-postgresql" or CommandLine contains "-psi-im" or CommandLine contains "-puttycm" or CommandLine contains "-pypykatz" or CommandLine contains "-Rclone" or CommandLine contains "-rdpmanager" or CommandLine contains "-robomongo" or CommandLine contains "-roguestale" or CommandLine contains "-skype" or CommandLine contains "-SQLDeveloper" or CommandLine contains "-squirrel" or CommandLine contains "-tortoise" or CommandLine contains "-turba" or CommandLine contains "-UCBrowser" or CommandLine contains "-unattended" or CommandLine contains "-vault" or CommandLine contains "-vaultfiles" or CommandLine contains "-vnc" or CommandLine contains "-winscp"))