// Title: Suspicious ArcSOC.exe Child Process
// Rule ID: 8e95e73e-ba02-4a87-b4d7-0929b8053038
// Severity: high
// Tags: attack.execution, attack.t1059, attack.t1203
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_arcsoc_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\ArcSOC.exe" and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\wmic.exe" or NewProcessName endswith "\\wscript.exe")) and (not((NewProcessName endswith "\\cmd.exe" and CommandLine =~ "cmd.exe /c \"ver\"")))