// Title: Potentially Suspicious Child Process Of DiskShadow.EXE
// Rule ID: 9f546b25-5f12-4c8d-8532-5893dcb1e4b8
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_diskshadow_child_process_susp.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\diskshadow.exe" and (NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\wscript.exe")