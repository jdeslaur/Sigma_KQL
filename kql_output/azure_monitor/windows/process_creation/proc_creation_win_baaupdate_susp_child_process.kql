// Title: Suspicious BitLocker Access Agent Update Utility Execution
// Rule ID: 9f38c1db-e2ae-40bf-81d0-5b68f73fb512
// Severity: high
// Tags: attack.defense-evasion, attack.t1218, attack.lateral-movement, attack.t1021.003
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_baaupdate_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\baaupdate.exe" and (NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell_ise.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\wmic.exe" or NewProcessName endswith "\\wscript.exe")