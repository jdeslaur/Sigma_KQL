// Title: Suspicious PowerShell Invocations - Specific - ProcessCreation
// Rule ID: 536e2947-3729-478c-9903-745aaffe60d2
// Severity: medium
// Tags: attack.defense-evasion
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_invocation_specific.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((CommandLine contains "-nop" and CommandLine contains " -w " and CommandLine contains "hidden" and CommandLine contains " -c " and CommandLine contains "[Convert]::FromBase64String") or (CommandLine contains " -w " and CommandLine contains "hidden" and CommandLine contains "-noni" and CommandLine contains "-nop" and CommandLine contains " -c " and CommandLine contains "iex" and CommandLine contains "New-Object") or (CommandLine contains " -w " and CommandLine contains "hidden" and CommandLine contains "-ep" and CommandLine contains "bypass" and CommandLine contains "-Enc") or (CommandLine contains "powershell" and CommandLine contains "reg" and CommandLine contains "add" and CommandLine contains "\\software\\") or (CommandLine contains "bypass" and CommandLine contains "-noprofile" and CommandLine contains "-windowstyle" and CommandLine contains "hidden" and CommandLine contains "new-object" and CommandLine contains "system.net.webclient" and CommandLine contains ".download") or (CommandLine contains "iex" and CommandLine contains "New-Object" and CommandLine contains "Net.WebClient" and CommandLine contains ".Download")) and (not((CommandLine contains "(New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1" or CommandLine contains "Write-ChocolateyWarning")))