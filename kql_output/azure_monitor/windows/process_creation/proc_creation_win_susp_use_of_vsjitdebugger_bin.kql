SecurityEvent
| where ParentProcessName endswith "\\vsjitdebugger.exe" and (not(((NewProcessName contains "\\vsimmersiveactivatehelper" and NewProcessName contains ".exe") or NewProcessName endswith "\\devenv.exe")))