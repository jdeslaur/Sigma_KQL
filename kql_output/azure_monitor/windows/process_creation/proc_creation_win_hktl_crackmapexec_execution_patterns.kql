SecurityEvent
| where (CommandLine contains "cmd.exe /Q /c " and CommandLine contains " 1> \\" and CommandLine contains "\\" and CommandLine contains "\\" and CommandLine contains " 2>&1") or (CommandLine contains "cmd.exe /C " and CommandLine contains " > \\" and CommandLine contains "\\" and CommandLine contains "\\" and CommandLine contains " 2>&1") or (CommandLine contains "cmd.exe /C " and CommandLine contains " > " and CommandLine contains "\\Temp\\" and CommandLine contains " 2>&1") or CommandLine contains "powershell.exe -exec bypass -noni -nop -w 1 -C \"" or CommandLine contains "powershell.exe -noni -nop -w 1 -enc "