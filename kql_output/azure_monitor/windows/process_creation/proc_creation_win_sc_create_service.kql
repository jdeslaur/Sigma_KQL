SecurityEvent
| where (NewProcessName endswith "\\sc.exe" and (CommandLine contains "create" and CommandLine contains "binPath")) and (not(((ParentProcessName startswith "C:\\Program Files (x86)\\Dropbox\\Client\\" or ParentProcessName startswith "C:\\Program Files\\Dropbox\\Client\\") and ParentProcessName endswith "\\Dropbox.exe")))