// Title: Windows Processes Suspicious Parent Directory
// Rule ID: 96036718-71cc-4027-a538-d1587e0006a7
// Severity: low
// Tags: attack.defense-evasion, attack.t1036.003, attack.t1036.005
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_proc_wrong_parent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\svchost.exe" or NewProcessName endswith "\\taskhost.exe" or NewProcessName endswith "\\lsm.exe" or NewProcessName endswith "\\lsass.exe" or NewProcessName endswith "\\services.exe" or NewProcessName endswith "\\lsaiso.exe" or NewProcessName endswith "\\csrss.exe" or NewProcessName endswith "\\wininit.exe" or NewProcessName endswith "\\winlogon.exe") and (not((((ParentProcessName endswith "\\SavService.exe" or ParentProcessName endswith "\\ngen.exe") or (ParentProcessName contains "\\System32\\" or ParentProcessName contains "\\SysWOW64\\")) or ((ParentProcessName contains "\\Windows Defender\\" or ParentProcessName contains "\\Microsoft Security Client\\") and ParentProcessName endswith "\\MsMpEng.exe") or (isnull(ParentProcessName) or (ParentProcessName in~ ("", "-"))))))