// Title: Execution of Powershell Script in Public Folder
// Rule ID: fb9d3ff7-7348-46ab-af8c-b55f5fbf39b4
// Severity: high
// Tags: attack.execution, attack.t1059.001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_public_folder.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and (CommandLine contains "-f C:\\Users\\Public" or CommandLine contains "-f \"C:\\Users\\Public" or CommandLine contains "-f %Public%" or CommandLine contains "-fi C:\\Users\\Public" or CommandLine contains "-fi \"C:\\Users\\Public" or CommandLine contains "-fi %Public%" or CommandLine contains "-fil C:\\Users\\Public" or CommandLine contains "-fil \"C:\\Users\\Public" or CommandLine contains "-fil %Public%" or CommandLine contains "-file C:\\Users\\Public" or CommandLine contains "-file \"C:\\Users\\Public" or CommandLine contains "-file %Public%")