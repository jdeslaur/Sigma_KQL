// Title: PUA - Netcat Suspicious Execution
// Rule ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Severity: high
// Tags: attack.command-and-control, attack.t1095
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_pua_netcat.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\nc.exe" or NewProcessName endswith "\\ncat.exe" or NewProcessName endswith "\\netcat.exe") or (CommandLine contains " -lvp " or CommandLine contains " -lvnp" or CommandLine contains " -l -v -p " or CommandLine contains " -lv -p " or CommandLine contains " -l --proxy-type http " or CommandLine contains " -vnl --exec " or CommandLine contains " -vnl -e " or CommandLine contains " --lua-exec " or CommandLine contains " --sh-exec ")