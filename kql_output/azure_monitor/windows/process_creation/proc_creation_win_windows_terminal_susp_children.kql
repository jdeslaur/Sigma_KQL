// Title: Suspicious WindowsTerminal Child Processes
// Rule ID: 8de89e52-f6e1-4b5b-afd1-41ecfa300d48
// Severity: medium
// Tags: attack.execution, attack.persistence
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_windows_terminal_susp_children.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName endswith "\\WindowsTerminal.exe" or ParentProcessName endswith "\\wt.exe") and ((NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\csc.exe") or (NewProcessName contains "C:\\Users\\Public\\" or NewProcessName contains "\\Downloads\\" or NewProcessName contains "\\Desktop\\" or NewProcessName contains "\\AppData\\Local\\Temp\\" or NewProcessName contains "\\Windows\\TEMP\\") or (CommandLine contains " iex " or CommandLine contains " icm" or CommandLine contains "Invoke-" or CommandLine contains "Import-Module " or CommandLine contains "ipmo " or CommandLine contains "DownloadString(" or CommandLine contains " /c " or CommandLine contains " /k " or CommandLine contains " /r "))) and (not(((CommandLine contains "Import-Module" and CommandLine contains "Microsoft.VisualStudio.DevShell.dll" and CommandLine contains "Enter-VsDevShell") or (CommandLine contains "\\AppData\\Local\\Packages\\Microsoft.WindowsTerminal_" and CommandLine contains "\\LocalState\\settings.json") or (CommandLine contains "C:\\Program Files\\Microsoft Visual Studio\\" and CommandLine contains "\\Common7\\Tools\\VsDevCmd.bat"))))