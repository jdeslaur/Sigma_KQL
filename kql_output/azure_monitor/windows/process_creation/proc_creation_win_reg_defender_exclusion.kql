// Title: Suspicious Windows Defender Folder Exclusion Added Via Reg.EXE
// Rule ID: 48917adc-a28e-4f5d-b729-11e75da8941f
// Severity: medium
// Tags: attack.defense-evasion, attack.t1562.001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_reg_defender_exclusion.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\reg.exe" and (CommandLine contains "SOFTWARE\\Microsoft\\Windows Defender\\Exclusions\\Paths" or CommandLine contains "SOFTWARE\\Microsoft\\Microsoft Antimalware\\Exclusions\\Paths") and (CommandLine contains "ADD " and CommandLine contains "/t " and CommandLine contains "REG_DWORD " and CommandLine contains "/v " and CommandLine contains "/d " and CommandLine contains "0")