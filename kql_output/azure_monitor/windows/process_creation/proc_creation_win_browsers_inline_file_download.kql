// Title: File Download From Browser Process Via Inline URL
// Rule ID: 94771a71-ba41-4b6e-a757-b531372eaab6
// Severity: medium
// Tags: attack.command-and-control, attack.t1105
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_browsers_inline_file_download.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\chrome.exe" or NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\vivaldi.exe") and CommandLine contains "http" and ((CommandLine endswith ".7z" or CommandLine endswith ".dat" or CommandLine endswith ".dll" or CommandLine endswith ".exe" or CommandLine endswith ".hta" or CommandLine endswith ".ps1" or CommandLine endswith ".psm1" or CommandLine endswith ".txt" or CommandLine endswith ".vbe" or CommandLine endswith ".vbs" or CommandLine endswith ".zip") or (CommandLine contains ".7z\"" or CommandLine contains ".dat\"" or CommandLine contains ".dll\"" or CommandLine contains ".hta\"" or CommandLine contains ".ps1\"" or CommandLine contains ".psm1\"" or CommandLine contains ".txt\"" or CommandLine contains ".vbe\"" or CommandLine contains ".vbs\"" or CommandLine contains ".zip\""))