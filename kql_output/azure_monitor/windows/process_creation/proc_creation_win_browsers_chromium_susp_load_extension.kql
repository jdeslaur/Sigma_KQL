// Title: Suspicious Chromium Browser Instance Executed With Custom Extension
// Rule ID: 27ba3207-dd30-4812-abbf-5d20c57d474e
// Severity: high
// Tags: attack.persistence, attack.t1176.001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_browsers_chromium_susp_load_extension.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\cmd.exe" or ParentProcessName endswith "\\cscript.exe" or ParentProcessName endswith "\\mshta.exe" or ParentProcessName endswith "\\powershell.exe" or ParentProcessName endswith "\\pwsh.exe" or ParentProcessName endswith "\\regsvr32.exe" or ParentProcessName endswith "\\rundll32.exe" or ParentProcessName endswith "\\wscript.exe") and (NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\chrome.exe" or NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\vivaldi.exe") and CommandLine contains "--load-extension="