// Title: OneNote.EXE Execution of Malicious Embedded Scripts
// Rule ID: 84b1706c-932a-44c4-ae28-892b28a25b94
// Severity: high
// Tags: attack.defense-evasion, attack.t1218.001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_office_onenote_embedded_script_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\onenote.exe" and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wscript.exe") and (CommandLine contains "\\exported\\" or CommandLine contains "\\onenoteofflinecache_files\\")