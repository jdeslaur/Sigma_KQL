// Title: Scheduled Task Creation From Potential Suspicious Parent Location
// Rule ID: 9494479d-d994-40bf-a8b1-eea890237021
// Severity: medium
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.t1053.005, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_schtasks_creation_from_susp_parent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName contains ":\\Temp\\" or ParentProcessName contains "\\AppData\\Local\\" or ParentProcessName contains "\\AppData\\Roaming\\" or ParentProcessName contains "\\Temporary Internet" or ParentProcessName contains "\\Users\\Public\\" or ParentProcessName contains "\\Windows\\Temp\\") and NewProcessName endswith "\\schtasks.exe" and CommandLine contains "/Create ") and (not((CommandLine contains "update_task.xml" or CommandLine contains "unattended.ini")))