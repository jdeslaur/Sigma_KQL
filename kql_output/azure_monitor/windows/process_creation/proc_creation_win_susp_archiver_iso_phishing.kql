// Title: Phishing Pattern ISO in Archive
// Rule ID: fcdf69e5-a3d3-452a-9724-26f2308bf2b1
// Severity: high
// Tags: attack.initial-access, attack.t1566
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_archiver_iso_phishing.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\Winrar.exe" or ParentProcessName endswith "\\7zFM.exe" or ParentProcessName endswith "\\peazip.exe") and (NewProcessName endswith "\\isoburn.exe" or NewProcessName endswith "\\PowerISO.exe" or NewProcessName endswith "\\ImgBurn.exe")