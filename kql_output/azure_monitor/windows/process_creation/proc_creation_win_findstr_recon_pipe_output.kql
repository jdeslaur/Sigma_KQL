// Title: Recon Command Output Piped To Findstr.EXE
// Rule ID: ccb5742c-c248-4982-8c5c-5571b9275ad3
// Severity: medium
// Tags: attack.discovery, attack.t1057
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_findstr_recon_pipe_output.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((CommandLine contains "ipconfig" and CommandLine contains "|" and CommandLine contains "find") or (CommandLine contains "net" and CommandLine contains "|" and CommandLine contains "find") or (CommandLine contains "netstat" and CommandLine contains "|" and CommandLine contains "find") or (CommandLine contains "ping" and CommandLine contains "|" and CommandLine contains "find") or (CommandLine contains "systeminfo" and CommandLine contains "|" and CommandLine contains "find") or (CommandLine contains "tasklist" and CommandLine contains "|" and CommandLine contains "find") or (CommandLine contains "whoami" and CommandLine contains "|" and CommandLine contains "find")) and (not((CommandLine contains "cmd.exe /c TASKLIST /V |" and CommandLine contains "FIND /I" and CommandLine contains "\\xampp\\" and CommandLine contains "\\catalina_start.bat")))