// Title: Sdiagnhost Calling Suspicious Child Process
// Rule ID: f3d39c45-de1a-4486-a687-ab126124f744
// Severity: high
// Tags: attack.defense-evasion, attack.t1036, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_sdiagnhost_susp_child.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\sdiagnhost.exe" and (NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\taskkill.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\calc.exe")) and (not(((NewProcessName endswith "\\cmd.exe" and CommandLine contains "bits") or (NewProcessName endswith "\\powershell.exe" and (CommandLine endswith "-noprofile -" or CommandLine endswith "-noprofile")))))