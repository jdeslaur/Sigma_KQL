// Title: Use NTFS Short Name in Image
// Rule ID: 3ef5605c-9eb9-47b0-9a71-b727e6aa5c3b
// Severity: medium
// Tags: attack.defense-evasion, attack.t1564.004
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_ntfs_short_name_use_image.yml
//
// Generated by sigma-to-kql converter
