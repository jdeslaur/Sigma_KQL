// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName contains "~1.bat" or NewProcessName contains "~1.dll" or NewProcessName contains "~1.exe" or NewProcessName contains "~1.hta" or NewProcessName contains "~1.js" or NewProcessName contains "~1.msi" or NewProcessName contains "~1.ps1" or NewProcessName contains "~1.tmp" or NewProcessName contains "~1.vbe" or NewProcessName contains "~1.vbs" or NewProcessName contains "~2.bat" or NewProcessName contains "~2.dll" or NewProcessName contains "~2.exe" or NewProcessName contains "~2.hta" or NewProcessName contains "~2.js" or NewProcessName contains "~2.msi" or NewProcessName contains "~2.ps1" or NewProcessName contains "~2.tmp" or NewProcessName contains "~2.vbe" or NewProcessName contains "~2.vbs") and (not(ParentProcessName =~ "C:\\Windows\\explorer.exe")) and (not((ParentProcessName endswith "\\WebEx\\WebexHost.exe" or ParentProcessName endswith "\\thor\\thor64.exe" or NewProcessName =~ "C:\\PROGRA~1\\WinZip\\WZPREL~1.EXE" or NewProcessName endswith "\\VCREDI~1.EXE")))