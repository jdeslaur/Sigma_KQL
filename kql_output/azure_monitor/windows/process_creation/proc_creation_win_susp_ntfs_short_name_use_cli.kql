// Title: Use NTFS Short Name in Command Line
// Rule ID: dd6b39d9-d9be-4a3b-8fe0-fe3c6a5c1795
// Severity: medium
// Tags: attack.defense-evasion, attack.t1564.004
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_ntfs_short_name_use_cli.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains "~1.exe" or CommandLine contains "~1.bat" or CommandLine contains "~1.msi" or CommandLine contains "~1.vbe" or CommandLine contains "~1.vbs" or CommandLine contains "~1.dll" or CommandLine contains "~1.ps1" or CommandLine contains "~1.js" or CommandLine contains "~1.hta" or CommandLine contains "~2.exe" or CommandLine contains "~2.bat" or CommandLine contains "~2.msi" or CommandLine contains "~2.vbe" or CommandLine contains "~2.vbs" or CommandLine contains "~2.dll" or CommandLine contains "~2.ps1" or CommandLine contains "~2.js" or CommandLine contains "~2.hta") and (not(((ParentProcessName endswith "\\WebEx\\WebexHost.exe" or ParentProcessName endswith "\\thor\\thor64.exe") or CommandLine contains "C:\\xampp\\vcredist\\VCREDI~1.EXE")))