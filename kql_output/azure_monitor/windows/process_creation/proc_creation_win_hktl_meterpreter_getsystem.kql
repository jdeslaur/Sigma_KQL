SecurityEvent
| where ParentProcessName endswith "\\services.exe" and (((CommandLine contains "/c" and CommandLine contains "echo" and CommandLine contains "\\pipe\\") and (CommandLine contains "cmd" or CommandLine contains "%COMSPEC%")) or (CommandLine contains "rundll32" and CommandLine contains ".dll,a" and CommandLine contains "/p:")) and (not(CommandLine contains "MpCmdRun"))