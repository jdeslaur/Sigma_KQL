SecurityEvent
| where (CommandLine matches regex "\\w+`(\\w+|-|.)`[\\w+|\\s]" or CommandLine matches regex "\"(\\{\\d\\})+\"\\s*-f" or CommandLine matches regex "(?i)\\$\\{`?e`?n`?v`?:`?p`?a`?t`?h`?\\}") and (not(CommandLine contains "${env:path}"))