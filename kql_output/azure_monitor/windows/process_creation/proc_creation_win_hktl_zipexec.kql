| where (CommandLine contains "/generic:Microsoft_Windows_Shell_ZipFolder:filename=" and CommandLine contains ".zip" and CommandLine contains "/pass:" and CommandLine contains "/user:") or (CommandLine contains "/delete" and CommandLine contains "Microsoft_Windows_Shell_ZipFolder:filename=" and CommandLine contains ".zip")