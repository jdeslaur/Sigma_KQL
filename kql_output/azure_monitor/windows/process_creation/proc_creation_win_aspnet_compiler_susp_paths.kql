SecurityEvent
| where (NewProcessName contains ":\\Windows\\Microsoft.NET\\Framework\\" or NewProcessName contains ":\\Windows\\Microsoft.NET\\Framework64\\" or NewProcessName contains ":\\Windows\\Microsoft.NET\\FrameworkArm\\" or NewProcessName contains ":\\Windows\\Microsoft.NET\\FrameworkArm64\\") and NewProcessName endswith "\\aspnet_compiler.exe" and (CommandLine contains "\\Users\\Public\\" or CommandLine contains "\\AppData\\Local\\Temp\\" or CommandLine contains "\\AppData\\Local\\Roaming\\" or CommandLine contains ":\\Temp\\" or CommandLine contains ":\\Windows\\Temp\\" or CommandLine contains ":\\Windows\\System32\\Tasks\\" or CommandLine contains ":\\Windows\\Tasks\\")