SecurityEvent
| where (NewProcessName contains ":\\RECYCLER\\" or NewProcessName contains ":\\SystemVolumeInformation\\") or (NewProcessName startswith "C:\\Windows\\Tasks\\" or NewProcessName startswith "C:\\Windows\\debug\\" or NewProcessName startswith "C:\\Windows\\fonts\\" or NewProcessName startswith "C:\\Windows\\help\\" or NewProcessName startswith "C:\\Windows\\drivers\\" or NewProcessName startswith "C:\\Windows\\addins\\" or NewProcessName startswith "C:\\Windows\\cursors\\" or NewProcessName startswith "C:\\Windows\\system32\\tasks\\")