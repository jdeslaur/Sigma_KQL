SecurityEvent
| where ((CommandLine contains "--password-file" and CommandLine contains "init" and CommandLine contains " -r ") or (CommandLine contains "--use-fs-snapshot" and CommandLine contains "backup" and CommandLine contains " -r ")) or ((CommandLine contains "sftp:" or CommandLine contains "rest:http" or CommandLine contains "s3:s3." or CommandLine contains "s3.http" or CommandLine contains "azure:" or CommandLine contains " gs:" or CommandLine contains "rclone:" or CommandLine contains "swift:" or CommandLine contains " b2:") and (CommandLine contains " init " and CommandLine contains " -r "))