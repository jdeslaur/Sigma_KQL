// Title: Shell Process Spawned by Java.EXE
// Rule ID: dff1e1cc-d3fd-47c8-bfc2-aeb878a754c0
// Severity: medium
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_java_susp_child_process_2.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\java.exe" and (NewProcessName endswith "\\bash.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe")) and (not((ParentProcessName contains "build" and CommandLine contains "build")))