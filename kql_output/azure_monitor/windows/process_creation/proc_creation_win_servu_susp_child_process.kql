// Title: Suspicious Serv-U Process Pattern
// Rule ID: 58f4ea09-0fc2-4520-ba18-b85c540b0eaf
// Severity: high
// Tags: attack.credential-access, attack.t1555, cve.2021-35211
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_servu_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\Serv-U.exe" and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\sh.exe" or NewProcessName endswith "\\bash.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\wmic.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\msiexec.exe" or NewProcessName endswith "\\forfiles.exe" or NewProcessName endswith "\\scriptrunner.exe")