// Title: PowerShell Script Run in AppData
// Rule ID: ac175779-025a-4f12-98b0-acdaeb77ea85
// Severity: medium
// Tags: attack.execution, attack.t1059.001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_susp_ps_appdata.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains "powershell.exe" or CommandLine contains "\\powershell" or CommandLine contains "\\pwsh" or CommandLine contains "pwsh.exe") and ((CommandLine contains "/c " and CommandLine contains "\\AppData\\") and (CommandLine contains "Local\\" or CommandLine contains "Roaming\\"))