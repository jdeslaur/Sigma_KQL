// Title: Potential Suspicious Browser Launch From Document Reader Process
// Rule ID: 1193d960-2369-499f-a158-7b50a31df682
// Severity: medium
// Tags: attack.execution, attack.t1204.002
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_browser_launch_from_document_reader_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName contains "Acrobat Reader" or ParentProcessName contains "Microsoft Office" or ParentProcessName contains "PDF Reader") and (NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\chrome.exe" or NewProcessName endswith "\\firefox.exe" or NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\maxthon.exe" or NewProcessName endswith "\\seamonkey.exe" or NewProcessName endswith "\\vivaldi.exe") and CommandLine contains "http") and (not(CommandLine contains "https://go.microsoft.com/fwlink/")) and (not(((CommandLine contains "http://ad.foxitsoftware.com/adlog.php") or (CommandLine contains "https://globe-map.foxitservice.com/go.php" and CommandLine contains "do=redirect"))))