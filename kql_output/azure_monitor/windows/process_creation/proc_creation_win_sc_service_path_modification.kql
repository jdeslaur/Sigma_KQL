// Title: Suspicious Service Path Modification
// Rule ID: 138d3531-8793-4f50-a2cd-f291b2863d78
// Severity: high
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_sc_service_path_modification.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\sc.exe" and (CommandLine contains "config" and CommandLine contains "binPath") and (CommandLine contains "powershell" or CommandLine contains "cmd " or CommandLine contains "mshta" or CommandLine contains "wscript" or CommandLine contains "cscript" or CommandLine contains "rundll32" or CommandLine contains "svchost" or CommandLine contains "dllhost" or CommandLine contains "cmd.exe /c" or CommandLine contains "cmd.exe /k" or CommandLine contains "cmd.exe /r" or CommandLine contains "cmd /c" or CommandLine contains "cmd /k" or CommandLine contains "cmd /r" or CommandLine contains "C:\\Users\\Public" or CommandLine contains "\\Downloads\\" or CommandLine contains "\\Desktop\\" or CommandLine contains "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\" or CommandLine contains "C:\\Windows\\TEMP\\" or CommandLine contains "\\AppData\\Local\\Temp")