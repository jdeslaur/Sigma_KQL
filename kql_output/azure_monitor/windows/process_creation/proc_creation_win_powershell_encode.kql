// Title: Suspicious Execution of Powershell with Base64
// Rule ID: fb843269-508c-4b76-8b8d-88679db22ce7
// Severity: medium
// Tags: attack.execution, attack.t1059.001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_powershell_encode.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and (CommandLine contains " -e " or CommandLine contains " -en " or CommandLine contains " -enc " or CommandLine contains " -enco" or CommandLine contains " -ec ")) and (not((CommandLine contains " -Encoding " or (ParentProcessName contains "C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\" or ParentProcessName contains "\\gc_worker.exe"))))