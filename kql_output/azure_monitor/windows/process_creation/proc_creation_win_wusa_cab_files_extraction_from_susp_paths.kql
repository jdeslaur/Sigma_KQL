//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\wusa.exe" and CommandLine contains "/extract:") and (CommandLine contains ":\\PerfLogs\\" or CommandLine contains ":\\Users\\Public\\" or CommandLine contains ":\\Windows\\Temp\\" or CommandLine contains "\\Appdata\\Local\\Temp\\")