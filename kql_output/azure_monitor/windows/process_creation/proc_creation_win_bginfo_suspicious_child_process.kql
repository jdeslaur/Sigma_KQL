// Title: Suspicious Child Process Of BgInfo.EXE
// Rule ID: 811f459f-9231-45d4-959a-0266c6311987
// Severity: high
// Tags: attack.execution, attack.t1059.005, attack.defense-evasion, attack.t1218, attack.t1202
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_bginfo_suspicious_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\bginfo.exe" or ParentProcessName endswith "\\bginfo64.exe") and ((NewProcessName endswith "\\calc.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\notepad.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wscript.exe") or (NewProcessName contains "\\AppData\\Local\\" or NewProcessName contains "\\AppData\\Roaming\\" or NewProcessName contains ":\\Users\\Public\\" or NewProcessName contains ":\\Temp\\" or NewProcessName contains ":\\Windows\\Temp\\" or NewProcessName contains ":\\PerfLogs\\"))