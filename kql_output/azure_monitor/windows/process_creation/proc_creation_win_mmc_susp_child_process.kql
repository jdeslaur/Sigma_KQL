// Title: MMC Spawning Windows Shell
// Rule ID: 05a2ab7e-ce11-4b63-86db-ab32e763e11d
// Severity: high
// Tags: attack.lateral-movement, attack.t1021.003
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_mmc_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\mmc.exe" and ((NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\sh.exe" or NewProcessName endswith "\\bash.exe" or NewProcessName endswith "\\reg.exe" or NewProcessName endswith "\\regsvr32.exe") or NewProcessName contains "\\BITSADMIN")