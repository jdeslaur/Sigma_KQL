// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and (CommandLine contains " | iex;" or CommandLine contains " | iex " or CommandLine contains " | iex}" or CommandLine contains " | IEX ;" or CommandLine contains " | IEX -Error" or CommandLine contains " | IEX (new" or CommandLine contains ");IEX ")) and (CommandLine contains "::FromBase64String" or CommandLine contains ".GetString([System.Convert]::")) or (CommandLine contains ")|iex;$" or CommandLine contains ");iex($" or CommandLine contains ");iex $" or CommandLine contains " | IEX | " or CommandLine contains " | iex\\\"")