SecurityEvent
| where CommandLine contains "Set-MpPreference" and (CommandLine contains "-LowThreatDefaultAction" or CommandLine contains "-ModerateThreatDefaultAction" or CommandLine contains "-HighThreatDefaultAction" or CommandLine contains "-SevereThreatDefaultAction" or CommandLine contains "-ltdefac " or CommandLine contains "-mtdefac " or CommandLine contains "-htdefac " or CommandLine contains "-stdefac ") and (CommandLine contains "Allow" or CommandLine contains "6" or CommandLine contains "NoAction" or CommandLine contains "9")