// Title: Suspicious Processes Spawned by Java.EXE
// Rule ID: 0d34ed8b-1c12-4ff2-828c-16fc860b766d
// Severity: high
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_java_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\java.exe" and (NewProcessName endswith "\\AppVLP.exe" or NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\curl.exe" or NewProcessName endswith "\\forfiles.exe" or NewProcessName endswith "\\hh.exe" or NewProcessName endswith "\\mftrace.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe" or NewProcessName endswith "\\query.exe" or NewProcessName endswith "\\reg.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\scrcons.exe" or NewProcessName endswith "\\scriptrunner.exe" or NewProcessName endswith "\\sh.exe" or NewProcessName endswith "\\systeminfo.exe" or NewProcessName endswith "\\whoami.exe" or NewProcessName endswith "\\wmic.exe" or NewProcessName endswith "\\wscript.exe")