// Title: Suspicious Process Parents
// Rule ID: cbec226f-63d9-4eca-9f52-dfb6652f24df
// Severity: high
// Tags: attack.defense-evasion, attack.t1036
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_parents.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\minesweeper.exe" or ParentProcessName endswith "\\winver.exe" or ParentProcessName endswith "\\bitsadmin.exe") or ((ParentProcessName endswith "\\csrss.exe" or ParentProcessName endswith "\\certutil.exe" or ParentProcessName endswith "\\eventvwr.exe" or ParentProcessName endswith "\\calc.exe" or ParentProcessName endswith "\\notepad.exe") and (not(((NewProcessName endswith "\\WerFault.exe" or NewProcessName endswith "\\wermgr.exe" or NewProcessName endswith "\\conhost.exe" or NewProcessName endswith "\\mmc.exe" or NewProcessName endswith "\\win32calc.exe" or NewProcessName endswith "\\notepad.exe") or isnull(NewProcessName)))))