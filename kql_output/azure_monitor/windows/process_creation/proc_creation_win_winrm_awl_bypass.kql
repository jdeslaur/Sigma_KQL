SecurityEvent
| where CommandLine contains "winrm" and ((CommandLine contains "format:pretty" or CommandLine contains "format:\"pretty\"" or CommandLine contains "format:\"text\"" or CommandLine contains "format:text") and (not((NewProcessName startswith "C:\\Windows\\System32\\" or NewProcessName startswith "C:\\Windows\\SysWOW64\\"))))