// Title: Potentially Suspicious GoogleUpdate Child Process
// Rule ID: 84b1ecf9-6eff-4004-bafb-bae5c0e251b2
// Severity: high
// Tags: attack.defense-evasion
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_googleupdate_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\GoogleUpdate.exe" and (not(((NewProcessName contains "\\Google" or (NewProcessName endswith "\\setup.exe" or NewProcessName endswith "chrome_updater.exe" or NewProcessName endswith "chrome_installer.exe")) or isnull(NewProcessName))))