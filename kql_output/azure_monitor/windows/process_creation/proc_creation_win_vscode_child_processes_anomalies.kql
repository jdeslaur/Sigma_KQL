// Title: Potentially Suspicious Child Process Of VsCode
// Rule ID: 5a3164f2-b373-4152-93cf-090b13c12d27
// Severity: medium
// Tags: attack.execution, attack.defense-evasion, attack.t1218, attack.t1202
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_vscode_child_processes_anomalies.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\code.exe" and ((NewProcessName endswith "\\calc.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\wscript.exe") or ((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\cmd.exe") and (CommandLine contains "Invoke-Expressions" or CommandLine contains "IEX" or CommandLine contains "Invoke-Command" or CommandLine contains "ICM" or CommandLine contains "DownloadString" or CommandLine contains "rundll32" or CommandLine contains "regsvr32" or CommandLine contains "wscript" or CommandLine contains "cscript")) or (NewProcessName contains ":\\Users\\Public\\" or NewProcessName contains ":\\Windows\\Temp\\" or NewProcessName contains ":\\Temp\\"))