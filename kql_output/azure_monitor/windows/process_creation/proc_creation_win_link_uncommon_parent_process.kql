// Title: Uncommon Link.EXE Parent Process
// Rule ID: 6e968eb1-5f05-4dac-94e9-fd0c5cb49fd6
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_link_uncommon_parent_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\link.exe" and CommandLine contains "LINK /") and (not(((ParentProcessName startswith "C:\\Program Files\\Microsoft Visual Studio\\" or ParentProcessName startswith "C:\\Program Files (x86)\\Microsoft Visual Studio\\") and (ParentProcessName contains "\\VC\\bin\\" or ParentProcessName contains "\\VC\\Tools\\"))))