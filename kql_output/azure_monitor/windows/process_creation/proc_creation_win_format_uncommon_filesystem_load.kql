SecurityEvent
| where (NewProcessName endswith "\\format.com" and CommandLine contains "/fs:") and (not((CommandLine contains "/fs:exFAT" or CommandLine contains "/fs:FAT" or CommandLine contains "/fs:NTFS" or CommandLine contains "/fs:ReFS" or CommandLine contains "/fs:UDF")))