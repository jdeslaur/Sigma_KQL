SecurityEvent
| where ((CommandLine contains "localgroup " and CommandLine contains " /add") or (CommandLine contains "Add-LocalGroupMember " and CommandLine contains " -Group ")) and (CommandLine contains "Remote Desktop Users" or CommandLine contains "Utilisateurs du Bureau à distance" or CommandLine contains "Usuarios de escritorio remoto")