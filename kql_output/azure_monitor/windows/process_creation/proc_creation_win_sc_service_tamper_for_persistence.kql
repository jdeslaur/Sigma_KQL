SecurityEvent
| where ((CommandLine contains "sc " and CommandLine contains "config " and CommandLine contains "binpath=") or (CommandLine contains "sc " and CommandLine contains "failure" and CommandLine contains "command=")) or (((CommandLine contains "reg " and CommandLine contains "add " and CommandLine contains "FailureCommand") or (CommandLine contains "reg " and CommandLine contains "add " and CommandLine contains "ImagePath")) and (CommandLine contains ".sh" or CommandLine contains ".exe" or CommandLine contains ".dll" or CommandLine contains ".bin$" or CommandLine contains ".bat" or CommandLine contains ".cmd" or CommandLine contains ".js" or CommandLine contains ".msh$" or CommandLine contains ".reg$" or CommandLine contains ".scr" or CommandLine contains ".ps" or CommandLine contains ".vb" or CommandLine contains ".jar" or CommandLine contains ".pl"))