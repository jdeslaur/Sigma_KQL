// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\gup.exe" and NewProcessName endswith "\\explorer.exe") and (not(((NewProcessName endswith "\\explorer.exe" and CommandLine contains "\\Notepad++\\notepad++.exe") or ParentProcessName contains "\\Notepad++\\updater\\" or isnull(CommandLine))))