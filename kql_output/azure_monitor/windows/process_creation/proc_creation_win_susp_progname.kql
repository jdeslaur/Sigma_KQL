// Title: Suspicious Program Names
// Rule ID: efdd8dd5-cee8-4e59-9390-7d4d5e4dd6f6
// Severity: high
// Tags: attack.execution, attack.t1059
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_progname.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName contains "\\CVE-202" or NewProcessName contains "\\CVE202") or (NewProcessName endswith "\\poc.exe" or NewProcessName endswith "\\artifact.exe" or NewProcessName endswith "\\artifact64.exe" or NewProcessName endswith "\\artifact_protected.exe" or NewProcessName endswith "\\artifact32.exe" or NewProcessName endswith "\\artifact32big.exe" or NewProcessName endswith "obfuscated.exe" or NewProcessName endswith "obfusc.exe" or NewProcessName endswith "\\meterpreter")) or (CommandLine contains "inject.ps1" or CommandLine contains "Invoke-CVE" or CommandLine contains "pupy.ps1" or CommandLine contains "payload.ps1" or CommandLine contains "beacon.ps1" or CommandLine contains "PowerView.ps1" or CommandLine contains "bypass.ps1" or CommandLine contains "obfuscated.ps1" or CommandLine contains "obfusc.ps1" or CommandLine contains "obfus.ps1" or CommandLine contains "obfs.ps1" or CommandLine contains "evil.ps1" or CommandLine contains "MiniDogz.ps1" or CommandLine contains "_enc.ps1" or CommandLine contains "\\shell.ps1" or CommandLine contains "\\rshell.ps1" or CommandLine contains "revshell.ps1" or CommandLine contains "\\av.ps1" or CommandLine contains "\\av_test.ps1" or CommandLine contains "adrecon.ps1" or CommandLine contains "mimikatz.ps1" or CommandLine contains "\\PowerUp_" or CommandLine contains "powerup.ps1" or CommandLine contains "\\Temp\\a.ps1" or CommandLine contains "\\Temp\\p.ps1" or CommandLine contains "\\Temp\\1.ps1" or CommandLine contains "Hound.ps1" or CommandLine contains "encode.ps1" or CommandLine contains "powercat.ps1")