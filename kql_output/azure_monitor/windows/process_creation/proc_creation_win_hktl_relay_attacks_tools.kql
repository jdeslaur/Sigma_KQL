SecurityEvent
| where ((NewProcessName contains "PetitPotam" or NewProcessName contains "RottenPotato" or NewProcessName contains "HotPotato" or NewProcessName contains "JuicyPotato" or NewProcessName contains "\\just_dce_" or NewProcessName contains "Juicy Potato" or NewProcessName contains "\\temp\\rot.exe" or NewProcessName contains "\\Potato.exe" or NewProcessName contains "\\SpoolSample.exe" or NewProcessName contains "\\Responder.exe" or NewProcessName contains "\\smbrelayx" or NewProcessName contains "\\ntlmrelayx" or NewProcessName contains "\\LocalPotato") or (CommandLine contains "Invoke-Tater" or CommandLine contains " smbrelay" or CommandLine contains " ntlmrelay" or CommandLine contains "cme smb " or CommandLine contains " /ntlm:NTLMhash " or CommandLine contains "Invoke-PetitPotam" or (CommandLine contains ".exe -t " and CommandLine contains " -p ")) or (CommandLine contains ".exe -c \"{" and CommandLine endswith "}\" -z")) and (not((NewProcessName contains "HotPotatoes6" or NewProcessName contains "HotPotatoes7" or NewProcessName contains "HotPotatoes ")))