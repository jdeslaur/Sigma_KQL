// Title: Script Event Consumer Spawning Process
// Rule ID: f6d1dd2f-b8ce-40ca-bc23-062efb686b34
// Severity: high
// Tags: attack.execution, attack.t1047
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_scrcons_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\scrcons.exe" and (NewProcessName endswith "\\svchost.exe" or NewProcessName endswith "\\dllhost.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\msiexec.exe" or NewProcessName endswith "\\msbuild.exe")