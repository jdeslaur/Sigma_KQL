// Title: Obfuscated IP Download Activity
// Rule ID: cb5a2333-56cf-4562-8fcb-22ba1bca728d
// Severity: medium
// Tags: attack.discovery
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_obfuscated_ip_download.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains "Invoke-WebRequest" or CommandLine contains "iwr " or CommandLine contains "Invoke-RestMethod" or CommandLine contains "irm " or CommandLine contains "wget " or CommandLine contains "curl " or CommandLine contains "DownloadFile" or CommandLine contains "DownloadString") and ((CommandLine contains " 0x" or CommandLine contains "//0x" or CommandLine contains ".0x" or CommandLine contains ".00x") or (CommandLine contains "http://%" and CommandLine contains "%2e") or (CommandLine matches regex "https?://[0-9]{1,3}\\.[0-9]{1,3}\\.0[0-9]{3,4}" or CommandLine matches regex "https?://[0-9]{1,3}\\.0[0-9]{3,7}" or CommandLine matches regex "https?://0[0-9]{3,11}" or CommandLine matches regex "https?://(0[0-9]{1,11}\\.){3}0[0-9]{1,11}" or CommandLine matches regex "https?://0[0-9]{1,11}" or CommandLine matches regex " [0-7]{7,13}")) and (not(CommandLine matches regex "https?://((25[0-5]|(2[0-4]|1\\d|[1-9])?\\d)(\\.|\\b)){4}"))