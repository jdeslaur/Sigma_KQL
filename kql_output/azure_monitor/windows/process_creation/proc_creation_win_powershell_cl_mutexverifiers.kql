SecurityEvent
| where ((ParentProcessName endswith "\\powershell.exe" or ParentProcessName endswith "\\pwsh.exe") and NewProcessName endswith "\\powershell.exe" and CommandLine contains " -nologo -windowstyle minimized -file ") and (CommandLine contains "\\AppData\\Local\\Temp\\" or CommandLine contains "\\Windows\\Temp\\")