// Title: Suspicious Child Process of AspNetCompiler
// Rule ID: 9ccba514-7cb6-4c5c-b377-700758f2f120
// Severity: high
// Tags: attack.defense-evasion, attack.t1127
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_aspnet_compiler_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\aspnet_compiler.exe" and ((NewProcessName endswith "\\calc.exe" or NewProcessName endswith "\\notepad.exe") or (NewProcessName contains "\\Users\\Public\\" or NewProcessName contains "\\AppData\\Local\\Temp\\" or NewProcessName contains "\\AppData\\Local\\Roaming\\" or NewProcessName contains ":\\Temp\\" or NewProcessName contains ":\\Windows\\Temp\\" or NewProcessName contains ":\\Windows\\System32\\Tasks\\" or NewProcessName contains ":\\Windows\\Tasks\\"))