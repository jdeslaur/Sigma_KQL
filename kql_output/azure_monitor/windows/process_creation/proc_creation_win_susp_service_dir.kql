// Title: Suspicious Service Binary Directory
// Rule ID: 883faa95-175a-4e22-8181-e5761aeb373c
// Severity: high
// Tags: attack.defense-evasion, attack.t1202
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_service_dir.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName contains "\\Users\\Public\\" or NewProcessName contains "\\$Recycle.bin" or NewProcessName contains "\\Users\\All Users\\" or NewProcessName contains "\\Users\\Default\\" or NewProcessName contains "\\Users\\Contacts\\" or NewProcessName contains "\\Users\\Searches\\" or NewProcessName contains "C:\\Perflogs\\" or NewProcessName contains "\\config\\systemprofile\\" or NewProcessName contains "\\Windows\\Fonts\\" or NewProcessName contains "\\Windows\\IME\\" or NewProcessName contains "\\Windows\\addins\\") and (ParentProcessName endswith "\\services.exe" or ParentProcessName endswith "\\svchost.exe")