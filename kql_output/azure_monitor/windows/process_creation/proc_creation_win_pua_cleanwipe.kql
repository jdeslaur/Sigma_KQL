SecurityEvent
| where NewProcessName endswith "\\SepRemovalToolNative_x64.exe" or (NewProcessName endswith "\\CATClean.exe" and CommandLine contains "--uninstall") or (NewProcessName endswith "\\NetInstaller.exe" and CommandLine contains "-r") or (NewProcessName endswith "\\WFPUnins.exe" and (CommandLine contains "/uninstall" and CommandLine contains "/enterprise"))