//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\schtasks.exe" and (CommandLine contains " -create " or CommandLine contains " /create " or CommandLine contains " –create " or CommandLine contains " —create " or CommandLine contains " ―create ")) and (CommandLine contains "curl " and CommandLine contains "http" and CommandLine contains "-o") and CommandLine contains "powershell"