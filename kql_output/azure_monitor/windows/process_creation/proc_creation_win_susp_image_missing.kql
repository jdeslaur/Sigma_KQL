SecurityEvent
| where (not(NewProcessName contains "\\")) and (not((isnull(NewProcessName) or (NewProcessName in~ ("-", "")) or ((NewProcessName in~ ("System", "Registry", "MemCompression", "vmmem")) or (CommandLine in~ ("Registry", "MemCompression", "vmmem"))))))