SecurityEvent
| where (CommandLine contains " -c " or CommandLine contains " /c " or CommandLine contains " –c " or CommandLine contains " —c " or CommandLine contains " ―c ") and (CommandLine contains "curl " and CommandLine contains "http" and CommandLine contains "-o" and CommandLine contains "&")