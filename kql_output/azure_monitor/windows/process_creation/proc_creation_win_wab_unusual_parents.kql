// Title: Wab/Wabmig Unusual Parent Or Child Processes
// Rule ID: 63d1ccc0-2a43-4f4b-9289-361b308991ff
// Severity: high
// Tags: attack.defense-evasion, attack.execution
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wab_unusual_parents.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName endswith "\\WmiPrvSE.exe" or ParentProcessName endswith "\\svchost.exe" or ParentProcessName endswith "\\dllhost.exe") and (NewProcessName endswith "\\wab.exe" or NewProcessName endswith "\\wabmig.exe")) or (ParentProcessName endswith "\\wab.exe" or ParentProcessName endswith "\\wabmig.exe")