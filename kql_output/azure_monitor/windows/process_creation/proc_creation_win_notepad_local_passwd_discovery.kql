// Title: Notepad Password Files Discovery
// Rule ID: 3b4e950b-a3ea-44d3-877e-432071990709
// Severity: low
// Tags: attack.discovery, attack.t1083
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_notepad_local_passwd_discovery.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\explorer.exe" and NewProcessName endswith "\\notepad.exe" and ((CommandLine contains "password" and CommandLine contains ".txt") or (CommandLine contains "password" and CommandLine contains ".csv") or (CommandLine contains "password" and CommandLine contains ".doc") or (CommandLine contains "password" and CommandLine contains ".xls"))