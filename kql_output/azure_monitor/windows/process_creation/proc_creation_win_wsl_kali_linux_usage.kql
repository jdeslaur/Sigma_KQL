// Title: WSL Kali-Linux Usage
// Rule ID: 6f1a11aa-4b8a-4b7f-9e13-4d3e4ff0e0d4
// Severity: high
// Tags: attack.defense-evasion, attack.t1202
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wsl_kali_linux_usage.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (((NewProcessName contains ":\\Users\\" and NewProcessName contains "\\AppData\\Local\\packages\\KaliLinux") or (NewProcessName contains ":\\Users\\" and NewProcessName contains "\\AppData\\Local\\Microsoft\\WindowsApps\\kali.exe")) or (NewProcessName contains ":\\Program Files\\WindowsApps\\KaliLinux." and NewProcessName endswith "\\kali.exe")) or (((ParentProcessName endswith "\\wsl.exe" or ParentProcessName endswith "\\wslhost.exe") and ((NewProcessName contains "\\kali.exe" or NewProcessName contains "\\KaliLinux") or (CommandLine contains "Kali.exe" or CommandLine contains "Kali-linux" or CommandLine contains "kalilinux"))) and (not((CommandLine contains " -i " or CommandLine contains " --install " or CommandLine contains " --unregister "))))