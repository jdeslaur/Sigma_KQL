// Title: Cscript/Wscript Potentially Suspicious Child Process
// Rule ID: b6676963-0353-4f88-90f5-36c20d443c6a
// Severity: medium
// Tags: attack.execution
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wscript_cscript_susp_child_processes.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ParentProcessName endswith "\\wscript.exe" or ParentProcessName endswith "\\cscript.exe") and (NewProcessName endswith "\\rundll32.exe" or ((NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and ((CommandLine contains "mshta" and CommandLine contains "http") or (CommandLine contains "rundll32" or CommandLine contains "regsvr32" or CommandLine contains "msiexec")))) and (not((NewProcessName endswith "\\rundll32.exe" and (CommandLine contains "UpdatePerUserSystemParameters" or CommandLine contains "PrintUIEntry" or CommandLine contains "ClearMyTracksByProcess"))))