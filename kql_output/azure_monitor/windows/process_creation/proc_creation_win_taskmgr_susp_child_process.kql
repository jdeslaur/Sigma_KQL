// Title: New Process Created Via Taskmgr.EXE
// Rule ID: 3d7679bd-0c00-440c-97b0-3f204273e6c7
// Severity: low
// Tags: attack.defense-evasion, attack.t1036
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_taskmgr_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\taskmgr.exe" and (not((NewProcessName endswith ":\\Windows\\System32\\mmc.exe" or NewProcessName endswith ":\\Windows\\System32\\resmon.exe" or NewProcessName endswith ":\\Windows\\System32\\Taskmgr.exe")))