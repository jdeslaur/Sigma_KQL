SecurityEvent
| where (CommandLine contains ".DownloadString(" or CommandLine contains ".DownloadFile(" or CommandLine contains "Invoke-WebRequest " or CommandLine contains "iwr " or CommandLine contains "Invoke-RestMethod " or CommandLine contains "irm ") and (CommandLine contains ";iex $" or CommandLine contains "| IEX" or CommandLine contains "|IEX " or CommandLine contains "I`E`X" or CommandLine contains "I`EX" or CommandLine contains "IE`X" or CommandLine contains "iex " or CommandLine contains "IEX (" or CommandLine contains "IEX(" or CommandLine contains "Invoke-Expression")