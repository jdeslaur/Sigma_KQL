// Title: Execution of Suspicious File Type Extension
// Rule ID: c09dad97-1c78-4f71-b127-7edb2b8e491a
// Severity: medium
// Tags: attack.defense-evasion
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_non_exe_image.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (not((NewProcessName endswith ".bin" or NewProcessName endswith ".cgi" or NewProcessName endswith ".com" or NewProcessName endswith ".exe" or NewProcessName endswith ".scr" or NewProcessName endswith ".tmp"))) and (not(((NewProcessName in~ ("System", "Registry", "MemCompression", "vmmem")) or NewProcessName contains ":\\Windows\\Installer\\MSI" or NewProcessName contains ":\\Windows\\System32\\DriverStore\\FileRepository\\" or (NewProcessName contains ":\\Config.Msi\\" and (NewProcessName endswith ".rbf" or NewProcessName endswith ".rbs")) or (ParentProcessName contains ":\\Windows\\Temp\\" or NewProcessName contains ":\\Windows\\Temp\\") or NewProcessName contains ":\\$Extend\\$Deleted\\" or (NewProcessName in~ ("-", "")) or isnull(NewProcessName)))) and (not((ParentProcessName contains ":\\ProgramData\\Avira\\" or (NewProcessName contains "NVIDIA\\NvBackend\\" and NewProcessName endswith ".dat") or ((NewProcessName contains ":\\Program Files (x86)\\WINPAKPRO\\" or NewProcessName contains ":\\Program Files\\WINPAKPRO\\") and NewProcessName endswith ".ngn") or (NewProcessName endswith ":\\Program Files (x86)\\MyQ\\Server\\pcltool.dll" or NewProcessName endswith ":\\Program Files\\MyQ\\Server\\pcltool.dll") or (NewProcessName contains "\\AppData\\Local\\Packages\\" and NewProcessName contains "\\LocalState\\rootfs\\") or NewProcessName endswith "\\LZMA_EXE" or NewProcessName contains ":\\Program Files\\Mozilla Firefox\\" or (ParentProcessName =~ "C:\\Windows\\System32\\services.exe" and NewProcessName endswith "com.docker.service"))))