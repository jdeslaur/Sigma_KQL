// Title: Potentially Suspicious Execution From Parent Process In Public Folder
// Rule ID: 69bd9b97-2be2-41b6-9816-fb08757a4d1a
// Severity: high
// Tags: attack.defense-evasion, attack.execution, attack.t1564, attack.t1059
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_execution_from_public_folder_as_parent.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName contains ":\\Users\\Public\\" and ((NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\wscript.exe") or (CommandLine contains "bitsadmin" or CommandLine contains "certutil" or CommandLine contains "cscript" or CommandLine contains "mshta" or CommandLine contains "powershell" or CommandLine contains "regsvr32" or CommandLine contains "rundll32" or CommandLine contains "wscript"))