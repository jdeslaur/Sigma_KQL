// Title: Potentially Suspicious Execution Of PDQDeployRunner
// Rule ID: 12b8e9f5-96b2-41e1-9a42-8c6779a5c184
// Severity: medium
// Tags: attack.execution
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_pdqdeploy_runner_susp_children.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName contains "\\PDQDeployRunner-" and ((NewProcessName endswith "\\bash.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\csc.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\dllhost.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\msiexec.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\scriptrunner.exe" or NewProcessName endswith "\\wmic.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\wsl.exe") or (NewProcessName contains ":\\ProgramData\\" or NewProcessName contains ":\\Users\\Public\\" or NewProcessName contains ":\\Windows\\TEMP\\" or NewProcessName contains "\\AppData\\Local\\Temp") or (CommandLine contains " -decode " or CommandLine contains " -enc " or CommandLine contains " -encodedcommand " or CommandLine contains " -w hidden" or CommandLine contains "DownloadString" or CommandLine contains "FromBase64String" or CommandLine contains "http" or CommandLine contains "iex " or CommandLine contains "Invoke-"))