// Title: Uncommon Child Process Of Appvlp.EXE
// Rule ID: 9c7e131a-0f2c-4ae0-9d43-b04f4e266d43
// Severity: medium
// Tags: attack.t1218, attack.defense-evasion, attack.execution
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_appvlp_uncommon_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\appvlp.exe" and (not((NewProcessName endswith ":\\Windows\\SysWOW64\\rundll32.exe" or NewProcessName endswith ":\\Windows\\System32\\rundll32.exe"))) and (not(((NewProcessName contains ":\\Program Files\\Microsoft Office" and NewProcessName endswith "\\msoasb.exe") or ((NewProcessName contains ":\\Program Files\\Microsoft Office" and NewProcessName contains "\\SkypeSrv\\") and NewProcessName endswith "\\SKYPESERVER.EXE") or (NewProcessName contains ":\\Program Files\\Microsoft Office" and NewProcessName endswith "\\MSOUC.EXE"))))