SecurityEvent
| where ((CommandLine contains "localgroup " and CommandLine contains " /add") or (CommandLine contains "Add-LocalGroupMember " and CommandLine contains " -Group ")) and (CommandLine contains " administrators " or CommandLine contains " administrateur")