// Title: PUA - Ngrok Execution
// Rule ID: ee37eb7c-a4e7-4cd5-8fa4-efa27f1c3f31
// Severity: high
// Tags: attack.command-and-control, attack.t1572
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_pua_ngrok.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains " tcp 139" or CommandLine contains " tcp 445" or CommandLine contains " tcp 3389" or CommandLine contains " tcp 5985" or CommandLine contains " tcp 5986") or (CommandLine contains " start " and CommandLine contains "--all" and CommandLine contains "--config" and CommandLine contains ".yml") or (NewProcessName endswith "ngrok.exe" and (CommandLine contains " tcp " or CommandLine contains " http " or CommandLine contains " authtoken ")) or (CommandLine contains ".exe authtoken " or CommandLine contains ".exe start --all")