// Title: Suspicious Child Process Of Manage Engine ServiceDesk
// Rule ID: cea2b7ea-792b-405f-95a1-b903ea06458f
// Severity: high
// Tags: attack.command-and-control, attack.t1102
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_java_manageengine_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName contains "\\ManageEngine\\ServiceDesk\\" and ParentProcessName contains "\\java.exe") and (NewProcessName endswith "\\AppVLP.exe" or NewProcessName endswith "\\bash.exe" or NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\calc.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\curl.exe" or NewProcessName endswith "\\forfiles.exe" or NewProcessName endswith "\\mftrace.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe" or NewProcessName endswith "\\notepad.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\query.exe" or NewProcessName endswith "\\reg.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\scrcons.exe" or NewProcessName endswith "\\sh.exe" or NewProcessName endswith "\\systeminfo.exe" or NewProcessName endswith "\\whoami.exe" or NewProcessName endswith "\\wmic.exe" or NewProcessName endswith "\\wscript.exe")) and (not(((NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe") and CommandLine contains " stop")))