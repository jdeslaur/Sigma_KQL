// Title: Suspicious Velociraptor Child Process
// Rule ID: 4bc90587-e6ca-4b41-be0b-ed4d04e4ed0c
// Severity: high
// Tags: attack.command-and-control, attack.persistence, attack.defense-evasion, attack.t1219
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_susp_velociraptor_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\Velociraptor.exe" and ((CommandLine contains "code.exe" and CommandLine contains "tunnel" and CommandLine contains "--accept-server-license-terms") or (CommandLine contains "msiexec" and CommandLine contains "/i" and CommandLine contains "http") or ((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\powershell_ise.exe" or NewProcessName endswith "\\pwsh.exe") and (CommandLine contains "Invoke-WebRequest " or CommandLine contains "IWR " or CommandLine contains ".DownloadFile" or CommandLine contains ".DownloadString")))