// Title: HTML Help HH.EXE Suspicious Child Process
// Rule ID: 52cad028-0ff0-4854-8f67-d25dfcbc78b4
// Severity: high
// Tags: attack.defense-evasion, attack.execution, attack.initial-access, attack.t1047, attack.t1059.001, attack.t1059.003, attack.t1059.005, attack.t1059.007, attack.t1218, attack.t1218.001, attack.t1218.010, attack.t1218.011, attack.t1566, attack.t1566.001
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_hh_html_help_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName endswith "\\hh.exe" and (NewProcessName endswith "\\CertReq.exe" or NewProcessName endswith "\\CertUtil.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\installutil.exe" or NewProcessName endswith "\\MSbuild.exe" or NewProcessName endswith "\\MSHTA.EXE" or NewProcessName endswith "\\msiexec.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\wmic.exe" or NewProcessName endswith "\\wscript.exe")