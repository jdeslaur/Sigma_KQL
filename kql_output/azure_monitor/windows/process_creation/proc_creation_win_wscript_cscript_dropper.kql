// Title: Potential Dropper Script Execution Via WScript/CScript
// Rule ID: cea72823-df4d-4567-950c-0b579eaf0846
// Severity: medium
// Tags: attack.execution, attack.t1059.005, attack.t1059.007
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_wscript_cscript_dropper.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe") and (CommandLine contains ":\\Temp\\" or CommandLine contains ":\\Tmp\\" or CommandLine contains ":\\Users\\Public\\" or CommandLine contains ":\\Windows\\Temp\\" or CommandLine contains "\\AppData\\Local\\Temp\\") and (CommandLine contains ".js" or CommandLine contains ".jse" or CommandLine contains ".vba" or CommandLine contains ".vbe" or CommandLine contains ".vbs" or CommandLine contains ".wsf")