SecurityEvent
| where (NewProcessName endswith "\\squirrel.exe" or NewProcessName endswith "\\update.exe") and (CommandLine contains " --download " or CommandLine contains " --update " or CommandLine contains " --updateRollback=") and CommandLine contains "http"