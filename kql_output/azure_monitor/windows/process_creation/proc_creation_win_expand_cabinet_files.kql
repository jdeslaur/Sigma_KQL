// Title: Potentially Suspicious Cabinet File Expansion
// Rule ID: 9f107a84-532c-41af-b005-8d12a607639f
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_expand_cabinet_files.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\expand.exe" and (CommandLine contains "-F:" or CommandLine contains "/F:" or CommandLine contains "–F:" or CommandLine contains "—F:" or CommandLine contains "―F:")) and ((CommandLine contains ":\\Perflogs\\" or CommandLine contains ":\\ProgramData" or CommandLine contains ":\\Users\\Public\\" or CommandLine contains ":\\Windows\\Temp\\" or CommandLine contains "\\Admin$\\" or CommandLine contains "\\AppData\\Local\\Temp\\" or CommandLine contains "\\AppData\\Roaming\\" or CommandLine contains "\\C$\\" or CommandLine contains "\\Temporary Internet") or ((CommandLine contains ":\\Users\\" and CommandLine contains "\\Favorites\\") or (CommandLine contains ":\\Users\\" and CommandLine contains "\\Favourites\\") or (CommandLine contains ":\\Users\\" and CommandLine contains "\\Contacts\\"))) and (not((ParentProcessName =~ "C:\\Program Files (x86)\\Dell\\UpdateService\\ServiceShell.exe" and CommandLine contains "C:\\ProgramData\\Dell\\UpdateService\\Temp\\")))