// Title: HTML File Opened From Download Folder
// Rule ID: 538c5851-8c03-4724-8ec4-623bc7aadaea
// Severity: low
// Tags: attack.t1598.002, attack.t1566.001, attack.initial-access, attack.reconnaissance, detection.threat-hunting
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/process_creation/proc_creation_win_susp_open_html_file_from_download_folder.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\chrome.exe" or NewProcessName endswith "\\firefox.exe" or NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\vivaldi.exe") and (CommandLine contains ":\\users\\" and CommandLine contains "\\Downloads\\" and CommandLine contains ".htm")