// Title: Veeam Backup Database Suspicious Query
// Rule ID: 696bfb54-227e-4602-ac5b-30d9d2053312
// Severity: medium
// Tags: attack.collection, attack.t1005
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_sqlcmd_veeam_db_recon.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\sqlcmd.exe" and (CommandLine contains "VeeamBackup" and CommandLine contains "From ")) and (CommandLine contains "BackupRepositories" or CommandLine contains "Backups" or CommandLine contains "Credentials" or CommandLine contains "HostCreds" or CommandLine contains "SmbFileShares" or CommandLine contains "Ssh_creds" or CommandLine contains "VSphereInfo")