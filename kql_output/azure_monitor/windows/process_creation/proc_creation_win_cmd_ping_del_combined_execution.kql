SecurityEvent
| where (CommandLine contains " -n " or CommandLine contains " /n " or CommandLine contains " –n " or CommandLine contains " —n " or CommandLine contains " ―n ") and CommandLine contains "Nul" and (CommandLine contains " -f " or CommandLine contains " /f " or CommandLine contains " –f " or CommandLine contains " —f " or CommandLine contains " ―f " or CommandLine contains " -q " or CommandLine contains " /q " or CommandLine contains " –q " or CommandLine contains " —q " or CommandLine contains " ―q ") and (CommandLine contains "ping" and CommandLine contains "del ")