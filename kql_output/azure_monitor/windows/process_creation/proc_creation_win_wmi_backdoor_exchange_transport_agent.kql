SecurityEvent
| where ParentProcessName endswith "\\EdgeTransport.exe" and (not((NewProcessName =~ "C:\\Windows\\System32\\conhost.exe" or (NewProcessName startswith "C:\\Program Files\\Microsoft\\Exchange Server\\" and NewProcessName endswith "\\Bin\\OleConverter.exe"))))