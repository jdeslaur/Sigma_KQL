SecurityEvent
| where ((CommandLine contains "localgroup " and CommandLine contains " /add") or (CommandLine contains "Add-LocalGroupMember " and CommandLine contains " -Group ")) and (CommandLine contains "Group Policy Creator Owners" or CommandLine contains "Schema Admins")