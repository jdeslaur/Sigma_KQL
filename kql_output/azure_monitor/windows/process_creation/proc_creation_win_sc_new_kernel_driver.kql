// Title: New Kernel Driver Via SC.EXE
// Rule ID: 431a1fdb-4799-4f3b-91c3-a683b003fc49
// Severity: medium
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/process_creation/proc_creation_win_sc_new_kernel_driver.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\sc.exe" and (CommandLine contains "create" or CommandLine contains "config") and (CommandLine contains "binPath" and CommandLine contains "type" and CommandLine contains "kernel")) and (not(((CommandLine contains "create netprotection_network_filter" and CommandLine contains "type= kernel start= " and CommandLine contains "binPath= System32\\drivers\\netprotection_network_filter" and CommandLine contains "DisplayName= netprotection_network_filter" and CommandLine contains "group= PNP_TDI tag= yes") or (CommandLine contains "create avelam binpath=C:\\Windows\\system32\\drivers\\avelam.sys" and CommandLine contains "type=kernel start=boot error=critical group=Early-Launch"))))