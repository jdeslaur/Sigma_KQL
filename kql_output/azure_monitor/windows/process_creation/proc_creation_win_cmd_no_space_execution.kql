SecurityEvent
| where ((CommandLine contains "cmd.exe/c" or CommandLine contains "\\cmd/c" or CommandLine contains "\"cmd/c" or CommandLine contains "cmd.exe/k" or CommandLine contains "\\cmd/k" or CommandLine contains "\"cmd/k" or CommandLine contains "cmd.exe/r" or CommandLine contains "\\cmd/r" or CommandLine contains "\"cmd/r") or (CommandLine contains "/cwhoami" or CommandLine contains "/cpowershell" or CommandLine contains "/cschtasks" or CommandLine contains "/cbitsadmin" or CommandLine contains "/ccertutil" or CommandLine contains "/kwhoami" or CommandLine contains "/kpowershell" or CommandLine contains "/kschtasks" or CommandLine contains "/kbitsadmin" or CommandLine contains "/kcertutil") or (CommandLine contains "cmd.exe /c" or CommandLine contains "cmd /c" or CommandLine contains "cmd.exe /k" or CommandLine contains "cmd /k" or CommandLine contains "cmd.exe /r" or CommandLine contains "cmd /r")) and (not(((CommandLine contains "cmd.exe /c " or CommandLine contains "cmd /c " or CommandLine contains "cmd.exe /k " or CommandLine contains "cmd /k " or CommandLine contains "cmd.exe /r " or CommandLine contains "cmd /r ") or (CommandLine in~ ("cmd.exe /c") or CommandLine contains "AppData\\Local\\Programs\\Microsoft VS Code\\resources\\app\\node_modules" or CommandLine endswith "cmd.exe/c ."))))