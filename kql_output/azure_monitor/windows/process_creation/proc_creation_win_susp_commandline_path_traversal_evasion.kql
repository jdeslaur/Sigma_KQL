SecurityEvent
| where ((NewProcessName contains "\\Windows\\" and (CommandLine contains "\\..\\Windows\\" or CommandLine contains "\\..\\System32\\" or CommandLine contains "\\..\\..\\")) or CommandLine contains ".exe\\..\\") and (not((CommandLine contains "\\Google\\Drive\\googledrivesync.exe\\..\\" or CommandLine contains "\\Citrix\\Virtual Smart Card\\Citrix.Authentication.VirtualSmartcard.Launcher.exe\\..\\")))