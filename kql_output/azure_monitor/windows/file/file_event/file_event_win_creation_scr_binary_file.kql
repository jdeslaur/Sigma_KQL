SecurityEvent
| where ObjectName endswith ".scr" and (not(((NewProcessName endswith "\\Kindle.exe" or NewProcessName endswith "\\Bin\\ccSvcHst.exe") or (NewProcessName endswith "\\TiWorker.exe" and ObjectName endswith "\\uwfservicingscr.scr"))))