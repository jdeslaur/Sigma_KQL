SecurityEvent
| where (NewProcessName endswith ".exe" and ObjectName endswith ".exe") and (not(((NewProcessName endswith ":\\Windows\\System32\\msiexec.exe" or NewProcessName endswith ":\\Windows\\system32\\cleanmgr.exe" or NewProcessName endswith ":\\Windows\\explorer.exe" or NewProcessName endswith ":\\WINDOWS\\system32\\dxgiadaptercache.exe" or NewProcessName endswith ":\\WINDOWS\\system32\\Dism.exe" or NewProcessName endswith ":\\Windows\\System32\\wuauclt.exe") or (NewProcessName endswith ":\\WINDOWS\\system32\\svchost.exe" and ObjectName endswith ":\\Windows\\SoftwareDistribution\\Download*") or (NewProcessName endswith ":\\Windows\\system32\\svchost.exe" and (ObjectName endswith ":\\WUDownloadCache*" and ObjectName contains "\\WindowsUpdateBox.exe")) or (NewProcessName contains ":\\WINDOWS\\SoftwareDistribution\\Download\\" and NewProcessName endswith "\\WindowsUpdateBox.Exe" and ObjectName endswith ":\\$WINDOWS.~BT\\Sources*") or (NewProcessName contains ":\\Windows\\WinSxS\\" and NewProcessName endswith "\\TiWorker.exe") or ((NewProcessName contains ":\\Program Files\\" or NewProcessName contains ":\\Program Files (x86)\\") or (ObjectName endswith ":\\Program Files*" or ObjectName endswith ":\\Program Files (x86)*")) or (NewProcessName contains ":\\ProgramData\\Microsoft\\Windows Defender\\" or NewProcessName contains ":\\Program Files\\Windows Defender\\") or ObjectName endswith "\\AppData\\Local\\Microsoft\\WindowsApps*" or (NewProcessName endswith "\\AppData\\Local\\Microsoft\\Teams\\Update.exe" and (ObjectName endswith "\\AppData\\Local\\Microsoft\\Teams\\stage\\Teams.exe" or ObjectName endswith "\\AppData\\Local\\Microsoft\\Teams\\stage\\Squirrel.exe" or ObjectName endswith "\\AppData\\Local\\Microsoft\\SquirrelTemp\\tempb\\")) or ((NewProcessName contains ":\\Windows\\Microsoft.NET\\Framework\\" or NewProcessName contains ":\\Windows\\Microsoft.NET\\Framework64\\" or NewProcessName contains ":\\Windows\\Microsoft.NET\\FrameworkArm\\" or NewProcessName contains ":\\Windows\\Microsoft.NET\\FrameworkArm64\\") and NewProcessName endswith "\\mscorsvw.exe" and ObjectName contains ":\\Windows\\assembly\\NativeImages_") or (NewProcessName contains "\\AppData\\Local\\" and NewProcessName endswith "\\Microsoft VS Code\\Code.exe" and ObjectName endswith "\\.vscode\\extensions*") or (NewProcessName endswith "\\AppData\\Local\\GitHubDesktop\\Update.exe" and ObjectName endswith "\\AppData\\Local\\SquirrelTemp*") or (NewProcessName contains ":\\WINDOWS\\TEMP\\" or ObjectName endswith ":\\WINDOWS\\TEMP*") or (NewProcessName contains "\\AppData\\Local\\Temp\\" or ObjectName endswith "\\AppData\\Local\\Temp*") or (NewProcessName contains ":\\Windows\\Microsoft.NET\\Framework" and NewProcessName endswith "\\mscorsvw.exe" and ObjectName contains ":\\Windows\\assembly")))) and (not(((NewProcessName contains "\\Python27\\python.exe" and (ObjectName endswith "\\Python27\\Lib\\site-packages*" or ObjectName endswith "\\Python27\\Scripts*" or ObjectName endswith "\\AppData\\Local\\Temp*")) or (NewProcessName contains "\\AppData\\Local\\SquirrelTemp\\Update.exe" and ObjectName contains "\\AppData\\Local") or (NewProcessName endswith "\\ChromeSetup.exe" and ObjectName contains "\\Google"))))