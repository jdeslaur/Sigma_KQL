// Title: Potential SAM Database Dump
// Rule ID: 4e87b8e2-2ee9-4b2a-a715-4727d297ece0
// Severity: high
// Tags: attack.credential-access, attack.t1003.002
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_sam_dump.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\Temp\\sam" or ObjectName endswith "\\sam.sav" or ObjectName endswith "\\Intel\\sam" or ObjectName endswith "\\sam.hive" or ObjectName endswith "\\Perflogs\\sam" or ObjectName endswith "\\ProgramData\\sam" or ObjectName endswith "\\Users\\Public\\sam" or ObjectName endswith "\\AppData\\Local\\sam" or ObjectName endswith "\\AppData\\Roaming\\sam" or ObjectName endswith "_ShadowSteal.zip" or ObjectName endswith "\\Documents\\SAM.export" or ObjectName endswith ":\\sam") or (ObjectName contains "\\hive_sam_" or ObjectName contains "\\sam.save" or ObjectName contains "\\sam.export" or ObjectName contains "\\~reg_sam.save" or ObjectName contains "\\sam_backup" or ObjectName contains "\\sam.bck" or ObjectName contains "\\sam.backup")