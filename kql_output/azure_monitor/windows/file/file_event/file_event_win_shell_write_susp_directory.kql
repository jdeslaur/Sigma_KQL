// Title: Windows Shell/Scripting Application File Write to Suspicious Folder
// Rule ID: 1277f594-a7d1-4f28-a2d3-73af5cbeab43
// Severity: high
// Tags: attack.execution, attack.t1059
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_shell_write_susp_directory.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\bash.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\msbuild.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\sh.exe" or NewProcessName endswith "\\wscript.exe") and (ObjectName in~ ("C:\\PerfLogs*", "C:\\Users\\Public*"))) or ((NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\forfiles.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\schtasks.exe" or NewProcessName endswith "\\scriptrunner.exe" or NewProcessName endswith "\\wmic.exe") and (ObjectName endswith "C:\\PerfLogs*" or ObjectName endswith "C:\\Users\\Public*" or ObjectName endswith "C:\\Windows\\Temp*"))