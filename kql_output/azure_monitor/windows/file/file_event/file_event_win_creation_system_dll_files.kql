// Title: Files With System DLL Name In Unsuspected Locations
// Rule ID: 13c02350-4177-4e45-ac17-cf7ca628ff5e
// Severity: medium
// Tags: attack.defense-evasion, attack.t1036.005
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_creation_system_dll_files.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\secur32.dll" or ObjectName endswith "\\tdh.dll") and (not((ObjectName endswith "C:\\$WINDOWS.~BT*" or ObjectName endswith "C:\\$WinREAgent*" or ObjectName endswith "C:\\Windows\\SoftwareDistribution*" or ObjectName endswith "C:\\Windows\\System32*" or ObjectName endswith "C:\\Windows\\SysWOW64*" or ObjectName endswith "C:\\Windows\\WinSxS*" or ObjectName endswith "C:\\Windows\\uus*")))