SecurityEvent
| where ObjectName endswith ".scr" and (not((ObjectName endswith ":\\$WINDOWS.~BT\\NewOS*" or ObjectName endswith ":\\Windows\\System32*" or ObjectName endswith ":\\Windows\\SysWOW64*" or ObjectName endswith ":\\Windows\\WinSxS*" or ObjectName endswith ":\\WUDownloadCache*")))