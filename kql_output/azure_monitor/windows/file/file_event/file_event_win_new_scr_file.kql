// Title: SCR File Write Event
// Rule ID: c048f047-7e2a-4888-b302-55f509d4a91d
// Severity: medium
// Tags: attack.defense-evasion, attack.t1218.011
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_new_scr_file.yml
//
