SecurityEvent
| where (ObjectName endswith "\\Microsoft\\Event Viewer\\RecentViews" or ObjectName endswith "\\Microsoft\\EventV~1\\RecentViews") and (not((NewProcessName startswith "C:\\Windows\\System32\\" or NewProcessName startswith "C:\\Windows\\SysWOW64\\")))