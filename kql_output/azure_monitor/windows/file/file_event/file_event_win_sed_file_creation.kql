SecurityEvent
| where (ObjectName endswith ":\\ProgramData*" or ObjectName endswith ":\\Temp*" or ObjectName endswith ":\\Windows\\System32\\Tasks*" or ObjectName endswith ":\\Windows\\Tasks*" or ObjectName endswith ":\\Windows\\Temp*" or ObjectName endswith "\\AppData\\Local\\Temp*") and ObjectName endswith ".sed"