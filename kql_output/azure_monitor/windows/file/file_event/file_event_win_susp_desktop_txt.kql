// Title: Suspicious Creation TXT File in User Desktop
// Rule ID: caf02a0a-1e1c-4552-9b48-5e070bd88d11
// Severity: high
// Tags: attack.impact, attack.t1486
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_desktop_txt.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\cmd.exe" and (ObjectName endswith "\\Users*" and ObjectName endswith "\\Desktop*") and ObjectName endswith ".txt"