SecurityEvent
| where ((NewProcessName endswith "\\AnyDesk.exe" or NewProcessName endswith "\\AnyDeskMSI.exe") and (ObjectName endswith ".dll" or ObjectName endswith ".exe")) and (not(ObjectName endswith "\\gcapi.dll"))