// Title: Uncommon File Created In Office Startup Folder
// Rule ID: a10a2c40-2c4d-49f8-b557-1a946bc55d9d
// Severity: high
// Tags: attack.resource-development, attack.t1587.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_office_uncommon_file_startup.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (((ObjectName contains "\\Microsoft\\Word\\STARTUP" or (ObjectName contains "\\Office" and ObjectName contains "\\Program Files" and ObjectName contains "\\STARTUP")) and (not((ObjectName endswith ".docb" or ObjectName endswith ".docm" or ObjectName endswith ".docx" or ObjectName endswith ".dotm" or ObjectName endswith ".mdb" or ObjectName endswith ".mdw" or ObjectName endswith ".pdf" or ObjectName endswith ".wll" or ObjectName endswith ".wwl")))) or ((ObjectName contains "\\Microsoft\\Excel\\XLSTART" or (ObjectName contains "\\Office" and ObjectName contains "\\Program Files" and ObjectName contains "\\XLSTART")) and (not((ObjectName endswith ".xll" or ObjectName endswith ".xls" or ObjectName endswith ".xlsm" or ObjectName endswith ".xlsx" or ObjectName endswith ".xlt" or ObjectName endswith ".xltm" or ObjectName endswith ".xlw"))))) and (not(((NewProcessName contains ":\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" and NewProcessName endswith "\\OfficeClickToRun.exe") or ((NewProcessName contains ":\\Program Files\\Microsoft Office\\" or NewProcessName contains ":\\Program Files (x86)\\Microsoft Office\\") and (NewProcessName endswith "\\winword.exe" or NewProcessName endswith "\\excel.exe")))))