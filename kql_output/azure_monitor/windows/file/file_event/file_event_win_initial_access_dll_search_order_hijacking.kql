// Title: Potential Initial Access via DLL Search Order Hijacking
// Rule ID: dbbd9f66-2ed3-4ca2-98a4-6ea985dd1a1c
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.t1566, attack.t1566.001, attack.initial-access, attack.t1574, attack.t1574.001, attack.defense-evasion
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_initial_access_dll_search_order_hijacking.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\winword.exe" or NewProcessName endswith "\\excel.exe" or NewProcessName endswith "\\powerpnt.exe" or NewProcessName endswith "\\MSACCESS.EXE" or NewProcessName endswith "\\MSPUB.EXE" or NewProcessName endswith "\\fltldr.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\curl.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and ObjectName endswith ".dll" and (ObjectName endswith "\\Users*" and ObjectName endswith "\\AppData*") and (ObjectName endswith "\\Microsoft\\OneDrive*" or ObjectName endswith "\\Microsoft OneDrive*" or ObjectName endswith "\\Microsoft\\Teams*" or ObjectName contains "\\Local\\slack\\app-" or ObjectName endswith "\\Local\\Programs\\Microsoft VS Code*")) and (not((NewProcessName endswith "\\cmd.exe" and (ObjectName endswith "\\Users*" and ObjectName endswith "\\AppData*" and ObjectName endswith "\\Microsoft\\OneDrive*" and ObjectName contains "\\api-ms-win-core-"))))