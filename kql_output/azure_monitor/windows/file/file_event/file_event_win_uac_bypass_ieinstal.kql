SecurityEvent
| where NewProcessName =~ "C:\\Program Files\\Internet Explorer\\IEInstal.exe" and ObjectName =~ "C:\\Users*" and ObjectName endswith "\\AppData\\Local\\Temp*" and ObjectName endswith "consent.exe"