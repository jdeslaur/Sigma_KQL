// Title: Legitimate Application Writing Files In Uncommon Location
// Rule ID: 1cf465a1-2609-4c15-9b66-c32dbe4bfd67
// Severity: high
// Tags: attack.defense-evasion, attack.t1218, attack.command-and-control, attack.t1105
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_legitimate_app_dropping_in_uncommon_location.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\eqnedt32.exe" or NewProcessName endswith "\\wordpad.exe" or NewProcessName endswith "\\wordview.exe" or NewProcessName endswith "\\cmdl32.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\certoc.exe" or NewProcessName endswith "\\CertReq.exe" or NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\Desktopimgdownldr.exe" or NewProcessName endswith "\\esentutl.exe" or NewProcessName endswith "\\expand.exe" or NewProcessName endswith "\\extrac32.exe" or NewProcessName endswith "\\replace.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\ftp.exe" or NewProcessName endswith "\\Ldifde.exe" or NewProcessName endswith "\\RdrCEF.exe" or NewProcessName endswith "\\hh.exe" or NewProcessName endswith "\\finger.exe" or NewProcessName endswith "\\findstr.exe") and (ObjectName contains ":\\Perflogs" or ObjectName endswith ":\\ProgramData*" or ObjectName endswith ":\\Temp*" or ObjectName endswith ":\\Users\\Public*" or ObjectName endswith ":\\Windows*" or ObjectName endswith "\\$Recycle.Bin*" or ObjectName endswith "\\AppData\\Local*" or ObjectName endswith "\\AppData\\Roaming*" or ObjectName endswith "\\Contacts*" or ObjectName endswith "\\Desktop*" or ObjectName endswith "\\Favorites*" or ObjectName endswith "\\Favourites*" or ObjectName endswith "\\inetpub\\wwwroot*" or ObjectName endswith "\\Music*" or ObjectName endswith "\\Pictures*" or ObjectName endswith "\\Start Menu\\Programs\\Startup*" or ObjectName endswith "\\Users\\Default*" or ObjectName endswith "\\Videos*")