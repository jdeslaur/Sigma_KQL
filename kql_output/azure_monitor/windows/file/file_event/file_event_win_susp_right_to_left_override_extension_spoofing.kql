SecurityEvent
| where (ObjectName contains "\\u202e" or ObjectName contains "[U+202E]") and (ObjectName contains "3pm." or ObjectName contains "4pm." or ObjectName contains "cod." or ObjectName contains "fdp." or ObjectName contains "ftr." or ObjectName contains "gepj." or ObjectName contains "gnp." or ObjectName contains "gpj." or ObjectName contains "ism." or ObjectName contains "lmth." or ObjectName contains "nls." or ObjectName contains "piz." or ObjectName contains "slx." or ObjectName contains "tdo." or ObjectName contains "vsc." or ObjectName contains "vwm." or ObjectName contains "xcod." or ObjectName contains "xslx." or ObjectName contains "xtpp.")