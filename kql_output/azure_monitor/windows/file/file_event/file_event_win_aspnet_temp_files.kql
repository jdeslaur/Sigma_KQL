// Title: Assembly DLL Creation Via AspNetCompiler
// Rule ID: 4c7f49ee-2638-43bb-b85b-ce676c30b260
// Severity: medium
// Tags: attack.execution
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_aspnet_temp_files.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\aspnet_compiler.exe" and (ObjectName endswith "\\Temporary ASP.NET Files*" and ObjectName endswith "\\assembly\\tmp*" and ObjectName contains ".dll")