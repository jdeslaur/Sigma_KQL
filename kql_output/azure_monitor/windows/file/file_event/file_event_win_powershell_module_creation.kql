SecurityEvent
| where (NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and (ObjectName endswith "\\WindowsPowerShell\\Modules*" or ObjectName endswith "\\PowerShell\\7\\Modules*")