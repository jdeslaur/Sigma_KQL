// Title: BloodHound Collection Files
// Rule ID: 02773bed-83bf-469f-b7ff-e676e7d78bab
// Severity: high
// Tags: attack.discovery, attack.t1087.001, attack.t1087.002, attack.t1482, attack.t1069.001, attack.t1069.002, attack.execution, attack.t1059.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_bloodhound_collection.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "BloodHound.zip" or ObjectName endswith "_computers.json" or ObjectName endswith "_containers.json" or ObjectName endswith "_domains.json" or ObjectName endswith "_gpos.json" or ObjectName endswith "_groups.json" or ObjectName endswith "_ous.json" or ObjectName endswith "_users.json") and (not((NewProcessName endswith "\\svchost.exe" and ObjectName startswith "C:\\Program Files\\WindowsApps\\Microsoft." and ObjectName endswith "\\pocket_containers.json")))