// Title: VHD Image Download Via Browser
// Rule ID: 8468111a-ef07-4654-903b-b863a80bbc95
// Severity: medium
// Tags: attack.resource-development, attack.t1587.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_vhd_download_via_browsers.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\chrome.exe" or NewProcessName endswith "\\firefox.exe" or NewProcessName endswith "\\iexplore.exe" or NewProcessName endswith "\\maxthon.exe" or NewProcessName endswith "\\MicrosoftEdge.exe" or NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\msedgewebview2.exe" or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\safari.exe" or NewProcessName endswith "\\seamonkey.exe" or NewProcessName endswith "\\vivaldi.exe" or NewProcessName endswith "\\whale.exe") and ObjectName contains ".vhd"