SecurityEvent
| where (ObjectName endswith "\\AppData\\Local\\Temp*" or ObjectName endswith "\\Users\\Public*" or ObjectName endswith "\\Windows\\Temp*" or ObjectName endswith "C:\\Temp*") and ObjectName endswith ".pub"