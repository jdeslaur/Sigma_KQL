// Title: Suspicious Double Extension Files
// Rule ID: b4926b47-a9d7-434c-b3a0-adc3fa0bd13e
// Severity: high
// Tags: attack.defense-evasion, attack.t1036.007
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_double_extension.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ObjectName endswith ".exe" or ObjectName endswith ".iso" or ObjectName endswith ".rar" or ObjectName endswith ".svg" or ObjectName endswith ".zip") and (ObjectName contains ".doc." or ObjectName contains ".docx." or ObjectName contains ".gif." or ObjectName contains ".jpeg." or ObjectName contains ".jpg." or ObjectName contains ".mp3." or ObjectName contains ".mp4." or ObjectName contains ".pdf." or ObjectName contains ".png." or ObjectName contains ".ppt." or ObjectName contains ".pptx." or ObjectName contains ".rtf." or ObjectName contains ".svg." or ObjectName contains ".txt." or ObjectName contains ".xls." or ObjectName contains ".xlsx.")) or (ObjectName endswith ".rar.exe" or ObjectName endswith ".zip.exe")