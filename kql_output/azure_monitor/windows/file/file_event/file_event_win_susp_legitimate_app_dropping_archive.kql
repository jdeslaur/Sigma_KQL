// Title: Legitimate Application Dropped Archive
// Rule ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
// Severity: high
// Tags: attack.defense-evasion, attack.t1218
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_legitimate_app_dropping_archive.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\winword.exe" or NewProcessName endswith "\\excel.exe" or NewProcessName endswith "\\powerpnt.exe" or NewProcessName endswith "\\msaccess.exe" or NewProcessName endswith "\\mspub.exe" or NewProcessName endswith "\\eqnedt32.exe" or NewProcessName endswith "\\visio.exe" or NewProcessName endswith "\\wordpad.exe" or NewProcessName endswith "\\wordview.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\certoc.exe" or NewProcessName endswith "\\CertReq.exe" or NewProcessName endswith "\\Desktopimgdownldr.exe" or NewProcessName endswith "\\esentutl.exe" or NewProcessName endswith "\\finger.exe" or NewProcessName endswith "\\notepad.exe" or NewProcessName endswith "\\AcroRd32.exe" or NewProcessName endswith "\\RdrCEF.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\hh.exe") and (ObjectName endswith ".zip" or ObjectName endswith ".rar" or ObjectName endswith ".7z" or ObjectName endswith ".diagcab" or ObjectName endswith ".appx")