// Title: File With Uncommon Extension Created By An Office Application
// Rule ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
// Severity: high
// Tags: attack.t1204.002, attack.execution
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_office_susp_file_extension.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\excel.exe" or NewProcessName endswith "\\msaccess.exe" or NewProcessName endswith "\\mspub.exe" or NewProcessName endswith "\\powerpnt.exe" or NewProcessName endswith "\\visio.exe" or NewProcessName endswith "\\winword.exe") and (ObjectName endswith ".bat" or ObjectName endswith ".cmd" or ObjectName endswith ".com" or ObjectName endswith ".dll" or ObjectName endswith ".exe" or ObjectName endswith ".hta" or ObjectName endswith ".ocx" or ObjectName endswith ".proj" or ObjectName endswith ".ps1" or ObjectName endswith ".scf" or ObjectName endswith ".scr" or ObjectName endswith ".sys" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs" or ObjectName endswith ".wsf" or ObjectName endswith ".wsh")) and (not((ObjectName endswith "\\AppData\\Local\\assembly\\tmp*" and ObjectName endswith ".dll"))) and (not((((ObjectName endswith "C:\\Users*" and ObjectName endswith "\\AppData\\Local\\Microsoft\\Office*" and ObjectName contains "\\WebServiceCache\\AllUsers") and ObjectName endswith ".com") or (NewProcessName endswith "\\winword.exe" and ObjectName endswith "\\AppData\\Local\\Temp\\webexdelta*" and (ObjectName endswith ".dll" or ObjectName endswith ".exe")) or ((ObjectName endswith "C:\\Users*" and ObjectName endswith "\\AppData\\Local\\Microsoft\\Office*" and ObjectName endswith "\\BackstageInAppNavCache*") and ObjectName endswith ".com"))))