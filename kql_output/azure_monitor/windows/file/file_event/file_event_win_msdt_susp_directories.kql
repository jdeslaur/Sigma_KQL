// Title: File Creation In Suspicious Directory By Msdt.EXE
// Rule ID: 318557a5-150c-4c8d-b70e-a9910e199857
// Severity: high
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001, cve.2022-30190
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_msdt_susp_directories.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\msdt.exe" and (ObjectName endswith "\\Desktop*" or ObjectName endswith "\\Start Menu\\Programs\\Startup*" or ObjectName endswith "C:\\PerfLogs*" or ObjectName endswith "C:\\ProgramData*" or ObjectName endswith "C:\\Users\\Public*")