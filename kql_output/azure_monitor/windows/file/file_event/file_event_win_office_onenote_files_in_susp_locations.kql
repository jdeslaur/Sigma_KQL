// Title: OneNote Attachment File Dropped In Suspicious Location
// Rule ID: 7fd164ba-126a-4d9c-9392-0d4f7c243df0
// Severity: medium
// Tags: attack.defense-evasion
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_office_onenote_files_in_susp_locations.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ObjectName endswith "\\AppData\\Local\\Temp*" or ObjectName endswith "\\Users\\Public*" or ObjectName endswith "\\Windows\\Temp*" or ObjectName endswith ":\\Temp*") and (ObjectName endswith ".one" or ObjectName endswith ".onepkg")) and (not((NewProcessName contains ":\\Program Files\\Microsoft Office\\" and NewProcessName endswith "\\ONENOTE.EXE")))