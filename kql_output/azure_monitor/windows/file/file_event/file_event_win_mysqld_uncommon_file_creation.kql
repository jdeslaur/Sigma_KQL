// Title: Uncommon File Creation By Mysql Daemon Process
// Rule ID: c61daa90-3c1e-4f18-af62-8f288b5c9aaf
// Severity: high
// Tags: attack.defense-evasion
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_mysqld_uncommon_file_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\mysqld.exe" or NewProcessName endswith "\\mysqld-nt.exe") and (ObjectName endswith ".bat" or ObjectName endswith ".dat" or ObjectName endswith ".dll" or ObjectName endswith ".exe" or ObjectName endswith ".ps1" or ObjectName endswith ".psm1" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs")