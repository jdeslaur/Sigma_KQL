// Title: Suspicious Scheduled Task Write to System32 Tasks
// Rule ID: 80e1f67a-4596-4351-98f5-a9c3efabac95
// Severity: high
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_task_write.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName contains "\\Windows\\System32\\Tasks" and (NewProcessName contains "\\AppData\\" or NewProcessName contains "C:\\PerfLogs" or NewProcessName contains "\\Windows\\System32\\config\\systemprofile")