// Title: LiveKD Driver Creation By Uncommon Process
// Rule ID: 059c5af9-5131-4d8d-92b2-de4ad6146712
// Severity: high
// Tags: attack.defense-evasion, attack.privilege-escalation
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_sysinternals_livekd_driver_susp_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName =~ "C:\\Windows\\System32\\drivers\\LiveKdD.SYS" and (not((NewProcessName endswith "\\livekd.exe" or NewProcessName endswith "\\livek64.exe")))