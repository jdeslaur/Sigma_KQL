// Title: Suspicious File Created Via OneNote Application
// Rule ID: fcc6d700-68d9-4241-9a1a-06874d621b06
// Severity: high
// Tags: attack.defense-evasion
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_office_onenote_susp_dropped_files.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\onenote.exe" or NewProcessName endswith "\\onenotem.exe" or NewProcessName endswith "\\onenoteim.exe") and ObjectName endswith "\\AppData\\Local\\Temp\\OneNote*" and (ObjectName endswith ".bat" or ObjectName endswith ".chm" or ObjectName endswith ".cmd" or ObjectName endswith ".dll" or ObjectName endswith ".exe" or ObjectName endswith ".hta" or ObjectName endswith ".htm" or ObjectName endswith ".html" or ObjectName endswith ".js" or ObjectName endswith ".lnk" or ObjectName endswith ".ps1" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs" or ObjectName endswith ".wsf")