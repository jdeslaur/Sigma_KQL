// Title: Suspicious ASPX File Drop by Exchange
// Rule ID: bd1212e5-78da-431e-95fa-c58e3237a8e6
// Severity: high
// Tags: attack.persistence, attack.t1505.003
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_exchange_webshell_drop.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\w3wp.exe" and CommandLine contains "MSExchange" and (ObjectName endswith "FrontEnd\\HttpProxy*" or ObjectName endswith "\\inetpub\\wwwroot\\aspnet_client*")) and (ObjectName endswith ".aspx" or ObjectName endswith ".asp" or ObjectName endswith ".ashx")