// Title: Windows Binaries Write Suspicious Extensions
// Rule ID: b8fd0e93-ff58-4cbd-8f48-1c114e342e62
// Severity: high
// Tags: attack.defense-evasion, attack.t1036
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_shell_write_susp_files_extensions.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (((NewProcessName endswith "\\csrss.exe" or NewProcessName endswith "\\lsass.exe" or NewProcessName endswith "\\RuntimeBroker.exe" or NewProcessName endswith "\\sihost.exe" or NewProcessName endswith "\\smss.exe" or NewProcessName endswith "\\wininit.exe" or NewProcessName endswith "\\winlogon.exe") and (ObjectName endswith ".bat" or ObjectName endswith ".dll" or ObjectName endswith ".exe" or ObjectName endswith ".hta" or ObjectName endswith ".iso" or ObjectName endswith ".ps1" or ObjectName endswith ".txt" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs")) or ((NewProcessName endswith "\\dllhost.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\svchost.exe") and (ObjectName endswith ".bat" or ObjectName endswith ".hta" or ObjectName endswith ".iso" or ObjectName endswith ".ps1" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs"))) and (not(((NewProcessName =~ "C:\\Windows\\System32\\dllhost.exe" and (ObjectName endswith ":\\Users*" and ObjectName contains "\\AppData\\Local\\Temp\\__PSScriptPolicyTest_") and ObjectName endswith ".ps1") or (NewProcessName =~ "C:\\Windows\\system32\\svchost.exe" and (ObjectName endswith "C:\\Windows\\System32\\GroupPolicy\\DataStore*" and ObjectName endswith "\\sysvol*" and ObjectName endswith "\\Policies*" and ObjectName endswith "\\Machine\\Scripts\\Startup*") and (ObjectName endswith ".ps1" or ObjectName endswith ".bat")) or (NewProcessName =~ "C:\\Windows\\system32\\svchost.exe" and (ObjectName contains "C:\\Program Files\\WindowsApps\\Clipchamp" and ObjectName contains ".ps1")) or ((NewProcessName in~ ("C:\\Windows\\system32\\svchost.exe", "C:\\Windows\\SysWOW64\\svchost.exe")) and (ObjectName startswith "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" or ObjectName startswith "C:\\Program Files (x86)\\WindowsApps\\Microsoft.PowerShellPreview") and ObjectName endswith ".ps1"))))