// Title: Suspicious File Created by ArcSOC.exe
// Rule ID: e890acee-d488-420e-8f20-d9b19b3c3d43
// Severity: high
// Tags: attack.defense-evasion, attack.command-and-control, attack.persistence, attack.initial-access, attack.t1127, attack.t1105, attack.t1133
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_arcsoc_susp_file_created.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "\\ArcSOC.exe" and (ObjectName endswith ".ahk" or ObjectName endswith ".aspx" or ObjectName endswith ".au3" or ObjectName endswith ".bat" or ObjectName endswith ".cmd" or ObjectName endswith ".dll" or ObjectName endswith ".exe" or ObjectName endswith ".hta" or ObjectName endswith ".js" or ObjectName endswith ".ps1" or ObjectName endswith ".py" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs" or ObjectName endswith ".wsf")