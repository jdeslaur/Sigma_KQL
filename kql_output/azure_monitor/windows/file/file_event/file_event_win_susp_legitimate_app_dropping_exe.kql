// Title: Legitimate Application Dropped Executable
// Rule ID: f0540f7e-2db3-4432-b9e0-3965486744bc
// Severity: high
// Tags: attack.defense-evasion, attack.t1218
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_legitimate_app_dropping_exe.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\eqnedt32.exe" or NewProcessName endswith "\\wordpad.exe" or NewProcessName endswith "\\wordview.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\certoc.exe" or NewProcessName endswith "\\CertReq.exe" or NewProcessName endswith "\\Desktopimgdownldr.exe" or NewProcessName endswith "\\esentutl.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\AcroRd32.exe" or NewProcessName endswith "\\RdrCEF.exe" or NewProcessName endswith "\\hh.exe" or NewProcessName endswith "\\finger.exe") and (ObjectName endswith ".exe" or ObjectName endswith ".dll" or ObjectName endswith ".ocx")