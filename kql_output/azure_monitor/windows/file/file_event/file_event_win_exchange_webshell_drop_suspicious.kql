SecurityEvent
| where (NewProcessName endswith "\\w3wp.exe" and CommandLine contains "MSExchange") and (ObjectName endswith ".aspx" or ObjectName endswith ".asp" or ObjectName endswith ".ashx" or ObjectName endswith ".ps1" or ObjectName endswith ".bat" or ObjectName endswith ".exe" or ObjectName endswith ".dll" or ObjectName endswith ".vbs")