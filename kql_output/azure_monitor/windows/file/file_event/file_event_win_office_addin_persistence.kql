// Title: Potential Persistence Via Microsoft Office Add-In
// Rule ID: 8e1cb247-6cf6-42fa-b440-3f27d57e9936
// Severity: high
// Tags: attack.persistence, attack.t1137.006
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_office_addin_persistence.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\Microsoft\\Word\\Startup*" and ObjectName endswith ".wll") or (ObjectName endswith "\\Microsoft\\Excel\\Startup*" and ObjectName endswith ".xll") or (ObjectName endswith "Microsoft\\Excel\\XLSTART*" and ObjectName endswith ".xlam") or (ObjectName endswith "\\Microsoft\\Addins*" and (ObjectName endswith ".xlam" or ObjectName endswith ".xla" or ObjectName endswith ".ppam"))