// Title: LSASS Process Memory Dump Files
// Rule ID: a5a2d357-1ab8-4675-a967-ef9990a59391
// Severity: high
// Tags: attack.credential-access, attack.t1003.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_lsass_default_dump_file_names.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\Andrew.dmp" or ObjectName endswith "\\Coredump.dmp" or ObjectName endswith "\\lsass.dmp" or ObjectName endswith "\\lsass.rar" or ObjectName endswith "\\lsass.zip" or ObjectName endswith "\\NotLSASS.zip" or ObjectName endswith "\\PPLBlade.dmp" or ObjectName endswith "\\rustive.dmp") or (ObjectName contains "\\lsass_2" or ObjectName contains "\\lsassdmp" or ObjectName contains "\\lsassdump") or (ObjectName contains "\\lsass" and ObjectName contains ".dmp") or (ObjectName contains "SQLDmpr" and ObjectName endswith ".mdmp") or ((ObjectName contains "\\nanodump" or ObjectName contains "\\proc_") and ObjectName endswith ".dmp")