// Title: PowerShell Script Dropped Via PowerShell.EXE
// Rule ID: 576426ad-0131-4001-ae01-be175da0c108
// Severity: low
// Tags: attack.persistence
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_powershell_drop_powershell.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and ObjectName endswith ".ps1") and (not((ObjectName contains "__PSScriptPolicyTest_" or (ObjectName has_all ("C:\\Users*") and ObjectName endswith "\\AppData\\Local\\Temp*") or ObjectName =~ "C:\\Windows\\Temp*")))