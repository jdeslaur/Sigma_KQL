// Title: Potential Binary Or Script Dropper Via PowerShell
// Rule ID: 7047d730-036f-4f40-b9d8-1c63e36d5e62
// Severity: medium
// Tags: attack.persistence
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_powershell_drop_binary_or_script.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\powershell_ise.exe" or NewProcessName endswith "\\pwsh.exe") and (ObjectName endswith ".bat" or ObjectName endswith ".chm" or ObjectName endswith ".cmd" or ObjectName endswith ".com" or ObjectName endswith ".dll" or ObjectName endswith ".exe" or ObjectName endswith ".hta" or ObjectName endswith ".jar" or ObjectName endswith ".js" or ObjectName endswith ".ocx" or ObjectName endswith ".scr" or ObjectName endswith ".sys" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs" or ObjectName endswith ".wsf")) and (not(((ObjectName =~ "C:\\Users*" and ObjectName endswith "\\AppData\\Local\\Temp*" and (ObjectName endswith ".dll" or ObjectName endswith ".exe")) or ((ObjectName in~ ("C:\\Windows\\Temp*", "C:\\Windows\\SystemTemp*")) and (ObjectName endswith ".dll" or ObjectName endswith ".exe")) or (ObjectName has_all ("C:\\Users*") and ObjectName endswith "\\WindowsPowerShell\\Modules*" and ObjectName endswith ".dll") or (ObjectName has_all ("C:\\Program Files\\PackageManagement\\ProviderAssemblies\\nuget*") and ObjectName endswith "\\Microsoft.PackageManagement.NuGetProvider.dll"))))