// Title: ADSI-Cache File Creation By Uncommon Tool
// Rule ID: 75bf09fa-1dd7-4d18-9af9-dd9e492562eb
// Severity: medium
// Tags: attack.t1001.003, attack.command-and-control
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_adsi_cache_creation_by_uncommon_tool.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\Local\\Microsoft\\Windows\\SchCache*" and ObjectName endswith ".sch") and (not((((NewProcessName endswith ":\\Program Files\\Cylance\\Desktop\\CylanceSvc.exe" or NewProcessName endswith ":\\Windows\\CCM\\CcmExec.exe" or NewProcessName endswith ":\\windows\\system32\\dllhost.exe" or NewProcessName endswith ":\\Windows\\system32\\dsac.exe" or NewProcessName endswith ":\\Windows\\system32\\efsui.exe" or NewProcessName endswith ":\\windows\\system32\\mmc.exe" or NewProcessName endswith ":\\windows\\system32\\svchost.exe" or NewProcessName endswith ":\\Windows\\System32\\wbem\\WmiPrvSE.exe" or NewProcessName endswith ":\\windows\\system32\\WindowsPowerShell\\v1.0\\powershell.exe") or (NewProcessName contains ":\\Windows\\ccmsetup\\autoupgrade\\ccmsetup" or NewProcessName contains ":\\Program Files\\SentinelOne\\Sentinel Agent")) or ((NewProcessName contains ":\\Program Files\\" and NewProcessName contains "\\Microsoft Office") and NewProcessName endswith "\\OUTLOOK.EXE")))) and (not((NewProcessName endswith "\\LANDesk\\LDCLient\\ldapwhoami.exe" or NewProcessName endswith ":\\Program Files\\Citrix\\Receiver StoreFront\\Services\\DefaultDomainServices\\Citrix.DeliveryServices.DomainServices.ServiceHost.exe")))