// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName contains "\\procmon" and ObjectName endswith ".sys") and (not((NewProcessName endswith "\\procmon.exe" or NewProcessName endswith "\\procmon64.exe")))