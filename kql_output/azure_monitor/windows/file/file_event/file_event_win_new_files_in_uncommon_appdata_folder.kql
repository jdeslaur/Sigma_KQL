// Title: Suspicious File Creation In Uncommon AppData Folder
// Rule ID: d7b50671-d1ad-4871-aa60-5aa5b331fe04
// Severity: high
// Tags: attack.defense-evasion, attack.execution
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_new_files_in_uncommon_appdata_folder.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName =~ "C:\\Users*" and ObjectName endswith "\\AppData*" and (ObjectName endswith ".bat" or ObjectName endswith ".cmd" or ObjectName endswith ".cpl" or ObjectName endswith ".dll" or ObjectName endswith ".exe" or ObjectName endswith ".hta" or ObjectName endswith ".iso" or ObjectName endswith ".lnk" or ObjectName endswith ".msi" or ObjectName endswith ".ps1" or ObjectName endswith ".psm1" or ObjectName endswith ".scr" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs")) and (not((ObjectName =~ "C:\\Users*" and (ObjectName endswith "\\AppData\\Local*" or ObjectName endswith "\\AppData\\LocalLow*" or ObjectName endswith "\\AppData\\Roaming*"))))