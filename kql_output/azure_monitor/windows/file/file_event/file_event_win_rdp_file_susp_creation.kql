// Title: .RDP File Created By Uncommon Application
// Rule ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
// Severity: high
// Tags: attack.defense-evasion
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_rdp_file_susp_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith ".rdp" and (NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\CCleaner Browser\\Application\\CCleanerBrowser.exe" or NewProcessName endswith "\\chromium.exe" or NewProcessName endswith "\\firefox.exe" or NewProcessName endswith "\\Google\\Chrome\\Application\\chrome.exe" or NewProcessName endswith "\\iexplore.exe" or NewProcessName endswith "\\microsoftedge.exe" or NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\Opera.exe" or NewProcessName endswith "\\Vivaldi.exe" or NewProcessName endswith "\\Whale.exe" or NewProcessName endswith "\\olk.exe" or NewProcessName endswith "\\Outlook.exe" or NewProcessName endswith "\\RuntimeBroker.exe" or NewProcessName endswith "\\Thunderbird.exe" or NewProcessName endswith "\\Discord.exe" or NewProcessName endswith "\\Keybase.exe" or NewProcessName endswith "\\msteams.exe" or NewProcessName endswith "\\Slack.exe" or NewProcessName endswith "\\teams.exe")