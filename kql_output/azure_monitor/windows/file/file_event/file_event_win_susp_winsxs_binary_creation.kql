// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName has_all ("C:\\Windows\\WinSxS*") and ObjectName endswith ".exe") and (not((NewProcessName startswith "C:\\Windows\\Systems32\\" or NewProcessName startswith "C:\\Windows\\SysWOW64\\" or NewProcessName startswith "C:\\Windows\\WinSxS\\")))