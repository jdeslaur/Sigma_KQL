// Title: NTDS.DIT Creation By Uncommon Process
// Rule ID: 11b1ed55-154d-4e82-8ad7-83739298f720
// Severity: high
// Tags: attack.credential-access, attack.t1003.002, attack.t1003.003
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_ntds_dit_uncommon_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith "\\ntds.dit" and ((NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\wsl.exe" or NewProcessName endswith "\\wt.exe") or (NewProcessName contains "\\AppData\\" or NewProcessName contains "\\Temp\\" or NewProcessName contains "\\Public\\" or NewProcessName contains "\\PerfLogs\\"))