// Title: Suspicious LNK Double Extension File Created
// Rule ID: 3215aa19-f060-4332-86d5-5602511f3ca8
// Severity: medium
// Tags: attack.defense-evasion, attack.t1036.007
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_lnk_double_extension.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith ".lnk" and (ObjectName contains ".doc." or ObjectName contains ".docx." or ObjectName contains ".jpg." or ObjectName contains ".pdf." or ObjectName contains ".ppt." or ObjectName contains ".pptx." or ObjectName contains ".xls." or ObjectName contains ".xlsx.")) and (not(ObjectName endswith "\\AppData\\Roaming\\Microsoft\\Windows\\Recent*")) and (not((((NewProcessName endswith "\\excel.exe" or NewProcessName endswith "\\powerpnt.exe" or NewProcessName endswith "\\winword.exe") and ObjectName endswith "\\AppData\\Roaming\\Microsoft\\Office\\Recent*") or (NewProcessName endswith "\\excel.exe" and ObjectName contains "\\AppData\\Roaming\\Microsoft\\Excel") or (NewProcessName endswith "\\powerpnt.exe" and ObjectName contains "\\AppData\\Roaming\\Microsoft\\PowerPoint") or (NewProcessName endswith "\\winword.exe" and ObjectName contains "\\AppData\\Roaming\\Microsoft\\Word"))))