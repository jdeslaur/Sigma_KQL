// Title: Potential Persistence Via Microsoft Office Startup Folder
// Rule ID: 0e20c89d-2264-44ae-8238-aeeaba609ece
// Severity: high
// Tags: attack.persistence, attack.t1137
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_office_startup_persistence.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (((ObjectName contains "\\Microsoft\\Word\\STARTUP" or (ObjectName contains "\\Office" and ObjectName contains "\\Program Files" and ObjectName contains "\\STARTUP")) and (ObjectName endswith ".doc" or ObjectName endswith ".docm" or ObjectName endswith ".docx" or ObjectName endswith ".dot" or ObjectName endswith ".dotm" or ObjectName endswith ".rtf")) or ((ObjectName contains "\\Microsoft\\Excel\\XLSTART" or (ObjectName contains "\\Office" and ObjectName contains "\\Program Files" and ObjectName contains "\\XLSTART")) and (ObjectName endswith ".xls" or ObjectName endswith ".xlsm" or ObjectName endswith ".xlsx" or ObjectName endswith ".xlt" or ObjectName endswith ".xltm"))) and (not((NewProcessName endswith "\\WINWORD.exe" or NewProcessName endswith "\\EXCEL.exe")))