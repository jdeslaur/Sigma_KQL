SecurityEvent
| where (ObjectName endswith "\\AtBroker.exe" or ObjectName endswith "\\audiodg.exe" or ObjectName endswith "\\backgroundTaskHost.exe" or ObjectName endswith "\\bcdedit.exe" or ObjectName endswith "\\bitsadmin.exe" or ObjectName endswith "\\cmdl32.exe" or ObjectName endswith "\\cmstp.exe" or ObjectName endswith "\\conhost.exe" or ObjectName endswith "\\csrss.exe" or ObjectName endswith "\\dasHost.exe" or ObjectName endswith "\\dfrgui.exe" or ObjectName endswith "\\dllhost.exe" or ObjectName endswith "\\dwm.exe" or ObjectName endswith "\\eventcreate.exe" or ObjectName endswith "\\eventvwr.exe" or ObjectName endswith "\\explorer.exe" or ObjectName endswith "\\extrac32.exe" or ObjectName endswith "\\fontdrvhost.exe" or ObjectName endswith "\\ipconfig.exe" or ObjectName endswith "\\iscsicli.exe" or ObjectName endswith "\\iscsicpl.exe" or ObjectName endswith "\\logman.exe" or ObjectName endswith "\\LogonUI.exe" or ObjectName endswith "\\LsaIso.exe" or ObjectName endswith "\\lsass.exe" or ObjectName endswith "\\lsm.exe" or ObjectName endswith "\\msiexec.exe" or ObjectName endswith "\\msinfo32.exe" or ObjectName endswith "\\mstsc.exe" or ObjectName endswith "\\nbtstat.exe" or ObjectName endswith "\\odbcconf.exe" or ObjectName endswith "\\powershell.exe" or ObjectName endswith "\\pwsh.exe" or ObjectName endswith "\\regini.exe" or ObjectName endswith "\\regsvr32.exe" or ObjectName endswith "\\rundll32.exe" or ObjectName endswith "\\RuntimeBroker.exe" or ObjectName endswith "\\schtasks.exe" or ObjectName endswith "\\SearchFilterHost.exe" or ObjectName endswith "\\SearchIndexer.exe" or ObjectName endswith "\\SearchProtocolHost.exe" or ObjectName endswith "\\SecurityHealthService.exe" or ObjectName endswith "\\SecurityHealthSystray.exe" or ObjectName endswith "\\services.exe" or ObjectName endswith "\\ShellAppRuntime.exe" or ObjectName endswith "\\sihost.exe" or ObjectName endswith "\\smartscreen.exe" or ObjectName endswith "\\smss.exe" or ObjectName endswith "\\spoolsv.exe" or ObjectName endswith "\\svchost.exe" or ObjectName endswith "\\SystemSettingsBroker.exe" or ObjectName endswith "\\taskhost.exe" or ObjectName endswith "\\taskhostw.exe" or ObjectName endswith "\\Taskmgr.exe" or ObjectName endswith "\\TiWorker.exe" or ObjectName endswith "\\vssadmin.exe" or ObjectName endswith "\\w32tm.exe" or ObjectName endswith "\\WerFault.exe" or ObjectName endswith "\\WerFaultSecure.exe" or ObjectName endswith "\\wermgr.exe" or ObjectName endswith "\\wevtutil.exe" or ObjectName endswith "\\wininit.exe" or ObjectName endswith "\\winlogon.exe" or ObjectName endswith "\\winrshost.exe" or ObjectName endswith "\\WinRTNetMUAHostServer.exe" or ObjectName endswith "\\wlanext.exe" or ObjectName endswith "\\wlrmdr.exe" or ObjectName endswith "\\WmiPrvSE.exe" or ObjectName endswith "\\wslhost.exe" or ObjectName endswith "\\WSReset.exe" or ObjectName endswith "\\WUDFHost.exe" or ObjectName endswith "\\WWAHost.exe") and (not(((ObjectName endswith "C:\\$WINDOWS.~BT*" or ObjectName endswith "C:\\$WinREAgent*" or ObjectName endswith "C:\\Windows\\SoftwareDistribution*" or ObjectName endswith "C:\\Windows\\System32*" or ObjectName endswith "C:\\Windows\\SysWOW64*" or ObjectName endswith "C:\\Windows\\WinSxS*" or ObjectName endswith "C:\\Windows\\uus*") or ((NewProcessName endswith "\\TiWorker.exe" or NewProcessName endswith "\\wuaucltcore.exe") and ObjectName =~ "C:\\Windows\\Temp*") or ((NewProcessName endswith "C:\\Windows\\system32\\svchost.exe" or NewProcessName endswith "C:\\Windows\\SysWOW64\\svchost.exe") and (ObjectName endswith "C:\\Program Files\\WindowsApps*" or ObjectName endswith "C:\\Program Files (x86)\\WindowsApps*" or ObjectName endswith "\\AppData\\Local\\Microsoft\\WindowsApps*")) or (NewProcessName in~ ("C:\\Windows\\System32\\wuauclt.exe", "C:\\Windows\\SysWOW64\\wuauclt.exe", "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe")) or ObjectName endswith "C:\\Windows\\explorer.exe" or ((NewProcessName endswith "C:\\WINDOWS\\system32\\msiexec.exe" or NewProcessName endswith "C:\\WINDOWS\\SysWOW64\\msiexec.exe") and (ObjectName in~ ("C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*") or ObjectName startswith "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or ObjectName startswith "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe")) or (ObjectName endswith "C:\\Windows\\System32\\SecurityHealth*" and ObjectName endswith "\\SecurityHealthSystray.exe" and NewProcessName endswith "\\SecurityHealthSetup.exe"))))