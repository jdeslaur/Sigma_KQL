// Title: LSASS Process Memory Dump Creation Via Taskmgr.EXE
// Rule ID: 69ca12af-119d-44ed-b50f-a47af0ebc364
// Severity: high
// Tags: attack.credential-access, attack.t1003.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_taskmgr_lsass_dump.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith ":\\Windows\\system32\\taskmgr.exe" or NewProcessName endswith ":\\Windows\\SysWOW64\\taskmgr.exe") and (ObjectName endswith "\\AppData\\Local\\Temp*" and ObjectName contains "\\lsass" and ObjectName contains ".DMP")