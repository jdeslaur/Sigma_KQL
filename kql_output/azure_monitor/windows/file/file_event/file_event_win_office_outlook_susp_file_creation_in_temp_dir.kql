// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith ".cpl" or ObjectName endswith ".hta" or ObjectName endswith ".iso" or ObjectName endswith ".rdp" or ObjectName endswith ".svg" or ObjectName endswith ".vba" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs") and ((ObjectName contains "\\AppData\\Local\\Packages\\Microsoft.Outlook_" or ObjectName endswith "\\AppData\\Local\\Microsoft\\Olk\\Attachments*") or (ObjectName endswith "\\AppData\\Local\\Microsoft\\Windows*" and ObjectName endswith "\\Content.Outlook*"))