// Title: WebDAV Temporary Local File Creation
// Rule ID: 4c55738d-72d8-490e-a2db-7969654e375f
// Severity: medium
// Tags: attack.initial-access, attack.resource-development, attack.t1584, attack.t1566, detection.threat-hunting
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/file/file_event/file_event_win_webdav_tmpfile_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith "\\AppData\\Local\\Temp\\TfsStore\\Tfs_DAV*" and (ObjectName endswith ".7z" or ObjectName endswith ".bat" or ObjectName endswith ".dat" or ObjectName endswith ".ico" or ObjectName endswith ".js" or ObjectName endswith ".lnk" or ObjectName endswith ".ps1" or ObjectName endswith ".rar" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs" or ObjectName endswith ".zip")