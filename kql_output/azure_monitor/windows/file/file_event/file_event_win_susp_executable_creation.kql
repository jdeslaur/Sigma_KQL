// Title: Suspicious Executable File Creation
// Rule ID: 74babdd6-a758-4549-9632-26535279e654
// Severity: high
// Tags: attack.defense-evasion, attack.t1564
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_executable_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith ":\\$Recycle.Bin.exe" or ObjectName endswith ":\\Documents and Settings.exe" or ObjectName endswith ":\\MSOCache.exe" or ObjectName endswith ":\\PerfLogs.exe" or ObjectName endswith ":\\Recovery.exe" or ObjectName endswith ".bat.exe" or ObjectName endswith ".sys.exe"