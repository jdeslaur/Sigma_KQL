// Title: Suspicious File Created In PerfLogs
// Rule ID: bbb7e38c-0b41-4a11-b306-d2a457b7ac2b
// Severity: medium
// Tags: attack.execution, attack.t1059
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_perflogs_susp_files.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName =~ "C:\\PerfLogs*" and (ObjectName endswith ".7z" or ObjectName endswith ".bat" or ObjectName endswith ".bin" or ObjectName endswith ".chm" or ObjectName endswith ".dll" or ObjectName endswith ".exe" or ObjectName endswith ".hta" or ObjectName endswith ".lnk" or ObjectName endswith ".ps1" or ObjectName endswith ".psm1" or ObjectName endswith ".py" or ObjectName endswith ".scr" or ObjectName endswith ".sys" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs" or ObjectName endswith ".zip")