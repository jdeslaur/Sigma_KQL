SecurityEvent
| where (ObjectName has_all ("C:\\Users*") and ObjectName endswith "\\AppData\\Local\\Temp\\OskSupport.dll") or (NewProcessName =~ "C:\\Windows\\system32\\DllHost.exe" and ObjectName =~ "C:\\Program Files\\Windows Media Player\\osk.exe")