// Title: Potential Startup Shortcut Persistence Via PowerShell.EXE
// Rule ID: 92fa78e7-4d39-45f1-91a3-8b23f3f1088d
// Severity: high
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_powershell_startup_shortcuts.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and ObjectName endswith "\\start menu\\programs\\startup*" and ObjectName endswith ".lnk"