// Title: Creation of WerFault.exe/Wer.dll in Unusual Folder
// Rule ID: 28a452f3-786c-4fd8-b8f2-bddbe9d616d1
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.defense-evasion, attack.t1574.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_werfault_dll_hijacking.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName endswith "\\WerFault.exe" or ObjectName endswith "\\wer.dll") and (not((ObjectName in~ ("C:\\Windows\\SoftwareDistribution*", "C:\\Windows\\System32*", "C:\\Windows\\SysWOW64*", "C:\\Windows\\WinSxS*", "C:\\Windows\\UUS\\arm64*"))))