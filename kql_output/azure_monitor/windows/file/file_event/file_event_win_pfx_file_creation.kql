// Title: PFX File Creation
// Rule ID: dca1b3e8-e043-4ec8-85d7-867f334b5724
// Severity: low
// Tags: attack.credential-access, attack.t1552.004, detection.threat-hunting
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/file/file_event/file_event_win_pfx_file_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith ".pfx" and (not((((NewProcessName in~ ("C:\\Program Files\\Microsoft OneDrive\\OneDrive.exe", "C:\\Program Files (x86)\\Microsoft OneDrive\\OneDrive.exe")) and ObjectName endswith "\\OneDrive\\CodeSigning.pfx") or (ObjectName in~ ("C:\\Program Files (x86)\\Microsoft Visual Studio*", "C:\\Program Files\\Microsoft Visual Studio*")) or ObjectName =~ "C:\\Program Files\\CMake*")))