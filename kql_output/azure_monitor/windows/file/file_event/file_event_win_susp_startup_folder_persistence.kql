// Title: Suspicious Startup Folder Persistence
// Rule ID: 28208707-fe31-437f-9a7f-4b1108b94d2e
// Severity: high
// Tags: attack.privilege-escalation, attack.execution, attack.t1204.002, attack.persistence, attack.t1547.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_startup_folder_persistence.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith "\\Windows\\Start Menu\\Programs\\Startup*" and (ObjectName endswith ".bat" or ObjectName endswith ".cmd" or ObjectName endswith ".dll" or ObjectName endswith ".hta" or ObjectName endswith ".jar" or ObjectName endswith ".js" or ObjectName endswith ".jse" or ObjectName endswith ".msi" or ObjectName endswith ".ps1" or ObjectName endswith ".psd1" or ObjectName endswith ".psm1" or ObjectName endswith ".scr" or ObjectName endswith ".url" or ObjectName endswith ".vba" or ObjectName endswith ".vbe" or ObjectName endswith ".vbs" or ObjectName endswith ".wsf")