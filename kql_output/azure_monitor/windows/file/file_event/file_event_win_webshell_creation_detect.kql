// Title: Potential Webshell Creation On Static Website
// Rule ID: 39f1f9f2-9636-45de-98f6-a4046aa8e4b9
// Severity: medium
// Tags: attack.persistence, attack.t1505.003
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_webshell_creation_detect.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ObjectName endswith "\\inetpub\\wwwroot*" and (ObjectName contains ".ashx" or ObjectName contains ".asp" or ObjectName contains ".ph" or ObjectName contains ".soap")) or ((ObjectName endswith "\\www*" or ObjectName endswith "\\htdocs*" or ObjectName endswith "\\html*") and ObjectName contains ".ph")) and (not(((ObjectName endswith "\\AppData\\Local\\Temp*" or ObjectName endswith "\\Windows\\Temp*") or NewProcessName =~ "System" or ObjectName contains "\\xampp")))