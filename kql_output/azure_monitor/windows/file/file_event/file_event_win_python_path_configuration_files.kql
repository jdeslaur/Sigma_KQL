// Title: Python Path Configuration File Creation - Windows
// Rule ID: e3652ba3-0ad8-4010-a957-b7ba369e7bac
// Severity: medium
// Tags: attack.execution, attack.t1059.006, detection.threat-hunting
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/windows/file/file_event/file_event_win_python_path_configuration_files.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName matches regex "(?i)\\\\(venv|python(.+)?)\\\\lib\\\\site-packages\\\\" and ObjectName endswith ".pth") and (not((NewProcessName endswith "\\python.exe" and (ObjectName endswith "\\pywin32.pth" or ObjectName endswith "\\distutils-precedence.pth"))))