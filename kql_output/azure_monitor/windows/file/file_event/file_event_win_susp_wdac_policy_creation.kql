// Title: Potentially Suspicious WDAC Policy File Creation
// Rule ID: 1d2de8a6-4803-4fde-b85b-f58f3aa7a705
// Severity: medium
// Tags: attack.defense-evasion
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_susp_wdac_policy_creation.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith "\\Windows\\System32\\CodeIntegrity*" and (not(((NewProcessName endswith "\\Microsoft.ConfigurationManagement.exe" or NewProcessName endswith "\\WDAC Wizard.exe" or NewProcessName endswith "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or NewProcessName endswith "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or NewProcessName endswith "C:\\Windows\\System32\\dllhost.exe" or NewProcessName endswith "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or NewProcessName endswith "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or NewProcessName endswith "C:\\Windows\\SysWOW64\\dllhost.exe" or NewProcessName endswith "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or NewProcessName endswith "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe") or ((CommandLine contains "ConvertFrom-CIPolicy -XmlFilePath" and CommandLine contains "-BinaryFilePath ") or CommandLine contains "CiTool --update-policy" or (CommandLine contains "Copy-Item -Path" and CommandLine contains "-Destination")) or NewProcessName =~ "System" or (NewProcessName in~ ("C:\\Windows\\System32\\wuauclt.exe", "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe")))))