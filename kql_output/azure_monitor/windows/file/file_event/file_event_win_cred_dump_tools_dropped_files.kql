SecurityEvent
| where (ObjectName contains "\\fgdump-log" or ObjectName contains "\\kirbi" or ObjectName contains "\\pwdump" or ObjectName contains "\\pwhashes" or ObjectName contains "\\wce_ccache" or ObjectName contains "\\wce_krbtkts") or (ObjectName endswith "\\cachedump.exe" or ObjectName endswith "\\cachedump64.exe" or ObjectName endswith "\\DumpExt.dll" or ObjectName endswith "\\DumpSvc.exe" or ObjectName endswith "\\Dumpy.exe" or ObjectName endswith "\\fgexec.exe" or ObjectName endswith "\\lsremora.dll" or ObjectName endswith "\\lsremora64.dll" or ObjectName endswith "\\NTDS.out" or ObjectName endswith "\\procdump.exe" or ObjectName endswith "\\procdump64.exe" or ObjectName endswith "\\procdump64a.exe" or ObjectName endswith "\\pstgdump.exe" or ObjectName endswith "\\pwdump.exe" or ObjectName endswith "\\SAM.out" or ObjectName endswith "\\SECURITY.out" or ObjectName endswith "\\servpw.exe" or ObjectName endswith "\\servpw64.exe" or ObjectName endswith "\\SYSTEM.out" or ObjectName endswith "\\test.pwd" or ObjectName endswith "\\wceaux.dll")