SecurityEvent
| where (NewProcessName endswith "\\svchost.exe" and ObjectName endswith "\\Personalization\\LockScreenImage*") and (not(ObjectName endswith "C:\\Windows*")) and (not((ObjectName contains ".jpg" or ObjectName contains ".jpeg" or ObjectName contains ".png")))