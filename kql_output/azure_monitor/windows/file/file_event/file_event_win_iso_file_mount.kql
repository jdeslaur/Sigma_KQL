// Title: ISO File Created Within Temp Folders
// Rule ID: 2f9356ae-bf43-41b8-b858-4496d83b2acb
// Severity: high
// Tags: attack.initial-access, attack.t1566.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_iso_file_mount.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ObjectName endswith "\\AppData\\Local\\Temp*" and ObjectName endswith ".zip*") and ObjectName endswith ".iso") or (ObjectName endswith "\\AppData\\Local\\Microsoft\\Windows\\INetCache\\Content.Outlook*" and ObjectName endswith ".iso")