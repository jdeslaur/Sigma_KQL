// Title: Desktop.INI Created by Uncommon Process
// Rule ID: 81315b50-6b60-4d8f-9928-3466e1022515
// Severity: medium
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.009
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_desktop_ini_created_by_uncommon_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName endswith "\\desktop.ini" and (not(((NewProcessName startswith "C:\\Windows\\" or NewProcessName startswith "C:\\Program Files\\" or NewProcessName startswith "C:\\Program Files (x86)\\") or ObjectName =~ "C:\\$WINDOWS.~BT\\NewOS*"))) and (not(((NewProcessName startswith "C:\\Users\\" and NewProcessName endswith "\\AppData\\Local\\JetBrains\\Toolbox\\bin\\7z.exe" and ObjectName endswith "\\JetBrains\\apps*") or (NewProcessName startswith "C:\\Users\\" and NewProcessName contains "\\AppData\\Local\\Microsoft\\OneDrive\\"))))