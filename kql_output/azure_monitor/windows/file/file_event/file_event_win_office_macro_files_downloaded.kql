// Title: Office Macro File Download
// Rule ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
// Severity: low
// Tags: attack.initial-access, attack.t1566.001
// Category: file_event
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/windows/file/file_event/file_event_win_office_macro_files_downloaded.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "\\RuntimeBroker.exe" or NewProcessName endswith "\\outlook.exe" or NewProcessName endswith "\\thunderbird.exe" or NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\chrome.exe" or NewProcessName endswith "\\firefox.exe" or NewProcessName endswith "\\iexplore.exe" or NewProcessName endswith "\\maxthon.exe" or NewProcessName endswith "\\MicrosoftEdge.exe" or NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\msedgewebview2.exe" or NewProcessName endswith "\\opera.exe" or NewProcessName endswith "\\safari.exe" or NewProcessName endswith "\\seamonkey.exe" or NewProcessName endswith "\\vivaldi.exe" or NewProcessName endswith "\\whale.exe") and ((ObjectName endswith ".docm" or ObjectName endswith ".dotm" or ObjectName endswith ".xlsm" or ObjectName endswith ".xltm" or ObjectName endswith ".potm" or ObjectName endswith ".pptm") or (ObjectName contains ".docm:Zone" or ObjectName contains ".dotm:Zone" or ObjectName contains ".xlsm:Zone" or ObjectName contains ".xltm:Zone" or ObjectName contains ".potm:Zone" or ObjectName contains ".pptm:Zone"))