SecurityEvent
| where (ObjectName endswith ":\\Program Files\\SysAidServer\\tomcat\\webapps\\usersfiles\\user.exe" or ObjectName endswith ":\\Program Files\\SysAidServer\\tomcat\\webapps\\usersfiles.war" or ObjectName endswith ":\\Program Files\\SysAidServer\\tomcat\\webapps\\leave") or ObjectName contains ":\\Program Files\\SysAidServer\\tomcat\\webapps\\user."