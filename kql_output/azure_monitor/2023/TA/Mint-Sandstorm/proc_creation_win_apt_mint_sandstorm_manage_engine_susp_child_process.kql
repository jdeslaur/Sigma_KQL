// Title: Mint Sandstorm - ManageEngine Suspicious Process Execution
// Rule ID: 58d8341a-5849-44cd-8ac8-8b020413a31b
// Severity: critical
// Tags: attack.execution, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2023/TA/Mint-Sandstorm/proc_creation_win_apt_mint_sandstorm_manage_engine_susp_child_process.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName contains "manageengine" or ParentProcessName contains "ServiceDesk") and ParentProcessName contains "\\java") and (((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\powershell_ise.exe") and ((CommandLine contains " echo " or CommandLine contains "-dumpmode" or CommandLine contains "-ssh" or CommandLine contains ".dmp" or CommandLine contains "add-MpPreference" or CommandLine contains "adscredentials" or CommandLine contains "bitsadmin" or CommandLine contains "certutil" or CommandLine contains "csvhost.exe" or CommandLine contains "DownloadFile" or CommandLine contains "DownloadString" or CommandLine contains "dsquery" or CommandLine contains "ekern.exe" or CommandLine contains "FromBase64String" or CommandLine contains "iex " or CommandLine contains "iex(" or CommandLine contains "Invoke-Expression" or CommandLine contains "Invoke-WebRequest" or CommandLine contains "localgroup administrators" or CommandLine contains "o365accountconfiguration" or CommandLine contains "samaccountname=" or CommandLine contains "set-MpPreference" or CommandLine contains "svhost.exe" or CommandLine contains "System.IO.Compression" or CommandLine contains "System.IO.MemoryStream" or CommandLine contains "usoprivate" or CommandLine contains "usoshared" or CommandLine contains "whoami") or CommandLine matches regex "[-/–][Ee^]{1,2}[ncodema^]*\\s[A-Za-z0-9+/=]{15,}" or CommandLine matches regex "net\\s+user" or CommandLine matches regex "net\\s+group" or CommandLine matches regex "query\\ssession")) or (CommandLine contains "lsass" and (CommandLine contains "procdump" or CommandLine contains "tasklist" or CommandLine contains "findstr")) or ((NewProcessName endswith "\\wget.exe" and CommandLine contains "http") or (NewProcessName endswith "\\curl.exe" and CommandLine contains "http") or (CommandLine contains "E:jscript" or CommandLine contains "e:vbscript") or (CommandLine contains "localgroup Administrators" and CommandLine contains "/add") or (CommandLine contains "net" and (CommandLine contains "user" and CommandLine contains "/add")) or ((CommandLine contains "reg add" and CommandLine contains "DisableAntiSpyware" and CommandLine contains "\\Microsoft\\Windows Defender") or (CommandLine contains "reg add" and CommandLine contains "DisableRestrictedAdmin" and CommandLine contains "CurrentControlSet\\Control\\Lsa")) or (CommandLine contains "wmic" and CommandLine contains "process call create") or (CommandLine contains "wmic" and CommandLine contains "delete" and CommandLine contains "shadowcopy") or (CommandLine contains "vssadmin" and CommandLine contains "delete" and CommandLine contains "shadows") or (CommandLine contains "wbadmin" and CommandLine contains "delete" and CommandLine contains "catalog"))) and (not((CommandLine contains "download.microsoft.com" and CommandLine contains "manageengine.com" and CommandLine contains "msiexec")))