// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "\\rundll32.exe" and (CommandLine contains "%LOCALAPPDATA%" or CommandLine contains "\\AppData\\Local\\")) and (CommandLine contains ".dat\"," or (CommandLine endswith ".dll #1" or CommandLine endswith ".dll\" #1" or CommandLine endswith ".dll\",#1"))) and (not(CommandLine contains "\\AppData\\Local\\Temp\\"))