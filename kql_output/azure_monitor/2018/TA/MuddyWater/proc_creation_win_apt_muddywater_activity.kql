SecurityEvent
| where (CommandLine contains "vbscript:Close(Execute(\"CreateObject(" and CommandLine contains "powershell" and CommandLine contains "-w 1 -exec Bypass" and CommandLine contains "\\ProgramData\\") or (CommandLine contains "Win32_OperatingSystem" and CommandLine contains "Win32_NetworkAdapterConfiguration" and CommandLine contains "root\\SecurityCenter2" and CommandLine contains "[System.Net.DNS]") or (CommandLine contains "[Convert]::ToBase64String" and CommandLine contains "[System.Text.Encoding]::UTF8.GetString]" and CommandLine contains "GetResponse().GetResponseStream()" and CommandLine contains "[System.Net.HttpWebRequest]::Create(" and CommandLine contains "-bxor ")