SecurityEvent
| where (ParentProcessName endswith "\\sllauncher.exe" and NewProcessName endswith "\\svchost.exe") or (ParentProcessName contains "\\AppData\\Roaming\\" and NewProcessName endswith "\\svchost.exe" and CommandLine contains "-k")