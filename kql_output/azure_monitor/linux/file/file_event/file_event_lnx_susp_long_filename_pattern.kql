// Title: Potentially Suspicious Long Filename Pattern - Linux
// Rule ID: 11629c4d-0fe6-465b-be62-b39a1c442aad
// Severity: low
// Tags: attack.execution, attack.t1059.004, attack.defense-evasion, attack.t1027, detection.threat-hunting
// Category: file_event
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-threat-hunting/linux/file/file_event/file_event_lnx_susp_long_filename_pattern.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ObjectName matches regex "[^/]{100,}$" and (not((ObjectName startswith "/run/systemd/units/invocation:systemd-fsck@" or ObjectName startswith "/sys/firmware/" or ObjectName startswith "/var/log/journal/")))