// Title: Inline Python Execution - Spawn Shell Via OS System Library
// Rule ID: 2d2f44ff-4611-4778-a8fc-323a0e9850cc
// Severity: high
// Tags: attack.execution, attack.t1059
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_python_shell_os_system.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "/python" or NewProcessName endswith "/python2" or NewProcessName endswith "/python3") or (NewProcessName contains "/python2." or NewProcessName contains "/python3.")) and ((CommandLine contains " -c " and CommandLine contains "os.system(") and (CommandLine contains "/bin/bash" or CommandLine contains "/bin/dash" or CommandLine contains "/bin/fish" or CommandLine contains "/bin/sh" or CommandLine contains "/bin/zsh"))