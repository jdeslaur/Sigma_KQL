SecurityEvent
| where NewProcessName endswith "/atop" or NewProcessName endswith "/htop" or NewProcessName endswith "/pgrep" or NewProcessName endswith "/ps" or NewProcessName endswith "/pstree" or NewProcessName endswith "/top"