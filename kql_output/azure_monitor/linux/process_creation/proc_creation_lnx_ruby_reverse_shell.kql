SecurityEvent
| where NewProcessName contains "ruby" and (CommandLine contains " -e" and CommandLine contains "rsocket" and CommandLine contains "TCPSocket") and (CommandLine contains " ash" or CommandLine contains " bash" or CommandLine contains " bsh" or CommandLine contains " csh" or CommandLine contains " ksh" or CommandLine contains " pdksh" or CommandLine contains " sh" or CommandLine contains " tcsh")