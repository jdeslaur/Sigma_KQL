SecurityEvent
| where (CommandLine startswith "sh -c " or CommandLine startswith "bash -c ") and ((CommandLine contains "| bash " or CommandLine contains "| sh " or CommandLine contains "|bash " or CommandLine contains "|sh ") or (CommandLine endswith "| bash" or CommandLine endswith "| sh" or CommandLine endswith "|bash" or CommandLine endswith " |sh"))