// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (((NewProcessName endswith "/cat" or NewProcessName endswith "/echo" or NewProcessName endswith "/grep" or NewProcessName endswith "/head" or NewProcessName endswith "/more" or NewProcessName endswith "/tail") and CommandLine contains ">") or (NewProcessName endswith "/emacs" or NewProcessName endswith "/nano" or NewProcessName endswith "/sed" or NewProcessName endswith "/vi" or NewProcessName endswith "/vim")) and (CommandLine contains "/bin/login" or CommandLine contains "/bin/passwd" or CommandLine contains "/boot/" or (CommandLine contains "/etc/" and CommandLine contains ".conf") or CommandLine contains "/etc/cron." or CommandLine contains "/etc/crontab" or CommandLine contains "/etc/hosts" or CommandLine contains "/etc/init.d" or CommandLine contains "/etc/sudoers" or CommandLine contains "/opt/bin/" or CommandLine contains "/sbin" or CommandLine contains "/usr/bin/" or CommandLine contains "/usr/local/bin/")