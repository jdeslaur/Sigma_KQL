// Title: Suspicious Invocation of Shell via Rsync
// Rule ID: 297241f3-8108-4b3a-8c15-2dda9f844594
// Severity: high
// Tags: attack.execution, attack.t1059, attack.t1203
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_rsync_shell_spawn.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((ParentProcessName endswith "/rsync" or ParentProcessName endswith "/rsyncd") and (NewProcessName endswith "/ash" or NewProcessName endswith "/bash" or NewProcessName endswith "/csh" or NewProcessName endswith "/dash" or NewProcessName endswith "/ksh" or NewProcessName endswith "/sh" or NewProcessName endswith "/tcsh" or NewProcessName endswith "/zsh")) and (not(CommandLine contains " -e "))