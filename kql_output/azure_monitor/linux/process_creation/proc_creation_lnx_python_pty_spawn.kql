SecurityEvent
| where ((NewProcessName endswith "/python" or NewProcessName endswith "/python2" or NewProcessName endswith "/python3") or (NewProcessName contains "/python2." or NewProcessName contains "/python3.")) and (CommandLine contains "import pty" or CommandLine contains "from pty ") and CommandLine contains "spawn"