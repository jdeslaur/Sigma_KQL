SecurityEvent
| where ((NewProcessName endswith "/python" or NewProcessName endswith "/python2" or NewProcessName endswith "/python3") or (NewProcessName contains "/python2." or NewProcessName contains "/python3.")) and (CommandLine contains "http.server" or CommandLine contains "SimpleHTTPServer")