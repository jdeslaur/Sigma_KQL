SecurityEvent
| where (NewProcessName endswith "/cat" or NewProcessName endswith "/ed" or NewProcessName endswith "/egrep" or NewProcessName endswith "/emacs" or NewProcessName endswith "/fgrep" or NewProcessName endswith "/grep" or NewProcessName endswith "/head" or NewProcessName endswith "/less" or NewProcessName endswith "/more" or NewProcessName endswith "/nano" or NewProcessName endswith "/tail") and CommandLine contains " /etc/sudoers"