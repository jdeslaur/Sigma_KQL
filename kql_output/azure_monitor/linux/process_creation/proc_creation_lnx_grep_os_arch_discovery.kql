SecurityEvent
| where NewProcessName endswith "/grep" and (CommandLine endswith "aarch64" or CommandLine endswith "arm" or CommandLine endswith "i386" or CommandLine endswith "i686" or CommandLine endswith "mips" or CommandLine endswith "x86_64")