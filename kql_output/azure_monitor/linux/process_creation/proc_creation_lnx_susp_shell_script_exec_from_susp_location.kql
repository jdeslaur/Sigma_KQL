SecurityEvent
| where (NewProcessName endswith "/bash" or NewProcessName endswith "/csh" or NewProcessName endswith "/dash" or NewProcessName endswith "/fish" or NewProcessName endswith "/ksh" or NewProcessName endswith "/sh" or NewProcessName endswith "/zsh") and CommandLine contains " -c " and CommandLine contains "/tmp/"