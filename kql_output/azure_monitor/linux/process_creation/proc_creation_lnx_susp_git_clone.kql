SecurityEvent
| where (NewProcessName endswith "/git" and CommandLine contains " clone ") and (CommandLine contains "exploit" or CommandLine contains "Vulns" or CommandLine contains "vulnerability" or CommandLine contains "RCE" or CommandLine contains "RemoteCodeExecution" or CommandLine contains "Invoke-" or CommandLine contains "CVE-" or CommandLine contains "poc-" or CommandLine contains "ProofOfConcept" or CommandLine contains "proxyshell" or CommandLine contains "log4shell" or CommandLine contains "eternalblue" or CommandLine contains "eternal-blue" or CommandLine contains "MS17-")