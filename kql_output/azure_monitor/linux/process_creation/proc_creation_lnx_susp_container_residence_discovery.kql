SecurityEvent
| where (NewProcessName endswith "awk" or NewProcessName endswith "/cat" or NewProcessName endswith "grep" or NewProcessName endswith "/head" or NewProcessName endswith "/less" or NewProcessName endswith "/more" or NewProcessName endswith "/nl" or NewProcessName endswith "/tail") and (CommandLine contains "/proc/2/" or (CommandLine contains "/proc/" and (CommandLine endswith "/cgroup" or CommandLine endswith "/sched")))