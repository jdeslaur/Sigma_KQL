// Title: History File Deletion
// Rule ID: 1182f3b3-e716-4efa-99ab-d2685d04360f
// Severity: high
// Tags: attack.impact, attack.t1565.001
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_susp_history_delete.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "/rm" or NewProcessName endswith "/unlink" or NewProcessName endswith "/shred") and ((CommandLine contains "/.bash_history" or CommandLine contains "/.zsh_history") or (CommandLine endswith "_history" or CommandLine endswith ".history" or CommandLine endswith "zhistory"))