SecurityEvent
| where ((NewProcessName endswith "/rvim" or NewProcessName endswith "/vim" or NewProcessName endswith "/vimdiff") and (CommandLine contains " --cmd" or CommandLine contains " -c ")) and (CommandLine contains ":!/" or CommandLine contains ":lua " or CommandLine contains ":py " or CommandLine contains "/bin/bash" or CommandLine contains "/bin/dash" or CommandLine contains "/bin/fish" or CommandLine contains "/bin/sh" or CommandLine contains "/bin/zsh")