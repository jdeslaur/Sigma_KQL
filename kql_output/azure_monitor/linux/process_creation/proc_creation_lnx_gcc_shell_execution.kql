SecurityEvent
| where ((NewProcessName endswith "/c89" or NewProcessName endswith "/c99" or NewProcessName endswith "/gcc") and CommandLine contains "-wrapper") and (CommandLine contains "/bin/bash,-s" or CommandLine contains "/bin/dash,-s" or CommandLine contains "/bin/fish,-s" or CommandLine contains "/bin/sh,-s" or CommandLine contains "/bin/zsh,-s")