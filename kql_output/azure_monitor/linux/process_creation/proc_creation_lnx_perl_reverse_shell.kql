SecurityEvent
| where (NewProcessName endswith "/perl" and CommandLine contains " -e ") and ((CommandLine contains "fdopen(" and CommandLine contains "::Socket::INET") or (CommandLine contains "Socket" and CommandLine contains "connect" and CommandLine contains "open" and CommandLine contains "exec"))