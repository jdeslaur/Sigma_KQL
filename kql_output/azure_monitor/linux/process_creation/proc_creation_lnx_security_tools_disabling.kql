// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "/service" and (CommandLine contains "iptables" and CommandLine contains "stop")) or (NewProcessName endswith "/service" and (CommandLine contains "ip6tables" and CommandLine contains "stop")) or (NewProcessName endswith "/chkconfig" and (CommandLine contains "iptables" and CommandLine contains "stop")) or (NewProcessName endswith "/chkconfig" and (CommandLine contains "ip6tables" and CommandLine contains "stop")) or (NewProcessName endswith "/systemctl" and (CommandLine contains "firewalld" and CommandLine contains "stop")) or (NewProcessName endswith "/systemctl" and (CommandLine contains "firewalld" and CommandLine contains "disable")) or (NewProcessName endswith "/service" and (CommandLine contains "cbdaemon" and CommandLine contains "stop")) or (NewProcessName endswith "/chkconfig" and (CommandLine contains "cbdaemon" and CommandLine contains "off")) or (NewProcessName endswith "/systemctl" and (CommandLine contains "cbdaemon" and CommandLine contains "stop")) or (NewProcessName endswith "/systemctl" and (CommandLine contains "cbdaemon" and CommandLine contains "disable")) or (NewProcessName endswith "/setenforce" and CommandLine contains "0") or (NewProcessName endswith "/systemctl" and (CommandLine contains "stop" and CommandLine contains "falcon-sensor")) or (NewProcessName endswith "/systemctl" and (CommandLine contains "disable" and CommandLine contains "falcon-sensor"))