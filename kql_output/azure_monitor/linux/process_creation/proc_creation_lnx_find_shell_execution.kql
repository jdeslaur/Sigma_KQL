SecurityEvent
| where (NewProcessName endswith "/find" and (CommandLine contains " . " and CommandLine contains "-exec")) and (CommandLine contains "/bin/bash" or CommandLine contains "/bin/dash" or CommandLine contains "/bin/fish" or CommandLine contains "/bin/sh" or CommandLine contains "/bin/zsh")