// Title: Suspicious Package Installed - Linux
// Rule ID: 700fb7e8-2981-401c-8430-be58e189e741
// Severity: medium
// Tags: attack.defense-evasion, attack.t1553.004
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_install_suspicious_packages.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (((NewProcessName endswith "/apt" or NewProcessName endswith "/apt-get") and CommandLine contains "install") or (NewProcessName endswith "/yum" and (CommandLine contains "localinstall" or CommandLine contains "install")) or (NewProcessName endswith "/rpm" and CommandLine contains "-i") or (NewProcessName endswith "/dpkg" and (CommandLine contains "--install" or CommandLine contains "-i"))) and (CommandLine contains "nmap" or CommandLine contains " nc" or CommandLine contains "netcat" or CommandLine contains "wireshark" or CommandLine contains "tshark" or CommandLine contains "openconnect" or CommandLine contains "proxychains" or CommandLine contains "socat")