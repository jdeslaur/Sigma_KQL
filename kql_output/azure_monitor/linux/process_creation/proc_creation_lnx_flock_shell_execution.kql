SecurityEvent
| where (NewProcessName endswith "/flock" and CommandLine contains " -u ") and (CommandLine contains "/bin/bash" or CommandLine contains "/bin/dash" or CommandLine contains "/bin/fish" or CommandLine contains "/bin/sh" or CommandLine contains "/bin/zsh")