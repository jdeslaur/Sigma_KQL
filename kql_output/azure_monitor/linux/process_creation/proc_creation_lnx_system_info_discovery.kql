SecurityEvent
| where NewProcessName endswith "/uname" or NewProcessName endswith "/hostname" or NewProcessName endswith "/uptime" or NewProcessName endswith "/lspci" or NewProcessName endswith "/dmidecode" or NewProcessName endswith "/lscpu" or NewProcessName endswith "/lsmod"