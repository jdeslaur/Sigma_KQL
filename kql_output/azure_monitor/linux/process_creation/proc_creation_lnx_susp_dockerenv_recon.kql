SecurityEvent
| where (NewProcessName endswith "/cat" or NewProcessName endswith "/dir" or NewProcessName endswith "/find" or NewProcessName endswith "/ls" or NewProcessName endswith "/stat" or NewProcessName endswith "/test" or NewProcessName endswith "grep") and CommandLine endswith ".dockerenv"