// Title: Suspicious Curl File Upload - Linux
// Rule ID: 00b90cc1-17ec-402c-96ad-3a8117d7a582
// Severity: medium
// Tags: attack.exfiltration, attack.command-and-control, attack.t1567, attack.t1105
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_susp_curl_fileupload.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "/curl" and ((CommandLine contains " --form" or CommandLine contains " --upload-file " or CommandLine contains " --data " or CommandLine contains " --data-") or CommandLine matches regex "\\s-[FTd]\\s")) and (not((CommandLine contains "://localhost" or CommandLine contains "://127.0.0.1")))