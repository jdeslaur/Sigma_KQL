// Title: Suspicious Invocation of Shell via AWK - Linux
// Rule ID: 8c1a5675-cb85-452f-a298-b01b22a51856
// Severity: high
// Tags: attack.execution, attack.t1059
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_awk_shell_spawn.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "/awk" or NewProcessName endswith "/gawk" or NewProcessName endswith "/mawk" or NewProcessName endswith "/nawk") and CommandLine contains "BEGIN {system") and (CommandLine contains "/bin/bash" or CommandLine contains "/bin/dash" or CommandLine contains "/bin/fish" or CommandLine contains "/bin/sh" or CommandLine contains "/bin/zsh")