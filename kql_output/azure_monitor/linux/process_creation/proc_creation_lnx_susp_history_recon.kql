// Title: Print History File Contents
// Rule ID: d7821ff1-4527-4e33-9f84-d0d57fa2fb66
// Severity: medium
// Tags: attack.reconnaissance, attack.t1592.004
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_susp_history_recon.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "/cat" or NewProcessName endswith "/head" or NewProcessName endswith "/tail" or NewProcessName endswith "/more") and ((CommandLine contains "/.bash_history" or CommandLine contains "/.zsh_history") or (CommandLine endswith "_history" or CommandLine endswith ".history" or CommandLine endswith "zhistory"))