SecurityEvent
| where (NewProcessName endswith "/yum" and (CommandLine contains "erase" or CommandLine contains "remove")) or ((NewProcessName endswith "/apt" or NewProcessName endswith "/apt-get") and (CommandLine contains "remove" or CommandLine contains "purge")) or (NewProcessName endswith "/dpkg" and (CommandLine contains "--remove " or CommandLine contains " -r ")) or (NewProcessName endswith "/rpm" and CommandLine contains " -e ")