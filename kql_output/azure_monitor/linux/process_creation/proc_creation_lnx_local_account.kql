// Title: Local System Accounts Discovery - Linux
// Rule ID: b45e3d6f-42c6-47d8-a478-df6bd6cf534c
// Severity: low
// Tags: attack.discovery, attack.t1087.001
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_local_account.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "/lastlog" or CommandLine contains "'x:0:'" or ((NewProcessName endswith "/cat" or NewProcessName endswith "/ed" or NewProcessName endswith "/head" or NewProcessName endswith "/more" or NewProcessName endswith "/nano" or NewProcessName endswith "/tail" or NewProcessName endswith "/vi" or NewProcessName endswith "/vim" or NewProcessName endswith "/less" or NewProcessName endswith "/emacs" or NewProcessName endswith "/sqlite3" or NewProcessName endswith "/makemap") and (CommandLine contains "/etc/passwd" or CommandLine contains "/etc/shadow" or CommandLine contains "/etc/sudoers" or CommandLine contains "/etc/spwd.db" or CommandLine contains "/etc/pwd.db" or CommandLine contains "/etc/master.passwd")) or NewProcessName endswith "/id" or (NewProcessName endswith "/lsof" and CommandLine contains "-u")