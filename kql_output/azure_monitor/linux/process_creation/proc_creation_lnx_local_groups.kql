// Title: Local Groups Discovery - Linux
// Rule ID: 676381a6-15ca-4d73-a9c8-6a22e970b90d
// Severity: low
// Tags: attack.discovery, attack.t1069.001
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_local_groups.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where NewProcessName endswith "/groups" or ((NewProcessName endswith "/cat" or NewProcessName endswith "/ed" or NewProcessName endswith "/head" or NewProcessName endswith "/less" or NewProcessName endswith "/more" or NewProcessName endswith "/nano" or NewProcessName endswith "/tail" or NewProcessName endswith "/vi" or NewProcessName endswith "/vim") and CommandLine contains "/etc/group")