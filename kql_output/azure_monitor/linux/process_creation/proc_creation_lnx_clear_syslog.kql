// Title: Syslog Clearing or Removal Via System Utilities
// Rule ID: 3fcc9b35-39e4-44c0-a2ad-9e82b6902b31
// Severity: high
// Tags: attack.defense-evasion, attack.t1070.002
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_clear_syslog.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains "/var/log/syslog" and ((NewProcessName endswith "/rm" and (CommandLine contains " -r " or CommandLine contains " -f " or CommandLine contains " -rf " or CommandLine contains "/var/log/syslog")) or NewProcessName endswith "/unlink" or NewProcessName endswith "/mv" or (NewProcessName endswith "/truncate" and (CommandLine contains "0 " and CommandLine contains "/var/log/syslog") and (CommandLine contains "-s " or CommandLine contains "-c " or CommandLine contains "--size")) or (NewProcessName endswith "/ln" and (CommandLine contains "/dev/null " and CommandLine contains "/var/log/syslog") and (CommandLine contains "-sf " or CommandLine contains "-sfn " or CommandLine contains "-sfT ")) or (NewProcessName endswith "/cp" and CommandLine contains "/dev/null") or (NewProcessName endswith "/shred" and CommandLine contains "-u "))) or ((CommandLine contains " > /var/log/syslog" or CommandLine contains " >/var/log/syslog" or CommandLine contains " >| /var/log/syslog" or CommandLine contains ": > /var/log/syslog" or CommandLine contains ":> /var/log/syslog" or CommandLine contains ":>/var/log/syslog" or CommandLine contains ">|/var/log/syslog") or (CommandLine contains "journalctl --vacuum" or CommandLine contains "journalctl --rotate"))