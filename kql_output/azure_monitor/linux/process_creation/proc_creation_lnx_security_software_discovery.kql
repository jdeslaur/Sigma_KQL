SecurityEvent
| where (NewProcessName endswith "/grep" or NewProcessName endswith "/egrep") and (CommandLine contains "nessusd" or CommandLine contains "td-agent" or CommandLine contains "packetbeat" or CommandLine contains "filebeat" or CommandLine contains "auditbeat" or CommandLine contains "osqueryd" or CommandLine contains "cbagentd" or CommandLine contains "falcond")