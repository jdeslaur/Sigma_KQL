// Title: Shell Execution Of Process Located In Tmp Directory
// Rule ID: 2fade0b6-7423-4835-9d4f-335b39b83867
// Severity: high
// Tags: attack.execution
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_susp_shell_child_process_from_parent_tmp_folder.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ParentProcessName startswith "/tmp/" and (NewProcessName endswith "/bash" or NewProcessName endswith "/csh" or NewProcessName endswith "/dash" or NewProcessName endswith "/fish" or NewProcessName endswith "/ksh" or NewProcessName endswith "/sh" or NewProcessName endswith "/zsh")