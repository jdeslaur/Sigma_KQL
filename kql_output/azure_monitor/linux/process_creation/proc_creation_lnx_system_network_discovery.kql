SecurityEvent
| where (NewProcessName endswith "/firewall-cmd" or NewProcessName endswith "/ufw" or NewProcessName endswith "/iptables" or NewProcessName endswith "/netstat" or NewProcessName endswith "/ss" or NewProcessName endswith "/ip" or NewProcessName endswith "/ifconfig" or NewProcessName endswith "/systemd-resolve" or NewProcessName endswith "/route") or CommandLine contains "/etc/resolv.conf"