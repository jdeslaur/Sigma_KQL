// Title: Linux Network Service Scanning Tools Execution
// Rule ID: 3e102cd9-a70d-4a7a-9508-403963092f31
// Severity: low
// Tags: attack.discovery, attack.t1046
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_susp_network_utilities_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where ((NewProcessName endswith "/nc" or NewProcessName endswith "/ncat" or NewProcessName endswith "/netcat" or NewProcessName endswith "/socat") and (not((CommandLine contains " --listen " or CommandLine contains " -l ")))) or (NewProcessName endswith "/autorecon" or NewProcessName endswith "/hping" or NewProcessName endswith "/hping2" or NewProcessName endswith "/hping3" or NewProcessName endswith "/naabu" or NewProcessName endswith "/nmap" or NewProcessName endswith "/nping" or NewProcessName endswith "/telnet" or NewProcessName endswith "/zenmap")