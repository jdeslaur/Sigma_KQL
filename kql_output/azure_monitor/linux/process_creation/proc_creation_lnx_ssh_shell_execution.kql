// Title: Shell Invocation Via Ssh - Linux
// Rule ID: 8737b7f6-8df3-4bb7-b1da-06019b99b687
// Severity: high
// Tags: attack.execution, attack.t1059
// Category: process_creation
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/process_creation/proc_creation_lnx_ssh_shell_execution.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (NewProcessName endswith "/ssh" and (CommandLine contains "ProxyCommand=;" or CommandLine contains "permitlocalcommand=yes" or CommandLine contains "localhost")) and (CommandLine contains "/bin/bash" or CommandLine contains "/bin/dash" or CommandLine contains "/bin/fish" or CommandLine contains "/bin/sh" or CommandLine contains "/bin/zsh" or CommandLine contains "sh 0<&2 1>&2" or CommandLine contains "sh 1>&2 0<&2")