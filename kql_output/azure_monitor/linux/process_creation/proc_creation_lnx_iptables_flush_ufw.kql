SecurityEvent
| where (NewProcessName endswith "/iptables" or NewProcessName endswith "/xtables-legacy-multi" or NewProcessName endswith "/iptables-legacy-multi" or NewProcessName endswith "/ip6tables" or NewProcessName endswith "/ip6tables-legacy-multi") and (CommandLine contains "-F" or CommandLine contains "-Z" or CommandLine contains "-X") and (CommandLine contains "ufw-logging-deny" or CommandLine contains "ufw-logging-allow" or CommandLine contains "ufw6-logging-deny" or CommandLine contains "ufw6-logging-allow")