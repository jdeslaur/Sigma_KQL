SecurityEvent
| where NewProcessName contains "/php" and (CommandLine contains " -r " and CommandLine contains "fsockopen") and (CommandLine contains "ash" or CommandLine contains "bash" or CommandLine contains "bsh" or CommandLine contains "csh" or CommandLine contains "ksh" or CommandLine contains "pdksh" or CommandLine contains "sh" or CommandLine contains "tcsh" or CommandLine contains "zsh")