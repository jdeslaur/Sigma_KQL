// Title: Persistence Via Cron Files
// Rule ID: 6c4e2f43-d94d-4ead-b64d-97e53fa2bd05
// Severity: medium
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.003
// Category: file_event
// Product: linux
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules/linux/file_event/file_event_lnx_persistence_cron_files.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (ObjectName startswith "/etc/cron.d/" or ObjectName startswith "/etc/cron.daily/" or ObjectName startswith "/etc/cron.hourly/" or ObjectName startswith "/etc/cron.monthly/" or ObjectName startswith "/etc/cron.weekly/" or ObjectName startswith "/var/spool/cron/crontabs/") or (ObjectName contains "/etc/cron.allow" or ObjectName contains "/etc/cron.deny" or ObjectName contains "/etc/crontab")