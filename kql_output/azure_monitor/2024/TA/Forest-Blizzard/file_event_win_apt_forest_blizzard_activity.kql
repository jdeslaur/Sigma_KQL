SecurityEvent
| where ((ObjectName startswith "C:\\ProgramData\\Microsoft\\v" or ObjectName startswith "C:\\ProgramData\\Adobe\\v" or ObjectName startswith "C:\\ProgramData\\Comms\\v" or ObjectName startswith "C:\\ProgramData\\Intel\\v" or ObjectName startswith "C:\\ProgramData\\Kaspersky Lab\\v" or ObjectName startswith "C:\\ProgramData\\Bitdefender\\v" or ObjectName startswith "C:\\ProgramData\\ESET\\v" or ObjectName startswith "C:\\ProgramData\\NVIDIA\\v" or ObjectName startswith "C:\\ProgramData\\UbiSoft\\v" or ObjectName startswith "C:\\ProgramData\\Steam\\v") and (ObjectName contains "\\prnms003.inf_" or ObjectName contains "\\prnms009.inf_")) or (ObjectName =~ "C:\\ProgramData*" and ((ObjectName endswith ".save" or ObjectName endswith "\\doit.bat" or ObjectName endswith "\\execute.bat" or ObjectName endswith "\\servtask.bat") or (ObjectName contains "\\wayzgoose" and ObjectName endswith ".dll")))