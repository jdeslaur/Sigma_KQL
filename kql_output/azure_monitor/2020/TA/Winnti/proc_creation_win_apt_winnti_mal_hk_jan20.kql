SecurityEvent
| where ((ParentProcessName contains "C:\\Windows\\Temp" or ParentProcessName contains "\\hpqhvind.exe") and NewProcessName startswith "C:\\ProgramData\\DRM") or (ParentProcessName startswith "C:\\ProgramData\\DRM" and NewProcessName endswith "\\wmplayer.exe") or (ParentProcessName endswith "\\Test.exe" and NewProcessName endswith "\\wmplayer.exe") or NewProcessName =~ "C:\\ProgramData\\DRM\\CLR\\CLR.exe" or (ParentProcessName startswith "C:\\ProgramData\\DRM\\Windows" and NewProcessName endswith "\\SearchFilterHost.exe")