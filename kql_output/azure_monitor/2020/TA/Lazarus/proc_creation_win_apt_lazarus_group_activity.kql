SecurityEvent
| where (CommandLine contains "reg.exe save hklm\\sam %temp%\\~reg_sam.save" or CommandLine contains "1q2w3e4r@#$@#$@#$" or CommandLine contains " -hp1q2w3e4 " or CommandLine contains ".dat data03 10000 -p ") or (CommandLine contains "netstat -aon | find " and CommandLine contains "ESTA" and CommandLine contains " > %temp%\\~") or (CommandLine contains ".255 10 C:\\ProgramData\\IBM\\" and CommandLine contains ".DAT") or ((CommandLine contains " /c " and CommandLine contains " -p 0x") and (CommandLine contains "C:\\ProgramData\\" or CommandLine contains "C:\\RECYCLER\\")) or ((CommandLine contains "rundll32 " and CommandLine contains "C:\\ProgramData\\") and (CommandLine contains ".bin," or CommandLine contains ".tmp," or CommandLine contains ".dat," or CommandLine contains ".io," or CommandLine contains ".ini," or CommandLine contains ".db,"))