SecurityEvent
| where (NewProcessName endswith ":\\ProgramData\\adobe\\Adobe.exe" or NewProcessName endswith ":\\ProgramData\\oracle\\local.exe" or NewProcessName endswith "\\revshell.exe" or NewProcessName endswith "\\infopagesbackup\\ncat.exe" or NewProcessName endswith ":\\ProgramData\\comms\\comms.exe") or (CommandLine contains "-ExecutionPolicy Bypass -File" and CommandLine contains "\\msf.ps1") or (CommandLine contains "infopagesbackup" and CommandLine contains "\\ncat" and CommandLine contains "-e cmd.exe") or (CommandLine contains "system.Data.SqlClient.SqlDataAdapter($cmd); [void]$da.fill" or CommandLine contains "-nop -w hidden -c $k=new-object" or CommandLine contains "[Net.CredentialCache]::DefaultCredentials;IEX " or CommandLine contains " -nop -w hidden -c $m=new-object net.webclient;$m" or CommandLine contains "-noninteractive -executionpolicy bypass whoami" or CommandLine contains "-noninteractive -executionpolicy bypass netstat -a") or CommandLine contains "L3NlcnZlcj1"