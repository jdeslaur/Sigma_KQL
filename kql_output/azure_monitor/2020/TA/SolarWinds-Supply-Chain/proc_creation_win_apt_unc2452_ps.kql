SecurityEvent
| where (CommandLine contains "Invoke-WMIMethod win32_process -name create -argumentlist" and CommandLine contains "rundll32 c:\\windows") or (CommandLine contains "wmic /node:" and CommandLine contains "process call create \"rundll32 c:\\windows")