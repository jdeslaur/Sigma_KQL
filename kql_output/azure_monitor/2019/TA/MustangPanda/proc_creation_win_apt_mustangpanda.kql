SecurityEvent
| where ((CommandLine contains "Temp\\wtask.exe /create" or CommandLine contains "%windir:~-3,1%%PUBLIC:~-9,1%" or CommandLine contains "/tn \"Security Script " or CommandLine contains "%windir:~-1,1%") or (CommandLine contains "/E:vbscript" and CommandLine contains "C:\\Users\\" and CommandLine contains ".txt" and CommandLine contains "/F")) or NewProcessName endswith "Temp\\winwsh.exe"