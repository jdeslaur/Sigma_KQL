| where (CommandLine contains "ldifde" and CommandLine contains "-f -n" and CommandLine contains "eprod.ldf") or ((CommandLine contains "copy \\\\" and CommandLine contains "c$") and (CommandLine contains "\\aaaa\\procdump64.exe" or CommandLine contains "\\aaaa\\netsess.exe" or CommandLine contains "\\aaaa\\7za.exe" or CommandLine contains "\\c$\\aaaa\\"))