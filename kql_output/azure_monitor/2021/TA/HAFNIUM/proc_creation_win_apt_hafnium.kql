// Title: HAFNIUM Exchange Exploitation Activity
// Rule ID: bbb2dedd-a0e3-46ab-ba6c-6c82ae7a9aa7
// Severity: critical
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1546, attack.t1053, attack.g0125, detection.emerging-threats
// Category: process_creation
// Product: windows
// Pipeline: azure_monitor
// Source: /home/user/Sigma_KQL/sigma_rules/rules-emerging-threats/2021/TA/HAFNIUM/proc_creation_win_apt_hafnium.yml
//
// Generated by sigma-to-kql converter
// Sigma rules: https://github.com/SigmaHQ/sigma
// pySigma Kusto backend: https://github.com/AttackIQ/pySigma-backend-kusto

SecurityEvent
| where (CommandLine contains "attrib" and CommandLine contains " +h " and CommandLine contains " +s " and CommandLine contains " +r " and CommandLine contains ".aspx") or (NewProcessName contains "\\ProgramData\\VSPerfMon\\" or (CommandLine contains "schtasks" and CommandLine contains "VSPerfMon")) or (NewProcessName endswith "Opera_browser.exe" and (ParentProcessName endswith "\\services.exe" or ParentProcessName endswith "\\svchost.exe")) or NewProcessName endswith "Users\\Public\\opera\\Opera_browser.exe" or (CommandLine contains "vssadmin list shadows" and CommandLine contains "Temp\\__output") or (NewProcessName endswith "\\makecab.exe" and (CommandLine contains "inetpub\\wwwroot\\" and CommandLine contains ".dmp.zip")) or (NewProcessName endswith "\\makecab.exe" and (CommandLine contains "Microsoft\\Exchange Server\\" or CommandLine contains "compressionmemory" or CommandLine contains ".gif")) or (CommandLine contains " -t7z " and CommandLine contains "C:\\Programdata\\pst" and CommandLine contains "\\it.zip") or (CommandLine contains "\\comsvcs.dll" and CommandLine contains "Minidump" and CommandLine contains "full " and CommandLine contains "\\inetpub\\wwwroot") or (CommandLine contains "Windows\\Temp\\xx.bat" or CommandLine contains "Windows\\WwanSvcdcs" or CommandLine contains "Windows\\Temp\\cw.exe")