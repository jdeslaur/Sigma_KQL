SecurityEvent
| where (CommandLine contains "C:\\Windows\\cert.exe" or CommandLine contains "del /q /f c:\\kworking\\agent.crt" or CommandLine contains "Kaseya VSA Agent Hot-fix" or CommandLine contains "\\AppData\\Local\\Temp\\MsMpEng.exe" or CommandLine contains "rmdir /s /q %SystemDrive%\\inetpub\\logs" or (CommandLine contains "del /s /q /f %SystemDrive%\\" and CommandLine contains ".log") or CommandLine contains "c:\\kworking1\\agent.exe" or CommandLine contains "c:\\kworking1\\agent.crt") or (NewProcessName in~ ("C:\\Windows\\MsMpEng.exe", "C:\\Windows\\cert.exe", "C:\\kworking\\agent.exe", "C:\\kworking1\\agent.exe")) or (CommandLine contains "del /s /q /f" and CommandLine contains "WebPages\\Errors\\webErrorLog.txt")